# Copy thành .env trong thư mục triển khai rồi sửa giá trị trước khi chạy:
#   docker compose up -d --build
# Tên biến __ map vào appsettings (.NET).

WORKER_CONTAINER_NAME=ems-eoms-category-sync-worker

DOTNET_ENVIRONMENT=Production

# Timeout / an toàn job (tùy chọn; mặc định trong appsettings.json)
# Worker__HttpTimeoutSeconds=120
# Worker__OracleCommandTimeoutSeconds=180
# Worker__OracleConnectionTimeoutSeconds=30
# Worker__StopHostOnBackgroundServiceException=true

ConnectionStrings__EMSONE=Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=oracle-host)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=EMSONEDB)));User Id=emsone;Password=CHANGE_ME;

# Đồng bộ danh mục EOMS (Tỉnh / Xã / Sản phẩm) lúc 00:00
EomsCategory__Enabled=true
EomsCategory__BaseUrl=https://uat-vlp-edi.vnpost.vn
EomsCategory__SecretKey=9CnQHmC8qUDhbQ7VTbU4
EomsCategory__AppCode=VLP
EomsCategory__SchemeCode=VLP-RC
EomsCategory__UseSign=true
EomsCategory__RunAtLocalTime=00:00
EomsCategory__TimeZoneId=Asia/Ho_Chi_Minh
EomsCategory__RunOnStartup=false
EomsCategory__ProductPageSize=100
EomsCategory__ProductBrand=EMS
EomsCategory__MaxRetry=3
EomsCategory__MongoConnectionString=mongodb://user:pass@mongo-host:27017/
EomsCategory__MongoDatabaseName=emsoneloguat
EomsCategory__MongoCollectionName=EomsCategorySyncLog
