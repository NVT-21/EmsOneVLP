# Trên server: mỗi folder (uat / product) một bản copy; trong folder đó đổi tên file này thành .env
#   docker compose up -d --build
#
# WORKER_CONTAINER_NAME phải khác nhau giữa UAT và Product nếu chạy trên cùng một máy.
# Tên biến __ map vào appsettings (.NET).

WORKER_CONTAINER_NAME=ems-transport-worker

DOTNET_ENVIRONMENT=Production

# Timeout / an toàn job (tùy chọn; mặc định trong appsettings.json)
# Worker__HttpTimeoutSeconds=120
# Worker__OracleConnectionTimeoutSeconds=30
# Worker__MaxProcessingSecondsPerMessage=300
# Worker__StopHostOnBackgroundServiceException=true

ConnectionStrings__EMSONE=Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=oracle-host)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=EMSONEDB)));User Id=emsone;Password=CHANGE_ME;

RabbitMQ__HostName=rabbitmq
RabbitMQ__Port=5672
RabbitMQ__UseSsl=false
RabbitMQ__SslServerName=
RabbitMQ__VirtualHost=/
RabbitMQ__AmqpUri=
RabbitMQ__UserName=ems_user
RabbitMQ__Password=CHANGE_ME
RabbitMQ__QueueName=transport_queue

Mongo__ConnectionString=mongodb://user:pass@mongo-host:27017/
Mongo__DatabaseName=emsoneloguat
Mongo__CollectionName=OrderSendTransport

EMS__ApiUrl=http://ems-api-host:8060/
EMS__ApiKey=CHANGE_ME
EMS__Authorization=BASE64_BASIC_HERE
EMS__TransportKey=

SyncGateway__BaseUrl=
