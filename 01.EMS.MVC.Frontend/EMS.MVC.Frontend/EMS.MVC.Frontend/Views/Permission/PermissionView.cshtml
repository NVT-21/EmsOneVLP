@model EMS.MVC.Frontend.Models.PermissionViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-3">
                        <div class="mb-3">
                            <label class="mb-1">Cấp sử dụng</label>
                            @Html.DropDownListFor(model => model.ShopLevel, new SelectList(Model.ListShopLevel, "Value", "Text"), new { @class = "select2" })
                        </div>
                    </div>
                    <div class="col-3">
                        <div class="mb-3">
                            <label class="mb-1">Nhóm quyền</label>
                            @Html.DropDownListFor(model => model.GroupPermissionID, new SelectList(Model.ListGroupPermission, "ID", "GroupPermissionName"), "--- Chọn nhóm quyền ---", new { @class = "select2" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card d-none" id="ShowListFunctionalView">
        <div class="card-body">
            <div id="ListFunctionalView" class="decentralization">
               
            </div>
        </div>
        <div class="card-footer d-sm-flex justify-content-end align-items-center">
            <button type="button" class="btn btn-outline-dark">Hủy bỏ</button>
            <button type="button" class="btn btn-primary" id="btnSubmit">Cập nhật</button>
        </div>
    </div>
</div>
@section scripts{

    <script>
        function LoadListFunctionalView(GroupPermissionID) {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("SearchListFunctionalView", "Permission")',
                data: {
                    GroupPermissionID: GroupPermissionID
                },
                loading: true,
                dataType: 'html',
                success: function (data) {
                    if (GroupPermissionID) {
                        $("#ShowListFunctionalView").removeClass("d-none");
                        $("#ListFunctionalView").html(data);
                    } else {
                        $("#ShowListFunctionalView").addClass("d-none");
                    }
                },
                error: function (xhr, status, error) {
                    var err = eval("(" + xhr.responseText + ")");
                    swal({
                        title: 'Lỗi',
                        text: err.Message,
                        button: {
                            text: "ĐÓNG",
                            value: true,
                            visible: true,
                            className: "btn btn-primary"
                        }
                    });
                    return;
                }
            });
        }

        $("#GroupPermissionID").on("change", function () {
            var GroupPermissionID = $(this).val();
            LoadListFunctionalView(GroupPermissionID);
        });

        $("#btnSubmit").on("click", function () {
            var checked_ids = [];
            //get_selected: lay tat ca nut duoc check
            //get_top_checked: lay nut cha va nut con
            //get_bottom_checked: lay nut con
            //get_undetermined: lay nut chua duoc check
            var selectedNodes = $('#tree').jstree("get_bottom_checked", true);
            $.each(selectedNodes, function () {
                //console.log(this);
                checked_ids.push(this.id);
            });

            if (checked_ids.length == 0) {
                CreateCustomSwal("error", "Vui lòng chọn chức năng");
                return;
            }

            swal({
                title: 'Thông báo',
                text: "Sau khi sửa, các nhân viên thuộc nhóm " + $("#GroupPermissionID option:selected").text() + " sẽ được cập nhật thay đổi, bạn có chắc chắn thay đổi?",
                html: true,
                buttons: {
                    confirm: {
                        text: "CÓ",
                        value: true,
                        visible: true,
                        className: "btn btn-primary",
                        closeModal: true
                    },
                    cancel: {
                        text: "KHÔNG",
                        value: false,
                        visible: true,
                        className: "btn btn-danger",
                        closeModal: true,
                    }
                },
            }).then((value) => {
                if (value) {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("JChangeFunctional", "Permission")',
                        dataType: 'json',
                        loading: true,
                        data: {
                            GroupPermissionID: $("#GroupPermissionID").val(),
                            strFunctionalID: checked_ids.join(",")
                        },
                        success: function (res) {
                            if (res.Code == "00") {
                                CreateCustomSwal("error", res.Message);
                            } else {
                                CreateCustomSwal("error", res.Message);
                            }
                        },
                        error: function (xhr, status, error) {
                            var err = eval("(" + xhr.responseText + ")");
                            swal({
                                title: 'Lỗi',
                                text: err.Message,
                                button: {
                                    text: "ĐÓNG",
                                    value: true,
                                    visible: true,
                                    className: "btn btn-primary"
                                }
                            });
                            return;
                        }
                    });
                }
            });
        });
    </script>

}