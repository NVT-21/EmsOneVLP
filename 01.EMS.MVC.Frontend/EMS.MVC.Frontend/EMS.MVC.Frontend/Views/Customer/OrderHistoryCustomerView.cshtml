@model List<EMS.MVC.Frontend.Models.OrderHistoryViewModel>
<table id="SearchListDataTable" class="table table-responsive-md" style="width: 100%;">
    <thead>
        <tr>
            <th> STT </th>
            <th> Mã đơn hàng </th>
            <th> Thời gian mua hàng </th>
            <th> Số tiền </th>
        </tr>
    </thead>
    <tbody>
        @{
            var stt = 1;
            long total = 0;
            foreach (var item in Model)
            {
                total += item.TotalProductValue;
                <tr>
                    <td>@(stt++)</td>
                    <td><a class="text-primary" style="cursor:pointer;" onclick="Detail(@item.ID)">@item.OrderCode</a></td>
                    <td>
                        @{
                            var split = item.CreatedDate.Split(' ');
                            <span>@split[1]</span>
                            <br />
                            <span>@split[0]</span>
                        }
                    </td>
                    <td>@item.TotalProductValue.ToString("N0")</td>
                </tr>
            }
        }
    </tbody>
    @if (Model.Count > 0)
    {
        <tfoot>
            <tr>
                <td colspan="3" class="text-left">Tổng: @(stt-1)</td>
                <td class="text-right">@total.ToString("N0")</td>
            </tr>
        </tfoot>
    }
</table>

<script>
    $(document).ready(function () {
        MyCreateDataTable("SearchListDataTable");
    });

    function Detail(OrderID) {
        $.get('@Url.Action("DetailOrderView", "Order")', {
            OrderID: OrderID, ShopID: @XHelper.Session.EmployeeProfile.ShopInformation.ID
        }, function (data) {
            $('#modal-ViewModal-html').html(data);
            $('#ViewModal').modal('show');
        });
    }
</script>