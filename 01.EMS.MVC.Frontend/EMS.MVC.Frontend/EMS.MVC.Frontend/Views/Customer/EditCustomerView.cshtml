@model EMS.MVC.Frontend.Models.EditCustomerViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-medium">
    <div class="card">
        <div class="card-header border-0 ">
            <h5 class="card-title">Sửa thông tin khách hàng</h5>
        </div>
        <div class="card-body">
            <p class="fs-16 font-w600">Thông tin liên hệ</p>
            <div class="row">
                <div class="col-xl-4 col-lg-4 col-md-4 mb-2">
                    <label class="form-label">Họ và tên <span class="text-danger">*</span></label>
                    @Html.EditorFor(model => model.FullName, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Họ và tên" } })
                    <span class="text-danger" id="errFullName"></span>
                </div>
                <div class="col-xl-4 col-lg-4 col-md-4 mb-2">
                    <label class="form-label">Số điện thoại <span class="text-danger">*</span></label>
                    @Html.EditorFor(model => model.MobileNumber, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Số điện thoại", @maxlength = "11" } })
                    <span class="text-danger" id="errMobileNumber"></span>
                </div>
                <div class="col-xl-4 col-lg-4 col-md-4 mb-2">
                    <label class="form-label">Email</label>
                    @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Địa chỉ Email" } })
                    <span class="text-danger" id="errEmail"></span>
                </div>
                <div class="col-xl-12 col-lg-12 col-md-12 mb-2">
                    <label class="form-label">Địa chỉ <span class="text-danger">*</span></label>
                    @Html.EditorFor(model => model.Street, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Địa chỉ", @maxlength = "400" } })
                    <span class="text-danger" id="errStreet"></span>
                </div>
                <div class="col-xl-4 col-lg-4 col-md-4 mb-2">
                    <label class="form-label">Tỉnh/Thành phố</label>
                    @Html.DropDownListFor(model => model.ProvinceID, new SelectList(Model.ListProvince, "ID", "Name"), "--- Tỉnh/ Thành phố ---", new { @class = "select2", @onchange = "LoadListDistrict('ProvinceID', 'DistrictID', 'WardID')" })
                    <span class="text-danger" id="errProvinceID"></span>
                </div>
                <div class="col-xl-4 col-lg-4 col-md-4 mb-2">
                    <label class="form-label">Quận/Huyện</label>
                    @Html.DropDownListFor(model => model.DistrictID, new SelectList(Model.ListDistrict, "ID", "Name"), "--- Quận/ Huyện ---", new { @class = "select2", @onchange = "LoadListWard('DistrictID', 'WardID')" })
                    <span class="text-danger" id="errDistrictID"></span>
                </div>
                <div class="col-xl-4 col-lg-4 col-md-4 mb-2">
                    <label class="form-label">Phường/Xã</label>
                    @Html.DropDownListFor(model => model.WardID, new SelectList(Model.ListWard, "ID", "Name"), "--- Phường/ Xã ---", new { @class = "select2" })
                    <span class="text-danger" id="errWardID"></span>
                </div>

            </div>
            <p class="fs-16 font-w600">Thông tin khác</p>
            <div class="row">
                <div class="col-xl-4 col-lg-4 col-md-4 mb-2">
                    <label class="form-label">Ngày sinh </label>
                    @Html.EditorFor(model => model.BirthDay, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Ngày sinh" } })
                    <span class="text-danger" id="errBirthDay"></span>
                </div>
                <div class="col-xl-4 col-lg-4 col-md-4 mb-2">
                    <label class="form-label">Mã số thuế</label>
                    @Html.EditorFor(model => model.TaxCode, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Mã số thuế" } })
                    <span class="text-danger" id="errTaxCode"></span>
                </div>
                <div class="col-xl-4 col-lg-4 col-md-4 mb-2">
                    <label class="form-label">Kênh</label>
                    @Html.DropDownListFor(model => model.Channel, new SelectList(Model.ListChannel, "Value", "Text"), "--- Kênh ---", new { @class = "select2" })
                    <span class="text-danger" id="errChannel"></span>
                </div>
            </div>
            <p class="fs-16 font-w600">Thông tin bổ sung</p>
            <div class="row">
                <div class="col-xl-12 col-lg-12 col-md-12 mb-2">
                    <label class="form-label">Nhãn khách hàng</label>
                    @Html.DropDownListFor(model => model.CustomerStickerID, new SelectList(Model.ListCustomerSticker, "ID", "Name"), new { @multiple = "multiple" })
                </div>
                <div class="col-xl-12 col-lg-12 col-md-12 mb-2">
                    <label class="form-label">Ghi chú </label>
                    @Html.EditorFor(model => model.Note, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Ghi chú" } })
                    <span class="text-danger" id="errNote"></span>
                </div>
            </div>
        </div>
        <div class="card-footer d-sm-flex justify-content-between align-items-center">
            <button type="button" class="btn btn-outline-dark" onclick="window.location.href = '@Url.Action("CustomerView","Customer")'">Hủy bỏ</button>
            <button type="button" class="btn btn-primary" id="btnSubmit">Cập nhật</button>
        </div>
    </div>
</div>
