@model EMS.MVC.Frontend.Models.TransportServiceViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="profile">
    <div class="custom-tab-1">
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="TransportServiceDataTab" data-bs-toggle="tab" href="#TransportServiceData" onclick="loadTransportServiceData(1)" role="tab" aria-selected="true">Dịch vụ chính</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="ListTransportExtraServiceTab" data-bs-toggle="tab" href="#TransportServiceData" onclick="loadTransportServiceData(2)" role="tab" aria-selected="false"> Dịch vụ cộng thêm</a>
            </li>
        </ul>
    </div>
    <div class="tab-content">
        <div class="tab-pane fade show active" id="TransportServiceData" role="tabpanel" aria-labelledby="TransportServiceDataTab">
            @{
                Html.RenderAction("SearchListTransportServiceView", "TransportService", Model);
            }
        </div>
    </div>
</div>

@section scripts{
    <script>
        function loadTransportServiceData(Type) {
            $.get('@Url.Action("SearchListTransportServiceView", "TransportService")?Type=' + Type, function (data) {
                $('#TransportServiceData').html(data);
            });
        }
    </script>
}


