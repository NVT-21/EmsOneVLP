@model EMS.MVC.Frontend.Models.AddGrabOrderViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@Html.HiddenFor(m => m.RequestOrderID)
<style>
    @@media (max-width: 1024px) {
        .order-left {
            width: 100% !important;
        }

        .order-right {
            display: none;
        }
    }
</style>
<div class="container-fluid pb-100">
    <div class="order">
        <div class="order-left">
            <div class="CustomScrollBar" data-bs-spy="scroll" data-bs-target="#ListTab" data-bs-offset="0" tabindex="0" style="position: relative; overflow: auto; height: 780px;">
                <div class="card " id="TabCustomer">
                    <div class="card-body">
                        <h5 class="card-title">Thông tin khách hàng</h5>
                        <div class="row">
                            <div class="col-xl-4 col-lg-6 col-md-12 mb-3">
                                <div class="form-search">
                                    <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M18.9842 17.6825L15.8675 14.575C16.8731 13.2939 17.4187 11.7119 17.4167 10.0833C17.4167 8.63294 16.9866 7.21512 16.1808 6.00916C15.375 4.80319 14.2297 3.86326 12.8897 3.30822C11.5497 2.75318 10.0752 2.60795 8.65268 2.89091C7.23015 3.17387 5.92347 3.8723 4.89789 4.89789C3.8723 5.92347 3.17387 7.23015 2.89091 8.65268C2.60795 10.0752 2.75318 11.5497 3.30822 12.8897C3.86326 14.2297 4.80319 15.375 6.00916 16.1808C7.21512 16.9866 8.63294 17.4167 10.0833 17.4167C11.7119 17.4187 13.2939 16.8731 14.575 15.8675L17.6825 18.9842C17.7677 19.0701 17.8691 19.1383 17.9808 19.1848C18.0925 19.2314 18.2123 19.2553 18.3333 19.2553C18.4543 19.2553 18.5742 19.2314 18.6859 19.1848C18.7976 19.1383 18.899 19.0701 18.9842 18.9842C19.0701 18.899 19.1383 18.7976 19.1848 18.6859C19.2314 18.5742 19.2553 18.4543 19.2553 18.3333C19.2553 18.2123 19.2314 18.0925 19.1848 17.9808C19.1383 17.8691 19.0701 17.7677 18.9842 17.6825V17.6825ZM4.58334 10.0833C4.58334 8.99554 4.90591 7.93217 5.51025 7.0277C6.1146 6.12323 6.97358 5.41828 7.97858 5.002C8.98357 4.58572 10.0894 4.4768 11.1563 4.68902C12.2232 4.90124 13.2032 5.42506 13.9724 6.19425C14.7416 6.96344 15.2654 7.94345 15.4777 9.01034C15.6899 10.0772 15.581 11.1831 15.1647 12.1881C14.7484 13.1931 14.0434 14.0521 13.139 14.6564C12.2345 15.2608 11.1711 15.5833 10.0833 15.5833C8.62465 15.5833 7.2257 15.0039 6.19425 13.9724C5.1628 12.941 4.58334 11.542 4.58334 10.0833Z"
                                              fill="#86909C" />
                                    </svg>
                                    <input type="text" class="form-control" id="SearchCustomer" value="@Model.MobileNumber" placeholder="Tìm thông tin KH">
                                    <span class="text-danger" id="errSearchCustomer"></span>
                                </div>
                            </div>
                            <div class="col-xl-4 col-lg-6 col-md-8 mb-3">
                                <button class="btn btn-secondary text-white font-w600" onclick="ShowAddCustomerView()">
                                    <i class="ti-plus"></i>
                                    Thêm mới khách hàng
                                </button>
                            </div>
                        </div>
                        <div id="ShowSearchCustomerView">
                            @if (!string.IsNullOrEmpty(Model.MobileNumber))
                            {
                                Html.RenderAction("SearchCustomerView", "Order", new { MobileNumber = Model.MobileNumber, IsTransport = "Y" });
                            }
                        </div>
                    </div>
                </div>
                <div class="card" id="TabProduct">
                    <div class="card-body">
                        <h5 class="card-title">Thông tin sản phẩm</h5>
                        <div class="row">
                            <div class="col-xl-4 col-lg-6 col-md-12 mb-3">
                                <label class="mb-1">Sản phẩm</label>
                                <div class="form-search">
                                    <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M18.9842 17.6825L15.8675 14.575C16.8731 13.2939 17.4187 11.7119 17.4167 10.0833C17.4167 8.63294 16.9866 7.21512 16.1808 6.00916C15.375 4.80319 14.2297 3.86326 12.8897 3.30822C11.5497 2.75318 10.0752 2.60795 8.65268 2.89091C7.23015 3.17387 5.92347 3.8723 4.89789 4.89789C3.8723 5.92347 3.17387 7.23015 2.89091 8.65268C2.60795 10.0752 2.75318 11.5497 3.30822 12.8897C3.86326 14.2297 4.80319 15.375 6.00916 16.1808C7.21512 16.9866 8.63294 17.4167 10.0833 17.4167C11.7119 17.4187 13.2939 16.8731 14.575 15.8675L17.6825 18.9842C17.7677 19.0701 17.8691 19.1383 17.9808 19.1848C18.0925 19.2314 18.2123 19.2553 18.3333 19.2553C18.4543 19.2553 18.5742 19.2314 18.6859 19.1848C18.7976 19.1383 18.899 19.0701 18.9842 18.9842C19.0701 18.899 19.1383 18.7976 19.1848 18.6859C19.2314 18.5742 19.2553 18.4543 19.2553 18.3333C19.2553 18.2123 19.2314 18.0925 19.1848 17.9808C19.1383 17.8691 19.0701 17.7677 18.9842 17.6825V17.6825ZM4.58334 10.0833C4.58334 8.99554 4.90591 7.93217 5.51025 7.0277C6.1146 6.12323 6.97358 5.41828 7.97858 5.002C8.98357 4.58572 10.0894 4.4768 11.1563 4.68902C12.2232 4.90124 13.2032 5.42506 13.9724 6.19425C14.7416 6.96344 15.2654 7.94345 15.4777 9.01034C15.6899 10.0772 15.581 11.1831 15.1647 12.1881C14.7484 13.1931 14.0434 14.0521 13.139 14.6564C12.2345 15.2608 11.1711 15.5833 10.0833 15.5833C8.62465 15.5833 7.2257 15.0039 6.19425 13.9724C5.1628 12.941 4.58334 11.542 4.58334 10.0833Z"
                                              fill="#86909C" />
                                    </svg>
                                    <input type="text" class="form-control " placeholder="Tìm theo tên sản phẩm" id="SearchProduct">
                                </div>
                            </div>
                            <div class="col-xl-4 col-lg-6 col-md-12 mb-3">
                                <label class="mb-1">Xuất kho <span class="text-danger">*</span></label>
                                @Html.DropDownListFor(model => model.WareHouseID, new SelectList(Model.ListWareHouse, "ID", "WareHouseName"), new { @class = "select2" })
                            </div>
                            <div class="col-xl-12 col-lg-12 col-md-12">
                                <div id="ShowSearchListProductView"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card mb-0" id="TabTransport">
                    <div class="card-body">
                        <h5 class="card-title">Thông tin vận chuyển</h5>
                        <div class="row">
                            <div class="col-xl-3 col-lg-6 col-md-6 mb-3">
                                <label class="mb-1">Mã đơn hàng</label>
                                @Html.EditorFor(model => model.OrderCode, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Mã đơn hàng", @maxlength = "70" } })
                                <span class="text-danger" id="errOrderCode"></span>
                            </div>
                            <div class="col-xl-3 col-lg-6 col-md-6 mb-3">
                                <label class="mb-1">Tên đơn hàng <span class="text-danger">*</span></label>
                                @Html.EditorFor(model => model.OrderName, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Tên đơn hàng", @maxlength = "150" } })
                                <span class="text-danger" id="errOrderName"></span>
                            </div>
                            <div class="col-xl-3 col-lg-6 col-md-6 mb-3">
                                <div class="custom-props">
                                    <label class="mb-1">Giá trị đơn hàng <span class="text-danger">*</span></label>
                                    @Html.EditorFor(model => model.OrderValue, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Giá trị đơn hàng", @maxlength = "11", @data_inputmask = "'alias': 'currency'" } })
                                    <span class="props">đ</span>
                                </div>
                                <span class="text-danger" id="errOrderValue"></span>
                            </div>
                            <div class="col-xl-3 col-lg-6 col-md-6 mb-3">
                                <label class="mb-1">Số lượng sản phẩm</label>
                                @Html.EditorFor(model => model.Quantity, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Số lượng sản phẩm", @maxlength = "3", @data_inputmask = "'alias': 'PositiveNumber'" } })
                                <span class="text-danger" id="errQuantity"></span>
                            </div>
                        </div>
                        <div class="ShowTransport">
                            <div class="row">
                                <div class="col-xl-9 col-lg-9 col-md-9 mb-3">
                                    <label class="mb-1">Kích thước (Dài x Rộng x Cao)</label>
                                    <div class="row">
                                        <div class="col-xl-4 col-lg-4 col-md-4 mb-3">
                                            <div class="custom-props">
                                                @Html.EditorFor(model => model.Length, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Dài", @maxlength = "4", @data_inputmask = "'alias': 'PositiveNumber'" } })
                                                <span class="props">cm</span>
                                            </div>
                                            <span class="text-danger" id="errLength"></span>
                                        </div>
                                        <div class="col-xl-4 col-lg-4 col-md-4 mb-3">
                                            <div class="custom-props">
                                                @Html.EditorFor(model => model.Width, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Rộng", @maxlength = "4", @data_inputmask = "'alias': 'PositiveNumber'" } })
                                                <span class="props">cm</span>
                                            </div>
                                            <span class="text-danger" id="errWidth"></span>
                                        </div>
                                        <div class="col-xl-4 col-lg-4 col-md-4 mb-3">
                                            <div class="custom-props">
                                                @Html.EditorFor(model => model.Height, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Cao", @maxlength = "4", @data_inputmask = "'alias': 'PositiveNumber'" } })
                                                <span class="props">cm</span>
                                            </div>
                                            <span class="text-danger" id="errHeight"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xl-3 col-lg-3 col-md-3 mb-3">
                                    <div class="custom-props">
                                        <label class="mb-1">Khối lượng <span class="text-danger">*</span></label>
                                        @Html.EditorFor(model => model.Weight, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Khối lượng", @maxlength = "6", @data_inputmask = "'alias': 'PositiveNumber'" } })
                                        <span class="props">gr</span>
                                    </div>
                                    <span class="text-danger" id="errWeight"></span>
                                </div>
                            </div>
                            @*<div class="row" id="TransportPayerDiv">
                                <div class="col-xl-6 col-lg-6 col-md-6 mb-3">
                                    <label class="mb-1">Người trả cước <span class="text-danger">*</span></label>
                                    <div>
                                        <div class="form-check form-check-inline">
                                            @Html.RadioButtonFor(m => m.TransportPayer, 1, new { @class = "form-check-input", @checked = "checked" })
                                            <label class="form-check-label " for="23">
                                                Shop trả
                                            </label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            @Html.RadioButtonFor(m => m.TransportPayer, 2, new { @class = "form-check-input"})
                                            <label class="form-check-label" for="13">
                                                Người nhận trả
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>*@
                            <div class="row">
                                <div class="col-xl-3 col-lg-3 col-md-3 mb-3">
                                    <label class="mb-1">Dịch vụ chuyển chính <span class="text-danger">*</span></label>
                                    @*<select id="MainTransportServiceID" class="select2">
                                        <option value="">--- Chọn ---</option>
                                        <option value="523">Giao hàng siêu tốc</option>
                                        <option value="524">Giao hàng siêu rẻ - 4 giờ</option>
                                    </select>*@
                                    @Html.DropDownListFor(model => model.MainTransportServiceID, new SelectList(Model.ListMainTransportService, "ID", "Name"), "-- Chọn --", new { @class = "select2" })
                                    <span class="text-danger" id="errMainTransportServiceID"></span>
                                </div>
                                <div class="col-xl-3 col-lg-3 col-md-3 mb-3">
                                    <label class="mb-1">Dịch vụ vận chuyển cộng thêm </label>
                                    @Html.DropDownListFor(model => model.ExtraTransportServiceID, new SelectList(Model.ListExtraTransportService, "ID", "Name"), new { @class = "selectpicker form-control form-control-sm", @data_live_search = "true", @data_dropup_auto = "false", @data_size = "8", @data_selected_text_format = "count", @data_actions_box = "true", @multiple = "true" })
                                    <span class="text-danger" id="errExtraTransportServiceID"></span>
                                </div>
                                <div id="ShowTotalCOD" class="col-xl-3 col-lg-3 col-md-3 mb-3 @{if (Model.ExtraTransportServiceID != "108"){ Write("d-none"); }}">
                                    <div class="custom-props">
                                        <label class="mb-1">Tiền thu hộ <span class="text-danger">*</span></label>
                                        @Html.EditorFor(model => model.TotalCOD, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Tiền thu hộ", @data_inputmask = "'alias': 'currency'", @maxlength = "10" } })
                                        <span class="props">đ</span>
                                    </div>
                                    <span class="text-danger" id="errTotalCOD"></span>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xl-12 col-lg-12 col-md-12 mb-3">
                                <label class="mb-1">Ghi chú đơn hàng</label>
                                @Html.TextAreaFor(model => model.Note, new { @class = "form-control", @placeholder = "Nhập ghi chú đơn hàng. Tối đa 250 ký tự", @maxlength = "250", @rows = "5" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xl-4 col-lg-4 col-md-4 mb-3">
                                <label class="mb-1">Mã giảm giá</label>
                                <div class="input-group">
                                    <input type="text" id="PromoCode" class="form-control">
                                    <button class="btn btn-secondary" type="button">Áp dụng</button>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="divider"></div>
                            <p class="font-w700">Cước vận chuyển</p>
                            <div class="row" id="TempGrabServiceFeeView">
                                @{
                                    Html.RenderAction("TempGrabServiceFeeView", "GrabOrder", new { req = "" });
                                }
                            </div>
                            <div class="divider"></div>
                            <div class="col-xl-6 col-lg-6 col-md-6 mt-3">
                                <table class="table table-clear">
                                    <tbody>
                                        <tr>
                                            <td class="left"><strong>Tổng tiền hàng</strong></td>
                                            <td class="right"><span id="TotalMoney">0</span>đ</td>
                                        </tr>
                                        @*<tr>
                                            <td class="left"><strong>Thời gian lấy hàng dự kiến</strong></td>
                                            <td class="right"><span id="EstimatedTimeLinePickup"></span></td>
                                        </tr>
                                        <tr>
                                            <td class="left"><strong>Thời gian trả hàng dự kiến</strong></td>
                                            <td class="right">
                                                <span id="EstimatedTimeLineDropoff"></span>
                                            </td>
                                        </tr>*@
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="fixed-tr order-right">
            <div id="ListTab" class="list-group bg-white">
                <a class="list-group-item list-group-item-action" href="#TabCustomer">Thông tin khách hàng</a>
                <a class="list-group-item list-group-item-action" href="#TabProduct">Thông tin sản phẩm</a>
                <a class="list-group-item list-group-item-action" href="#TabTransport">Thông tin vận chuyển</a>
            </div>
        </div>
    </div>
</div>
<div class="bottom-group">
    <div class="float-end">
        <button type="button" class="btn btn-primary" id="btnAddOrder" onclick="btnAddGrabOrder()">Tạo đơn & gửi Grab</button>
    </div>
</div>

@section scripts{
    <script>
        //document.getElementById("TransportPayerDiv").style.display = 'none';
        var TotalMoney = 0, TotalOrderValue = 0, TransportFee = 0;
        //OnlyNumber("#SearchCustomer");
        CheckChangeValue("StoreName", "Tên cửa hàng không được để trống.", "", "Y");
        CheckChangeValue("Quantity", "Vui lòng nhập số lượng sản phẩm", "Number", "Y");
        CheckChangeValue("OrderValue", "", "Number", "N");
        CheckChangeValue("OrderCode", "", "SpecialCharButNotVietnamese", "N");
        CheckChangeValue("OrderName", "Tên đơn hàng không được để trống.", "", "Y");

        CustomerAutocomplete("SearchCustomer");

        $(document).ready(function () {
            $('#SearchCustomer').focus();
            $("#ExtraTransportServiceID").selectpicker("refresh");
            $("#footer").addClass("d-none");
            $(".content-body").css("min-height", "");
        });

        //$('#SearchCustomer').keypress(function (event) {
        //    if (event.keyCode == 13) {
        //        SearchCustomer($(this).val().trim());
        //    }
        //});

        $('#SearchCustomer').on("change", function () {
            SearchCustomer($(this).val().trim());
        });

        function SearchCustomer(MobileNumber) {
            if (MobileNumber) {
                var IsValid = CheckNullAndRegexValue(MobileNumber, "MobileNumber", "SearchCustomer", "Số điện thoại không được để trống.", "Số điện thoại không hợp lệ.", false);
                if (!IsValid) {
                    $.post('@Url.Action("SearchCustomerView","Order")', {
                        MobileNumber: MobileNumber, IsTransport: $("input[name='IsTransport']:checked").val(),
                    }, function (data) {
                        $("#ShowSearchCustomerView").html(data);
                        if ($("#Receiver_ID").val() > 0) {
                            LoadTotalFee(null);
                        }
                    });
                }
            }
        }

        function ShowAddCustomerView() {
            $.post('@Url.Action("AddCustomerView", "Customer")', { IsReload: "N"}, function (data) {
                $('#modal-ViewModal-html').html(data);
                $('#ViewModal').modal('show');
            });
        }

        $("#SearchProduct").on("click", function () {
            var arr = [];
            $('.row-item').each(function () {
                var obj = {};
                obj.VariantID = $(this).attr("data-VariantID");
                obj.NumberOfProduct = parseInt($("#NumberOfProduct_" + obj.VariantID).val());
                arr.push(obj);
            });

            $.post('@Url.Action("SearchProductView", "Order")', {
                req: arr
            }, function (data) {
                $('#modal-ViewModal-html').html(data);
                $('#ViewModal').modal('show');
            });
        });

        function CheckNumberOfProductInWareHouseQuantity(VariantID, WareHouseQuantity, Type) {
            var value = $("#NumberOfProduct_" + VariantID).val();
            if (parseInt(value) > parseInt(WareHouseQuantity)) {
                $("#errVariant_" + VariantID).text("Số lượng mua vượt quá số lượng trong kho");
                return true;
            } else {
                if (Type == 2) {
                    //Nhấn dấu trừ ở view tạo đơn
                    LoadTotalPrice();
                }
                $("#errVariant_" + VariantID).text("");
                return false;
            }
        }

        function btnPlus(VariantID, Type) {
            var value = $("#NumberOfProduct_" + VariantID).val();
            $("#NumberOfProduct_" + VariantID).val(parseInt(value) + 1);
            $("#NumberOfProduct_" + VariantID).change();

            if (Type == 2) {
                //Nhấn dấu trừ ở view tạo đơn
                LoadTotalPrice();
            }
        }

        function btnMinus(VariantID, Type) {
            var value = $("#NumberOfProduct_" + VariantID).val();
            if (value > 1) {
                $("#NumberOfProduct_" + VariantID).val(parseInt(value) - 1);
                $("#NumberOfProduct_" + VariantID).change();
            }

            if (Type == 2) {
                //Nhấn dấu trừ ở view tạo đơn
                LoadTotalPrice();
            }
        }

        function btnDeleteProduct(this1) {
            swal({
                title: 'Thông báo',
                text: "Bạn có chắc chắn muốn xoá sản phẩm này?",
                buttons: {
                    confirm: {
                        text: "Xác nhận",
                        value: true,
                        visible: true,
                        className: "btn btn-primary",
                        closeModal: true
                    },
                    cancel: {
                        text: "Đóng",
                        value: false,
                        visible: true,
                        className: "btn btn-outline-light",
                        closeModal: true,
                    }
                },
            }).then((value) => {
                if (value) {
                    $(this1).parents("tr").remove();
                    LoadTotalPrice();
                    var RowItem = document.getElementsByClassName('row-item');
                    if (RowItem.length == 0) {
                        $("#ShowSearchListProductView").addClass("d-none");
                    }
                }
            });
        }

        function LoadTotalPrice() {
            var OrderName = "";
            var TotalProduct = 0;
            var TotalPrice = 0;
            var TotalWeight = 0;
            $("#errProduct").text("");
            $('.row-item').each(function () {
                if (!OrderName) {
                    OrderName = $(this).attr("data-ProductName");
                }
                var VariantID = $(this).attr("data-VariantID");
                var PriceProduct = parseInt($(this).attr("data-PriceProduct"));
                var SearchNumberOfProduct = parseInt($("#NumberOfProduct_" + VariantID).val());
                var SearchTotalPrice = PriceProduct * SearchNumberOfProduct;
                var SearchTotalWeight = parseInt($(this).attr("data-Weight")) * SearchNumberOfProduct;
                TotalProduct += SearchNumberOfProduct;
                TotalPrice += SearchTotalPrice;
                TotalWeight += SearchTotalWeight;

                $("#TotalPrice_" + VariantID).text(SearchTotalPrice.toLocaleString());
            });

            $("#OrderName").val(OrderName).change();
            $("#Quantity").val(TotalProduct).change(); // Số lượng sản phẩm
            $("#OrderValue").val(TotalPrice).change(); // Giá trị đơn hàng
            $("#TotalCOD").val(TotalPrice).change(); // Tiền thu hộ
            $("#Weight").val(TotalWeight).change(); // Khối lượng
            $("#TotalDiscount").text("0"); // Giá giảm
            $("#TotalMoney").text(TotalPrice.toLocaleString());
            $("#TotalOrderValue").text(TotalPrice.toLocaleString());
            LoadTotalFee(null);
            TotalMoney = TotalPrice;
            TotalOrderValue = TotalPrice;
        }

        $("input").on("focus", function () {
            $("#btnAddOrder").attr("disabled", true);
        });

        $("input").on("focusout", function () {
            $("#btnAddOrder").attr("disabled", false);
        });

        $('#MainTransportServiceID, #ExtraTransportServiceID, #Weight, #Length, #Width, #Height, #Quantity, #TotalCOD, #OrderValue, #PromoCode, #OrderName').on('change', function () {
            var DivID = this.id;
            var isError = false;
            var ReceiverID = $("#Receiver_ID").val();
            //var mainTransportServiceCode = "";
            //switch (Number($("#MainTransportServiceID").val())) {
            //    case 523:
            //        mainTransportServiceCode = "INSTANT";
            //        break;
            //    case 524:
            //        mainTransportServiceCode = "SAME_DAY";
            //        break;
            //    default:
            //        mainTransportServiceCode = "";
            //        break;
            //}
            //var ProductName = "";
            //$('.row-item').each(function () {
            //    ProductName = ProductName + $(this).attr("data-ProductName") + " - ";
            //});
            var agrs = {
                SearchCustomer: $("#SearchCustomer").val(),
                IsTransport: "Y",
                MainTransportServiceID: $('#MainTransportServiceID').val(),
                //MainTransportServiceCode: mainTransportServiceCode,
                ExtraTransportServiceID: $('#ExtraTransportServiceID').val().toString(),
                arrExtraService: $('#ExtraTransportServiceID').val(),
                Sender: {
                    Province: {
                        ID: $('#Sender_Province_ID').val()
                    },
                    District: {
                        ID: ReceiverID > 0 ? $('#Sender_District_ID').val() : 0
                    },
                    Ward: {
                        ID: ReceiverID > 0 ? $('#Sender_Ward_ID').val() : 0
                    },
                    FullAddress: $('#Sender_Street').val(),
                },
                Receiver: {
                    ID: $('#Receiver_ID').val(),
                    Province: {
                        ID: $('#Receiver_Province_ID').val()
                    },
                    District: {
                        ID: $('#Receiver_District_ID').val()
                    },
                    Ward: {
                        ID: $('#Receiver_Ward_ID').val()
                    },
                    FullAddress: $('#Receiver_Street').val(),
                },
                Weight: NumberReplace($('#Weight').val()),
                Length: $('#Length').val(),
                Width: $('#Width').val(),
                Height: $('#Height').val(),
                Quantity: NumberReplace($('#Quantity').val()),
                OrderName: $('#OrderName').val().trim(),
                OrderValue: NumberReplace($('#OrderValue').val()),
                TotalCOD: NumberReplace($('#TotalCOD').val()),
                ProductName: $('#OrderName').val().trim(),
                PromoCode: $('#PromoCode').val().trim()
            };
            var ListProduct = document.getElementsByClassName('row-item');
            if (DivID == "MainTransportServiceID") {
                if (agrs.MainTransportServiceID) {
                    $('#errMainTransportServiceID').text("");
                } else {
                    $('#errMainTransportServiceID').text("Vui lòng chọn dịch vụ vận chuyển chính");
                    isError = true;
                }
            } else if (DivID == "ExtraTransportServiceID") {
                var isServiceCOD = agrs.arrExtraService.includes("108");
                if (isServiceCOD == true) {
                    $("#ShowTotalCOD").removeClass("d-none");
                } else {
                    $("#ShowTotalCOD").addClass("d-none");
                    if (ListProduct.length == 0) {
                        $('#TotalMoney').html(NumberFormat(agrs.OrderValue));
                        $('#TotalOrderValue').html(NumberFormat(agrs.OrderValue));
                        TotalMoney = agrs.OrderValue;
                        TotalOrderValue = agrs.OrderValue;
                    }
                }
            } else if (DivID == "TotalCOD") {
                if (parseInt(agrs.TotalCOD) == 0) {
                    $('#errTotalCOD').text("Vui lòng nhập tiền COD.");
                    isError = true;
                } else {
                    $('#errTotalCOD').text("");
                    if (ListProduct.length == 0) {
                        $('#TotalMoney').html(NumberFormat(agrs.TotalCOD));
                        $('#TotalOrderValue').html(NumberFormat(agrs.TotalCOD));
                        TotalMoney = agrs.TotalCOD;
                        TotalOrderValue = agrs.TotalCOD;
                    }
                }
            } else if (DivID == "Weight") {
                if (parseInt(agrs.Weight) == 0) {
                    $('#errWeight').text("Vui lòng nhập trọng lượng.");
                    isError = true;
                } else {
                    $('#errWeight').text("");
                }
            } else if (DivID == "OrderValue") {
                if (ListProduct.length == 0) {
                    $("#TotalMoney").text(NumberFormat(agrs.OrderValue));
                    $("#TotalOrderValue").text(NumberFormat(agrs.OrderValue));
                    TotalMoney = agrs.OrderValue;
                    TotalOrderValue = agrs.OrderValue;
                }
            }

            if (!agrs.SearchCustomer) {
                $('#errSearchCustomer').text("Vui lòng nhập số điện thoại và tìm kiếm.");
                isError = true;
            } else {
                if (!parseInt(agrs.Receiver.ID)) {
                    $('#errReceiver_ID').css("color", "red");
                    isError = true;
                }
            }

            isError = CheckNullValue(agrs.OrderName, "OrderName", "Tên đơn hàng không được để trống.", isError);
            isError = CheckNullValue(parseInt(agrs.OrderValue), "OrderValue", "Giá trị đơn hàng phải lớn hơn 0.", isError);

            if (agrs.IsTransport == "Y") {
                if (isError == true) {
                    $("#errTempGrabServiceFee").text("Chưa đủ thông tin để tính cước");
                } else {
                    LoadTotalFee(agrs);
                }
            } else {
                $('#errMainTransportServiceID').text("");
                $('#errTotalCOD').text("");
                $('#errWeight').text("");
            }
        });

