        function btnAddGrabOrder() {
            var ListProduct = [];
            var isError = false;
            var Message = "Giá trị hợp lệ không bao gồm ký tự đặc biệt.";

            //var mainTransportServiceCode = "";
            //switch (Number($("#MainTransportServiceID").val())) {
            //    case 523:
            //        mainTransportServiceCode = "INSTANT";
            //        break;
            //    case 524:
            //        mainTransportServiceCode = "SAME_DAY";
            //        break;
            //    default:
            //        mainTransportServiceCode = "";
            //        break;
            //}
            //var ProductName = "";
            //$('.row-item').each(function () {
            //    ProductName = ProductName + ", " + $(this).attr("data-ProductName");
            //});

            $('.row-item').each(function () {
                var ProductID = $(this).attr("data-ProductID");
                var VariantID = $(this).attr("data-VariantID");
                var PriceProduct = parseInt($(this).attr("data-PriceProduct"));
                var WareHouseQuantity = parseInt($(this).attr("data-WareHouseQuantity"));
                var SearchNumberOfProduct = parseInt($("#NumberOfProduct_" + VariantID).val());

                if (!SearchNumberOfProduct) {
                    $("#errVariant_" + VariantID).text("Vui lòng nhập số lượng sản phẩm.");
                    $("#NumberOfProduct_" + VariantID).focus();
                    isError = true;
                    return false;
                }

                if (!PriceProduct) {
                    $("#errVariant_" + VariantID).text("Sản phẩm không có giá bán, vui lòng kiểm tra lại.");
                    isError = true;
                    return false;
                }

                if (SearchNumberOfProduct > WareHouseQuantity) {
                    $("#errVariant_" + VariantID).text("Số lượng mua vượt quá số lượng trong kho.");
                    $("#NumberOfProduct_" + VariantID).focus();
                    isError = true;
                    return false;
                }

                var obj = {};
                obj.ProductID = ProductID;
                obj.VariantID = VariantID;
                obj.NumberOfProduct = SearchNumberOfProduct;
                obj.Price = PriceProduct;
                ListProduct.push(obj);
            });

            var data = {
                SearchCustomer: $("#SearchCustomer").val(),
                Sender: {
                    PickUpAddressID: 0,
                    FullName: "",
                    MobileNumber: "",
                    Province: {
                        ID: 0
                    },
                    District: {
                        ID: 0
                    },
                    Ward: {
                        ID: 0
                    },
                    Street: "",
                    FullAddress: "",
                },
                Receiver: {
                    ID: 0,
                    FullName: "",
                    MobileNumber: "",
                    Province: {
                        ID:0
                    },
                    District: {
                        ID: 0
                    },
                    Ward: {
                        ID: 0
                    },
                    Street: "",
                    FullAddress: "",
                },
                IsUpdateReceiver: "N",
                WareHouseID: $("#WareHouseID").val(),
                ListProduct: ListProduct,
                IsTransport: "Y",
                OrderCode: $('#OrderCode').val().trim(),
                OrderName: $('#OrderName').val().trim(),
                OrderValue: NumberReplace($('#OrderValue').val()),
                Quantity: NumberReplace($('#Quantity').val()),
                Length: $('#Length').val(),
                Width: $('#Width').val(),
                Height: $('#Height').val(),
                Weight: NumberReplace($('#Weight').val()),
                CollectionType: {
                    ID: 1
                },
                MainTransportServiceID: $("#MainTransportServiceID").val(),
                //MainTransportServiceCode: mainTransportServiceCode,
                ExtraTransportServiceID: $("#ExtraTransportServiceID").val().toString(),
                TotalCOD: NumberReplace($('#TotalCOD').val()),
                TransportFee: TransportFee,
                Note: $('#Note').val(),
                Message: $('#Message').val(),
                Channel: "GRA",
                TotalMoney: TotalMoney,
                TotalDiscount: 0,
                TotalOrderValue: TotalOrderValue,
                TransportPayer: 2,
                RequestOrderID: $('#RequestOrderID').val(),
                IsRequestOrder: $('#RequestOrderID').val() == 0 ? "N" : "Y",
                //ProductName: ProductName == "" ? $('#OrderName').val().trim() : ProductName.substring(0, ProductName.length - 3),
                PromoCode: $('#PromoCode').val().trim()
            };

            if (data.SearchCustomer) {
                if (parseInt($("#Receiver_ID").val())) {
                    data.Sender = {
                        PickUpAddressID: $("#PickUpAddressID").val(),
                        FullName: $("#Sender_FullName").val().trim(),
                        MobileNumber: $('#Sender_MobileNumber').val().trim(),
                        Province: {
                            ID: $("#Sender_Province_ID").val()
                        },
                        District: {
                            ID: $("#Sender_District_ID").val()
                        },
                        Ward: {
                            ID: $("#Sender_Ward_ID").val()
                        },
                        Street: $("#Sender_Street").val().trim(),
                        FullAddress: $("#PickUpAddressID").val() != "0" ? $("#Sender_FullAddress").val() : ConvertAddress($('#Sender_Street').val(), $('#Sender_Ward_ID').val() == "" ? "" : $("#Sender_Ward_ID option:selected").text(), $("#Sender_District_ID option:selected").text(), $("#Sender_Province_ID option:selected").text()),
                    };
                    data.Receiver = {
                        ID: $('#Receiver_ID').val(),
                        FullName: $("#Receiver_FullName").val().trim(),
                        MobileNumber: $('#Receiver_MobileNumber').val().trim(),
                        Province: {
                            ID: $("#Receiver_Province_ID").val()
                        },
                        District: {
                            ID: $("#Receiver_District_ID").val()
                        },
                        Ward: {
                            ID: $("#Receiver_Ward_ID").val()
                        },
                        Street: $("#Receiver_Street").val().trim(),
                        FullAddress: ConvertAddress($('#Receiver_Street').val().trim(), $('#Receiver_Ward_ID').val() == "" ? "" : $("#Receiver_Ward_ID option:selected").text(), $("#Receiver_District_ID option:selected").text(), $("#Receiver_Province_ID option:selected").text()),

                    };
                    data.IsUpdateReceiver = $("input[name='IsUpdateReceiver']:checked").val();
                }
            }
            
            isError = CheckNullValue($("#SearchCustomer").val(), "SearchCustomer", "Vui lòng nhập số điện thoại và tìm kiếm.", isError);
            if (isError == false) {
                if (!parseInt($("#Receiver_ID").val())) {
                    $('#errReceiver_ID').css("color", "red");
                    $('#SearchCustomer').focus();
                    isError = true;
                }
            }

            if (data.OrderCode) {
                if (data.OrderCode.length > 70) {
                    $('#errOrderCode').text('Mã đơn hàng không hợp lệ.');
                    $('#OrderCode').focus();
                    isError = true;
                } else {
                    isError = CheckRegexValue(data.OrderCode, "SpecialCharButNotVietnamese", "OrderCode", Message, isError);
                }
            } else {
                $("#errOrderCode").text("");
            }

            if (data.IsTransport == "Y") {
                isError = CheckNullAndRegexValue(data.Receiver.FullName, "Vietnamese", "Receiver_FullName", "Vui lòng nhập Họ và tên.", Message, isError);
                isError = CheckNullAndRegexValue(data.Receiver.MobileNumber, "MobileNumber", "Receiver_MobileNumber", "Vui lòng nhập điện thoại.", "Số điện thoại không hợp lệ", isError);
                isError = CheckNullValue(data.Receiver.Province.ID, "Receiver_Province_ID", "Vui lòng chọn Tỉnh/ Thành phố.", isError);
                isError = CheckNullValue(data.Receiver.District.ID, "Receiver_District_ID", "Vui lòng chọn Quận/ Huyện.", isError);
                isError = CheckNullValue(data.Receiver.Ward.ID, "Receiver_Ward_ID", "Vui lòng chọn Phường/ Xã.", isError);
                isError = CheckNullValue(data.Receiver.Street, "Receiver_Street", "Vui lòng nhập địa chỉ.", isError);

                isError = CheckNullValue(data.Sender.PickUpAddressID, "Sender_PickUpAddressID", "Vui lòng chọn địa chỉ lấy hàng.", isError);
                isError = CheckNullValue(data.Sender.FullName, "Sender_FullName", "Vui lòng nhập Họ và tên.", isError);
                isError = CheckNullAndRegexValue(data.Sender.MobileNumber, "MobileNumber", "Sender_MobileNumber", "Vui lòng nhập điện thoại.", "Số điện thoại không hợp lệ", isError);
                isError = CheckNullValue(data.Sender.Province.ID, "Sender_Province_ID", "Vui lòng chọn Tỉnh/ Thành phố.", isError);
                isError = CheckNullValue(data.Sender.District.ID, "Sender_District_ID", "Vui lòng chọn Quận/ Huyện.", isError);
                isError = CheckNullValue(data.Sender.Ward.ID, "Sender_Ward_ID", "Vui lòng chọn Quận/ Huyện.", isError);
                isError = CheckNullValue(data.Sender.Street, "Sender_Street", "Vui lòng nhập địa chỉ.", isError);

                isError = CheckNullAndRegexValue(parseInt(data.Weight), "Number", "Weight", "Vui lòng nhập trọng lượng", "Chỉ được nhập số", isError);
                isError = CheckNullValue(data.MainTransportServiceID, "MainTransportServiceID", "Vui lòng chọn dịch vụ vận chuyển chính", isError);
                if (data.ExtraTransportServiceID) {
                    var ListExtraTransportService = $('#ExtraTransportServiceID').val();
                    //Dịch vụ thu hộ
                    var isServiceCOD = ListExtraTransportService.includes("108");
                    if (isServiceCOD == true) {
                        if (parseInt(data.TotalCOD) == 0) {
                            $("#errTotalCOD").text("Vui lòng nhập số tiền COD.");
                            $('#TotalCOD').focus();
                            isError = true;
                        } else if (parseInt(data.TotalCOD) > 50000000) {
                            $('#errTotalCOD').text('Số tiền COD tối đa 50 triệu đồng/BG.');
                            $('#TotalCOD').focus();
                            isError = true;
                        } else {
                            $("#errTotalCOD").text("");
                        }
                    } else {
                        data.TotalCOD = 0;
                    }
                } else {
                    data.TotalCOD = 0;
                    $("#errOrderValue").text("");
                    $("#errTotalCOD").text("");
                }
            }

            isError = CheckNullValue(parseInt(data.OrderValue), "OrderValue", "Giá trị đơn hàng phải lớn hơn 0.", isError);

            if (parseInt(data.OrderValue) > 100000000) {
                $('#errOrderValue').text('Giá trị đơn hàng không vượt quá 100 triệu đồng.');
                $('#OrderValue').focus();
                isError = true;
            }

            isError = CheckNullValue(data.WareHouseID, "WareHouseID", "Vui lòng chọn kho cần xuất", isError);

            if (!parseInt(data.Quantity)) {
                data.Quantity = 1;
            }

            isError = CheckNullValue(data.OrderName, "OrderName", "Tên đơn hàng không được để trống.", isError);

            if (data.TransportFee == 0) {
                isError = true;
            }

            if (isError == true) {
                return;
            }

            var MessageNotify = "Bạn chắc chắn muốn tạo đơn hàng?";
            var MessageSuccess = "Tạo đơn hàng thành công";

            swal({
                title: 'Thông báo',
                text: MessageNotify,
                buttons: {
                    confirm: {
                        text: "Xác nhận",
                        value: true,
                        visible: true,
                        className: "btn btn-primary",
                        closeModal: true
                    },
                    cancel: {
                        text: "Đóng",
                        value: false,
                        visible: true,
                        className: "btn btn-danger",
                        closeModal: true,
                    }
                },
            }).then((value) => {
                if (value) {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("JAddGrabOrder", "GrabOrder")',
                        dataType: 'json',
                        loading: true,
                        data: data,
                        success: function (res) {
                            if (res.Code == "00") {
                                CreateCustomSwal("success", MessageSuccess, '@Url.Action("GrabOrderView", "GrabOrder")');
                            } else {
                                CreateCustomSwal("error", res.Message);
                            }
                        },
                        error: function (xhr, status, error) {
                            var err = eval("(" + xhr.responseText + ")");
                            swal({
                                title: 'Lỗi',
                                text: err.Message,
                                button: {
                                    text: "ĐÓNG",
                                    value: true,
                                    visible: true,
                                    className: "btn btn-primary"
                                }
                            });
                            return;
                        }
                    });
                }
            });
        }
    </script>
}
