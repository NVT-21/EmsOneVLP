@model EMS.MVC.Frontend.Models.GrabDetailShippingViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="keywords" content="" />
    <meta name="author" content="" />
    <meta name="robots" content="" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="format-detection" content="telephone=no">
    <title>EMSOne</title>
    <link rel="shortcut icon" type="image/png" href="~/favicon.png" />
    @Styles.Render("~/bundles/css")
    <script src="~/Assets/js/global.min.js"></script>
    <script src="~/Assets/js/MyJS.js?n=@XHelper.JavaScriptVersion"></script>
</head>
<body>
    <div id="ajax_loader" style="background-color: rgba(0, 0, 0, 0.5); z-index: 99999999; position: fixed; left: 0px; top: 0px; width: 100%; height: 100%; display: none;" class="">
        <div id="ajax_loader_contend" style="position: fixed; left: 50%; top: 50%; color:white"><img src="~/Assets/images/default/loading.gif" style="width:30px; height:30px" /></div>
    </div>
    <div class="content-body">
        <div class="container-medium">
            <div class="row align-items-center">
                <div class="col-12">
                    <div class="d-flex align-items-center">
                        <img src="~/Assets/images/logo/logo-full.svg" />&nbsp;&nbsp;
                        <img src="~/Assets/images/logo/logo_ems_grab.jpg" />
                    </div>
                </div>
            </div>
            <div class="row mt-5">
                @{
                    Html.RenderAction("GrabInfoShippingView", "GrabOrder", new { ShippingID = Model.ShippingID });
                }
            </div>
        </div>
    </div>
    @Scripts.Render("~/bundles/js")
    <script>
        $(document).ajaxStart(function () {
            $('#ajax_loader').show();
        });

        $(document).ajaxStop(function () {
            $('#ajax_loader').hide();
        });
    </script>
</body>
</html>
