<script>
    $(document).ready(function () {
        NotifyCount();
    });
    function UpdateClickNotify(this1) {
        var DataUpdateNotifyClick = {
            StrID: $(this1).attr("data-ID").toString(),
            NotifyType: $(this1).attr("data-NotifyType"),
            ShippingCode: $(this1).attr("data-ShippingCode"),
            IsCheck: $(this1).attr("data-IsCheck")
        };
        switch (DataUpdateNotifyClick.NotifyType) {
            case "ORDER_STATUS":
            var param = String.format("ShippingCode={0}&ShopID={1}", btoa(DataUpdateNotifyClick.ShippingCode), btoa(@XHelper.Session.EmployeeProfile.ShopInformation.ID.ToString()));
                if (DataUpdateNotifyClick.IsCheck == "N") {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("JUpdateClickNotify", "Notify")',
                        data: {
                            StrID: DataUpdateNotifyClick.StrID
                        },
                        dataType: 'json',
                        loading: true,
                        global: false,
                        success: function (res) {
                            if (res.Code == "00") {
                                NotifyCount();
                                window.open('/tra-cuu-buu-gui?' + param, '_blank');
                            } else {
                                CreateCustomSwal("error", res.Message);
                                return;
                            }
                        }
                    });
                } else {
                    window.open('/tra-cuu-buu-gui?' + param, '_blank');
                }
                break;
            case "EMS":
                if (DataUpdateNotifyClick.IsCheck == "N") {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("JUpdateClickNotify", "Notify")',
                        data: {
                            StrID: DataUpdateNotifyClick.StrID
                        },
                        dataType: 'json',
                        loading: true,
                        global: false,
                        success: function (res) {
                            if (res.Code == "00") {
                                NotifyCount();
                                NotifyViewDetail(parseInt(DataUpdateNotifyClick.StrID), DataUpdateNotifyClick.IsCheck);
                            } else {
                                CreateCustomSwal("error", res.Message);
                                return;
                            }
                        }
                    });
                } else {
                    NotifyViewDetail(parseInt(DataUpdateNotifyClick.StrID), DataUpdateNotifyClick.IsCheck);
                }
                break;
            default:
                break;
        }
    }
    function NotifyViewDetail(ID, IsCheck) {
        UpdateNotify(ID, IsCheck);
        $.post('@Url.Action("NotifyDetailView", "Notify")', {
            ID: ID
        }, function (data) {
            $('#modal-ViewModal-html').html(data);
            $('#ViewModal').modal('show');
        });
    }
    function UpdateNotify(ID, IsCheck) {
        if (IsCheck == "N") {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("JUpdateClickNotify", "Notify")',
                data: {
                    StrID: ID.toString()
                },
                dataType: 'json',
                loading: true,
                global: false,
                success: function (res) {
                    if (res.Code == "00") {
                        NotifyCount();
                    } else {
                        CreateCustomSwal("error", res.Message);
                        return;
                    }
                }
            });
        }
    }

</script>

