@model List<EMS.MVC.Frontend.Models.NotifyListViewModel>
@{
    ViewBag.Title = "NotifyListView";
    var dtFormat = DateTime.Now.ToString("dd/MM/yyyy");
}
@if (ViewBag.CheckPermission == "Y")
{
    <input type="hidden" id="CountList" value="@ViewBag.IsCheckCount" />
    if (Model.Count() > 0)
    {
        foreach (var item in Model)
        {
            <div id="DZ_W_Notification_@item.ID"
                 class="widget-media dz-scroll p-3"
                 data-ID="@item.ID"
                 data-NotifyType="@item.NotifyType"
                 data-ShippingCode="@if (item.NotifyType == "ORDER_STATUS") { Write(item.NotifyName.Split(' ')[item.NotifyName.Split(' ').Length - 1]); } else { Write(""); }"
                 data-IsCheck="@item.IsCheck"
                 onclick="UpdateClickNotify(this)">
                <ul class="timeline">
                    <li>
                        <div class="timeline-panel" style="">
                            @{
                                switch (item.NotifyType)
                                {
                                    case "ORDER_STATUS":
                                        <div class="media media-info" style="max-width:30px; max-height: 30px;">
                                            <i class="fa fa-info fs-12"></i>
                                        </div>
                                        break;
                                    case "EMS":
                                        <div class="media media-success" style="max-width:30px; max-height: 30px;">
                                            <i class="fa fa-ticket-alt fs-12"></i>
                                        </div>
                                        break;
                                    default:
                                        break;
                                }
                            }
                            <div class="media-body c-pointer me-2">
                                @{
                                    <h6 class="mb-1 fw-bold fs-13">
                                        @if (item.NotifyName.Length < 30) { Write(@item.NotifyName); } else { Write(@item.NotifyName.Substring(0, 27) + " ..."); }
                                    </h6>
                                    <small class="d-block text-muted fs-12 mb-2">
                                        @if (item.NotifyContent.Length < 150) { Write(@item.NotifyContent); } else { Write(@item.NotifyContent.Substring(0, 146) + " ..."); }
                                    </small>
                                    if (dtFormat == item.CreatedDate.Split(' ')[0])
                                    {
                                        <small class="d-block text-muted fs-11">@item.CreatedDate.Split(' ')[1]</small>
                                    }
                                    else
                                    {
                                        <small class="d-block text-muted fs-11">@item.CreatedDate.Split(' ')[0]</small>
                                    }
                                }
                            </div>
                            <div class="d-flex justify-content-center">
                                @if (item.IsCheck == "N")
                                {
                                    <i class="fa fa-circle me-1 fs-10 me-2" style="color: rgb(255, 59, 48);"></i>
                                }
                            </div>
                        </div>
                    </li>
                </ul>
            </div>
        }
    }
    else
    {
        <div class="d-flex justify-content-center">
            <svg width="96" height="81" viewBox="0 0 96 81" fill="none" xmlns="http://www.w3.org/2000/svg">
