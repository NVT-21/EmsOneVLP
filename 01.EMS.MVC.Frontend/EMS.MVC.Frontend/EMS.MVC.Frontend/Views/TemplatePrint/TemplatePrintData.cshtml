@model EMS.MVC.Frontend.Models.TemplatePrintDataViewModel
@{
    var SampleBarCode = "";
    var SampleQRCode = "";
}
@if (Model.PrintType == "A4")
{
    <div class="row">
        <div class="col-md-6 col-print-6 text-start mb-2">
            <img class="img-fluid" src="~/Assets/images/logo/logo_ems_vietnam.png" style="width: 60%;" />
        </div>
        <div class="col-md-6 col-print-6 text-end mb-2">
            <h4 class="font-w600" style="border-bottom: solid #f0ad4e;">Vận đơn điện tử</h4>
        </div>
        <div class="col-md-4 col-print-4" style="min-height: 110px;">
            <img src="@String.Format(" data:image /png;base64,{0}", SampleQRCode)" style="width: 40%; height: auto; border-radius: 0;" />
        </div>
        <div class="col-md-4 col-print-4 m-auto">
            <div style="line-height: 1.4rem;"><b>BƯU GỬI</b></div>
            <div style="line-height: 1.4rem;">BILL OF CONSIGNMENT</div>
        </div>
        <div class="col-md-4 col-print-4 m-auto" style="min-height: 110px;">
            <div class="m-4">
                <img src="@String.Format(" data:image /png;base64,{0}", SampleBarCode)" style="width: auto; height: auto; border-radius: 0;" />
            </div>
        </div>
        <div class="col-md-12 col-print-12 text-start d-flex justify-content-between">
            <div>
                <label class="text-2">Dịch vụ:</label> <label class="font-w600" style="font-size: 20px;"></label>
            </div>
            <div>
                <label class="m-0">Loại vận đơn:</label>
            </div>
            <div>
                <label class="text-2">Nơi gửi:</label> <label class=""></label>
            </div>
            <div>
                <label class="text-2">Nơi nhận:</label> <label class=""></label>
            </div>
        </div>
        <div class="col-md-12 col-print-12">
            <table class="table table-bordered" style="width: 100%;">
                <tbody>
                    <tr>
                        <td colspan="2" style="max-width: 50%; white-space: inherit; text-align: justify; vertical-align: baseline; border: 1px solid #c9ccd7; ">
                            <span class="T_1 T_4" style="line-height: 1.4rem; display: block; @{ if (Model.SenderName == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } } "><b>Họ và tên người gửi/Sender</b></span>
                            <span class="T_1 T_5" style="line-height: 1.4rem; display: block; @{ if (Model.SenderAddress == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } } "><b>Địa chỉ/Address</b></span>
                            <span class="T_1 T_6" style="line-height: 1.4rem; display: block; @{ if (Model.SenderDistrict == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } } "><b>Quận huyện/District</b></span>
                            <span class="T_1 T_7" style="line-height: 1.4rem; display: block; @{ if (Model.SenderProvince == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } }"><b>Tỉnh/TP/Province</b> </span>
                            <span class="T_1 T_8" style="line-height: 1.4rem; display: block; @{ if (Model.SenderPhone == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } }"><b>Điện thoại/Phone</b></span>
                        </td>
                        <td colspan="2" style="max-width: 50%; white-space: inherit; text-align: justify; vertical-align: baseline; border: 1px solid #c9ccd7;">
                            <span style="line-height: 1.4rem; display: block; color: black !important; text-decoration: none !important;"><b>Họ và tên người nhận/Receiver</b></span>
                            <span style="line-height: 1.4rem; display: block; color: black !important; text-decoration: none !important;"><b>Địa chỉ/Address</b> </span>
                            @*<div class="">*@
                            <span class="T_2 T_11" style="line-height: 1.4rem; display: block; @{ if (Model.ReceiverDistrict == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } }"><b>Quận huyện/District</b> </span>
                            <span class="T_2 T_12" style="line-height: 1.4rem; display: block; @{ if (Model.ReceiverProvince == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } }"><b>Tỉnh/TP/Province</b> </span>
                            <span class="T_2 T_13" style="line-height: 1.4rem; display: block; @{ if (Model.ReceiverPhone == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } }"><b>Điện thoại/Phone</b> </span>
                            @*</div>*@
                        </td>
                    </tr>
                    <tr>
                        <td style="max-width: 50%; white-space: inherit; text-align: left; vertical-align: baseline; border: 1px solid #c9ccd7; border-bottom: 1px solid #c9ccd7;">
                            <span class="T_3 T_14" style="line-height: 1.4rem; display: block; @{ if (Model.OrderCode == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } }"><b>Mã đơn hàng</b> </span>
                            <span style="line-height: 1.4rem; display: block;"><b>Nội dung/Content</b> </span>
                            <span style="line-height: 1.4rem; display: block;"><b>Ghi chú/Note</b> </span>
                        </td>
                        <td style="vertical-align: baseline; white-space: inherit; border: 1px solid #c9ccd7; border-bottom: 1px solid #c9ccd7;">
                            <span class="T_3 T_17" style="line-height: 1.4rem; display: block; @{ if (Model.Weight == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } } "><b>Tr.lượng/Weight</b> <span class="float-right"></span></span>
                            <span class="T_3 T_18" style="line-height: 1.4rem; display: block; @{ if (Model.Quantity == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } } "><b>S.lượng/Quantity</b> <span class="float-right"></span></span>
                            <span style="line-height: 1.4rem; display: block;"><b>Tiền t.hộ/CoD</b></span>
                            <span style="line-height: 1.4rem;"><b>Cước thu người nhận</b></span>
                        </td>
                        <td style="text-align: center; vertical-align: baseline; border: 1px solid #c9ccd7; border-bottom: 1px solid #c9ccd7;">
                            <span style="line-height: 1.4rem;"><b>Ngày giờ gửi/Date</b></span>
                            <br />
                            <span style="line-height: 1.4rem;"></span>
                            <br />
                            <span style="line-height: 1.4rem;"><b>Họ tên, chữ ký người gửi</b></span>
                            <br />
                            <span style="line-height: 1.4rem;"><b>Signature of sender</b></span>
                            <br />
                            <br />
                            <br />
                            <br />
                            <span style="line-height: 1.4rem;"><b>Ngày giờ phát/Date, time</b></span>
                            <br />
                            <span style="line-height: 1.4rem;"><b>Họ tên nhân viên phát</b></span>
                            <br />
                            <span style="line-height: 1.4rem;"><b>Name, of P.O Deliverer</b></span>
                            <br />
                            <br />
                            <br />
                        </td>
                        <td style="text-align: center; vertical-align: baseline; border: 1px solid #c9ccd7; border-bottom: 1px solid #c9ccd7;">
                            <span style="line-height: 1.4rem;"><b>Dấu ngày BC chấp nhận</b></span>
                            <br />
                            <span style="line-height: 1.4rem;"><b>Date, stamp of accepting P.O</b></span>
                            <br />
                            <span style="line-height: 1.4rem;"><b>Tên nhân viên chấp nhận</b></span>
                            <br />
                            <span style="line-height: 1.4rem;"></span>
                            <br />
                            <br />
                            <br />
                            <br />
                            <span style="line-height: 1.4rem;"><b>Họ tên chữ ký người nhận</b></span>
                            <br />
                            <span style="line-height: 1.4rem;"><b>Signature of receiver</b></span>
                            <br />
                            <br />
                            <br />
                        </td>
                    </tr>
                    <tr>
                        <td class="text-center" colspan="4">
                            <span style="line-height: 1.4rem;"><b>Lưu ý:</b> Quý khách hàng cần đọc kỹ thông tin tiền thu hộ trước khi thực hiện thanh toán & ký nhận sản phẩm.</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}
else if (Model.PrintType == "A6")
{
    <table class="table table-bordered" style="width: 12cm; height: 13.5cm;">
        <thead>
            <tr>
                <td class="p-0" colspan="2">
                    <div class="row">
                        <div class="col-md-6 p-1 col-print-6">
                            <img class="size-logo" src="~/Assets/images/logo/logo_ems_vietnam.png" style="width: 90%; border-radius: 0;margin-left: 10px; margin-top: 5px;" />
                        </div>
                        <div class="col-md-6 p-1 col-print-6" style="white-space:initial;">
                            <span style="line-height: 1.1rem;"><b>Bưu cục:</b></span>
                            <br />
                            <span style="line-height: 1.1rem;"><b>Ngày gửi</b></span>
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                <td colspan="2" class="text-center">
                    <img src="@String.Format(" data:image /png;base64,{0}", SampleBarCode)" style="width: 60%; height: 35px; border-radius: 0;margin-bottom: 5px;" />
                </td>
            </tr>
            <tr>
                <td colspan="2" style="max-width: 50%; white-space: inherit; text-align: justify; vertical-align: middle;">
                    <span class="T_21 T_101" style="line-height: 1.4rem; @{ if (Model.SenderName == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } } "><b>Họ tên</b></span> <span class="ms-1 me-1">-</span>
                    <span class="T_21 T_102" style="line-height: 1.4rem; @{ if (Model.SenderPhone == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } } "><b>SĐT</b></span> <span class="ms-1 me-1">-</span>
                    <span class="T_21 T_103" style="line-height: 1.4rem; @{ if (Model.SenderAddress == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } } "><b>Địa chỉ</b></span>
                </td>
            </tr>
            <tr>
                <td style="white-space: inherit; text-align: justify; vertical-align: middle;">
                    <span style="line-height: 1.4rem;"><b>Họ tên</b></span> <span class="ms-1 me-1">-</span>
                    <span class="T_22 T_104" style="line-height: 1.4rem; @{ if (Model.ReceiverAddress == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } } "><b>Địa chỉ</b></span>
                </td>
                <td style="vertical-align: baseline;">
                    <span style="line-height: 1.4rem; display: block;"><b>Tiền thu hộ</b></span>
                </td>
            </tr>
            <tr>
                <td style="vertical-align: baseline;">
                    <span class="T_22 T_25" style="line-height: 1.4rem; display: block; @{ if (Model.ReceiverPhone == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } }"><b>ĐT người nhận</b></span>
                </td>
                <td style="vertical-align: baseline;">
                    <span style="line-height: 1.4rem; display: block;"><b>Cước thu người nhận</b></span>
                </td>
            </tr>
            <tr>
                <td style="white-space: inherit; text-align: justify; vertical-align: baseline;">
                    <span class="T_23 T_27" style="line-height: 1.4rem; display: block; @{ if (Model.Message == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } }"><b>Nội dung hàng</b></span>
                </td>
                <td style="vertical-align: baseline;">
                    <span style="line-height: 1.4rem; display: block;"><b>Khối lượng</b></span>
                </td>
            </tr>
            <tr>
                <td colspan="2" class="text-center">
                    <div class="d-flex justify-content-center">
                        <span class="T_105 T_107" style="line-height: 1.4rem; display: block; @{ if (Model.TransportMainServiceName == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } }"><b>Tên dịch vụ chính</b></span> <span class="ms-1 me-1">-</span>
                        <span class="T_105 T_106" style="line-height: 1.4rem; display: block; @{ if (Model.TransportMainServiceCode == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } }"><b>Mã dịch vụ chính</b></span>
                    </div>
                    <div class="">
                        <span class="T_105 T_108" style="line-height: 1.4rem; display: block; @{ if (Model.TransportExtraServiceCode == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } }"><b>Mã dịch vụ cộng thêm</b></span>
                    </div>
                </td>
            </tr>
            <tr>
                <td colspan="2" style="max-width: 50%; white-space: inherit; text-align: justify; vertical-align: baseline;">
                    <span class="T_23 T_29" style="line-height: 1.4rem; display: block; @{ if (Model.Note == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } }"><b>Ghi chú </b></span>
                </td>
            </tr>
            <tr>
                <td colspan="2" class="text-center pt-1">
                    <img src="@String.Format("data:image /png;base64,{0}", SampleBarCode)" style="width: 60%; height: 35px; border-radius: 0;margin-bottom: 5px;" />
                </td>
            </tr>
            <tr>
                <td colspan="2" class="text-center">
                    <span style="line-height: 1.4rem; display: block;"><b>In: @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</b></span>
                </td>
            </tr>
        </thead>
    </table>
}
else if (Model.PrintType == "B1")
{
    <table class="table" style="min-width: 7cm; max-width: 10cm;">
        <thead>
            <tr>
                <td colspan="2" class="text-center p-1" style="border-left: 1px #c9ccd7 solid; border-right: 1px #c9ccd7 solid; border-top: 1px #c9ccd7 solid">
                    <span class="T_31 T_40" style="line-height: 1.4rem; @{ if (Model.SenderName == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } }"><b>Tên người gửi</b></span>
                    -
                    <span style="line-height: 1.4rem;"><b>Tên dịch vụ vận chuyển chính</b></span>
                </td>
            </tr>
            <tr>
                <td class="p-1" style="vertical-align: baseline;border-left: 1px #c9ccd7 solid;border-right: 1px #c9ccd7 solid;">
                    <span style="line-height: 1.4rem; display: block;"><b>Ngày gửi</b></span>
                    <span style="line-height: 1.4rem; display: block;"><b>Bưu cục</b></span>
                    <span class="T_33 T_43" style="line-height: 1.4rem; display: block; @{ if (Model.OrderCode == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } }"><b>Mã đơn hàng</b></span>
                </td>
                <td class="text-center" width="50%" style="border-right: 1px #c9ccd7 solid;">
                    <img src="@String.Format("data:image /png;base64,{0}", SampleBarCode)" style="width: 100%; height: auto; border-radius: 0;" />
                </td>
            </tr>
            <tr>
                <td class="p-1" colspan="2" style="white-space: inherit; text-align: justify; vertical-align: baseline;border-left: 1px #c9ccd7 solid;border-right: 1px #c9ccd7 solid;">
                    <span style="line-height: 1.4rem; display: block;"><b>Người nhận</b></span>
                    <span class="T_32 T_45" style="line-height: 1.4rem; display: block; @{ if (Model.ReceiverPhone == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } }"><b>ĐT người nhận</b> </span>
                    <span style="line-height: 1.4rem;display: block;"><b>Địa chỉ</b></span>
                </td>
            </tr>
            <tr>
                <td class="p-0" colspan="2">
                    <div class="row" style="margin: 0;">
                        <div class="col-md-6 col-print-6 p-1" style="white-space: initial; text-align: left; vertical-align: middle; border-right: 1px #c9ccd7 solid;border-left: 1px #c9ccd7 solid;word-break: break-word;">
                            <span style="line-height: 1.4rem; display: block;"><b>Cước thu người nhận</b></span>
                            <span style="line-height: 1.4rem; display: block;"><b>Nội dung hàng</b></span>
                        </div>
                        <div class="col-md-6 col-print-6 p-1" style="white-space: initial; text-align: center; vertical-align: middle; word-break: break-word;border-right: 1px #c9ccd7 solid;">
                            <span style="line-height: 1.4rem;"><b>COD</b></span>
                            <br />
                            <span style="line-height: 1.4rem;"></span>
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                <td class="p-1" colspan="2" style="white-space: inherit; text-align: justify; vertical-align: baseline;border-left: 1px #c9ccd7 solid;border-right: 1px #c9ccd7 solid;border-bottom: 1px #c9ccd7 solid;">
                    <span style="line-height: 1.4rem;"><b>Ghi chú </b></span>
                </td>
            </tr>
        </thead>
    </table>
}
else if (Model.PrintType == "B2")
{
    <table class="table table-bordered table_custom" style="width:11cm;min-height: 12.5cm;">
        <thead>
            <tr>
                <td class="p-0" colspan="2">
                    <div class="row">
                        <div class="col-md-6 p-1 col-print-6">
                            <img class="size-logo" src="~/Assets/images/logo/logo_ems_vietnam.png" style="width: 90%; border-radius: 0;margin-left: 10px; margin-top: 5px;" />
                        </div>
                        <div class="col-md-6 p-1 col-print-6" style="white-space:initial;">
                            <span style="line-height: 1.1rem; display: block;"><b>Bưu cục</b></span>
                            <span style="line-height: 1.1rem; display: block;"><b>Ngày gửi</b></span>
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                <td colspan="2" class="text-center p-1" height="60">
                    <img src="@String.Format(" data:image /png;base64,{0}", SampleBarCode)" style="width: 60%; height: 35px; border-radius: 0;margin-bottom: 5px;" />
                </td>
            </tr>
            <tr>
                <td class="p-1" colspan="2" style="white-space: initial; text-align: left; vertical-align: middle;">
                    <span class="T_34 T_51" style="line-height: 1.1rem; display: block; @{ if (Model.SenderName == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } }"><b>Người gửi</b></span>
                </td>
            </tr>
            <tr>
                <td class="p-1" style="white-space: initial; text-align: left; vertical-align: middle; border-right: 1px #c9ccd7 solid;">
                    <span style="line-height: 1.1rem;"><b>Người nhận</b></span>
                    <br />
                </td>
                <td class="p-1" style="white-space: initial; text-align: left; vertical-align: middle; word-break: break-word;">
                    <span style="line-height: 1.1rem;"><b>Tiền thu hộ</b></span>
                    <br />
                </td>
            </tr>
            <tr>
                <td class="p-1" style="white-space: initial; text-align: left; vertical-align: middle; border-right: 1px #c9ccd7 solid;">
                    <span class="T_35 T_53" style="line-height: 1.1rem; @{ if (Model.ReceiverPhone == "Y") { Write(""); } else { Write("text-decoration: line-through; color: red;"); } }"><b>ĐT người nhận</b></span>
                    <br />
                </td>
                <td class="p-1" style="white-space: initial; text-align: left; vertical-align: middle; border-right: 1px #c9ccd7 solid;">
                    <span style="line-height: 1.1rem;"><b>Cước thu người nhận</b></span>
                    <br />
                </td>
            </tr>
            <tr>
                <td class="p-1" style="white-space: initial; text-align: left; vertical-align: middle; border-right: 1px #c9ccd7 solid;">
                    <span style="line-height: 1.1rem;"><b>Nội dung hàng</b></span>
                    <br />
                </td>
                <td class="p-1" style="white-space: initial; text-align: left; vertical-align: middle; border-right: 1px #c9ccd7 solid;">
                    <span style="line-height: 1.1rem;"><b>Khối lượng</b></span>
                    <br />
                </td>
            </tr>
            <tr>
                <td colspan="2" class="text-center p-1">
                    <span><b>DỊCH VỤ VẬN CHUYỂN CHÍNH</b></span>
                </td>
            </tr>
            <tr>
                <td class="p-1" colspan="2" height="60" style="white-space: inherit; text-align: justify; vertical-align: baseline;">
                    <span style="line-height: 1.1rem;"><b>Ghi chú </b></span>
                    <br />
                    <span style="line-height: 1.1rem;"></span>
                </td>
            </tr>
            <tr>
                <td colspan="2" class="text-center p-1">
                    <img src="@String.Format(" data:image /png;base64,{0}", SampleBarCode)" style="width: 60%; height: 35px; border-radius: 0;margin-bottom: 5px;" />
                    <br />
                </td>
            </tr>
            <tr>
                <td colspan="2" class="p-1 text-center">
                    <span style="line-height: 1.1rem;"><b>In: @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</b></span>
                </td>
            </tr>
        </thead>
    </table>
}
else if (Model.PrintType == "Label")
{
    <table class="table table-bordered table_custom" style="width:11cm;min-height: 12.5cm;">
        <thead>
            <tr>
                <td class="p-0" colspan="2">
                    <div class="row">
                        <div class="col-md-6 p-1 col-print-6">
                            <img class="size-logo" src="~/Assets/images/logo/logo_ems_vietnam.png" style="width: 90%; border-radius: 0;margin-left: 10px; margin-top: 5px;" />
                        </div>
                        <div class="col-md-6 p-1 col-print-6" style="white-space:initial;">
                            <span style="line-height: 1.1rem; display: block;"><b>Bưu cục</b></span>
                            <span style="line-height: 1.1rem; display: block;"><b>Ngày gửi</b></span>
                        </div>
                    </div>
                </td>
            </tr>
            <tr>
                <td colspan="2" class="text-center p-1" height="60">
                    <img src="@String.Format(" data:image /png;base64,{0}", SampleBarCode)" style="width: 60%; height: 35px; border-radius: 0;margin-bottom: 5px;" />
                    <br />
                </td>
            </tr>
            <tr>
                <td class="p-1" colspan="2" style="white-space: initial; text-align: left; vertical-align: middle;">
