@model EMS.MVC.Frontend.Models.ImportExcelViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@Html.HiddenFor(m => m.License)
<div class="container-fluid">
    <div class="card">
        <div class="card-header border-0 ">
            <h5 class="card-title">Thêm phiếu xuất kho bằng nhập file excel</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-xl-6 col-lg-6 col-md-6 mb-2">
                    <form id="DocumentUpload" enctype="multipart/form-data">
                        @Html.EditorFor(model => model.Document, new { htmlAttributes = new { @type = "file", @class = "form-control", @style = "padding: .3125rem 0.7rem;" } })
                    </form>
                    <span class="text-danger" id="errDocument"></span>
                </div>
            </div>
            <div class="d-flex align-items-center">
                <span class="d-flex align-items-center me-2" title="Số đơn hợp lệ">
                    <svg class="me-1" width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path opacity="0.4"
                              d="M11.0007 20.1663C16.0633 20.1663 20.1673 16.0623 20.1673 10.9997C20.1673 5.93706 16.0633 1.83301 11.0007 1.83301C5.93804 1.83301 1.83398 5.93706 1.83398 10.9997C1.83398 16.0623 5.93804 20.1663 11.0007 20.1663Z"
                              fill="#34C759" />
                        <path d="M9.6993 14.2821C9.51596 14.2821 9.3418 14.2088 9.21346 14.0805L6.6193 11.4863C6.35346 11.2205 6.35346 10.7805 6.6193 10.5146C6.88513 10.2488 7.32513 10.2488 7.59096 10.5146L9.6993 12.623L14.411 7.91129C14.6768 7.64546 15.1168 7.64546 15.3826 7.91129C15.6485 8.17712 15.6485 8.61712 15.3826 8.88296L10.1851 14.0805C10.0568 14.2088 9.88263 14.2821 9.6993 14.2821Z"
                              fill="#34C759" />
                    </svg>
                    <span id="NumberOfSuccess">0/0</span>
                </span>
                <span class="d-flex align-items-center me-2" title="Số đơn không hợp lệ">
                    <svg class="me-1" width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path opacity="0.4"
                              d="M11.0007 20.1663C16.0633 20.1663 20.1673 16.0623 20.1673 10.9997C20.1673 5.93706 16.0633 1.83301 11.0007 1.83301C5.93804 1.83301 1.83398 5.93706 1.83398 10.9997C1.83398 16.0623 5.93804 20.1663 11.0007 20.1663Z"
                              fill="#FF3B30" />
                        <path d="M11.9717 11.0001L14.0801 8.89174C14.3459 8.62591 14.3459 8.18591 14.0801 7.92008C13.8142 7.65424 13.3742 7.65424 13.1084 7.92008L11.0001 10.0284L8.89174 7.92008C8.62591 7.65424 8.18591 7.65424 7.92008 7.92008C7.65424 8.18591 7.65424 8.62591 7.92008 8.89174L10.0284 11.0001L7.92008 13.1084C7.65424 13.3742 7.65424 13.8142 7.92008 14.0801C8.05758 14.2176 8.23174 14.2817 8.40591 14.2817C8.58008 14.2817 8.75424 14.2176 8.89174 14.0801L11.0001 11.9717L13.1084 14.0801C13.2459 14.2176 13.4201 14.2817 13.5942 14.2817C13.7684 14.2817 13.9426 14.2176 14.0801 14.0801C14.3459 13.8142 14.3459 13.3742 14.0801 13.1084L11.9717 11.0001Z"
                              fill="#FF3B30" />
                    </svg>
                    <span id="NumberOfInvalid">0/0</span>
                </span>
                <span class="d-flex align-items-center me-2" title="Số đơn lỗi">
                    <svg class="me-1" width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path opacity="0.4"
                              d="M11.0007 20.1663C16.0633 20.1663 20.1673 16.0623 20.1673 10.9997C20.1673 5.93706 16.0633 1.83301 11.0007 1.83301C5.93804 1.83301 1.83398 5.93706 1.83398 10.9997C1.83398 16.0623 5.93804 20.1663 11.0007 20.1663Z"
                              fill="#FF9500" />
                        <path d="M11 12.6045C10.6242 12.6045 10.3125 12.2928 10.3125 11.917V7.10449C10.3125 6.72866 10.6242 6.41699 11 6.41699C11.3758 6.41699 11.6875 6.72866 11.6875 7.10449V11.917C11.6875 12.2928 11.3758 12.6045 11 12.6045Z"
                              fill="#FF9500" />
                        <path d="M11.0007 15.8128C10.8815 15.8128 10.7623 15.7853 10.6523 15.7394C10.5331 15.6936 10.4415 15.6295 10.3498 15.547C10.2673 15.4553 10.2032 15.3544 10.1482 15.2444C10.1023 15.1344 10.084 15.0153 10.084 14.8961C10.084 14.6578 10.1756 14.4194 10.3498 14.2453C10.4415 14.1628 10.5331 14.0986 10.6523 14.0528C10.9915 13.9061 11.3948 13.9886 11.6515 14.2453C11.734 14.3369 11.7981 14.4286 11.844 14.5478C11.8898 14.6578 11.9173 14.7769 11.9173 14.8961C11.9173 15.0153 11.8898 15.1344 11.844 15.2444C11.7981 15.3544 11.734 15.4553 11.6515 15.547C11.4773 15.7211 11.2482 15.8128 11.0007 15.8128Z"
                              fill="#FF9500" />
                    </svg>
                    <span id="NumberOfError">0/0</span>
                </span>
            </div>
            <p class="text-secondary font-w600">
                Xuất file excel những thông tin tải lên bị lỗi
            </p>
            Lưu ý
            <ul class="ps-4 mb-3">
                <li>
                    Tải mẫu file nhập <a data-redirect="false" data-file="true" href="~/Assets/file/MauImportPhieuXuatKho.xlsx">tại đây</a>.
                </li>
                <li>
                    Hệ thống chỉ hỗ trợ file tối đa 1.000 dòng và có định dạng .xls, .xlsx hoặc .xlsm
                </li>
            </ul>

        </div>
        <div class="card-footer d-sm-flex justify-content-end align-items-center">
            <button type="button" class="btn btn-outline-dark" onclick="excelExport()">Xuất Excel</button>
            <button type="button" class="btn btn-outline-dark" onclick="excelImport()">Thêm phiếu xuất kho</button>
        </div>

        <div class="card-body">
            <div class="col-xl-12 col-lg-12 col-md-12" id="JSpreadSheet">

            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        $(document).ready(function () {
            $("div.nav-control").click();
        });

        var jspreadSheetLicense = $("#License").val();
        var totalData = 0;
        var jspreadSheetID = document.getElementById("JSpreadSheet");
        var showJSpreadSheet = "";
        var isChangeExcel = false;
        var hightExcel = window.innerHeight - 530;
        var totalColumn = 9;
        var totalRow = 50;
        var arrColumn = ["A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K"];

        $(window).on('beforeunload', function (event) {
            if (isChangeExcel) {
                return 'Are you sure you want to leave?';
            } else {
                event.preventDefault();
            }
        });

        $("a").click(function (event) {
            event.preventDefault();
            if (isChangeExcel) {
                var isRedirect = $(this).attr("data-redirect");
                if (isRedirect == "true") {
                    swal({
                        title: 'Thông báo',
                        text: "Đang có dữ liệu chưa xử lý, bạn có muốn thoát trang không?",
                        className: 'width-358',
                        buttons: {
                            confirm: {
                                text: "Xác nhận",
                                value: true,
                                visible: true,
                                className: "btn btn-primary",
                                closeModal: true
                            },
                            cancel: {
                                text: "Đóng",
                                value: false,
                                visible: true,
                                className: "btn btn-danger",
                                closeModal: true,
                            }
                        },
                    }).then((value) => {
                        if (value) {
                            isChangeExcel = false;
                            window.location.href = event.currentTarget.href;
                        }
                    });
                } else {
                    var isFile = $(this).attr("data-file");
                    if (isFile == "true") {
                        isChangeExcel = false;
                        window.location.href = event.currentTarget.href;
                    }
                }
            } else {
                window.location.href = event.currentTarget.href;
            }
        });

        jspreadsheet.setLicense(jspreadSheetLicense);

        var FilterListProductVariant = function (o, cell, x, y, value, config) {
            var ListProductVariant = [];
            var value = o.getValueFromCoords(x - 1, y);
            if (value) {
                ListProductVariant = LoadListProductVariant(value);
            }
            config.source = ListProductVariant;
            return config;
        }

        var ListProductVariant = [];
        function LoadListProductVariant(WareHouseID) {
            ListProductVariant = [];
            var Data = SearchListProductVariant(WareHouseID);
            var JSON = Data.responseJSON;
            if (JSON.length > 0) {
                $.each(JSON, function (index, value) {
                    var Obj = {};
                    Obj.id = value.ProductVariantID;
                    Obj.name = value.ProductName + "(" + value.ProductVariantName + ")";
                    Obj.NumberOfInventory = value.NumberOfInventory;
                    Obj.ProductVariantSKU = value.ProductVariantSKU;
                    ListProductVariant.push(Obj);
                });
            }
            return ListProductVariant;
        }

        var ListWareHouse = @Html.Raw(Json.Encode(Model.ListWareHouse));

        var objWorksheet = {
            minDimensions: [totalColumn, totalRow],
            filters: true,
            columns: [
                { type: 'text', title: 'Trạng thái', width: 150, primaryKey: true, readOnly: true },
                { type: 'text', title: 'Tên khách hàng', width: 200, align: 'left', wrap: true },
                //{ type: 'dropdown', title: 'Kho xuất', width: 200, align: 'left', source: LoadListWareHouse(), multiple: false, wrap: true, autocomplete: true, },
                { type: 'dropdown', title: 'Kho xuất', width: 200, align: 'left', source: @Html.Raw(Json.Encode(Model.ListWareHouse)), multiple: false, wrap: true, autocomplete: true, },
                { type: 'dropdown', title: 'Mã SKU', width: 200, source: [], filterOptions: FilterListProductVariant, align: 'left', wrap: true, autocomplete: true, },
                { type: 'number', title: 'Số lượng tồn', width: 200, align: 'right', wrap: true, mask: '#,##0', readOnly: true },
                //{ type: 'text', title: 'Số lượng tồn', width: 200, align: 'right', wrap: true, readOnly: true },
                { type: 'number', title: 'Số lượng xuất', width: 200, align: 'left', wrap: true, mask: '#,##0' },
                { type: 'text', title: 'Mã phiếu xuất', width: 200, align: 'left', wrap: true },
                { type: 'calendar', title: 'Ngày xuất', width: 200, align: 'left', wrap: true, format: "dd/mm/yyyy"},
                //{ type: 'text', title: 'Ngày xuất', width: 200, align: 'left', wrap: true },
                { type: 'number', title: 'Số ngày lưu kho', width: 100, align: 'left', wrap: true, mask: '#,##0' },
                { type: 'calendar', title: 'Hạn lưu kho', width: 200, align: 'left', wrap: true, format: "dd/mm/yyyy" },
                //{ type: 'text', title: 'Hạn lưu kho', width: 200, align: 'left', wrap: true },
                { type: 'text', title: 'Mã Pallet', width: 200, align: 'left', wrap: true },
            ],
            allowComments: true,
            tableOverflow: true,
            tableHeight: hightExcel,
            freezeColumns: 1,
            allowInsertColumn: false,
        };

        var customToolbar = {
            items: [
                {
                    content: 'search',
                    onclick: function (a, b, c) {
                        if (c.children[0].innerText == 'search') {
                            jspreadsheet.current.showSearch();
                            c.children[0].innerText = 'search_off';
                        } else {
                            jspreadsheet.current.hideSearch();
                            c.children[0].innerText = 'search';
                        }
                    },
                    tooltip: 'Toggle Search',
                    updateState: function (a, b, c, worksheet) {
                        // Call this one when the worksheet is opened and on the selection of any cells
                        if (worksheet.options.search == true) {
                            c.children[0].innerText = 'search_off';
                        } else {
                            c.children[0].innerText = 'search';
                        }
                    }
                },
                {
                    content: 'fullscreen',
                    onclick: function (a, b, c) {
                        if (c.children[0].innerText == 'fullscreen') {
                            jspreadsheet.current.fullscreen(true);
                            c.children[0].innerText = 'fullscreen_exit';
                        } else {
                            jspreadsheet.current.fullscreen(false);
                            c.children[0].innerText = 'fullscreen';
                        }
                    },
                    tooltip: 'Toggle Fullscreen',
                    updateState: function (a, b, c, d) {
                        if (d.parent.config.fullscreen == true) {
                            c.children[0].innerText = 'fullscreen_exit';
                        } else {
                            c.children[0].innerText = 'fullscreen';
                        }
                    }
                },
            ]
        }

        showJSpreadSheet = jspreadsheet(jspreadSheetID, {
            toolbar: customToolbar,
            worksheets: [objWorksheet],
            contextMenu: function (o, x, y, e, items, section) {
                return false;
            },
            onchange: function (worksheet, domElement, column, row, newValue, oldValue) {
                JSpreadSheetChange(worksheet, domElement, column, row, newValue, oldValue);
            },
            onafterchanges: function (worksheet, records) {
                isChangeExcel = true;
            },
            onpaste: function (worksheet, data) {
                JSpreadSheetPaste(worksheet, data);
            },
        });

        function JSpreadSheetChange(worksheet, domElement, column, row, newValue, oldValue) {
            var numberColumn = Number(column);
            var numberRow = Number(row);
            if (numberColumn != 0) {
                if (numberColumn == 2) {
                    var columnSKUCode = jspreadsheet.helpers.getColumnNameFromCoords(numberColumn + 1, numberRow);
                    worksheet.setValue(columnSKUCode, '');
                    var columnNumberOfInventory = jspreadsheet.helpers.getColumnNameFromCoords(numberColumn + 2, numberRow);
                    worksheet.setReadOnly(columnNumberOfInventory, false);
                    worksheet.setValue(columnNumberOfInventory, '');
                    worksheet.setReadOnly(columnNumberOfInventory, true);
                    var columnNumberOfOutput = jspreadsheet.helpers.getColumnNameFromCoords(numberColumn + 3, numberRow);
                    worksheet.setValue(columnNumberOfOutput, '');
                } else if (numberColumn == 3) {
                    var ListFillter = ListProductVariant.filter(function (element) { return element.id == newValue; });
                    if (ListFillter.length > 0) {
                        var columnNumberOfInventory = jspreadsheet.helpers.getColumnNameFromCoords(numberColumn + 1, numberRow);
                        worksheet.setReadOnly(columnNumberOfInventory, false);
                        worksheet.setValue(columnNumberOfInventory, ListFillter[0].NumberOfInventory);
                        worksheet.setReadOnly(columnNumberOfInventory, true);
                    }
                }
                checkRowData(worksheet, domElement, numberColumn, numberRow, newValue, oldValue);
            }
        };

        function checkRowData(worksheet, domElement, numberColumn, numberRow, newValue, oldValue) {
            var rowData = numberRow + 1;
            $.each(arrColumn, function (index, value) {
                var indexColumn = value + rowData;
                switch (value) {
                    case "B":
                        CheckDataJSpreadSheet(worksheet.getValue(indexColumn), indexColumn, "Tên khách hàng", 200, "Vietnamese", "N");
                        break;
                    case "C":
                        CheckDataJSpreadSheet(worksheet.getValue(indexColumn), indexColumn, "Kho xuất", 200, "", "Y");
                        break;
                    case "D":
                        CheckDataJSpreadSheet(worksheet.getValue(indexColumn), indexColumn, "Mã SKU", 200, "", "Y");
                        break;
                    case "E":
                    case "F":
                        var numberOfInventory = NumberReplace(worksheet.getValue("E" + rowData));
                        if (numberOfInventory > 0) {
                            CheckDataJSpreadSheet(numberOfInventory.toString(), "E" + rowData, "Số lượng tồn", 10, "Number", "Y");
                            var numberOfOutput = NumberReplace(worksheet.getValue("F" + rowData));
                            if (numberOfOutput > 0) {
                                CheckDataJSpreadSheet(numberOfOutput.toString(), "F" + rowData, "Số lượng xuất", 10, "Number", "Y");
                                if (numberOfOutput > numberOfInventory) {
                                    showJSpreadSheet[0].setComments("F" + rowData, "Số lượng xuất không được vượt quá số lượng tồn");
                                }
                            } else {
                                CheckDataJSpreadSheet(null, "F" + rowData, "Số lượng xuất", 10, "Number", "Y");
                            }
                        } else {
                            CheckDataJSpreadSheet(null, "E" + rowData, "Số lượng tồn", 10, "Number", "Y");
                        }
                        break;
                    case "G":
                        CheckDataJSpreadSheet(worksheet.getValue(indexColumn), indexColumn, "Mã phiếu xuất", 50, "UserName", "N");
                        break;
                    case "H":
                        CheckDataJSpreadSheet(worksheet.getValue(indexColumn), indexColumn, "Ngày xuất", 50, "", "N");
                        break;
                    case "I":
                        CheckDataJSpreadSheet(worksheet.getValue(indexColumn).toString(), indexColumn, "Số ngày lưu kho", 3, "Number", "N");
                        break;
                    case "J":
                        CheckDataJSpreadSheet(worksheet.getValue(indexColumn), indexColumn, "Hạn lưu kho", 50, "", "N");
                        break;
                    case "K":
                        CheckDataJSpreadSheet(worksheet.getValue(indexColumn), indexColumn, "Mã Pallet", 20, "SpecialCharButNotVietnamese", "N");
                        break;
                    default:
                        break;
                }
            });

            excelSetComment(worksheet, numberColumn, rowData);
        }

        function excelSetComment(worksheet, column, row) {
            var commentError = "";
            for (var i = 1; i < arrColumn.length; i++) {
                var iComment = worksheet.getComments(arrColumn[i] + row);
                if (iComment) {
                    commentError += iComment;
                }
            };
            worksheet.setComments(arrColumn[0] + row, commentError);

            if (commentError) {
                worksheet.setValue(arrColumn[0] + row, 'Không hợp lệ', true);
                excelSetStyle(worksheet, column, row, "Error");
            } else {
                worksheet.setValue(arrColumn[0] + row, 'Hợp lệ', true);
                excelSetStyle(worksheet, column, row, "Success");
            }

            countData(worksheet);
        }

        function excelSetStyle(worksheet, column, row, Type) {
            for (var i = 1; i < arrColumn.length; i++) {
                if (Type == "Reset") {
                    worksheet.resetStyle(arrColumn[i] + row);
                } else {
                    if (Type == "Success") {
                        if (worksheet.getStyle(arrColumn[i] + row) != "background-color: white") {
                            worksheet.setStyle(arrColumn[i] + row, "background-color", "white");
                        }
                    } else {
                        if (worksheet.getStyle(arrColumn[i] + row) != "background-color: yellow") {
                            worksheet.setStyle(arrColumn[i] + row, "background-color", "yellow");
                        }
                    }
                }
            };
        }

        function excelSetRowBlank(worksheet, column, row) {
            for (var i = 0; i < arrColumn.length; i++) {
                worksheet.resetStyle(arrColumn[i] + row);
                worksheet.setComments(arrColumn[i] + row, "");
            };
        }

        function countData(worksheet) {
            var columnStatus = worksheet.getColumnData(0);
            var filterColumnStatus = columnStatus.filter(function (element) { return element != ""; });
            var NumberOfSuccess = 0, NumberOfInvalid = 0, NumberOfError = 0;
            for (var i = 0; i < filterColumnStatus.length; i++) {
                switch (filterColumnStatus[i]) {
                    case "Hợp lệ":
                        NumberOfSuccess++;
                        break;
                    case "Không hợp lệ":
                        NumberOfInvalid++;
                        break;
                    case "Lỗi":
                        NumberOfError++;
                        break;
                }
            }

            totalData = NumberOfSuccess + NumberOfInvalid + NumberOfError;

            $('#NumberOfSuccess').html(NumberOfSuccess + "/" + totalData);
            $('#NumberOfInvalid').html(NumberOfInvalid + "/" + totalData);
            $('#NumberOfError').html(NumberOfError + "/" + totalData);
        }

        function JSpreadSheetPaste(worksheet, data) {
            for (var i = 0; i < data.length; i++) {
                if (data[i].x == 3) {
                    ListProductVariant = LoadListProductVariant(worksheet.getValueFromCoords(data[i].x - 1, data[i].y));
                    var ListFillter = ListProductVariant.filter(function (element) { return element.id == parseInt(data[i].value); });
                    if (ListFillter.length > 0) {
                        var ColumnNumberOfInventory = jspreadsheet.helpers.getColumnNameFromCoords(data[i].x + 1, data[i].y);
                        worksheet.setReadOnly(ColumnNumberOfInventory, false);
                        worksheet.setValue(ColumnNumberOfInventory, ListFillter[0].NumberOfInventory);
                        worksheet.setReadOnly(ColumnNumberOfInventory, true);

                        worksheet.setCells('D' + Number(data[i].y + 1), { type: 'dropdown', title: 'Mã SKU', width: 200, source: [{ 'id': ListFillter[0].id, 'name': ListFillter[0].name }], filterOptions: FilterListProductVariant, align: 'left', wrap: true, autocomplete: true, });
                        worksheet.setValueFromCoords(data[i].x, data[i].y, ListFillter[0].id);
                    }
                }
            }
        };

        function excelImport() {
            var ListDataExcel = showJSpreadSheet[0].getData(false, false);
            var FilterDataExcel = ListDataExcel.filter(function (element) { return element[0] != ""; });
            var NumberOfExcel = FilterDataExcel.length;
            if (NumberOfExcel > 1000) {
                CreateCustomSwal("error", "Hệ thống chỉ hỗ trợ import tối đa 1000 dòng.");
                return;
            }
            var ListDataImport = [];
            var ListDataReject = [];
            var ListDataError = [];
            for (var i = 0; i < NumberOfExcel; i++) {
                var ItemExcel = FilterDataExcel[i];
                var SKUName = showJSpreadSheet[0].getValueFromCoords(3, i, true);

                if (ItemExcel[0] == "Hợp lệ") {
                    var obj = {
                        CustomerName: ItemExcel[1].trim(),
                        WareHouseID: ItemExcel[2],
                        SKUID: ItemExcel[3],
                        SKUName: SKUName.trim(),
                        SKUInventory: parseInt(NumberReplace(ItemExcel[4])),
                        NumberOfOutput: parseInt(NumberReplace(ItemExcel[5])),
                        InventoryOutputCode: ItemExcel[6].trim(),
                        InventoryOutputDate: ItemExcel[7],
                        NumberOfDateInWareHouse: ItemExcel[8],
                        TermInWareHouse: ItemExcel[9],
                        //PalletCode: ItemExcel[10],
                        ListInventoryOutputDetail: [
                            {
                                SKUID: ItemExcel[3],
                                SKUName: SKUName.trim(),
                                SKUInventory: parseInt(NumberReplace(ItemExcel[4])),
                                NumberOfOutput: parseInt(NumberReplace(ItemExcel[5])),
                                NumberOfDateInWareHouse: ItemExcel[8],
                                TermInWareHouse: ItemExcel[9],
                                PalletCode: ItemExcel[10],
                            }
                        ],
                        IsCheckSuccess: "Y",
                        IsCheckMessage: "",
                        NumberOfRow: i,
                    }

                    if (ListDataImport.length == 0) {
                        ListDataImport.push(obj);
                    } else {
                        var Filter = ListDataImport.filter(function (element) { return element.InventoryOutputCode == obj.InventoryOutputCode; });
                        if (Filter.length > 0) {
                            var ItemFilter = Filter[0];
                            var ItemImportIndex = ListDataImport.findIndex(m => m.InventoryOutputCode == obj.InventoryOutputCode);
                            var ItemImport = ListDataImport[ItemImportIndex];
                            if (ItemImport.IsCheckSuccess == "Y") {
                                if (ItemFilter.CustomerName == obj.CustomerName
                                    && ItemFilter.WareHouseID == obj.WareHouseID && ItemFilter.InventoryOutputDate == obj.InventoryOutputDate) {
                                    var FilterDetail = ItemFilter.ListInventoryOutputDetail.filter(function (element) { return element.SKUID == obj.SKUID; });
                                    if (FilterDetail.length > 0) {
                                        var ItemDetailIndex = ItemImport.ListInventoryOutputDetail.findIndex(m => m.SKUID == obj.SKUID);
                                        var ItemDetail = ItemImport.ListInventoryOutputDetail[ItemDetailIndex];
                                        if (ItemDetail.NumberOfDateInWareHouse == obj.NumberOfDateInWareHouse && ItemDetail.TermInWareHouse == obj.TermInWareHouse) {
                                            ItemDetail.NumberOfOutput = ItemDetail.NumberOfOutput + obj.NumberOfOutput;
                                        } else {
                                            //Chuyển phiếu xuất kho thành công thành thất bại.
                                            ItemImport.IsCheckSuccess = "N";
                                            ItemImport.IsCheckMessage = "Thông tin số ngày lưu kho và hạn lưu kho không trùng khớp.";
                                            ListDataReject.push([
                                                "Không hợp lệ",
                                                ItemImport.CustomerName,
                                                ItemImport.WareHouseID,
                                                ItemImport.SKUID,
                                                ItemImport.SKUInventory,
                                                ItemImport.NumberOfOutput,
                                                ItemImport.InventoryOutputCode,
                                                ItemImport.InventoryOutputDate,
                                                ItemImport.NumberOfDateInWareHouse,
                                                ItemImport.TermInWareHouse,
                                                ItemImport.PalletCode,
                                                ItemImport.SKUName,
                                                ItemImport.IsCheckMessage,
                                                ItemImport.NumberOfRow
                                            ]);

                                            //Chuyển phiếu xuất kho hiện tại thành thất bại.
                                            ItemExcel[0] = "Không hợp lệ";
                                            ItemExcel.push(SKUName);
                                            ItemExcel.push(ItemImport.IsCheckMessage);
                                            ItemExcel.push(obj.NumberOfRow);
                                            ListDataReject.push(ItemExcel);
                                        }
                                    } else {
                                        ItemImport.ListInventoryOutputDetail.push({
                                            SKUID: obj.SKUID,
                                            SKUName: obj.SKUName,
                                            SKUInventory: obj.SKUInventory,
                                            NumberOfOutput: obj.NumberOfOutput,
                                            NumberOfDateInWareHouse: obj.NumberOfDateInWareHouse,
                                            TermInWareHouse: obj.TermInWareHouse,
                                            PalletCode: obj.PalletCode,
                                        });
                                    }
                                } else {
                                    //Chuyển phiếu xuất kho thành công thành thất bại.
                                    ItemImport.IsCheckSuccess = "N";
                                    ItemImport.IsCheckMessage = "Thông tin tên khách hàng, kho xuất và ngày xuất không trùng khớp.";
                                    ListDataReject.push([
                                        "Không hợp lệ",
                                        ItemImport.CustomerName,
                                        ItemImport.WareHouseID,
                                        ItemImport.SKUID,
                                        ItemImport.SKUInventory,
                                        ItemImport.NumberOfOutput,
                                        ItemImport.InventoryOutputCode,
                                        ItemImport.InventoryOutputDate,
                                        ItemImport.NumberOfDateInWareHouse,
                                        ItemImport.TermInWareHouse,
                                        ItemImport.PalletCode,
                                        ItemImport.SKUName,
                                        ItemImport.IsCheckMessage,
                                        ItemImport.NumberOfRow
                                    ]);

                                    //Chuyển phiếu xuất kho hiện tại thành thất bại.
                                    ItemExcel[0] = "Không hợp lệ";
                                    ItemExcel.push(SKUName);
                                    ItemExcel.push(ItemImport.IsCheckMessage);
                                    ItemExcel.push(obj.NumberOfRow);
                                    ListDataReject.push(ItemExcel);
                                }
                            } else {
                                ItemExcel[0] = "Không hợp lệ";
                                ItemExcel.push(SKUName);
                                ItemExcel.push(ItemImport.IsCheckMessage);
                                ItemExcel.push(obj.NumberOfRow);
                                ListDataReject.push(ItemExcel);
                            }
                        } else {
                            ListDataImport.push(obj);
                        }
                    }
                } else {
                    ItemExcel.push(SKUName);
                    if (ItemExcel[0] == "Không hợp lệ") {
                        var Comment = showJSpreadSheet[0].getComments('A' + Number(i + 1));
                        ItemExcel.push(Comment);
                        ItemExcel.push(i);
                        ListDataReject.push(ItemExcel);
                    } else if (ItemExcel[0] == "Lỗi") {
                        var Comment = showJSpreadSheet[0].getComments('A' + Number(i + 1));
                        ItemExcel.push(Comment);
                        ItemExcel.push(i);
                        ListDataError.push(ItemExcel);
                    }
                }
            }

            ListDataImport = ListDataImport.filter(function (element) { return element.IsCheckSuccess == "Y"; });
            ListDataReject = ListDataReject.sort(function (a, b) { if (a[12] < b[12]) { return -1; } if (a[12] > b[12]) { return 1; } return 0 });

            //console.log("ListDataImport", ListDataImport);
            //console.log("ListDataReject", ListDataReject);

            var NumberOfImport = ListDataImport.length;
            var NumberOfReject = ListDataReject.length;
            var NumberOfError = ListDataError.length;

            if (NumberOfImport == 0 && NumberOfReject == 0 && NumberOfError == 0) {
                CreateCustomSwal("error", "Vui lòng nhập thông tin phiếu xuất kho.");
                return;
            } else if (NumberOfImport + NumberOfReject + NumberOfError > 1000) {
                CreateCustomSwal("error", "Hệ thống chỉ hỗ trợ import tối đa 1000 dòng.");
                return;
            };

            isChangeExcel = false;
            $.ajax({
                url: '@Url.Action("JImportExcel", "InventoryOutput")', //ReadExcelFile is a Action Name and ExcelUpload is Controller name
                type: 'POST',
                data: {
                    ListData: ListDataImport,
                    NumberOfReject: NumberOfReject,
                    NumberOfError: NumberOfError
                },
                dataType: 'json',
                success: function (res) {
                    var wrapper = document.createElement('div');
                    wrapper.className = "row";
                    var html = "";
                    html += '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">';
                    html += '<path fill-rule="evenodd" clip-rule="evenodd" d="M12 1.75C6.33908 1.75 1.75 6.33908 1.75 12C1.75 17.6609 6.33908 22.25 12 22.25C17.6609 22.25 22.25 17.6609 22.25 12C22.25 6.33908 17.6609 1.75 12 1.75ZM0.25 12C0.25 5.51065 5.51065 0.25 12 0.25C18.4893 0.25 23.75 5.51065 23.75 12C23.75 18.4893 18.4893 23.75 12 23.75C5.51065 23.75 0.25 18.4893 0.25 12ZM12 6.25C12.4142 6.25 12.75 6.58579 12.75 7V8C12.75 8.41421 12.4142 8.75 12 8.75C11.5858 8.75 11.25 8.41421 11.25 8V7C11.25 6.58579 11.5858 6.25 12 6.25ZM12 10.25C12.4142 10.25 12.75 10.5858 12.75 11V17C12.75 17.4142 12.4142 17.75 12 17.75C11.5858 17.75 11.25 17.4142 11.25 17V11C11.25 10.5858 11.5858 10.25 12 10.25Z" fill="white"';
                    html += '</svg>';
                    html += '<span class="ms-2 mt-1">' + res.Message + '</span>';
                    wrapper.innerHTML = html;

                    if (res.Code == "00" && NumberOfReject == 0 && NumberOfError == 0) {
                        CreateCustomSwal("success", res.Message, '@Url.Action("InventoryOutputView", "InventoryOutput")');
                    } else if (res.Code == "10" || res.Code == "00" && NumberOfReject > 0 || res.Code == "00" && NumberOfError > 0) {
                        swal({
                            content: wrapper,
                            className: "custom-background-swal",
                            html: true,
                            button: false,
                            timer: 3000
                        }).then(function () {
                            showJSpreadSheet[0].loadData([]);
                            var responseData = JSON.parse(res.Data);
                            var responseDataLength = 0;

                            //Hiển thị các dòng bị lỗi
                            if (res.Code == "10") {
                                responseDataLength = responseData.length;
                                showJSpreadSheet[0].setData(JSON.parse(res.Data));
                                for (var i = 0; i < responseDataLength; i++) {
                                    var numberRow = i + 1;
                                    var skuID = 0;
                                    var skuName = "";
                                    var skuInventory = 0;
                                    if (responseData[i][3] > 0) {
                                        skuID = responseData[i][3].toString();
                                        skuName = responseData[i][10].toString();
                                        showJSpreadSheet[0].setCells("D" + numberRow, { type: 'dropdown', title: 'Mã SKU', width: 200, align: 'left', source: [{ 'id': skuID, 'name': skuName }], filterOptions: FilterListProductVariant, multiple: false, wrap: true, autocomplete: true });
                                        showJSpreadSheet[0].setValue("D" + numberRow, skuID, true);
                                    }

                                    showJSpreadSheet[0].setReadOnly("E" + numberRow, false);
                                    if (responseData[i][4] > 0) {
                                        skuInventory = parseInt(NumberReplace(responseData[i][4].toString()));
                                    }
                                    showJSpreadSheet[0].setValue("E" + numberRow, skuInventory, true);
                                    showJSpreadSheet[0].setReadOnly("E" + numberRow, true);

                                    showJSpreadSheet[0].setValue(arrColumn[0] + numberRow, "Lỗi", true);
                                    excelSetStyle(showJSpreadSheet[0], 0, numberRow, "Error");
                                    showJSpreadSheet[0].setComments(arrColumn[0] + numberRow, responseData[i][12]);
                                }
                            }

                            var nextRow = Number(responseDataLength);
                            // Hiện thị các dòng không hợp lệ
                            for (var i = 0; i < NumberOfReject; i++) {
                                var numberRow = nextRow + 1;
                                if (nextRow >= totalRow) {
                                    showJSpreadSheet[0].insertRow(ListDataReject[i]);
                                    excelSetStyle(showJSpreadSheet[0], 0, numberRow, "Reset");
                                } else {
                                    showJSpreadSheet[0].setRowData(nextRow, ListDataReject[i], true);
                                }
                                var skuID = 0;
                                var skuName = "";
                                var skuInventory = 0;
                                if (NumberReplace(ListDataReject[i][3].toString()) > 0) {
                                    skuID = ListDataReject[i][3].toString();
                                    skuName = ListDataReject[i][11].toString();
                                    showJSpreadSheet[0].setCells("D" + numberRow, { type: 'dropdown', title: 'Mã SKU', width: 200, align: 'left', source: [{ 'id': skuID, 'name': skuName }], filterOptions: FilterListProductVariant, multiple: false, wrap: true, autocomplete: true });
                                    showJSpreadSheet[0].setValue("D" + numberRow, skuID, true);
                                }

                                showJSpreadSheet[0].setReadOnly("E" + numberRow, false);
                                if (NumberReplace(ListDataReject[i][4].toString()) > 0) {
                                    skuInventory = parseInt(NumberReplace(ListDataReject[i][4]));
                                }
                                showJSpreadSheet[0].setValue("E" + numberRow, skuInventory, true);
                                showJSpreadSheet[0].setReadOnly("E" + numberRow, true);

                                showJSpreadSheet[0].setValue(arrColumn[0] + numberRow, ListDataReject[i][0], true);
                                excelSetStyle(showJSpreadSheet[0], 0, numberRow, "Error");
                                showJSpreadSheet[0].setComments(arrColumn[0] + numberRow, ListDataReject[i][12]);
                                nextRow++;
                            }

                            // Hiện thị các dòng lỗi
                            for (var i = 0; i < NumberOfError; i++) {
                                var numberRow = nextRow + 1;
                                if (nextRow >= totalRow) {
                                    showJSpreadSheet[0].insertRow(ListDataError[i]);
                                    excelSetStyle(showJSpreadSheet[0], 0, numberRow, "Reset");
                                } else {
                                    showJSpreadSheet[0].setRowData(nextRow, ListDataError[i], true);
                                }
                                var skuID = 0;
                                var skuName = "";
                                var skuInventory = 0;
                                if (NumberReplace(ListDataError[i][3].toString()) > 0) {
                                    skuID = ListDataError[i][3].toString();
                                    skuName = ListDataError[i][11].toString();
                                    showJSpreadSheet[0].setCells('D' + numberRow, { type: 'dropdown', title: 'Mã SKU', width: 200, align: 'left', source: [{ 'id': skuID, 'name': skuName }], filterOptions: FilterListProductVariant, multiple: false, wrap: true, autocomplete: true });
                                    showJSpreadSheet[0].setValue('D' + numberRow, skuID, true);
                                }

                                showJSpreadSheet[0].setReadOnly('E' + numberRow, false);
                                if (NumberReplace(ListDataError[i][4].toString()) > 0) {
                                    skuInventory = parseInt(NumberReplace(ListDataError[i][4]));
                                }
                                showJSpreadSheet[0].setValue('E' + numberRow, skuInventory, true);
                                showJSpreadSheet[0].setReadOnly('E' + numberRow, true);

                                showJSpreadSheet[0].setValue(arrColumn[0] + numberRow, ListDataError[i][0], true);
                                excelSetStyle(showJSpreadSheet[0], 0, numberRow, "Error");
                                showJSpreadSheet[0].setComments(arrColumn[0] + numberRow, ListDataError[i][12]);
                                nextRow++;
                            }

                            if (nextRow <= totalRow) {
                                var listBlank = showJSpreadSheet[0].getData(false, false);
                                var filterListBlank = listBlank.filter(function (element) { return element[0] == ""; });
                                for (var i = nextRow; i < filterListBlank.length; i++) {
                                    var numberRow = nextRow + 1;
                                    excelSetRowBlank(showJSpreadSheet[0], 0, numberRow);
                                    nextRow++;
                                }
                            }

                            countData(showJSpreadSheet[0]);
                        });
                    } else {
                        CreateCustomSwal("error", res.Message);
                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                    var err = eval("(" + xhr.responseText + ")");
                    swal({
                        title: 'Lỗi',
                        text: err.Message,
                        button: {
                            text: "ĐÓNG",
                            value: true,
                            visible: true,
                            className: "btn btn-primary"
                        }
                    });
                    return;
                },
                complete: function () {
                    $("#errDocument").text("");
                    $('#DocumentUpload')[0].reset(); // this will reset the form fields
                }
            });
        }

        function excelExport() {
            var listDataExcel = showJSpreadSheet[0].getData(false, false);
            var filterDataExcel = listDataExcel.filter(function (element) { return element[0] != ""; });
            var numberOfExcel = filterDataExcel.length;
            var listDataExport = [];
            for (var i = 0; i < numberOfExcel; i++) {
                var ItemExcel = filterDataExcel[i];
                var MessageError = "";
                if (ItemExcel[0] == "Lỗi" || ItemExcel[0] == "Không hợp lệ") {
                    MessageError = showJSpreadSheet[0].getComments('A' + Number(i + 1));
                }

                var WareHouseID = 0;
                var WareHouseCode = "";
                var FilterWareHouse = ListWareHouse.filter(function (element) { return element.id == ItemExcel[2]; });
                if (FilterWareHouse.length > 0) {
                    WareHouseID = FilterWareHouse[0].id;
                    WareHouseCode = FilterWareHouse[0].code;
                }

                var SKUCode = "";
                var ListProductVariantTemp = SearchListProductVariant(WareHouseID);
                var JSONListProductVariantTemp = ListProductVariantTemp.responseJSON;

                if (JSONListProductVariantTemp.length > 0) {
                    var FilterProductVariant = JSONListProductVariantTemp.filter(function (element) { return element.ProductVariantID == ItemExcel[3]; });
                    SKUCode = FilterProductVariant[0].ProductVariantSKU;
                }
                var obj = {
                    CustomerName: ItemExcel[1].trim(),
                    WareHouseCode: WareHouseCode,
                    SKUCode: SKUCode,
                    NumberOfOutput: parseInt(NumberReplace(ItemExcel[5])),
                    InventoryOutputCode: ItemExcel[6],
                    InventoryOutputDate: ItemExcel[7],
                    NumberOfDateInWareHouse: ItemExcel[8],
                    TermInWareHouse: ItemExcel[9],
                    PalletCode: ItemExcel[10],
                    MessageError: MessageError
                };

                listDataExport.push(obj);
            }

            if (listDataExport.length == 0) {
                CreateCustomSwal("error", "Không có dữ liệu để xuất Excel. Vui lòng kiểm tra lại.");
                return;
            };

            $.ajax({
                type: 'POST',
                url: '@Url.Action("JExportExcel", "InventoryOutput")',
                data: {
                    ListData: listDataExport
                },
                xhrFields: {
                    responseType: 'blob'
                },
                global: false,
                success: function (data) {
                    var link = document.createElement('a');
                    link.href = window.URL.createObjectURL(data);
                    link.download = 'DanhSachPhieuXuatKho.xlsx';
                    link.click();
                },
                error: function (xhr, status, error) {
                    let err = eval("(" + xhr.responseText + ")");
                    swal({
                        title: 'Lỗi',
                        text: err.Message,
                        button: {
                            text: "ĐÓNG",
                        }
                    });
                    return;
                }
            });
        }

        $("#Document").on('click', function () {
            var fileInput = document.getElementById('Document');
            fileInput.value = '';
        });

        $("#Document").on('change', function () {
            var TypeFile = ["XLS", "XLSX", "XLSM"];
            var ListExcel = new FormData(); //FormData object
            var FileInput = document.getElementById('Document');
            if (FileInput.files.length == 0) {
                return;
            }
            var Filename = FileInput.files[0].name;
            //var Filesize = FileInput.files[0].size;
            var Extension = Filename.split('.').pop().toUpperCase();
            var CheckExtension = TypeFile.includes(Extension);
            if (CheckExtension) {
                $("#errDocument").text("");
                for (var i = 0; i < FileInput.files.length; i++) {
                    ListExcel.append(FileInput.files[i].name, FileInput.files[i]);
                }

                $.ajax({
                    url: '@Url.Action("JImportExcelData", "InventoryOutput")',
                    dataType: "html",
                    type: "post",
                    data: ListExcel,
                    cache: false,
                    contentType: false,
                    processData: false,
                    success: function (data) {
                        var res = JSON.parse(data);
                        if (res.Code == "00") {
                            var responseData = JSON.parse(res.Data);
                            showJSpreadSheet[0].loadData([]);
                            /*showJSpreadSheet[0].setData(JSON.parse(res.Data));*/
                            showJSpreadSheet[0].loadData(JSON.parse(res.Data));
                            var nextRow = 0;
                            for (var i = 0; i < responseData.length; i++) {
                                nextRow = i + 1;
                                var skuID = 0;
                                var skuName = "";
                                var skuInventory = 0;
                                if (responseData[i][3] > 0) {
                                    skuID = responseData[i][3].toString();
                                    skuName = responseData[i][11].toString();
                                    showJSpreadSheet[0].setCells("D" + nextRow, { type: 'dropdown', title: 'Mã SKU', width: 200, align: 'left', source: [{ 'id': skuID, 'name': skuName }], filterOptions: FilterListProductVariant, multiple: false, wrap: true, autocomplete: true });
                                    showJSpreadSheet[0].setValue("D" + nextRow, skuID, true);
                                }

                                showJSpreadSheet[0].setReadOnly("E" + nextRow, false);
                                if (responseData[i][4] > 0) {
                                    skuInventory = parseInt(NumberReplace(responseData[i][4]));
                                }
                                showJSpreadSheet[0].setValue("E" + nextRow, skuInventory, true);
                                showJSpreadSheet[0].setReadOnly("E" + nextRow, true);
                            }

                            if (nextRow <= totalRow) {
                                var listBlank = showJSpreadSheet[0].getData(false, false);
                                var filterListBlank = listBlank.filter(function (element) { return element[0] == ""; });
                                for (var i = nextRow; i < filterListBlank.length; i++) {
                                    var numberRow = nextRow + 1;
                                    excelSetRowBlank(showJSpreadSheet[0], 0, numberRow);
                                    nextRow++;
                                }
                            }
                        } else {
                            CreateCustomSwal("error", res.Message);
                        }
                    },
                    error: function (xhr, textStatus, errorThrown) {
                        var err = eval("(" + xhr.responseText + ")");
                        swal({
                            text: err.Message,
                            button: {
                                text: "ĐÓNG",
                            }
                        });
                        return;
                    },
                });
            } else {
                $('#DocumentUpload')[0].reset();
                $("#errDocument").text("Hệ thống chỉ hỗ trợ tải tập tin Excel định dạng xls, xlsx hoặc xlsm.");
            }
        });

        $(document).ajaxStart(function () {
            $('#ajax_loader').show();
        });

        $(document).ajaxStop(function () {
            $('#ajax_loader').hide();
        });
    </script>
}

