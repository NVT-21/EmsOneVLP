@model EMS.MVC.Frontend.Models.AddProductToGroupViewModel
@Html.HiddenFor(model => model.ListProductID)
<div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Thay đổi nhóm sản phẩm</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal">
            </button>
        </div>
        <div class="modal-body">
            <div class="row">
                <div class="col-12">
                    <div class="mb-3">
                        <label class="mb-1">Nhóm sản phẩm <span class="text-danger">(*)</span></label>
                        @Html.DropDownListFor(model => model.ProductGroupID, new SelectList(Model.ListProductGroup, "ID", "CodeAndName"), "--- Chọn ---", new { @class = "select2" })
                        <span class="text-danger" id="errProductGroupID"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline-dark light" data-bs-dismiss="modal">Hủy bỏ</button>
            <button type="button" class="btn btn-primary" id="AddProductToGroup">Xác nhận</button>
        </div>
    </div>
</div>
<script>
    CheckChangeValue("ProductGroupID", "Vui lòng chọn nhóm sản phẩm", "", "Y");

    $(document).ready(function () {
        $('select.select2').select2(AttributeSelect2);
    });

    $('#AddProductToGroup').on('click', function () {
        var isError = false;
        var data = {
            ListProductID: $("#ListProductID").val(),
            ProductGroupID: $('#ProductGroupID').val()
        };

        isError = CheckNullValue(data.ListProductID, "ProductGroupID", "Vui lòng chọn sản phẩm", isError);
        isError = CheckNullValue(data.ProductGroupID, "ProductGroupID", "Vui lòng chọn nhóm sản phẩm", isError);

        if (isError == true) {
            return;
        }

        $.ajax({
            type: 'POST',
            url: '@Url.Action("JAddProductToGroup", "Product")',
            data: {
                ListProductID: data.ListProductID,
                ProductGroupID: data.ProductGroupID
            },
            dataType: 'json',
            success: function (res) {
                if (res.Code == "00") {
                    CreateCustomSwal("success", res.Message);
                } else {
                    CreateCustomSwal("error", res.Message);
                }
            }
        });
    });
</script>