                </button>
            </div>
            @if (Model.Count() > 0)
            {
                <div class="modal-body">
                    <div class="row Frames">
                        <div class="list-form-img">
                            @foreach (var item in Model)
                            {
                                <div class="col-md-3 col-lg-3 p-1">
                                    <div class="img-item border rounded AspectRatio_1-1" name="VariantImage" onclick="FuncActive(this)" style="cursor:pointer;">
                                        <img name="ImageOld" data-value="@item.Image" src="@XHelper.pathImages@item.Image">
                                        <i class="close del" data-value="@item.Image">
                                            <svg width="30" height="30" viewBox="0 0 30 30" fill="none"
