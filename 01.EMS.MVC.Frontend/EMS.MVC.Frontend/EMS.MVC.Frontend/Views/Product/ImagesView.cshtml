@model IEnumerable<EMS.MVC.Frontend.Models.ProductImageViewModel>
@{
    Layout = null;
    string strPage = ViewBag.Page;
}
<style>
    .active-custom {
        border: 1px solid blue !important;
        box-shadow: 0 0 5px blue;
    }
</style>
@if (strPage == "Variant")
{
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cập nhật ảnh biến thể</h5>
