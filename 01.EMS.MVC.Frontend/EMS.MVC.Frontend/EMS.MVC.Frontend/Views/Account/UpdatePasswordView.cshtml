@model EMS.MVC.Frontend.Models.UpdatePasswordViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="keywords" content="" />
    <meta name="author" content="" />
    <meta name="robots" content="" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="format-detection" content="telephone=no">
    <title>EMSOne</title>
    <link rel="shortcut icon" type="image/png" href="~/favicon.png" />
    @Styles.Render("~/bundles/css")
    <script src="~/Assets/js/global.min.js"></script>
    <script src="~/Assets/js/MyJS.js?n=@XHelper.JavaScriptVersion"></script>
</head>
<body>
    <!-- AJAX LOADER -->
    <div id="preloader">
        <img src="~/Assets/images/logo/logo-full.svg" />
    </div>
    <div class="authincation h-100">
        <div class="container h-100 pt-5">
            <div class="row justify-content-center h-100 align-items-center mt-5">
                <div class="col-md-5">
                    <div class="authincation-content">
                        <div class="row ">
                            <div class="col-xl-12">
                                <div class="auth-form">
                                    <div class="text-center mb-5">
                                        <a target="_blank" href="https://ems.com.vn/"><img src="~/Assets/images/logo/logo-full.svg" /></a>
                                    </div>
                                    <div class="mb-3">
                                        <label class="mb-1">Mật khẩu</label>
                                        <div class="form-pass">
                                            @Html.EditorFor(m => m.NewPassword, new { htmlAttributes = new { @type = "password", @class = "form-control", @placeholder = "Mật khẩu mới", @maxlength = "20" } })
                                            <span class="input-group-eye show-pass" id="ShowNewPassword">
                                                <i class="icon-eye-slash"></i>
                                                <i class="icon-eye"></i>
                                            </span>
                                            <span class="text-danger" id="errNewPassword"></span>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="mb-1">Xác nhận mật khẩu</label>
                                        <div class="form-pass">
                                            @Html.EditorFor(m => m.ConfirmPassword, new { htmlAttributes = new { @type = "password", @class = "form-control", @placeholder = "Xác nhận mật khẩu", @maxlength = "20" } })
                                            <span class="input-group-eye show-pass" id="ShowConfirmPassword">
                                                <i class="icon-eye-slash"></i>
                                                <i class="icon-eye"></i>
                                            </span>
                                            <span class="text-danger" id="errConfirmPassword"></span>
                                        </div>
                                    </div>
                                    <div class="text-center">
                                        <button type="button" class="btn btn-primary btn-block" id="btnSubmit">Xác nhận</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @Scripts.Render("~/bundles/js")
    <script>
        $("#ShowNewPassword").on("click", function () {
            $(this).toggleClass("active");
            var TypeInput = document.getElementById("NewPassword").type;
            if (TypeInput == "password") {
                $("#NewPassword").attr("type", "text");
            } else {
                $("#NewPassword").attr("type", "password");
            }
        });

        $("#ShowConfirmPassword").on("click", function () {
            $(this).toggleClass("active");
            var TypeInput = document.getElementById("ConfirmPassword").type;
            if (TypeInput == "password") {
                $("#ConfirmPassword").attr("type", "text");
            } else {
                $("#ConfirmPassword").attr("type", "password");
            }
        });

        CheckChangeValue("NewPassword", "Vui lòng nhập Mật khẩu", "Password", "Y");
        CheckChangeValue("ConfirmPassword", "Vui lòng Xác nhận mật khẩu", "Password", "Y");

        $("#btnSubmit").on("click", function () {
            var isError = false;
            var errMessagePassword = "Mật khẩu phải có độ dài từ 6 đến 20 ký tự, bao gồm ký tự thường, ký tự in hoa, số và ký tự đặc biệt !#@@$%^&";
            var data = {
                ID: @Model.ID,
                MobileNumber: '@Model.MobileNumber',
                Password: '@EMS.Library.Security.EncodeBase64(Model.Password)',
                NewPassword: $('#NewPassword').val().trim(),
                ConfirmPassword: $('#ConfirmPassword').val().trim()
            }

            isError = CheckNullAndRegexValue(data.NewPassword, "Password", "NewPassword", "Vui lòng nhập Mật khẩu", errMessagePassword, isError);
            isError = CheckNullAndRegexValue(data.ConfirmPassword, "Password", "ConfirmPassword", "Vui lòng nhập Xác nhận mật khẩu", errMessagePassword, isError);

            if (isError == false) {
                if (data.NewPassword != data.ConfirmPassword) {
                    $("#errConfirmPassword").text("Xác nhận mật khẩu không trùng khớp.");
                    $("#ConfirmPassword").focus();
                    isError = true;
                }
            }

            if (isError == true) {
                return;
            }

            swal({
                title: 'Thông báo',
                text: "Bạn chắc chắn muốn đặt mật khẩu này?",
                icon: 'warning',
                buttons: {
                    confirm: {
                        text: "Xác nhận",
                        value: true,
                        visible: true,
                        className: "btn btn-primary",
                        closeModal: true
                    },
                    cancel: {
                        text: "Đóng",
                        value: false,
                        visible: true,
                        className: "btn btn-danger",
                        closeModal: true,
                    }
                },
            }).then((value) => {
                if (value) {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("JUpdatePassword", "Account")',
                        data: data,
                        dataType: 'json',
                        success: function (res) {
                            if (res.Code == "00") {
                                CreateCustomSwal("success", res.Message, '@Url.Action("LoginView", "Account")');
                            } else if (res.Code == "02") {
                                CreateCustomSwal("success", "Mật khẩu của bạn đã được thay đổi trước đó. Quay về trang đăng nhập.", '@Url.Action("LoginView", "Account")');
                            } else {
                                CreateCustomSwal("error", res.Message);
                            }
                        },
                        error: function (xhr, status, error) {
                            var err = eval("(" + xhr.responseText + ")");
                            swal({
                                title: 'Lỗi',
                                text: err.Message,
                                icon: 'error',
                                button: {
                                    text: "ĐÓNG",
                                    value: true,
                                    visible: true,
                                    className: "btn btn-primary"
                                }
                            });
                            return;
                        }
                    });
                }
            });
        });
    </script>
</body>
</html>
