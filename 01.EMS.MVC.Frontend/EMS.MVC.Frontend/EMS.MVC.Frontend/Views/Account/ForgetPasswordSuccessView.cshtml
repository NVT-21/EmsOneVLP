@model EMS.MVC.Frontend.Models.ForgetPasswordSuccessViewModel

<button class="btn btn-back btn-lg ps-0" onclick="window.location.href= '@Url.Action("LoginView","Account")'">
    <i class="fa fa-lg fa-angle-left" style="color: #4E5969;"></i> <span style="color: #4E5969;">Quay lại Đăng nhập</span>
</button>
<div class="text-center">
    <svg width="72" height="72" viewBox="0 0 72 72" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect width="72" height="72" rx="36" fill="#0054A6" />
        <path d="M24.3335 37.6667L31.0002 44.3334L47.6668 27.6667" stroke="white" stroke-width="3"
              stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <p class="mt-3 mb-3">
        Chúng tôi đã gửi mã xác thực tới email <span class="text-blue">@Model.Email</span>.
        <br />
        Vui lòng kiểm tra email và nhập mã xác thực.
    </p>
    <div class="mb-3">
        @Html.EditorFor(model => model.OtpCode, new { htmlAttributes = new { @type = "text", @class = "text-center form-control rounded", @placeholder = "Mã xác thực", @maxlength = "6", @style = "font-size:20px;" } })
        <span class="text-danger" id="errOtpCode"></span>
    </div>
    <div class="mb-3">
        <span id="isValidCountDown">Mã có hiệu lực trong vòng <span class="font-w600" id="validCountDown">10</span> phút. </span>
        <br />
        Nếu bạn chưa nhận được mã xác thực, <span id="isValidSendMail">Gửi lại (<span class="font-w600" id="resendCountDown">60</span> giây)</span>
    </div>
    <div class="mb-3">
        <div id="turnstileWidgetOtp"></div>
        <span class="text-danger" id="errCaptcha"></span>
    </div>
    <div class="text-center">
        <button class="btn btn-primary btn-block" id="btnSendOtpCode">Xác nhận</button>
    </div>
</div>

<script>
    captchaToken = "";
    turnstileWidgetId = null;

    function renderOtpCaptcha() {
        var siteKey = "@CaptchaHelper.SiteKey";
        if (!siteKey || !window.turnstile) {
            return;
        }
        turnstileWidgetId = turnstile.render("#turnstileWidgetOtp", {
            sitekey: siteKey,
            callback: onForgetPasswordCaptcha,
            "expired-callback": onForgetPasswordCaptchaExpired,
            "error-callback": onForgetPasswordCaptchaExpired
        });
    }

    renderOtpCaptcha();

    CheckChangeValue("OtpCode", "Vui lòng nhập mã xác thực", "UserName", "Y");

    startTimer("validCounter");
    startTimer("resendCounter");

    var validCounter, resendCounter, validCount, resendCount;

    function startTimer(Type) {
        if (Type == "validCounter") {
            validCount = 600;
            validCounter = setInterval(validCountDown, 1000);
        } else if (Type == "resendCounter") {
            resendCount = 60;
            resendCounter = setInterval(resendCountDown, 1000);
        }
    }

    function stopTimer(Type) {
        if (Type == "validCounter") {
            validCount = 600;
            clearInterval(validCounter);
        } else if (Type == "resendCounter") {
            resendCount = 60;
            clearInterval(resendCounter);
        }
    }

    function validCountDown() {
        validCount = validCount - 1;
        var minutes = Math.floor(validCount / 60);
        var seconds = validCount % 60;
        if (minutes < 10) minutes = '0' + minutes;
        if (seconds < 10) seconds = '0' + seconds;
        $("#validCountDown").text(minutes + ':' + seconds);
        if (minutes == 0 && seconds == 0) {
            $("#isValidCountDown").text("Mã đã hết thời gian sử dụng.");
            stopTimer("validCounter");
        }
    }

    function resendCountDown() {
        resendCount = resendCount - 1;
        $("#resendCountDown").text(resendCount);
        if (resendCount <= 0) {
            $("#isValidSendMail").html("").append('bấm vào đây <a href="#" onclick="ResendEmail()">Gửi lại email</a>');
            stopTimer("resendCounter");
        }
    }

    var otpID = @Model.OtpID;
    $("#btnSendOtpCode").on("click", function () {
        var isError = false;
        var data = {
            OtpID: otpID,
            OtpCode: $("#OtpCode").val().trim(),
            captchaToken: captchaToken
        }

        isError = CheckNullAndRegexValue(data.OtpCode, "UserName", "OtpCode", "Vui lòng nhập mã xác thực.", "Mã xác thực không hợp lệ.", isError);
        if (isError == false) {
            if (data.OtpCode.length != 6) {
                $("#errOtpCode").text("Mã xác thực gồm 6 ký tự.");
                $("#OtpCode").focus();
                isError = true;
            }
        }

        if (!captchaToken) {
            $("#errCaptcha").text("Vui lòng xác nhận captcha.");
            isError = true;
        }

        if (isError == true) {
            return;
        }

        $.ajax({
            type: 'POST',
            url: '@Url.Action("JVerifyOtp", "Account")',
            dataType: 'json',
            loading: true,
            data: data,
            beforeSend: function () {
                $("#btnSendOtpCode").attr("disabled", true).append("<i class= 'fa fa-spinner fa-spin ms-1' id='iLoading'></i>");
            },
            success: function (res) {
                if (res.Code == "00") {
                    var responseData = JSON.parse(res.Data);
                    $.get('@Url.Action("UpdateForgetPasswordView", "Account")', responseData, function (data) {
                        $("#showData").html(data)
                        console.log(data);
                    });
                } else {
                    resetForgetPasswordCaptcha();
                    CreateCustomSwal("error", res.Message);
                }
            },
            complete: function () {
                $("#btnSendOtpCode").attr("disabled", false).find("i#iLoading").remove();
            },
            error: function (xhr, status, error) {
                resetForgetPasswordCaptcha();
                var err = eval("(" + xhr.responseText + ")");
                swal({
                    text: err.Message,
                    button: {
                        text: "ĐÓNG",
                    }
                });
                return;
            }
        });

    });

    function ResendEmail() {
        var isError = false;
        var data = {
            Email: '@Model.Email',
            captchaToken: captchaToken
        }

        isError = CheckNullAndRegexValue(data.Email, "Email", "Email", "Vui lòng nhập địa chỉ Email.", "Email không hợp lệ.", isError);

        if (!captchaToken) {
            $("#errCaptcha").text("Vui lòng xác nhận captcha.");
            isError = true;
        }

        if (isError == true) {
            return;
        }

        $.ajax({
            type: 'POST',
            url: '@Url.Action("JForgetPassword", "Account")',
            dataType: 'json',
            loading: true,
            data: data,
            beforeSend: function () {
                stopTimer("validCounter");
                stopTimer("resendCounter");
            },
            success: function (res) {
                resetForgetPasswordCaptcha();
                if (res.Code == "00") {
                    otpID = parseInt(res.Data);
                    CreateCustomSwal("error", res.Message);
                } else {
                    CreateCustomSwal("error", res.Message);
                }
            },
            complete: function () {
                $("#isValidSendMail").html("").append('Gửi lại (<span class="font-w600" id="resendCountDown">60</span> giây)');
                $("#isValidCountDown").html("").append('Mã có hiệu lực trong vòng <span class="font-w600" id="validCountDown">10</span> phút. </span>');
                startTimer("validCounter");
                startTimer("resendCounter");
            },
            error: function (xhr, status, error) {
                resetForgetPasswordCaptcha();
                var err = eval("(" + xhr.responseText + ")");
                swal({
                    text: err.Message,
                    button: {
                        text: "ĐÓNG",
                    }
                });
                return;
            }
        });
    }
</script>