@model EMS.MVC.Frontend.Models.UpdateForgetPasswordViewModel

<h3 class="text-center">Đặt lại mật khẩu</h3>
<div class="mb-2">
    <div class="form-pass">
        @Html.EditorFor(model => model.NewPassword, new { htmlAttributes = new { @type = "password", @class = "form-control", @placeholder = "Mật khẩu mới", @maxlength="20" } })
        <span class="input-group-eye show-pass" id="ShowNewPassword">
            <i class="icon-eye-slash"></i>
            <i class="icon-eye"></i>
        </span>
        <span class="text-danger" id="errNewPassword"></span>
    </div>
</div>
<div class="mb-2">
    <div class="form-pass">
        @Html.EditorFor(model => model.ConfirmPassword, new { htmlAttributes = new { @type = "password", @class = "form-control", @placeholder = "Nhập lại mật khẩu mới", @maxlength = "20" } })
        <span class="input-group-eye show-pass" id="ShowConfirmPassword">
            <i class="icon-eye-slash"></i>
            <i class="icon-eye"></i>
        </span>
        <span class="text-danger" id="errConfirmPassword"></span>
    </div>
</div>
<div class="text-center">
    <button class="btn btn-primary btn-block" id="btnChangePassword">Đặt lại mật khẩu</button>
</div>
<script>
    CheckChangeValue("NewPassword", "Vui lòng nhập Mật khẩu mới", "Password", "Y");
    CheckChangeValue("ConfirmPassword", "Vui lòng nhập lại Mật khẩu mới", "Password", "Y");

    $("#ShowNewPassword").on("click", function () {
        $(this).toggleClass("active");
        var TypeInput = document.getElementById("NewPassword").type;
        if (TypeInput == "password") {
            $("#NewPassword").attr("type", "text");
        } else {
            $("#NewPassword").attr("type", "password");
        }
    });

    $("#ShowConfirmPassword").on("click", function () {
        $(this).toggleClass("active");
        var TypeInput = document.getElementById("ConfirmPassword").type;
        if (TypeInput == "password") {
            $("#ConfirmPassword").attr("type", "text");
        } else {
            $("#ConfirmPassword").attr("type", "password");
        }
    });

    $("#btnChangePassword").on("click", function (){
        var isError = false;
        var errMessagePassword = "Mật khẩu phải có độ dài từ 6 đến 20 ký tự, bao gồm ký tự thường, ký tự in hoa, số và ký tự đặc biệt !#@@$%^&";
        var data = {
            EmployeeID: @Model.EmployeeID,
            MobileNumber: '@Model.MobileNumber',
            OtpCode: '@Model.OtpCode',
            NewPassword: $('#NewPassword').val().trim(),
            ConfirmPassword: $('#ConfirmPassword').val().trim()
        }
        console.log(data);
        isError = CheckNullAndRegexValue(data.NewPassword, "Password", "NewPassword", "Vui lòng nhập Mật khẩu mới", errMessagePassword, isError);
        isError = CheckNullAndRegexValue(data.ConfirmPassword, "Password", "ConfirmPassword", "Vui lòng nhập lại Mật khẩu mới", errMessagePassword, isError);

        if (isError == false) {
            if (data.NewPassword != data.ConfirmPassword) {
                $("#errConfirmPassword").text("Xác nhận mật khẩu mới không trùng khớp.");
                $("#ConfirmPassword").focus();
                isError = true;
            }
        }

        if (isError == true) {
            return;
        }

        $.ajax({
            type: 'POST',
            url: '@Url.Action("JUpdateForgetPassword", "Account")',
            dataType: 'json',
            loading: true,
            data: data,
            beforeSend: function () {
                $("#btnChangePassword").attr("disabled", true).append("<i class= 'fa fa-spinner fa-spin ms-1' id='iLoading'></i>");
            },
            success: function (res) {
                if (res.Code == "00") {
                    CreateCustomSwal("success", res.Message, '@Url.Action("LoginView","Account")');
                } else {
                    CreateCustomSwal("error", res.Message);
                }
            },
            complete: function () {
                $("#btnChangePassword").attr("disabled", false).find("i#iLoading").remove();
            },
            error: function (xhr, status, error) {
                var err = eval("(" + xhr.responseText + ")");
                swal({
                    text: err.Message,
                    button: {
                        text: "ĐÓNG",
                    }
                });
                return;
            }
        });
    });
</script>