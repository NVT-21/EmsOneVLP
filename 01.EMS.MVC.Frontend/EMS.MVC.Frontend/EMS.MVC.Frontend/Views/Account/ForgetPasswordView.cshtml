@model EMS.MVC.Frontend.Models.ForgetPasswordViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="keywords" content="" />
    <meta name="author" content="" />
    <meta name="robots" content="" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="format-detection" content="telephone=no">
    <title>EMSOne</title>
    <link rel="shortcut icon" type="image/png" href="~/favicon.png" />
    @Styles.Render("~/bundles/css")
    @Styles.Render("~/bundles/fonts")
    <script src="~/Assets/js/global.min.js"></script>
    <script src="~/Assets/js/MyJS.js?n=@XHelper.JavaScriptVersion"></script>
</head>

<body class="vh-100">
    <!-- MODAL -->
    <div id="ViewModal" class="modal fade" role="dialog">
        <div id="modal-ViewModal-html" style="position: fixed; width: 100%; height: 100%;"></div>
    </div>
    <div class="authincation h-100">
        <div class="container h-100">
            <div class="row justify-content-center h-100 align-items-center">
                <div class="col-md-6">
                    <div class="authincation-content">
                        <div class="row ">
                            <div class="col-xl-12">
                                <div class="auth-form">
                                    <div id="showData">
                                        <button class="btn btn-back btn-lg ps-0" onclick="window.location.href= '@Url.Action("LoginView","Account")'">
                                            <i class="fa fa-lg fa-angle-left" style="color: #4E5969;"></i> <span style="color: #4E5969;">Quay lại</span>
                                        </button>
                                        <h3>Quên mật khẩu</h3>
                                        <p>Vui lòng nhập email đã đăng ký tài khoản, chúng tôi sẽ gửi cho bạn hướng dẫn đặt lại mật khẩu.</p>
                                        <div class="mb-3">
                                            @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Vui lòng nhập email" } })
                                            <span class="text-danger" id="errEmail"></span>
                                        </div>
                                        <div class="mb-3">
                                            <div id="turnstileWidget"></div>
                                            <span class="text-danger" id="errCaptcha"></span>
                                        </div>
                                        <div class="text-center">
                                            <button class="btn btn-primary btn-block" id="btnSendMail">Gửi email</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @Scripts.Render("~/bundles/js")
    <script>
        var captchaToken = "";
        var turnstileWidgetId = null;

        function onForgetPasswordCaptcha(token) {
            captchaToken = token || "";
            $("#errCaptcha").text("");
        }

        function onForgetPasswordCaptchaExpired() {
            captchaToken = "";
        }

        function resetForgetPasswordCaptcha() {
            captchaToken = "";
            if (window.turnstile && turnstileWidgetId) {
                turnstile.reset(turnstileWidgetId);
            }
        }

        function renderForgetPasswordCaptcha() {
            var siteKey = "@CaptchaHelper.SiteKey";
            if (!siteKey || !window.turnstile) {
                return;
            }
            turnstileWidgetId = turnstile.render("#turnstileWidget", {
                sitekey: siteKey,
                callback: onForgetPasswordCaptcha,
                "expired-callback": onForgetPasswordCaptchaExpired,
                "error-callback": onForgetPasswordCaptchaExpired
            });
        }

        CheckChangeValue("Email", "Vui lòng nhập địa chỉ Email", "Email", "Y");

        $("#btnSendMail").on("click", function () {
            var isError = false;
            var data = {
                Email: $("#Email").val().trim(),
                captchaToken: captchaToken
            }

            isError = CheckNullAndRegexValue(data.Email, "Email", "Email", "Vui lòng nhập địa chỉ Email.", "Email không hợp lệ.", isError);

            if (!captchaToken) {
                $("#errCaptcha").text("Vui lòng xác nhận captcha.");
                isError = true;
            }

            if (isError == true) {
                return;
            }

            $.ajax({
                type: 'POST',
                url: '@Url.Action("JForgetPassword", "Account")',
                dataType: 'json',
                loading: true,
                data: data,
                beforeSend: function () {
                    $("#btnSendMail").attr("disabled", true).append("<i class= 'fa fa-spinner fa-spin ms-1' id='iLoading'></i>");
                },
                success: function (res) {
                    if (res.Code == "00") {
                        $.get('@Url.Action("ForgetPasswordSuccessView", "Account")', {
                            Email: data.Email,
                            OtpID: parseInt(res.Data)
                        }, function (html) {
                            $("#showData").html(html);
                        });
                    } else {
                        resetForgetPasswordCaptcha();
                        CreateCustomSwal("error", res.Message);
                    }
                },
                complete: function () {
                    $("#btnSendMail").attr("disabled", false).find("i#iLoading").remove();
                },
                error: function (xhr, status, error) {
                    resetForgetPasswordCaptcha();
                    var err = eval("(" + xhr.responseText + ")");
                    swal({
                        text: err.Message,
                        button: {
                            text: "ĐÓNG",
                        }
                    });
                    return;
                }
            });
        });
    </script>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=renderForgetPasswordCaptcha" async defer></script>
</body>
</html>
