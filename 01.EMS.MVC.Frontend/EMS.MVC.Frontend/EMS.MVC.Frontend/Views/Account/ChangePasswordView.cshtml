@model EMS.MVC.Frontend.Models.ChangePasswordViewModel
<div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Đổi mật khẩu</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal">
            </button>
        </div>
        <div class="modal-body">
            <div class="row">
                <div class="col-12">
                    <div class="mb-3">
                        <label class="mb-1">
                            Mật khẩu cũ
                        </label>
                        <div class="form-pass">
                            @Html.EditorFor(model => model.OldPassword, new { htmlAttributes = new { @type = "password", @class = "form-control", @placeholder = "Mật khẩu", @maxlength = "20" } })
                            <span class="input-group-eye show-pass" id="ShowOldPassword">
                                <i class="icon-eye-slash"></i>
                                <i class="icon-eye"></i>
                            </span>
                            <span class="text-danger" id="errOldPassword"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="mb-1">
                            Mật khẩu mới
                        </label>
                        <div class="form-pass">
                            @Html.EditorFor(model => model.NewPassword, new { htmlAttributes = new { @type = "password", @class = "form-control", @placeholder = "Mật khẩu", @maxlength = "20" } })
                            <span class="input-group-eye show-pass" id="ShowNewPassword">
                                <i class="icon-eye-slash"></i>
                                <i class="icon-eye"></i>
                            </span>
                            <span class="text-danger" id="errNewPassword"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="mb-1">
                            Xác nhận mật khẩu mới
                        </label>
                        <div class="form-pass">
                            @Html.EditorFor(model => model.ConfirmPassword, new { htmlAttributes = new { @type = "password", @class = "form-control", @placeholder = "Mật khẩu", @maxlength = "20" } })
                            <span class="input-group-eye show-pass" id="ShowConfirmPassword">
                                <i class="icon-eye-slash"></i>
                                <i class="icon-eye"></i>
                            </span>
                            <span class="text-danger" id="errConfirmPassword"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline-dark light" data-bs-dismiss="modal">Hủy bỏ</button>
            <button type="button" class="btn btn-primary" id="btnChangePassword">Xác nhận</button>
        </div>
    </div>
</div>
<script>
    CheckChangeValue("OldPassword", "Vui lòng nhập Mật khẩu cũ.", "Password", "Y");
    CheckChangeValue("NewPassword", "Vui lòng nhập Mật khẩu mới.", "Password", "Y");
    CheckChangeValue("ConfirmPassword", "Vui lòng Xác nhận mật khẩu mới.", "Password", "Y");

    $("#ShowOldPassword").on("click", function () {
        $(this).toggleClass("active");
        var TypeInput = document.getElementById("OldPassword").type;
        if (TypeInput == "password") {
            $("#OldPassword").attr("type", "text");
        } else {
            $("#OldPassword").attr("type", "password");
        }
    });

    $("#ShowNewPassword").on("click", function () {
        $(this).toggleClass("active");
        var TypeInput = document.getElementById("NewPassword").type;
        if (TypeInput == "password") {
            $("#NewPassword").attr("type", "text");
        } else {
            $("#NewPassword").attr("type", "password");
        }
    });

    $("#ShowConfirmPassword").on("click", function () {
        $(this).toggleClass("active");
        var TypeInput = document.getElementById("ConfirmPassword").type;
        if (TypeInput == "password") {
            $("#ConfirmPassword").attr("type", "text");
        } else {
            $("#ConfirmPassword").attr("type", "password");
        }
    });


    $("#btnChangePassword").on("click", function (event) {
        var errMessagePassword = "Mật khẩu phải có độ dài từ 6 đến 20 ký tự, bao gồm ký tự thường, ký tự in hoa, số và ký tự đặc biệt !#@@$%^&";
        var isError = false;
        var data = {
            OldPassword: $('#OldPassword').val().trim(),
            NewPassword: $('#NewPassword').val().trim(),
            ConfirmPassword: $('#ConfirmPassword').val().trim()
        }

        isError = CheckNullAndRegexValue(data.OldPassword, "Password", "OldPassword", "Vui lòng nhập Mật khẩu cũ.", errMessagePassword, isError);
        isError = CheckNullAndRegexValue(data.NewPassword, "Password", "NewPassword", "Vui lòng nhập Mật khẩu mới.", errMessagePassword, isError);
        isError = CheckNullAndRegexValue(data.ConfirmPassword, "Password", "ConfirmPassword", "Vui lòng Xác nhận mật khẩu mới.", errMessagePassword, isError);

        if (isError == false) {
            if (data.NewPassword != data.ConfirmPassword) {
                $("#errConfirmPassword").text("Xác nhận mật khẩu mới không trùng khớp.");
                $("#ConfirmPassword").focus();
                isError = true;
            }
        }
        
        if (isError == true) {
            return;
        }

        $.ajax({
            type: 'POST',
            url: '@Url.Action("JChangePassword", "Account")',
            dataType: 'json',
            loading: true,
            data: data,
            beforeSend: function () {
                $("#btnChangePassword").attr("disabled",true).append("<i class= 'fa fa-spinner fa-spin ms-1' id='iLoading'></i>");
            },
            success: function (res) {
                if (res.Code == "00") {
                    CreateCustomSwal("success", res.Message);
                } else {
                    CreateCustomSwal("error", res.Message);
                }
            },
            complete: function () {
                $("#btnChangePassword").attr("disabled", false).find("i#iLoading").remove();
            },
            error: function (xhr, status, error) {
                var err = eval("(" + xhr.responseText + ")");
                swal({
                    text: err.Message,
                    button: {
                        text: "ĐÓNG",
                    }
                });
                return;
            }
        });
    });
</script>
