@model List<EMS.MVC.Frontend.Models.SearchListCustomerGroupModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    List<object> oListCustomerInGroupExport = new List<object>();
}

<div class="container-fluid">
    <div class="card">
        <div class="card-body">
            <form>
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-3">
                            <div class="form-search">
                                <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M18.9842 17.6825L15.8675 14.575C16.8731 13.2939 17.4187 11.7119 17.4167 10.0833C17.4167 8.63294 16.9866 7.21512 16.1808 6.00916C15.375 4.80319 14.2297 3.86326 12.8897 3.30822C11.5497 2.75318 10.0752 2.60795 8.65268 2.89091C7.23015 3.17387 5.92347 3.8723 4.89789 4.89789C3.8723 5.92347 3.17387 7.23015 2.89091 8.65268C2.60795 10.0752 2.75318 11.5497 3.30822 12.8897C3.86326 14.2297 4.80319 15.375 6.00916 16.1808C7.21512 16.9866 8.63294 17.4167 10.0833 17.4167C11.7119 17.4187 13.2939 16.8731 14.575 15.8675L17.6825 18.9842C17.7677 19.0701 17.8691 19.1383 17.9808 19.1848C18.0925 19.2314 18.2123 19.2553 18.3333 19.2553C18.4543 19.2553 18.5742 19.2314 18.6859 19.1848C18.7976 19.1383 18.899 19.0701 18.9842 18.9842C19.0701 18.899 19.1383 18.7976 19.1848 18.6859C19.2314 18.5742 19.2553 18.4543 19.2553 18.3333C19.2553 18.2123 19.2314 18.0925 19.1848 17.9808C19.1383 17.8691 19.0701 17.7677 18.9842 17.6825V17.6825ZM4.58334 10.0833C4.58334 8.99554 4.90591 7.93217 5.51025 7.0277C6.1146 6.12323 6.97358 5.41828 7.97858 5.002C8.98357 4.58572 10.0894 4.4768 11.1563 4.68902C12.2232 4.90124 13.2032 5.42506 13.9724 6.19425C14.7416 6.96344 15.2654 7.94345 15.4777 9.01034C15.6899 10.0772 15.581 11.1831 15.1647 12.1881C14.7484 13.1931 14.0434 14.0521 13.139 14.6564C12.2345 15.2608 11.1711 15.5833 10.0833 15.5833C8.62465 15.5833 7.2257 15.0039 6.19425 13.9724C5.1628 12.941 4.58334 11.542 4.58334 10.0833Z"
                                          fill="#86909C" />
                                </svg>
                                @Html.Editor("SearchKey", new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Tìm theo mã KH, tên KH, số điện thoại" } })
                            </div>
                        </div>
                    </div>

                    <div class="col-md-8 d-flex align-items-end justify-content-end">
                        <div class="dropdown ">
                            <button class="btn btn-upload " type="button" id="order-dropdown-1"
                                    data-bs-toggle="dropdown" data-boundary="viewport" aria-haspopup="true" aria-expanded="false">
                                <i class="icon-down fs-18"></i>
                                Xuất file
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end border py-0 " aria-labelledby="order-dropdown-1">
                                <li class="py-2">                                    
                                    <div class="dropdown-item">
                                        <label class="text-2" for="TableExcelWithoutDetailAddress">File excel - Mẫu chỉ có địa chỉ</label>
                                        <table id="TableExcelWithoutDetailAddress" style="display: none;"></table>
                                    </div>                                    
                                </li>
                                <li class="py-2">
                                    <div class="dropdown-item">
                                        <label class="text-2" for="TableExcelWithDetailAddress">File excel - mẫu có địa chỉ, tỉnh/thành, quận/huyện</label>
                                        <table id="TableExcelWithDetailAddress" style="display: none;"></table>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div class="card">
        <div class="card-body ">
            <div id="tbl-data" class="table-primary">
                <table id="ListDataTableSearch" class="table table-responsive-md">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Mã khách hàng</th>
                            <th>Thông tin khách hàng</th>
                            <th>Số đơn hàng thành công</th>
                            <th>Số tiền mua hàng thành công</th>
                            <th>Nhóm khách hàng</th>
                            <th class="text-center">Danh sách đen</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(Model.Count > 0)
                        {
                            for(int i = 0; i < Model.Count; i++)
                            {
                                var item = Model[i];
                                object oITem = new
                                {
                                    STT = item.Index,
                                    CustomerCode = item.CustomerCode,
                                    FullName = item.FullName,
                                    MobileNumber = item.MobileNumber,
                                    DistrictName = item.DistrictName,
                                    ProvinceName = item.ProvinceName,
                                    Address = item.Address,
                                    CountOrderSuccess = item.CountOrderSuccess,
                                    TotalAmountSuccess = item.TotalAmountSuccess,
                                    Sticker = item.Sticker,
                                    BlackList = item.BlackList == "Y"? "Có" : "Không"
                                };
                                oListCustomerInGroupExport.Add(oITem);
                                <tr>
                                    <td>@item.Index</td>
                                    <td><a onclick="btnDetail(@item.ID)" style="cursor: pointer; color: #007bff;">@item.CustomerCode</a></td>
                                    <td>
                                        <span style="line-height: 1.4rem;"><i class="fa fa-user mr-1" aria-hidden="true"></i>   @item.FullName</span>
                                        <br />
                                        <span style="line-height: 1.4rem;"><i class="fa fa-phone mr-1" aria-hidden="true"></i>   @item.MobileNumber</span>
                                        <br />
                                        <span style="line-height: 1.4rem;"><i class="fa fa-home mr-1" aria-hidden="true"></i>   @item.Address</span>
                                    </td>
                                    <td>@item.CountOrderSuccess</td>
                                    <td>@item.TotalAmountSuccess.ToString("N0")</td>
                                    <td>
                                        @{ 
                                            if (item.Sticker != "")
                                            {
                                                var splitSticker = item.Sticker.Split(',');
                                                for (var l = 0; l < splitSticker.Length; l++)
                                                {
                                                    <div>@splitSticker[l]</div>
                                                }
                                            }

                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="form-check form-check-inline form-check-td">
                                            @if (item.BlackList == "Y")
                                            {
                                                <input class="form-check-input" id="rd1" type="radio" onclick="checkBlacklist(@item.ID, '@item.FullName', 'checked')" title="Khách hàng nằm trong danh sách đen" data-toggle="tooltip" checked>
                                                <label class="form-check-label" for="rd1"></label>
                                            }
                                            else
                                            {
                                                <input class="form-check-input" id="rd1" type="radio" onclick="checkBlacklist(@item.ID, '@item.FullName', 'unchecked')" title="Khách hàng không nằm trong danh sách đen" data-toggle="tooltip" >
                                                <label class="form-check-label" for="rd1"></label>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }                 
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        var oList = @Html.Raw(Json.Encode(oListCustomerInGroupExport));

    $('#TableExcelWithDetailAddress').dataTable({
        "data": oList,
        "columns": [
            {
                title: "STT",
                data: "STT"
            },
            {
                title: "Mã khách hàng",
                data: "CustomerCode"
            },
            {
                title: "Họ và Tên",
                data: "FullName"
            },
            {
                title: "Số điện thoại",
                data:"MobileNumber"
            },
            {
                title: "Số nhà/tên đường",
                data: "Address"
            },
            {
                title: "Quận/Huyện",
                data: "DistrictName"
            },
            {
                title: "Tỉnh/Thành phố",
                data: "ProvinceName"
            },
            {
                title: "Số đơn hàng thành công",
                data: "CountOrderSuccess"
            },
            {
                title: "Số tiền mua hàng thành công",
                data: "TotalAmountSuccess"
            },
            {
                title: "Gán nhãn",
                data: "Sticker"
            },
            {
                title: "Danh sách đen",
                data: "BlackList"
            }
        ],
        "searching": false,
        "paging": false,
        "info": false,
        "dom": 'Bfrtip',
        "button": [
            {
                extend: 'excelHtml5',
                title: "Danh sách khách hàng thuộc nhóm " + "@Html.Raw(ViewBag.GroupName.ToUpper())",
                text: "EXPORT EXCEL",
                //text: '<i class="fa fa-file-excel-o"></i>',
                //titleAttr: 'Excel',
                className: 'btn btn-sm btn-primary',
                filename: 'DANH_SACH_KHACH_HANG',
                //sheetName: 'DanhSach',
                //exportOptions: {
                //    columns: [0, 1, 3, 4, 5, 6, 7, 8, 9]
                //},
                createEmptyCells: true,
                customize: function (xlsx) {
                    var sheet = xlsx.xl.worksheets['sheet1.xml'];
                    //22: tô đậm chữ
                    //25: border
                    $('row c[r*="2"]', sheet).attr('s', '25');
                    $('row c[r*="3"]', sheet).attr('s', '25');
                    $('row c[r*="4"]', sheet).attr('s', '25');
                    $('row c[r*="5"]', sheet).attr('s', '25');
                    $('row c[r*="6"]', sheet).attr('s', '25');
                    $('row c[r*="7"]', sheet).attr('s', '25');
                    $('row c[r*="8"]', sheet).attr('s', '25');
                    $('row c[r*="9"]', sheet).attr('s', '25');
                    $('row c[r*="10"]', sheet).attr('s', '25');
                    $('row c[r*="11"]', sheet).attr('s', '25');
                }
            }
        ]
    })

        $('#TableExcelWithoutDetailAddress').dataTable({
        "data": oList,
        "columns": [
            {
                title: "STT",
                data: "STT"
            },
            {
                title: "Mã khách hàng",
                data: "CustomerCode"
            },
            {
                title: "Họ và Tên",
                data: "FullName"
            },
            {
                title: "Số điện thoại",
                data:"MobileNumber"
            },
            {
                title: "Địa chỉ",
                data: "Address"
            },
            {
                title: "Số đơn hàng thành công",
                data: "CountOrderSuccess"
            },
            {
                title: "Số tiền mua hàng thành công",
                data: "TotalAmountSuccess"
            },
            {
                title: "Gán nhãn",
                data: "Sticker"
            },
            {
                title: "Danh sách đen",
                data: "BlackList"
            }
        ],
        "searching": false,
        "paging": false,
        "info": false,
        "dom": 'Bfrtip',
        "button": [
            {
                extend: 'excelHtml5',
                title: "Danh sách khách hàng thuộc nhóm " + "@Html.Raw(ViewBag.GroupName.ToUpper())",
                text: "EXPORT EXCEL",
                //text: '<i class="fa fa-file-excel-o"></i>',
                //titleAttr: 'Excel',
                className: 'btn btn-sm btn-primary',
                filename: 'DANH_SACH_KHACH_HANG',
                //sheetName: 'DanhSach',
                //exportOptions: {
                //    columns: [0, 1, 3, 4, 5, 6, 7, 8, 9]
                //},
                createEmptyCells: true,
                customize: function (xlsx) {
                    var sheet = xlsx.xl.worksheets['sheet1.xml'];
                    //22: tô đậm chữ
                    //25: border
                    $('row c[r*="2"]', sheet).attr('s', '25');
                    $('row c[r*="3"]', sheet).attr('s', '25');
                    $('row c[r*="4"]', sheet).attr('s', '25');
                    $('row c[r*="5"]', sheet).attr('s', '25');
                    $('row c[r*="6"]', sheet).attr('s', '25');
                    $('row c[r*="7"]', sheet).attr('s', '25');
                    $('row c[r*="8"]', sheet).attr('s', '25');
                    $('row c[r*="9"]', sheet).attr('s', '25');
                    $('row c[r*="10"]', sheet).attr('s', '25');
                    $('row c[r*="11"]', sheet).attr('s', '25');
                }
            }
        ]
    })
    });

    $("#SearchKey").on("change", function () {
        btnSearch();
    });
    function btnSearch() {
        var req = {
            SearchKey : $("#SearchKey").val().trim()
        };
        $.port('@Url.Action("SearchListCustomerView", "Customer")', req, function (data) {
            $("#tbl-data").html(data);
        });
    };

    function checkBlacklist(ID, FullName, IsChecked) {
        var text = "";
        var checked = "";
        if (IsChecked == "checked") {
            text = "Bạn có muốn xoá" + FullName + "khỏi danh sách đen?";
            checked = "N";
        }
        else {
            text = "Bạn có muốn thêm" + FullName + "vào danh sách đen?";
            checked = "Y";
        }
        swal({
            title: 'Thông báo',
            text: text,
            buttons: {
                confirm: {
                    text: "CÓ",
                    value: true,
                    visible: true,
                    className: "btn btn-primary",
                    closeModal: true
                },
                cancel: {
                    text: "KHÔNG",
                    value: false,
                    visible: true,
                    className: "btn btn-danger",
                    closeModal: true
                }
            },
        }).then((value) => {
            if (value) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("JBlackList", "Customer")',
                    dataType: 'json',
                    loading: true,
                    data: {
                        ID: ID,
                        BlackList: checked
                    },
                    success: function (res) {
                        if (res.Code == "00") {
                            swal({
                                title: "Thông báo",
                                text: res.Message,
                                button: false,
                                timer: 1500
                            }).then(function () {
                                window.location.reload();
                            });
                        } else {
                            swal({
                                title: "Thông báo",
                                text: res.Message,
                                button: {
                                    text: "ĐÓNG"
                                }
                            });
                        }
                    }
                });
            }
            else if (value == false) {
                window.location.reload();
            }
        });
    };

    function btnDetail(CustomerID) {
        window.location.href = '@Url.Action("DetailCustomerGroupView", "CustomerGroup")?ID=' + CustomerID;
    }
</script>


