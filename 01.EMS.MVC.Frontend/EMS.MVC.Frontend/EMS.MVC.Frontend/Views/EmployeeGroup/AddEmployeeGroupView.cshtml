@model EMS.MVC.Frontend.Models.AddEmployeeGroupViewModel
<div class="modal-dialog modal-medium modal-dialog-centered" role="document">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Thêm mới nhóm nhân viên</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal">
            </button>
        </div>
        <div class="modal-body" id="ClearModal">
            <div class="row">
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Mã nhóm nhân viên<span class="text-danger">*</span></label>
                        @Html.EditorFor(model => model.Code, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder= "Mã nhóm nhân viên" } })
                        <span class="text-danger" id="errCode"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Tên nhóm nhân viên<span class="text-danger">*</span></label>
                        @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Tên nhóm nhân viên" } })
                        <span class="text-danger" id="errName"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label">Trạng thái <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(model => model.IsLock, new SelectList(Model.ListIsLock, "Value", "Text"), new { @class = "select2" })
                        <span class="text-danger" id="errIsLock"></span>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="mb-3">
                        <label class="form-label">Mô tả</label>
                        @Html.TextAreaFor(model => model.Description, new { @class = "form-control", @placeholder = "Mô tả", @maxlength = "250", @rows = "4" })
                        <div class="text-end">
                            <span class="fs-12 font-w300 text-3"><span id="ShowLengthNote">0</span>/250</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-12">
                    <div class="mb-3">
                        <label class="form-label">Nhân viên <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(model => model.EmployeeID, new SelectList(Model.ListEmployee, "ID", "FullName"), "--- Chọn ---", new { @class = "selectpicker form-control form-control-sm", @data_live_search = "true", @data_actions_box = "true", @data_dropup_auto = "false", @data_size = "8", @data_selected_text_format = "count", @multiple = "true" })

                        @*<select multiple class="default-select form-control selectpicker" id="EmployeeID" data-live-search="true" data-selected-text-format="count" data-actions-box="true" data-size="5">
                                @if (ViewBag.ListEmployee.Count > 0)
                                {
                                    foreach (var item in ViewBag.ListEmployee)
                                    {
                                        <optgroup label="@item.EmployeeGroupPermissionName" data-icon="fa fa-users">
                                            @foreach (var itemEmployee in item.ListEmployee)
                                            {
                                                <option data-tokens="@item.EmployeeGroupPermissionName @itemEmployee.EmployeeName" data-subtext="@itemEmployee.EmployeeMobileNumber" value="@itemEmployee.EmployeeID">@itemEmployee.EmployeeName</option>
                                            }
                                        </optgroup>
                                    }
                                }
                            </select>*@
                        <span class="text-danger" id="errEmployeeID"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline-dark light" data-bs-dismiss="modal">Hủy bỏ</button>
            <button type="button" class="btn btn-primary" onclick="AddEmployeeGroup()">Thêm mới</button>
        </div>
    </div>
</div>

<script type="text/javascript">
    CheckChangeValue("Code", "Mã nhóm không được để trống", "Code", "Y");
    CheckChangeValue("Name", "Tên nhóm nhân viên không được để trống", "Vietnamese", "Y");
    CheckChangeValue("IsLock", "Vui lòng chọn trạng thái", "", "Y");
    CheckChangeValue("EmployeeID", "Vui lòng chọn nhân viên", "", "Y");

    ShowInputLength("Description", "ShowLengthNote", 250);

    $(document).ready(function () {
        $('#EmployeeID').selectpicker('refresh');
    })

    $('select.select2').select2(AttributeSelect2);

    function AddEmployeeGroup() {
        var isError = false;
        var msgIsValid = "Giá trị hợp lệ không bao gồm ký tự đặc biệt.";
        var data = {
            Code: $("#Code").val().trim(),
            Name: $("#Name").val().trim(),
            Description: $("#Description").val().trim(),
            IsLock: $("#IsLock").val(),
            EmployeeID: $("#EmployeeID").val().join(","),
        };

        isError = CheckNullAndRegexValue(data.Code, "Code", "Code", "Mã nhóm không được để trống", msgIsValid, isError);
        isError = CheckNullAndRegexValue(data.Name, "Vietnamese", "Name", "Tên nhóm nhân viên không được để trống", msgIsValid, isError);
        isError = CheckNullValue(data.EmployeeID, "EmployeeID", "Vui lòng chọn nhân viên.", isError);

        if (isError == true) {
            return;
        };

        $.ajax({
            type: 'POST',
            url: '@Url.Action("JAddEmployeeGroup", "EmployeeGroup")',
            data: data,
            dataType: 'json',
            success: function (res) {
                if (res.Code == "00") {
                    swal({
                        title: "Thông báo",
                        text: res.Message,
                        html: true,
                        button: false,
                        timer: 1500
                    }).then(function () {
                        LoadEmployeeGroupListData();
                        $('#ViewModal').modal('hide');
                    });
                } else {
                    swal({
                        title: "Thông báo",
                        text: res.Message,
                        button: {
                            text: "ĐÓNG"
                        }
                    });
                }
            },
            error: function (xhr, status, error) {
                var err = eval("(" + xhr.responseText + ")");
                swal({
                    title: 'Lỗi',
                    text: err.Message,
                    button: {
                        text: "ĐÓNG"
                    }
                });
                return;
            }
        });
    }
</script>
