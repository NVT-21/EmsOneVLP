@model List<EMS.MVC.Frontend.Models.EmployeeGroupListViewModel>
<table id="ListDataTableSearch" class="table table-responsive-md">
    <thead>
        <tr>
            <th hidden></th>
            <th>Mã nhóm</th>
            <th>Tên nhóm</th>
            <th>Mô tả</th>
            <th>Người tạo</th>
            <th>Thời gian tạo</th>
            <th class="text-center">Trạng thái</th>
            <th class="text-center">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td hidden>@item.Code || @item.Name</td>
                    <td>@item.Code</td>
                    <td>@item.Name</td>
                    <td style="max-width: 250px; white-space: pre-line; line-height: inherit; text-align: justify; vertical-align: middle;">@item.Description</td>
                    <td>@item.CreatedBy</td>
                    <td>
                        @{
                            var splitCreatedDate = item.CreatedDate.Split(' ');
                            <span style="line-height: 1.4rem;">@splitCreatedDate[0]</span>
                            <br />
                            <span style="line-height: 1.4rem;">@splitCreatedDate[1]</span>
                        }
                    </td>
                    <td class="text-center">
                        @if (item.IsLock == "N")
                        {
                            <button onclick="btnIsLock(@item.ID, 'Y')" title="Ngừng hoạt động" class="btn btn-lock light">
                                <i class="icon-lock fs-18"></i>
                            </button>
                        }
                        else
                        {
                            <button onclick="btnIsLock(@item.ID, 'N')" title="Hoạt động" class="btn btn-lock light">
                                <svg width="21" height="20" viewBox="0 0 21 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M9.9987 15.0026C9.9987 15.4168 10.3345 15.7526 10.7487 15.7526C11.1629 15.7526 11.4987 15.4168 11.4987 15.0026H9.9987ZM11.4987 13.3359C11.4987 12.9217 11.1629 12.5859 10.7487 12.5859C10.3345 12.5859 9.9987 12.9217 9.9987 13.3359H11.4987ZM3.33203 10.8359V17.5026H4.83203V10.8359H3.33203ZM5.7487 19.9193H15.7487V18.4193H5.7487V19.9193ZM18.1654 17.5026V10.8359H16.6654V17.5026H18.1654ZM5.7487 9.91927H6.58203V8.41927H5.7487V9.91927ZM7.33203 9.16927V5.0026H5.83203V9.16927H7.33203ZM6.58203 9.91927H14.9154V8.41927H6.58203V9.91927ZM14.9154 9.91927H15.7487V8.41927H14.9154V9.91927ZM14.1654 5.0026V9.16927H15.6654V5.0026H14.1654ZM11.4987 15.0026V13.3359H9.9987V15.0026H11.4987ZM10.7487 1.58594C12.6357 1.58594 14.1654 3.11563 14.1654 5.0026H15.6654C15.6654 2.2872 13.4641 0.0859375 10.7487 0.0859375V1.58594ZM18.1654 10.8359C18.1654 9.50125 17.0834 8.41927 15.7487 8.41927V9.91927C16.255 9.91927 16.6654 10.3297 16.6654 10.8359H18.1654ZM15.7487 19.9193C17.0834 19.9193 18.1654 18.8373 18.1654 17.5026H16.6654C16.6654 18.0089 16.255 18.4193 15.7487 18.4193V19.9193ZM3.33203 17.5026C3.33203 18.8373 4.41401 19.9193 5.7487 19.9193V18.4193C5.24244 18.4193 4.83203 18.0089 4.83203 17.5026H3.33203ZM7.33203 5.0026C7.33203 3.11563 8.86173 1.58594 10.7487 1.58594V0.0859375C8.0333 0.0859375 5.83203 2.2872 5.83203 5.0026H7.33203ZM4.83203 10.8359C4.83203 10.3297 5.24244 9.91927 5.7487 9.91927V8.41927C4.41401 8.41927 3.33203 9.50125 3.33203 10.8359H4.83203Z"
                                          fill="#FF3B30" />
                                </svg>
                            </button>
                        }
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-info light" onclick="btnEditEmployeeGroup(@item.ID)">
                            <i class="icon-edit fs-18"></i>
                        </button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<script type="text/javascript">
    $(document).ready(function () {
        MyCreateDataTable("ListDataTableSearch");
    });

    function btnEditEmployeeGroup(EmployeeGroupID) {
        $.get('@Url.Action("EditEmployeeGroupView", "EmployeeGroup")', {
            ID: EmployeeGroupID
        }, function (data) {
            $('#modal-ViewModal-html').html(data);
            $('#ViewModal').modal('show');
        });
    }

    function LoadEmployeeGroupListData() {
        $.ajax({
            type: 'POST',
            url: '@Url.Action("SearchListEmployeeGroupView", "EmployeeGroup")',
            data: {

            },
            dataType: 'html',
            success: function (data) {
                $("#tbl-data").html(data);
            },
            error: function (xhr, status, error) {
                var err = eval("(" + xhr.responseText + ")");
                swal({
                    title: 'Error',
                    text: err.Message,
                    button: {
                        text: "ĐÓNG",
                        value: true,
                        visible: true,
                        className: "btn btn-primary"
                    }
                });
                return;
            }
        });
    }

    function btnIsLock(ID, IsLock) {
        var text = "";
        if (IsLock == "N") {
            text = "Kích hoạt";
        } else {
            text = "Ngừng hoạt động";
        }
        swal({
            title: 'Thông báo',
            text: "Bạn chắc chắn muốn " + text + " nhóm nhân viên?",
            buttons: {
                confirm: {
                    text: "Xác nhận",
                    value: true,
                    visible: true,
                    className: "btn btn-primary",
                    closeModal: true
                },
                cancel: {
                    text: "Đóng",
                    value: false,
                    visible: true,
                    className: "btn btn-danger",
                    closeModal: true,
                }
            },
        }).then((value) => {
            if (value) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("JChangeIsLock", "EmployeeGroup")',
                    data: {
                        ID: ID,
                        IsLock: IsLock
                    },
                    dataType: 'json',
                    success: function (res) {
                        if (res.Code == "00") {
                            swal({
                                title: "Thông báo",
                                text: res.Message,
                                html: true,
                                button: false,
                                timer: 1500
                            }).then(function () {
                                LoadEmployeeGroupListData();
                            });
                        } else {
                            swal({
                                title: "Thông báo",
                                text: res.Message,
                                button: {
                                    text: "ĐÓNG"
                                }
                            });
                        }
                    }
                });
            }
        });
    }
</script>

