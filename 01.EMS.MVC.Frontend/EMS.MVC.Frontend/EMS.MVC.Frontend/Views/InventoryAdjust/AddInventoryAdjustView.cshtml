@model EMS.MVC.Frontend.Models.InventerAdjustAddViewModel
@{
    ViewBag.Title = "AddInventoryAdjustView";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-3">
                    <div class="mb-3">
                        <label class="form-label">Kho điều chỉnh</label>
                        <select class="select2 form-control" id="WarehouseID">
                            @foreach (var item in Model.WarehouseList)
                            {
                                if (item.IsDefault == "Y")
                                {
                                    <option value="@item.ID" selected>
                                        @item.WareHouseName
                                    </option>
                                }
                                else
                                {
                                    <option value="@item.ID">
                                        @item.WareHouseName
                                    </option>
                                }
                            }
                        </select>
                        <span class="text-danger" id="errWarehouseID"></span>
                    </div>
                </div>
                <div class="col-3">
                    <div class="mb-3 ">
                        <label class="form-label">Ngày điều chỉnh</label>
                        <input name="datepicker" class=" form-control" id="ImplementationDate" value="@DateTime.Now.ToString("dd/MM/yyyy HH:mm")">
                        <span class="error-message" id="errImplementationDate"></span>
                    </div>
                </div>
                <div class=" col-6">
                    <div class="mb-3">
                        <label class="form-label">Ghi chú</label>
                        <textarea class="form-control" rows="1" id="Note" maxlength="2000"></textarea>
                    </div>
                </div>
                <div class="col-6">
                    <div class="mb-3">
                        <div class="form-check custom-checkbox ms-1">
                            <input type="checkbox" class="form-check-input" id="cbStockTake">
                            <label class="form-check-label" for="cbStockTake">Điều chỉnh theo phiếu kiểm kho</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card" id="StockTakeView" style="display:none;">
        <div class="card-body ">
            <div class="row">
                <div class="col-4">
                    <div class="mb-3">
                        <label class="mb-1 label-0"></label>
                        <div class="form-search">
                            <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M18.9842 17.6825L15.8675 14.575C16.8731 13.2939 17.4187 11.7119 17.4167 10.0833C17.4167 8.63294 16.9866 7.21512 16.1808 6.00916C15.375 4.80319 14.2297 3.86326 12.8897 3.30822C11.5497 2.75318 10.0752 2.60795 8.65268 2.89091C7.23015 3.17387 5.92347 3.8723 4.89789 4.89789C3.8723 5.92347 3.17387 7.23015 2.89091 8.65268C2.60795 10.0752 2.75318 11.5497 3.30822 12.8897C3.86326 14.2297 4.80319 15.375 6.00916 16.1808C7.21512 16.9866 8.63294 17.4167 10.0833 17.4167C11.7119 17.4187 13.2939 16.8731 14.575 15.8675L17.6825 18.9842C17.7677 19.0701 17.8691 19.1383 17.9808 19.1848C18.0925 19.2314 18.2123 19.2553 18.3333 19.2553C18.4543 19.2553 18.5742 19.2314 18.6859 19.1848C18.7976 19.1383 18.899 19.0701 18.9842 18.9842C19.0701 18.899 19.1383 18.7976 19.1848 18.6859C19.2314 18.5742 19.2553 18.4543 19.2553 18.3333C19.2553 18.2123 19.2314 18.0925 19.1848 17.9808C19.1383 17.8691 19.0701 17.7677 18.9842 17.6825V17.6825ZM4.58334 10.0833C4.58334 8.99554 4.90591 7.93217 5.51025 7.0277C6.1146 6.12323 6.97358 5.41828 7.97858 5.002C8.98357 4.58572 10.0894 4.4768 11.1563 4.68902C12.2232 4.90124 13.2032 5.42506 13.9724 6.19425C14.7416 6.96344 15.2654 7.94345 15.4777 9.01034C15.6899 10.0772 15.581 11.1831 15.1647 12.1881C14.7484 13.1931 14.0434 14.0521 13.139 14.6564C12.2345 15.2608 11.1711 15.5833 10.0833 15.5833C8.62465 15.5833 7.2257 15.0039 6.19425 13.9724C5.1628 12.941 4.58334 11.542 4.58334 10.0833Z"
                                      fill="#86909C" />
                            </svg>
                            <input type="text" class="form-control " placeholder="Tìm theo mã phiếu điều chỉnh, mã phiếu kiểm" id="StockTakeCode">
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3">
                        <label class="form-label">Thời gian</label>
                        <div class="datepicker-form">
                            <div class="datepicker-form">
                                @Html.EditorFor(model => model.AllDate, new { htmlAttributes = new { @type = "text", @class = "form-control input-daterange-datepicker" } })
                                @Html.HiddenFor(m => m.FromDate)
                                @Html.HiddenFor(m => m.ToDate)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="table-responsive table-primary" id="StockTakeData"></div>
        </div>
        <div class="card">
            <div class="card-body">
                <div class="col-lg-12">
                    <div class="d-sm-flex justify-content-end align-items-center">
                        <button type="button" onclick="btnCancel()" class="btn btn-outline-dark">Hủy bỏ</button>
                        <button type="button" onclick="btnCreate()" class="btn btn-primary">Tạo mới</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card" id="StockTakeView1" style="display:none;">
        <div class="card-body">
            <div id="tbl-data" class="table-responsive table-primary">
                <table id="DataTable" class="table table-responsive-md">
                    <thead>
                        <tr>
                            <th class="text-center">Sản phẩm</th>
                            <th>Mã SKU</th>
                            <th>Giá</th>
                            <th>Số lượng tồn kho</th>
                            <th class="text-center">Số lượng thực tế</th>
                            <th>Chênh lệch</th>
                            <th>Giá trị chênh lệch</th>
                            <th>
                                <button class="btn btn-sm btn-outline-secondary" type="button" id="btnAddRow" title="Thêm hàng">
                                    <i class="fa fa-plus-circle" style="margin-left: 0;"></i>
                                </button>
                            </th>
                        </tr>
                    </thead>
                    <tbody id="tPI_tbody">
                        @{
                            Html.RenderAction("AddInventoryAdjustDetailView", "InventoryAdjust", new { Number = 1 });
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th class="text-center">Tổng: <span class="ClearData" id="TotalProduct"></span></th>
                            <th></th>
                            <th></th>
                            <th><span class="ClearData" id="TotalInventory"></span></th>
                            <th class="text-center"><span class="ClearData" id="TotalActual"></span></th>
                            <th><span class="ClearData" id="TotalDifferent"></span></th>
                            <th><span class="ClearData" id="TotalMoney"></span></th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
        <div class="card">
            <div class="card-body">
                <div class="col-lg-12">
                    <div class="d-sm-flex justify-content-end align-items-center">
                        <button type="button" onclick="btnCancel()" class="btn btn-outline-dark">Hủy bỏ</button>
                        <button type="button" onclick="btnCreate1('N')" class="btn btn-primary">Tạo mới</button>
                    </div>
                </div>
            </div>
        </div>
    </div>    
</div>

<script>
    $(document).ready(function () {
        CreateDatePickerAndTime('ImplementationDate');
        CreateDateRangePicker("AllDate", $("#FromDate").val(), $("#ToDate").val());
        $('#StockTakeView1').show();
    });

    $("#cbStockTake").on("change", function () {
        let Checked = document.getElementById('cbStockTake').checked;
        if (Checked) {
            $('#StockTakeView').show();
            $('#StockTakeView1').hide();
            $("#StockTakeCode, #WarehouseID, #AllDate").on("change", function () {
                var DivID = this.id;
                if (DivID = "AllDate") {
                    var AllDateValue = $("#AllDate").val();
                    if (AllDateValue) {
                        var SplitAllDateValue = AllDateValue.split('-');
                        $("#FromDate").val(SplitAllDateValue[0].trim());
                        $("#ToDate").val(SplitAllDateValue[1].trim());
                    }
                }
                btnSearch();
            });
        }
        else {
            $("#StockTakeView1").show();
            $('#StockTakeView').hide();
            $('#StockTakeData').html('');
        }
    });

    function btnSearch() {
        var req = {
                 StockTakeCode: $('#StockTakeCode').val().trim(),
                 WarehouseID: $('#WarehouseID').val(),
                 FromDate: $('#FromDate').val(),
                 ToDate: $('#ToDate').val()
            };
            $.post('@Url.Action("SearchStockTake", "InventoryAdjust")', req, function (data) {
                $('#StockTakeData').html(data);
            });
    }

    function btnCancel() {
        window.location.href = '@Url.Action("InventoryAdjustView", "InventoryAdjust")';
    }

    $("#WarehouseID").on("change", function () {
        $(".ClearDataProduct").empty();
        $(".ClearData").text("0");
        $(".ClearDataInput").val("0");
        $("#errWarehouseID").text("");
        loadProductVariant("WarehouseOnChange");
    });

    var stt = 2;
    $("#btnAddRow").on("click", function () {
        $.get('@Url.Action("AddInventoryAdjustDetailView", "InventoryAdjust")?Number=' + stt, function (data) {
            stt = stt + 1;
            $('#tPI_tbody').append(data);
        });
    });

    function btnCreate() {
        let isError = false;
        var data = {
            WarehouseID: $("#WarehouseID").val(),
            ImplementationDate: $("#ImplementationDate").val().trim(),
            Note: $("#Note").val().trim(),
            StockTakeID: $("input[name=StockTakeID]:checked").val()
        }
        let Checked = document.getElementById('cbStockTake').checked;
        if (Checked) {
            if (data.StockTakeID == "" || data.StockTakeID == undefined) {
                $('#errStockTakeID').text('Vui lòng chọn phiếu kiểm kho.');
                isError = true;
            };
        }
        if (isError) {
            return;
        }

        isError = CheckNullValue(data.WarehouseID, '#errWarehouseID', "", isError);
        isError = CheckNullValue(data.ImplementationDate, '#errImplementationDate', "", isError);

        swal({
            title: 'Thông báo',
            text: "Bạn chắc chắn muốn tạo phiếu điều chỉnh kho?",
            buttons: {
                confirm: {
                    text: "CÓ",
                    value: true,
                    visible: true,
                    className: "btn btn-primary",
                    closeModal: true
                },
                cancel: {
                    text: "KHÔNG",
                    value: false,
                    visible: true,
                    className: "btn btn-danger",
                    closeModal: true,
                }
            },
        }).then((value) => {
            if (value) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("JAddInventoryAdjust", "InventoryAdjust")',
                    dataType: 'json',
                    loading: true,
                    data: data,
                    success: function (res) {
                        if (res.Code == "00") {
                            var resData = JSON.parse(res.Data);
                            swal({
                                title: "Thông báo",
                                text: res.Message,
                                button: false,
                                timer: 1500
                            }).then(function () {
                                window.location.href = '@Url.Action("InventoryAdjustView", "InventoryAdjust")';
                            });
                        } else {
                            swal({
                                title: "Thông báo",
                                text: res.Message,
                                button: {
                                    text: "ĐÓNG"
                                }
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        var err = eval("(" + xhr.responseText + ")");
                        swal({
                            title: 'Lỗi',
                            text: err.Message,
                            button: {
                                text: "ĐÓNG",
                                value: true,
                                visible: true,
                                className: "btn btn-primary"
                            }
                        });
                        return;
                    }
                });
            }
        });
    }


    function btnCreate1(Status) {
        var isError = false;
        var data = {};
        var arrStockTakeDetail = [];
        $('.row-item').each(function () {
            var Number = $(this).find("td:eq(4) input[name='NumberOfActual']").data("number");
            var ProductVariant = $(this).find("td:eq(0) select[name='ProductVariant']").val().trim();
            if (ProductVariant == "") {
                $("#errProductVariant" + Number).text("Vui lòng chọn sản phẩm.");
                isError = true;
                return;
            }
            var ProductVariantPrice = $(this).closest('tr').find('.Price').html().trim();
            var NumberOfInventory = $(this).closest('tr').find('.NumberOfInventory').html().trim();
            var NumberOfActual = $(this).find("td:eq(4) input[name='NumberOfActual']").val().trim();
            if (NumberOfActual == "") {
                $("#errNumberOfActual" + Number).text("Vui lòng nhập số lượng");
                isError = true;
                return;
            }
            var NumberOfDifferent = $(this).closest('tr').find('.NumberOfDifferent').html().trim();
            var MoneyOfDifferent = $(this).closest('tr').find('.MoneyOfDifferent').html().trim();

            var obj = arrStockTakeDetail.find(o => o.ProductVariant == ProductVariant);

            if (obj != "" && obj != undefined) {
                $("#errProductVariant" + Number).text("Sản phẩm đã tồn tại.");
                isError = true;
                return;
            }

            arrStockTakeDetail.push({
                ProductVariant: ProductVariant,
                ProductID: ProductVariant.split('_')[0],
                ProductVariantID: ProductVariant.split('_')[1],
                ProductVariantPrice: ProductVariantPrice.trim().replaceAll(",", ""),
                NumberOfInventory: NumberOfInventory,
                NumberOfActual: NumberOfActual,
                NumberOfDifferent: NumberOfDifferent,
                MoneyOfDifferent: MoneyOfDifferent.trim().replaceAll(",", "")
            });
        });

        var data = {
            WarehouseID: $("#WarehouseID").val(),
            Note: $("#Note").val().trim(),
            Status: Status,
            AddStockTakeDetail: arrStockTakeDetail,
            ImplementationDate: $("#ImplementationDate").val(),
            Note: $("#Note").val()
        }

        if (data.WarehouseID == "") {
            $("#errWarehouseID").text("Vui lòng chọn kho.");
            isError = true;
        }

        if (isError == true) {
            return;
        }

        if (data.AddStockTakeDetail.length == 0) {
            $("#errtableProductInformation").text("Vui lòng chọn sản phẩm.");
            return;
        }

        var message = "";
        if (data.Status == "N") {
            message = "Bạn chắc chắn muốn tạo phiếu kiểm kê?";
        } else {
            message = "Bạn chắc chắn muốn lưu nháp phiếu kiểm kê?";
        }

        swal({
            title: 'Thông báo',
            text: message,
            buttons: {
                confirm: {
                    text: "CÓ",
                    value: true,
                    visible: true,
                    className: "btn btn-primary",
                    closeModal: true
                },
                cancel: {
                    text: "KHÔNG",
                    value: false,
                    visible: true,
                    className: "btn btn-danger",
                    closeModal: true,
                }
            },
        }).then((value) => {
            if (value) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("JAddInventoryAdjust", "InventoryAdjust")',
                    dataType: 'json',
                    loading: true,
                    data: data,
                    success: function (res) {
                        if (res.Code == "00") {
                            swal({
                                title: "Thông báo",
                                text: res.Message,
                                button: false,
                                timer: 1500
                            }).then(function () {
                                window.location.href = '@Url.Action("InventoryAdjustView", "InventoryAdjust")';
                            });
                        } else {
                            swal({
                                title: "Thông báo",
                                text: res.Message,
                                button: {
                                    text: "ĐÓNG"
                                }
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        var err = eval("(" + xhr.responseText + ")");
                        swal({
                            title: 'Lỗi',
                            text: err.Message,
                            button: {
                                text: "ĐÓNG"
                            }
                        });
                        return;
                    }
                });
            }
        });
    }
</script>

