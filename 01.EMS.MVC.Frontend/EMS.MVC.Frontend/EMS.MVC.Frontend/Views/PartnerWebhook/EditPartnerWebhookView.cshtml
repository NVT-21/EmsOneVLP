@model EMS.MVC.Frontend.Models.PartnerWebhookEditViewModel
<div class="modal-dialog modal-medium modal-dialog-centered" role="document">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Sửa thông tin đối tác Webhook</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal">
            </button>
        </div>
        <div class="modal-body">
            @Html.HiddenFor(m => m.ID)
            @Html.HiddenFor(m => m.PartnerCode)
            <div class="row mb-2">
                <h6>
                    Mã PP/CRM&nbsp;<span style="color: red">(*)</span>:
                    @{
                        var splitPartnerCode = Model.PartnerCode.Split(',');
                        for (var i = 0; i < splitPartnerCode.Length; i++)
                        {
                            <span style="line-height: 1.4rem;"><b>@splitPartnerCode[i]</b></span>
                            <br />
                        }
                    }
                </h6>
            </div>
            <div class="row mb-2">
                <div class="d-flex align-items-center pb-3">
                    <h6 class="mb-1">Trạng thái <span style="color: red">(*)</span></h6>
                </div>
                <button type="button" class="btn btn-toggle ml-auto px-1 py-1 mdi-24px" data-toggle="button" autocomplete="off" id="btnToggleStatus">
                    <div class="handle"></div>
                </button>
            </div>
            <hr />
            <div class="row">
                <div class="col-xl-12 col-lg-12 col-md-12 mb-2">
                    <label>Tên đối tác <span style="color: red">(*)</span></label>
                    @Html.EditorFor(model => model.PartnerName, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Tên đối tác", @maxlength = "100", @autocomplete = "off" } })
                    <span class="text-danger" id="errPartnerName"></span>
                </div>
                <div class="col-xl-12 col-lg-12 col-md-12 mb-2">
                    <label>Link Webhook <span style="color: red">(*)</span></label>
                    @Html.EditorFor(model => model.PartnerURL, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Link Webhook", @autocomplete = "off" } })
                    <span class="text-danger" id="errPartnerURL"></span>
                </div>
                <div class="col-xl-12 col-lg-12 col-md-12 mb-2">
                    <label>API Key</label>
                    @Html.EditorFor(model => model.PartnerKey, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "API Key", @maxlength = "100", @autocomplete = "off" } })
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline-dark light" data-bs-dismiss="modal">Hủy bỏ</button>
            <button type="button" class="btn btn-primary" id="btnSubmit">Cập nhật</button>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        if ("@Model.Status" == "Y")
        {
            $("#btnToggleStatus").addClass("active");
            $("#btnToggleStatus").attr("aria-pressed", true);
        }
        else
        {
            $("#btnToggleStatus").addClass("focus");
            $("#btnToggleStatus").attr("aria-pressed", false);
        }
    });
    $("#btnToggleStatus").on("click", function (event) {
        if ($("#btnToggleStatus").attr('aria-pressed') == "true")
        {
            $("#btnToggleStatus").removeClass("focus");
            $("#btnToggleStatus").removeClass("active");
            $("#btnToggleStatus").removeAttr("aria-pressed");

            $("#btnToggleStatus").addClass("focus");
            $("#btnToggleStatus").attr("aria-pressed", false);
        }
        else
        {
            $("#btnToggleStatus").removeClass("focus");
            $("#btnToggleStatus").removeClass("active");
            $("#btnToggleStatus").removeAttr("aria-pressed");

            $("#btnToggleStatus").addClass("active");
            $("#btnToggleStatus").attr("aria-pressed", true);
        }
    });
    CheckChangeValue("PartnerName", "Vui lòng nhập tên đối tác.", "Vietnamese", "Y");
    CheckChangeValue("PartnerURL", "Vui lòng nhập Link Webhook.", "", "Y");
    $("#btnSubmit").on("click", function () {
        var IsError = false;
        var Message = "Giá trị hợp lệ không bao gồm ký tự đặc biệt.";
        var data = {
            ID: $('#ID').val(),
            PartnerCode: $('#PartnerCode').val(),
            PartnerName: $("#PartnerName").val().trim(),
            PartnerURL: $("#PartnerURL").val().trim(),
            PartnerKey: $('#PartnerKey').val().trim(),
            Status: $("#btnToggleStatus").attr('aria-pressed') == "true" ? "Y" : "N"
        }

        IsError = CheckNullValue(data.PartnerName, "PartnerName", "Vui lòng nhập tên đối tác.", IsError);
        IsError = CheckNullValue(data.PartnerURL, "PartnerURL", "Vui lòng nhập Link Webhook.", IsError);


        if (IsError == true) {
            return;
        }

        $.ajax({
            type: 'POST',
            url: '@Url.Action("JEdit", "PartnerWebhook")',
            dataType: 'json',
            loading: true,
            data: data,
            success: function (res) {
                if (res.Code == "00") {
                    $('#ViewModal').modal('toggle');
                    swal({
                        title: "Thông báo",
                        text: res.Message,
                        button: false,
                        timer: 1500
                    });
                    setTimeout(function () {
                        $.get('@Url.Action("SearchListPartnerWebhookView", "PartnerWebhook")', function (data) {
                            $('#tbl-data').html(data);
                        });
                    });
                } else {
                    //CreateCustomSwal("error", res.Message);
                    $('#ViewModal').modal('toggle');
                    swal({
                        title: "Thông báo",
                        text: res.Message,
                        button: {
                            text: "Đóng"
                        }
                    });
                }
            }
        });
    });
</script>