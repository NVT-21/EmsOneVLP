        </div>
        <div id="sidebar" class="deznav">
            <div class="deznav-scroll">
                <ul class="metismenu" id="menu">
                    @*@RenderPage("_MenuLeft.cshtml")*@

                    @{ Html.RenderAction("SearchListMenuView", "Permission"); }
                </ul>
            </div>
