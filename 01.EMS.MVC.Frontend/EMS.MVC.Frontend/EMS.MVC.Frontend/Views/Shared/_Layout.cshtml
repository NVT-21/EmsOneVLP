        <div class="content-body">
            @RenderBody()
        </div>
    </div>
    <div id="footer" class="footer">
        <div class="footer-content">
            @RenderPage("_Footer.cshtml")
        </div>
    </div>

    <a href="" target="_blank" class="DZ-bt-support-now DZ-theme-btn" data-redirect="true">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M18.1182 14.702L14 15.5C11.2182 14.1038 9.49995 12.5 8.49995 10L9.26991 5.8699L7.81447 2L4.06355 2C2.936 2 2.04809 2.93178 2.21649 4.04668C2.6369 6.83 3.87648 11.8765 7.49995 15.5C11.3052 19.3052 16.7857 20.9564 19.802 21.6127C20.9667 21.8662 22 20.9575 22 19.7655L21.9999 16.1812L18.1182 14.702Z"
                  fill="white" />
        </svg>

        <span>Hotline: <b>1900 54 54 33</b></span>
    </a>
    @Scripts.Render("~/bundles/js")
<script>
    $(document).ready(function () {
        //$('[data-toggle="tooltip"]').tooltip();
        $('select.select2').select2(AttributeSelect2);
        NotifyCount();
    });

    $("#SearchShippingCodeHeader").on('change', function () {
        var ShippingCodeHeader = $("#SearchShippingCodeHeader").val().trim();
        if (ShippingCodeHeader) {
            var link = document.createElement('a');
            var param = String.format("ShippingCode={0}&ShopID={1}", btoa(ShippingCodeHeader), btoa(@XHelper.Session.EmployeeProfile.ShopInformation.ID));
            link.target = "_blank";
            link.href = '@Url.Action("DetailShippingView", "Handle")?' + param;
            link.click();
        }
    });

    $("#ShowChangePasswordView").on("click", function (event) {
        $.get('@Url.Action("ChangePasswordView", "Account")', function (data) {
            $('#modal-ViewModal-html').html(data);
            $('#ViewModal').modal('show');
        });
    });

    $(".modal").on("hidden.bs.modal", function () {
        $("#ClearModal").html("");
    });

    //$(document).ajaxStart(function () {
    //    $('#ajax_loader').show();
    //});

    //$(document).ajaxStop(function () {
    //    $('#ajax_loader').hide();
    //});

    $(document).ajaxError(function (xhr, props) {
        var message = "";
        switch (props.status) {
            case 1:
                message = "Dữ liệu không tồn tại.";
                break;
            case 2:
                message = "Cửa hàng đã bị xóa. Vui lòng liên hệ quản trị viên.";
                break;
            case 3:
                message = "Cửa hàng đã bị khoá. Vui lòng liên hệ quản trị viên.";
                break;
            case 4:
                message = "Cửa hàng đã hết thời hạn sử dụng. Vui lòng liên hệ quản trị viên.";
                break;
            case 5:
                message = "Nhân viên đã bị xóa. Vui lòng liên hệ quản trị viên.";
                break;
            case 6:
                message = "Nhân viên đã bị khóa. Vui lòng liên hệ quản trị viên.";
                break;
            case 7:
                message = "Hết thời gian hoạt động. Vui lòng liên hệ quản trị viên.";
                break;
            //case 7:
            //    message = "Tải danh sách menu thất bại. Vui lòng kiểm tra lại nhóm quyền.";
            //    break;
            case 403:
                message = "Không có quyền thực hiện chức năng này.";
                break;
            case 408:
                message = "Thời gian đăng nhập đã hết, vui lòng đăng nhập lại.";
                break;
            case 413:
                message = "Hệ thống hỗ trợ tải tệp tin kích thước tối đa 5 MB.";
                break;
            default:
                message = props.statusText;
                break;
        }
        if (props.status == 403) {
            CreateCustomSwal("error", message);
        } else {
            CreateCustomSwal("success", message, '@Url.Action("LogOut", "Account")');
        }
    });

    /* Notify */
    var Notify = document.querySelector('#Notify');
    Notify.addEventListener("show.bs.dropdown", function (event) {
        NotifyCount();
        var element = event.target;
        if (element.getAttribute("data-bs-toggle") === "dropdown") {
            var dropdownCheck = element.nextElementSibling;
            if (!dropdownCheck.classList.contains("show")) {
                $.get('@Url.Action("NotifyListView", "Notify")', function (data) {
                    $('#NotifyData').html(data);
                });
            }
        }
    });
    Notify.addEventListener("hide.bs.dropdown", function (event) {
        NotifyCount();
        $('#NotifyData').html("");
    });
    function NotifyCount() {
        $.get('@Url.Action("JCountNotify", "Notify")', function (data) {
            if (parseInt(data.Quantity) > 0) {
                $("#NotifyCount").text(data.Quantity);
                $("#NotifyCount").css("display", "block");
            } else if (parseInt(data.Quantity) == 0 || CountList == undefined) {
                $("#NotifyCount").css("display", "none");
            } else if (parseInt(data.Quantity) >= 100) {
                $("#NotifyCount").text("99+");
                $("#NotifyCount").css("display", "block");
            } else {
                $("#NotifyCount").text(data.Quantity);
                $("#NotifyCount").css("display", "block");
            }
        });
    }
    /* End Notify */
</script>
    @RenderSection("scripts", required: false)
</body>
</html>
