                            <li class="nav-item dropdown header-profile">
                                <a class="nav-link" href="javascript:void(0);" role="button" data-bs-toggle="dropdown" data-redirect="false">
                                    <img src="~/Assets/images/default/avatar.jpg" width="20" alt="" />
                                    <div class="header-info me-3">
                                        <span class="fs-16 d-flex align-items-center">
                                            @XHelper.Session.EmployeeProfile.FullName
                                            <i class="icon-arrow-b fs-20"></i>
                                        </span>
                                        <!-- <small class="fs-14 font-w400">toannadi@gmail.com</small> -->
                                    </div>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end">
                                    <a href="@Url.Action("ShopView","Shop")" class="dropdown-item ai-icon" data-redirect="true">
                                        <span class="ms-2">Thông tin tài khoản </span>
                                    </a>
                                    <a href="#" id="ShowChangePasswordView" class="dropdown-item ai-icon" data-redirect="true">
                                        <span class="ms-2">Đổi mật khẩu </span>
                                    </a>
                                    @*<a href="#" id="LockAccount" class="dropdown-item ai-icon">
                                            <span class="ms-2">Khoá tài khoản </span>
                                        </a>
                                        <a href="#" id="DeleteAccount" class="dropdown-item ai-icon">
                                            <span class="ms-2">Xoá tài khoản </span>
                                        </a>*@
                                    <a href="@Url.Action("LogOut","Account")" class="dropdown-item ai-icon" data-redirect="true">
