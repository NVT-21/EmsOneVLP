                                    Tạo đơn hàng <i class="icon-arrow-b fs-20"></i>
                                </button>
                                <div class="dropdown-menu dropdown-menu-end border py-0" aria-labelledby="add-order-dropdown">
                                    <div class="py-2">
                                        <a class="dropdown-item" href="@Url.Action("FastOrderView","Order")" data-redirect="true">Tạo đơn hàng nhanh</a>
                                        <a class="dropdown-item" href="@Url.Action("AddOrderView","Order")" data-redirect="true">Tạo đơn hàng</a>
                                        <a class="dropdown-item" href="@Url.Action("AddOrderBatchView","OrderBatch")" data-redirect="true">Tạo đơn hàng lô</a>
                                        <a class="dropdown-item" href="@Url.Action("AddGrabOrderView","GrabOrder")" data-redirect="true">Tạo đơn hàng siêu tốc</a>
                                        <a class="dropdown-item" href="@Url.Action("ImportExcelView","Order", new { Version = "EMSV2" })" data-redirect="true">File Excel (EMSCode)</a>
                                        <a class="dropdown-item" href="@Url.Action("ImportExcelViewNew","Order")" data-redirect="true">File Excel (New Featurer)</a>
                                    </div>
                                </div>
                            </li>
                            <li class="nav-item dropdown notification_dropdown">
                                <a id="Notify" class="nav-link" href="javascript:void(0);" role="button" data-bs-toggle="dropdown" data-redirect="false">
                                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path fill-rule="evenodd" clip-rule="evenodd"
                                              d="M10 0.083252C10.4142 0.083252 10.75 0.419038 10.75 0.833252V1.79839C13.5713 2.16589 15.75 4.57847 15.75 7.49992V8.41958C15.75 9.80371 16.2353 11.144 17.1214 12.2073L17.4648 12.6195C18.7765 14.1935 17.6572 16.5833 15.6083 16.5833H13.25V16.6666C13.25 18.4615 11.7949 19.9166 10 19.9166C8.20509 19.9166 6.75001 18.4615 6.75001 16.6666V16.5833H4.39175C2.34281 16.5833 1.22351 14.1935 2.53521 12.6195L2.87865 12.2073C3.76475 11.144 4.25001 9.80371 4.25001 8.41958V7.49992C4.25001 4.57847 6.42874 2.16589 9.25001 1.79839V0.833252C9.25001 0.419038 9.5858 0.083252 10 0.083252ZM8.25001 16.5833V16.6666C8.25001 17.6331 9.03351 18.4166 10 18.4166C10.9665 18.4166 11.75 17.6331 11.75 16.6666V16.5833H8.25001ZM12.5 15.0833H7.50001H4.39175C3.61456 15.0833 3.19 14.1768 3.68754 13.5798L4.03098 13.1676C5.14172 11.8347 5.75001 10.1546 5.75001 8.41958V7.49992C5.75001 5.15271 7.6528 3.24992 10 3.24992C12.3472 3.24992 14.25 5.15271 14.25 7.49992V8.41958C14.25 10.1546 14.8583 11.8347 15.969 13.1676L16.3125 13.5797C16.81 14.1768 16.3855 15.0833 15.6083 15.0833H12.5Z"
