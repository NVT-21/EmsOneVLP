<script>
    $(".ClickTab").on("click", function (event) {
        event.preventDefault();
        var Tab = $(this).attr("data-Tab");
        var url = "";
        switch (Tab) {
            case "Facebook":
                url = "https://www.facebook.com/EMSVietnam";
                break;
            case "Zalo":
                url = "https://zalo.me/847218404971118757";
                break;
            case "Tiktok":
                url = "https://www.tiktok.com/@@anhbuutavannang";
                break;
            case "Youtube":
                url = "https://www.youtube.com/channel/UCcUvf6RE8U33uQwE9GmqSpw";
                break;
            case "Instagram":
                url = "https://instagram.com/ems_viet_nam";
                break;
            case "Linkedin":
                url = "https://www.linkedin.com/in/emsvietnam";
                break;
            case "CHPlay":
                url = "https://play.google.com/store/apps/details?id=com.ems.emsone";
                break;
            case "AppleStore":
                url = "https://apps.apple.com/vn/app/emsone/id1621666479";
                break;
            default:
                url = "";
                break;
        }
        if (url) {
            window.open(url);
        }
    });
</script>

