@model List<EMS.MVC.Frontend.Models.ReconciliationListCODMoneyViewModel>
@{
    var stt = 1;
}
<table id="SearchListDataTable" class="table table-responsive-md">
    <thead>
        <tr>
            <th class="text-center">Tổng</th>
            <th class="text-center"></th>
            <th class="text-center"><span class="text-red">@ViewBag.SumEmsBarCode.ToString("N0")</span> (Bưu gửi)</th>
            <th class="text-center"></th>
            <th class="text-end"> <span class="text-red">@ViewBag.SumCODMoney.ToString("N0")</span> (VNĐ)</th>
            <th class="text-center"></th>
            <th class="text-center"></th>
            <th class="text-center"></th>
        </tr>
        <tr class="text-center">
            <th>STT</th>
            <th>Trạng thái COD</th>
            <th>Mã bưu gửi</th>
            <th>Mã đơn hàng</th>
            <th class="text-end">Tiền COD (VNĐ)</th>
            <th>Ngày phát hành</th>
            <th>Ngày tạo đơn</th>
            <th>Mã bảng kê</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="text-center">@(stt++)</td>
                <td class="text-center">@item.CODTransTypeName</td>
                <td class="text-center"><span class="text-secondary"><a href="@Url.Action("DetailShippingView", "Handle", new { ShippingCode = EMS.Library.Security.EncodeBase64(item.EmsBarCode), ShopID = EMS.Library.Security.EncodeBase64(XHelper.Session.EmployeeProfile.ShopInformation.ID.ToString()) })" target="_blank">@item.EmsBarCode</a></span></td>
                <td class="text-center"><span class="text-secondary"><a href="#" class="ShowDetailOrderView" data-OrderID="@item.OrderID" data-ShopID="@XHelper.Session.EmployeeProfile.ShopInformation.ID">@item.OrderCode</a></span></td>

                <td class="text-end">@item.CODMoney.ToString("N0")</td>
                <td class="text-center">
                    @item.TimeRelease
                </td>
                <td class="text-center">
                    @item.CreatedDateOrder
                </td>
                <td class="text-center"><span class="text-secondary">@item.ListCode</span></td>
            </tr>
        }
    </tbody>
</table>
<script>
    $(document).ready(function () {
        MyCreateDataTable("SearchListDataTable");
    });
    $(".ShowDetailOrderView").on("click", function (event) {
        event.preventDefault();
        $.post('@Url.Action("DetailOrderView", "Order")', {
            OrderID: $(this).attr("data-OrderID"), ShopID: $(this).attr("data-ShopID")
        }, function (data) {
            $('#modal-ViewModal-html').html(data);
            $('#ViewModal').modal('show');
        });
    });
</script>