@model EMS.MVC.Frontend.Models.PostageRefundDataViewModel
@{
    var stt = 1;
}
<table id="SearchListDataTable" class="table table-responsive-md">
    <thead>
        <tr>
            @if (Model != null)
            {
                <th class="align-middle" colspan="6">Tổng dữ liệu</th>
                <th class="text-end"> @Model.SumMoneyforCollection.ToString("N0") ₫</th>
                <th class="text-end"> @Model.SumCODFee.ToString("N0") ₫</th>
                <th class="text-end"> @Model.SumCODFeeRefund.ToString("N0") ₫</th>
                <th class="text-end"> @Model.SumFeeE1TransferRefund.ToString("N0") ₫</th>
                <th class="text-end"></th>
                <th class="text-end"> @Model.SumRefundAmount.ToString("N0") ₫</th>
                <th class="text-center"></th>
            }
            else
            {
                <th class="align-middle" colspan="6">Tổng dữ liệu</th>
                <th class="text-end"> 0 ₫</th>
                <th class="text-end"> 0 ₫</th>
                <th class="text-end"> 0 ₫</th>
                <th class="text-end"> 0 ₫</th>
                <th class="text-end"></th>
                <th class="text-end"> 0 ₫</th>
                <th class="text-center"></th>
            }
        </tr>
        <tr class="text-center">
            <th> STT </th>
            <th> Mã PP/CRM </th>
            <th> Tham chiếu </th>
            <th> Mã bưu gửi </th>
            <th> Ngày phát hành</th>
            <th> Ngày chuyển hoàn</th>
            <th> Tiền nhờ thu (VNĐ)</th>
            <th> Cước COD (VNĐ)</th>
            <th> Cước hoàn (VNĐ)</th>
            <th> Cước E1 CH (VNĐ)</th>
            <th> Tỷ lệ giảm cước (%)</th>
            <th> Số tiền hoàn cước (VNĐ)</th>
            <th style="max-width: 360px; white-space: inherit; text-align: left; vertical-align: baseline;line-height: 1.4rem;"> Ghi chú</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            foreach (var item in Model.DataDetails)
            {
                <tr>
                    <td class="text-center">@(stt++)</td>
                    <td class="text-center">@item.CustomerCode</td>
                    <td class="text-center">@item.Reference</td>
                    <td class="text-center">
                        @item.ItemCode
                    </td>
                    <td class="text-center">
                        @item.ReleaseDate
                    </td>
                    <td class="text-center">
                        @item.RefundDate
                    </td>
                    <td class="text-end">
                        @item.MoneyforCollection.ToString("N0")
                    </td>
                    <td class="text-end">
                        @item.CODFee.ToString("N0")
                    </td>
                    <td class="text-end">
                        @item.CODFeeRefund.ToString("N0")
                    </td>
                    <td class="text-end">
                        @item.FeeE1TransferRefund.ToString("N0")
                    </td>
                    <td class="text-end">
                        @item.DiscountRate.ToString("N0")
                    </td>
                    <td class="text-end">
                        @item.RefundAmount.ToString("N0")
                    </td>
                    <td class="text-start" style="max-width: 360px; white-space: inherit; text-align: left; vertical-align: baseline;line-height: 1.4rem;">
                        @item.Note
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
<script>
    $(document).ready(function () {
        MyCreateDataTable("SearchListDataTable");
    });
</script>