@model EMS.MVC.Frontend.Models.DetailInventoryImportViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@Html.HiddenFor(m => m.Inventory.ID)
<div class="container-fluid">
    <div class="header-content">
        <p class="fs-20 font-w600">Chi tiết phiếu nhập kho - @Model.Inventory.InventoryCode</p>
    </div>
    <div class="row">
        <div class="col-xl-6 col-lg-6 col-md-6">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="mb-2">
                            <label class="text-2">Mã phiếu nhập kho: </label>
                            <label class="font-w600">@Model.Inventory.InventoryCode</label>
                        </div>
                        <div class="mb-2">
                            <label class="text-2">Kho: </label>
                            <label class="font-w600">@Model.Inventory.WareHouse.WareHouseName</label>
                        </div>
                        <div class="mb-2">
                            <label class="text-2">Người nhập kho: </label>
                            <label class="font-w600">@Model.Inventory.ImporterName</label>
                        </div>
                        <div class="mb-2">
                            <label class="text-2">Số điện thoại: </label>
                            <label class="font-w600">@Model.Inventory.MobileNumber</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-6 col-lg-6 col-md-6">
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="mb-2">
                            <label class="text-2">Ngày nhập kho: </label>
                            <label class="font-w600">@Model.Inventory.DateOfInventoryImport</label>
                        </div>
                        <div class="mb-2">
                            <label class="text-2">Nhà cung cấp: </label>
                            <label class="font-w600">@Model.Inventory.Provider.ProviderName</label>
                        </div>
                        <div class="mb-2">
                            <label class="text-2">Ghi chú: </label>
                            <label class="font-w600">@Model.Inventory.Note</label>
                        </div>
                        <div class="mb-2">
                            <label class="text-2">Trạng thái: </label>
                            <label class="font-w600">@Model.Inventory.Status.Name</label>
                        </div>
                        @if (Model.Inventory.Status.Code == "R" || Model.Inventory.Status.Code == "C")
                        {
                            <div class="mb-2">
                                <label class="text-2">Lý do từ chối: </label>
                                <label class="font-w600">@Model.Inventory.Reason</label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <div class="table-primary table-responsive">
                <table id="SearchListDataTable" class="table table-bordered" style="width: 100%;">
                    <thead>
                        <tr>
                            <th>Tên sản phẩm</th>
                            <th>Số lượng</th>
                            <th>Giá nhập</th>
                            <th>Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.ListInventoryImportDetail)
                        {
                            <tr>
                                <td>
                                    <span style="line-height: 1.2rem;">@item.Product.ProductVariant.SKU - @item.Product.ProductName</span>
                                    <br />
                                    <span style="line-height: 1.2rem;">Mã Pallet: @item.Product.ProductVariant.Pallet.PalletCode</span>
                                    <br />
                                    <span style="line-height: 1.2rem;">(@item.Product.ProductVariant.Options)</span>
                                </td>
                                <td class="text-right">@item.Quantity.ToString("N0")</td>
                                <td class="text-right">@item.Price.ToString("N0") đ</td>
                                <td class="text-right">@item.TotalAmount.ToString("N0") đ</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3">Tổng tiền</th>
                            <th>@Model.Inventory.TotalAmount.ToString("N0") đ</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
        <div class="card-footer">
            <div class="row">
                <div class="col-xl-3 col-lg-3 col-md-3">
                    <button type="button" class="btn btn-outline-dark light" onclick="window.location.href = '@Url.Action("InventoryImportView", "InventoryImport")'">Quay lại</button>
                </div>
                @if (Model.Inventory.Status.Code == "W")
                {
                    <div class="col-xl-9 col-lg-9 col-md-9 d-flex justify-content-end">
                        <button type="button" class="btn btn-outline-danger" id="btnRemove">Xóa</button>
                        <button type="button" class="btn btn-outline-primary" id="btnReject">Từ chối</button>
                        <button type="button" class="btn btn-primary" id="btnConfirm">Xác nhận</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
@section scripts{
    <script>
        $(document).ready(function () {
            MyCreateDataTable("SearchListDataTable");
        });

        $('#btnReject').on('click', function () {
            $.get('@Url.Action("RejectInventoryImportView", "InventoryImport")', {
                ID: $("#Inventory_ID").val()
            }, function (data) {
                $('#modal-ViewModal-html').html(data);
                $('#ViewModal').modal('show');
            });
        });

        $("#btnConfirm").on('click', function () {
            swal({
                title: 'Thông báo',
                text: "Bạn chắc chắn xác nhận phiếu nhập kho?",
                buttons: {
                    confirm: {
                        text: "Xác nhận",
                        value: true,
                        visible: true,
                        className: "btn btn-primary",
                        closeModal: true
                    },
                    cancel: {
                        text: "Đóng",
                        value: false,
                        visible: true,
                        className: "btn btn-danger",
                        closeModal: true,
                    }
                },
            }).then((value) => {
                if (value) {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("JAcceptInventoryImport", "InventoryImport")',
                        data: {
                            InventoryImportID: $("#Inventory_ID").val()
                        },
                        dataType: 'json',
                        success: function (res) {
                            if (res.Code == "00") {
                                CreateCustomSwal("success", res.Message, '@Url.Action("InventoryImportView", "InventoryImport")');
                            } else {
                                CreateCustomSwal("error", res.Message);
                            }
                        },
                        error: function (xhr, status, error) {
                            var err = eval("(" + xhr.responseText + ")");
                            swal({
                                title: 'Lỗi',
                                text: err.Message,
                                button: {
                                    text: "ĐÓNG",
                                    value: true,
                                    visible: true,
                                    className: "btn btn-primary"
                                }
                            });
                            return;
                        }
                    });
                }
            });
        });

        $("#btnRemove").on("click", function () {
            swal({
                title: 'Thông báo',
                text: "Bạn chắc chắn muốn xoá phiếu nhập kho?",
                buttons: {
                    confirm: {
                        text: "Xác nhận",
                        value: true,
                        visible: true,
                        className: "btn btn-primary",
                        closeModal: true
                    },
                    cancel: {
                        text: "Đóng",
                        value: false,
                        visible: true,
                        className: "btn btn-danger",
                        closeModal: true,
                    }
                },
            }).then((value) => {
                if (value) {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("JRemoveInventoryImport", "InventoryImport")',
                        dataType: 'json',
                        loading: true,
                        data: {
                            InventoryImportID: $("#Inventory_ID").val()
                        },
                        success: function (res) {
                            if (res.Code == "00") {
                                CreateCustomSwal("success", res.Message, '@Url.Action("InventoryImportView", "InventoryImport")');
                            } else {
                                CreateCustomSwal("error", res.Message);
                            }
                        },
                        error: function (xhr, status, error) {
                            var err = eval("(" + xhr.responseText + ")");
                            swal({
                                title: 'Lỗi',
                                text: err.Message,
                                button: {
                                    text: "ĐÓNG",
                                    value: true,
                                    visible: true,
                                    className: "btn btn-primary"
                                }
                            });
                            return;
                        }
                    });
                }
            });
        });
    </script>
}

