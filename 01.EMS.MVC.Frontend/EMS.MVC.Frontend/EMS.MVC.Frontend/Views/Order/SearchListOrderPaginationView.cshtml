<script>
    $(document).ready(function () {
        var SearchOrderStatus = '@ViewBag.SearchOrderStatus';
        var CheckCustomerCode = '@ViewBag.CheckCustomerCode';
        if ('@ViewBag.ReloadStatusNumber' == "Y") {
            LoadCountStatus();
        }
    });

    $("#SelectAll").on("click", function (e) {
        MySelectAllDataTable(this, "SearchListDataTable", 0);
    });

    function chbSelectData(this1) {
        var isChecked = $(this1).is(":checked");
        var BatchCode = $(this1).attr("data-BatchCode");

        $(this1).closest('.ems-order-card').toggleClass('is-checked', isChecked);

        if (BatchCode) {
            $('.ems-order-select').filter(function () {
                return $(this).attr('data-BatchCode') == BatchCode;
            }).each(function () {
                $(this).prop('checked', isChecked);
                $(this).closest('.ems-order-card').toggleClass('is-checked', isChecked);
            });
        }
    }

    function markOrderCardSelected(element) {
        $('.ems-order-card').removeClass('is-selected');
        $(element).closest('.ems-order-card').addClass('is-selected');
    }

    function LoadCountStatus() {
        var data = @Html.Raw(Json.Encode(ViewBag.OrderStatusNumber));
        var TotalOrder = 0;
        for (var i = 0; i < data.length; i++) {
            if (data[i].Count >= 1000) {
                $("#OrderStatus" + data[i].Status).text("(999+)");
            } else {
                $("#OrderStatus" + data[i].Status).text("(" + data[i].Count + ")");
            }
            if (data[i].Status != "C" && data[i].Status != "D" && data[i].Status != "L") {
                //Trạng thái đơn hàng khác đã huỷ, đơn nháp và tại cửa hàng thì tính tổng
                TotalOrder += data[i].Count;
            }
        }
        if (TotalOrder >= 1000) {
            $("#StatusAll").text("(999+)");
        } else {
            $("#StatusAll").text("(" + TotalOrder + ")");
        }
    }

    function btnSearchCode(OrderCodeOrShippingCode, ShopID) {
            if (OrderCodeOrShippingCode) {
                $.post('@Url.Action("InfoShippingView","Handle")', {
                    ShippingCode: OrderCodeOrShippingCode, ShopID: ShopID
                }, function (data) {
                    $("#ShowDetailShippingView").html(data);
                });
            }
    };

    function btnDetailOrder(OrderID, ShopID) {
        $.post('@Url.Action("DetailOrderView", "Order")', {
            OrderID: OrderID, ShopID: ShopID
        }, function (data) {
            $('#modal-ViewModal-html').html(data);
            $('#ViewModal').modal('show');
        });
    }

    function btnDetailOrderBatch(BatchCode, ShopID) {
        $.post('@Url.Action("DetailOrderBatchView", "OrderBatch")', {
            BatchCode: BatchCode, ShopID: ShopID
        }, function (data) {
            $('#modal-ViewModal-html').html(data);
            $('#ViewModal').modal('show');
        });
    }

    function btnEditOrder(OrderID, BatchCode) {
        var param = "";
        if (BatchCode) {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("CheckEditOrderBatch", "OrderBatch")',
                dataType: 'json',
                loading: true,
                data: {
                    SearchKey: btoa(BatchCode)
                },
                success: function (res) {
                    if (res.Code == "00") {
                        localStorage.setItem('EditOrderBatchView', res.Data);
                        window.location.href = '@Url.Action("HandleEditOrderBatchView", "OrderBatch")';
                        //window.location.href = '@Url.Action("EditOrderBatchView", "OrderBatch")?SearchKey=' + btoa(BatchCode);
                    } else {
                        CreateCustomSwal("error", res.Message);
                    }
                }
            });
        } else {
            param = String.format("SearchKey={0}", btoa(OrderID));
            window.location.href = '@Url.Action("EditOrderView", "Order")?' + param;
        }
    }

    function btnCoppyOrder(OrderID, BatchCode) {
        var param = "";
        if (BatchCode) {
            param = String.format("SearchKey={0}", btoa(BatchCode));
            window.location.href = '@Url.Action("CoppyOrderBatchView", "OrderBatch")?' + param;
        } else {
            param = String.format("SearchKey={0}", btoa(OrderID));
            window.location.href = '@Url.Action("CoppyOrderView", "Order")?' + param;
        }
    }

    function btnRequestSupport(ShippingCode) {
        $.post('@Url.Action("AddRequestSupportView", "RequestSupport")', {
            EShippingCode: ShippingCode
        }, function (html) {
            $('#modal-ViewModal-html').html(html);
            $('#ViewModal').modal('show');
        });
    }

    function btnSignaruteAndImageInfo(ShippingCode, SearchKey) {
        $.post('@Url.Action("InformationSignaruteAndImageOrderView", "Order")', {
            ShippingCode: ShippingCode,
            SearchKey: SearchKey
        }, function (html) {
            $('#modal-ViewModal-html').html(html);
            $('#ViewModal').modal('show');
        });
    }

    function btnEditReceiverAddress(OrderID, OrderCode, BatchCode, ProvinceID, DistrictID, WardID, Street) {
        var data = {
            OrderID: OrderID,
            OrderCode, OrderCode,
            BatchCode, BatchCode,
            ReceiverProvinceID: ProvinceID,
            ReceiverDistrictID: DistrictID,
            ReceiverWardID: WardID,
            ReceiverStreet: Street
        };

        $.post('@Url.Action("EditOrderReceiverAddressView", "Order")', data, function (html) {
            $('#modal-ViewModal-html').html(html);
            $('#ViewModal').modal('show');
        });
    }
    // Length change -> gọi lại hàm btnSearch ở View cha, truyền PageIndex/PageSize
    $(document).off("change", "#dtLength").on("change", "#dtLength", function () {
        var ps = parseInt(this.value, 10) || 20;
        var status = $('.nav-link.active').data('status');
        if (window.btnSearch) window.btnSearch(status, 1, ps);
    });

    // Pager click -> gọi lại btnSearch(PageIndex,...)
    $(document).off("click", ".js-goto-page").on("click", ".js-goto-page", function (e) {
        e.preventDefault();
        var p = parseInt($(this).data("page"), 10);
        if (!p || p < 1) return;
        var ps = parseInt($("#dtLength").val(), 10) || 20;
        var status = $('.nav-link.active').data('status');
        if (window.btnSearch) window.btnSearch(status, p, ps);
    });
</script>