                            ID: 0
                        },
                    },
                    Receiver: {
                        ID: 0,
                        Province: {
                            ID: 0
                        },
                        Ward: {
                            ID: 0
                        },
                    },
                    Weight: NumberReplace($('#Weight').val()),
                    Length: $('#Length').val(),
                    Width: $('#Width').val(),
                    Height: $('#Height').val(),
                    Quantity: NumberReplace($('#Quantity').val()),
                    OrderValue: NumberReplace($('#OrderValue').val()),
                    TotalCOD: NumberReplace($('#TotalCOD').val()),
                    IsLoad: "Y"
                };

                if (ReceiverID > 0) {
                    data.Sender.Province.ID = $('#Sender_Province_ID').val();
                    data.Sender.Ward.ID = $('#Sender_Ward_ID').val();

                    data.Receiver.ID = ReceiverID;
                    data.Receiver.Province.ID = $('#Receiver_Province_ID').val();
                    data.Receiver.Ward.ID = $('#Receiver_Ward_ID').val();
                }
            }

            if (!data.MainTransportServiceID || !data.Sender.Province.ID || !data.Receiver.Province.ID || !data.Weight) {
                $("#errTemporaryTransportServiceFee").text("Chưa đủ thông tin để tính cước");
            } else {
                $.post('@Url.Action("TemporaryTransportServiceFeeView", "Order")', data, function (data) {
                    $('#TemporaryTransportServiceFee').html(data);
                });
            }
        }

