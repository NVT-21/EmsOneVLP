            } else if (DivID == "TotalPHU") {
                if (data.TotalPHU == 0) {
                    $('#errTotalPHU').text("Vui lòng nhập tiền thu phí hủy đơn");
                    isError = true;
                } else {
                    $('#errTotalPHU').text("");
                }
            } else if (DivID == "Weight") {
                if (data.Weight == 0) {
                    $('#errWeight').text("Vui lòng nhập trọng lượng.");
                    isError = true;
                } else {
                    $('#errWeight').text("");
                }
            } else if (DivID == "OrderValue") {
                if (data.Sender.Province.ID == undefined || data.Sender.Province.ID == "" || data.Receiver.Province.ID == undefined || data.Receiver.Province.ID == "") {
                    isError = true;
                } else {
                    if (data.OrderValue > 100000000) {
                        $('#errOrderValue').text('Giá trị đơn hàng không vượt quá 100 triệu đồng.');
                        isError = true;
                    }

                    if (ListProduct.length == 0 && data.TotalCOD == 0) {
                        $("#TotalMoney").text(NumberFormat(data.OrderValue));
                        //$("#TotalOrderValue").text(NumberFormat(data.OrderValue));
                        TotalMoney = data.OrderValue;
                        TotalOrderValue = data.OrderValue;
                    }
