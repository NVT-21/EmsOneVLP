                data = {
                    MainTransportServiceID: parseInt($('#MainTransportServiceID').val()),
                    ExtraTransportServiceID: $('#ExtraTransportServiceID').val().toString(),
                    Sender: {
                        Province: {
                            ID: 0
                        },
