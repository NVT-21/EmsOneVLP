        function SearchDateExpectedDelivery() {
            if (ExpectedDeliveryDateTemp) {
                ExpectedDeliveryDateTemp = "";
                return;
            }

            var req = {
                Date: "",
                TransportServiceID: parseInt($('#MainTransportServiceID').val()),
                SenderProvinceID: parseInt($("#Sender_Province_ID").val()),
                ReceiverProvinceID: parseInt($("#Receiver_Province_ID").val()),
            }

            if (req.TransportServiceID <= 0 || req.SenderProvinceID <= 0 || req.ReceiverProvinceID <= 0 ) {
                return;
            }

            $.ajax({
                type: 'POST',
                url: '@Url.Action("SearchDateExpectedDelivery", "Handle")',
                dataType: 'json',
                loading: true,
                data: req,
                beforeSend: function () {
                    ExpectedDeliveryDate = "";
                },
                success: function (res) {
                    if (res.Code == "00") {
                        ExpectedDeliveryDate = res.Data;
                        $("#ShowExpectedDelivery").html("Thời gian giao hàng dự kiến: <span class='text-secondary'>" + res.Data.split(' ')[0] + "</span>");
                    } else if (res.Code == "01") {
                        $("#ShowExpectedDelivery").html("Thời gian giao hàng dự kiến: <span class='text-secondary'>" + res.Message + "</span>");
                    } else {
                        $("#ShowExpectedDelivery").html("");
                    }
                },
                error: function (xhr, status, error) {
                    var err = eval("(" + xhr.responseText + ")");
                    swal({
                        title: 'Lỗi',
                        text: err.Message,
                        button: {
                            text: "ĐÓNG",
                            value: true,
                            visible: true,
                            className: "btn btn-primary"
                        }
                    });
                    return;
                }
            });
        }

        function LoadTotalPrice() {
            var OrderName = "";
            var TotalProduct = 0;
            var TotalPrice = 0;
            var TotalWeight = 0;

            $('.row-item').each(function () {
                if (!OrderName) {
                    OrderName = $(this).attr("data-ProductName");
                }
                var VariantID = $(this).attr("data-VariantID");
                var PriceProduct = parseInt($(this).attr("data-PriceProduct"));
                var SearchNumberOfProduct = parseInt($("#NumberOfProduct_" + VariantID).val());
                var SearchTotalPrice = PriceProduct * SearchNumberOfProduct;
                var SearchTotalWeight = parseInt($(this).attr("data-Weight")) * SearchNumberOfProduct;
                TotalProduct += SearchNumberOfProduct;
                TotalPrice += SearchTotalPrice;
                TotalWeight += SearchTotalWeight;

                $("#TotalPrice_" + VariantID).text(SearchTotalPrice.toLocaleString());
            });

            $("#OrderName").val(OrderName);
            $("#Quantity").val(TotalProduct); // Số lượng sản phẩm
            $("#OrderValue").val(TotalPrice); // Giá trị đơn hàng
            $("#TotalCOD").val(TotalPrice); // Tiền thu hộ
            $("#Weight").val(TotalWeight); // Khối lượng

            //$("#TotalDiscount").text("0"); // Giá giảm
            $("#TotalMoney").text(TotalPrice.toLocaleString());
            //$("#TotalOrderValue").text(TotalPrice.toLocaleString());

            if ($("input[name='IsTransport']:checked").val() == "Y") {
                LoadTotalFee(null);
            }

            TotalMoney = TotalPrice;
            TotalOrderValue = TotalPrice;
        }

        function LoadTotalFee(data) {
