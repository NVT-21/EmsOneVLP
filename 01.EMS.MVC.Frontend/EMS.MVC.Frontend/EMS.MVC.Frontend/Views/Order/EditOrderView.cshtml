@model EMS.MVC.Frontend.Models.EditOrderViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid pb-100">
    <div class="order">
        <div class="order-left CustomScrollBar" data-bs-spy="scroll" data-bs-target="#ListTab" data-bs-offset="10" style="overflow: auto; height: 740px; padding-right: 0; margin-right: 10px;">

            <div class="card" id="TabCustomer">
                <div class="card-body">
                    <h5 class="card-title">Thông tin khách hàng</h5>
                    <div class="row">
                        <div class="col-xl-4 col-lg-6 col-md-12 mb-2">
                            <div class="form-search">
                                <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M18.9842 17.6825L15.8675 14.575C16.8731 13.2939 17.4187 11.7119 17.4167 10.0833C17.4167 8.63294 16.9866 7.21512 16.1808 6.00916C15.375 4.80319 14.2297 3.86326 12.8897 3.30822C11.5497 2.75318 10.0752 2.60795 8.65268 2.89091C7.23015 3.17387 5.92347 3.8723 4.89789 4.89789C3.8723 5.92347 3.17387 7.23015 2.89091 8.65268C2.60795 10.0752 2.75318 11.5497 3.30822 12.8897C3.86326 14.2297 4.80319 15.375 6.00916 16.1808C7.21512 16.9866 8.63294 17.4167 10.0833 17.4167C11.7119 17.4187 13.2939 16.8731 14.575 15.8675L17.6825 18.9842C17.7677 19.0701 17.8691 19.1383 17.9808 19.1848C18.0925 19.2314 18.2123 19.2553 18.3333 19.2553C18.4543 19.2553 18.5742 19.2314 18.6859 19.1848C18.7976 19.1383 18.899 19.0701 18.9842 18.9842C19.0701 18.899 19.1383 18.7976 19.1848 18.6859C19.2314 18.5742 19.2553 18.4543 19.2553 18.3333C19.2553 18.2123 19.2314 18.0925 19.1848 17.9808C19.1383 17.8691 19.0701 17.7677 18.9842 17.6825V17.6825ZM4.58334 10.0833C4.58334 8.99554 4.90591 7.93217 5.51025 7.0277C6.1146 6.12323 6.97358 5.41828 7.97858 5.002C8.98357 4.58572 10.0894 4.4768 11.1563 4.68902C12.2232 4.90124 13.2032 5.42506 13.9724 6.19425C14.7416 6.96344 15.2654 7.94345 15.4777 9.01034C15.6899 10.0772 15.581 11.1831 15.1647 12.1881C14.7484 13.1931 14.0434 14.0521 13.139 14.6564C12.2345 15.2608 11.1711 15.5833 10.0833 15.5833C8.62465 15.5833 7.2257 15.0039 6.19425 13.9724C5.1628 12.941 4.58334 11.542 4.58334 10.0833Z"
                                          fill="#86909C" />
                                </svg>
                                @*<select id="SearchCustomer">
                                        <option value="@Model.Buyer.MobileNumber" selected="selected">@Model.Buyer.FullName</option>
                                    </select>*@
                                @Html.EditorFor(model => model.Buyer.MobileNumber, new { htmlAttributes = new { @type = "text", @id = "SearchCustomer", @class = "form-control", @placeholder = "Tìm thông tin KH" } })
                                <span class="text-danger" id="errSearchCustomer"></span>
                            </div>
                        </div>
                        <div class="col-xl-4 col-lg-6 col-md-8 mb-2">
                            <button class="btn btn-secondary text-white font-w600" onclick="ShowAddCustomerView()">
                                <i class="ti-plus"></i>
                                Thêm mới khách hàng
                            </button>
                        </div>
                    </div>
                    <div id="ShowSearchCustomerView">
                        @{
                            Html.RenderAction("SearchCustomerView", "Order", new { Sender = Model.Sender, Receiver = Model.Receiver, PickUpAddressID = Model.Sender.PickUpAddressID, MobileNumber = Model.Buyer.MobileNumber, IsTransport = Model.IsTransport, CollectionPostOfficeRecentID = Model.CollectionPostOfficeRecentID });
                        }
                    </div>
                </div>
            </div>

            <div class="card" id="TabProduct">
                <div class="card-body">
                    <h5 class="card-title">Thông tin sản phẩm</h5>
                    <div class="row">
                        <div class="col-xl-4 col-lg-6 col-md-12 mb-2">
                            <label class="mb-1">Sản phẩm</label>
                            <div class="form-search">
                                <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M18.9842 17.6825L15.8675 14.575C16.8731 13.2939 17.4187 11.7119 17.4167 10.0833C17.4167 8.63294 16.9866 7.21512 16.1808 6.00916C15.375 4.80319 14.2297 3.86326 12.8897 3.30822C11.5497 2.75318 10.0752 2.60795 8.65268 2.89091C7.23015 3.17387 5.92347 3.8723 4.89789 4.89789C3.8723 5.92347 3.17387 7.23015 2.89091 8.65268C2.60795 10.0752 2.75318 11.5497 3.30822 12.8897C3.86326 14.2297 4.80319 15.375 6.00916 16.1808C7.21512 16.9866 8.63294 17.4167 10.0833 17.4167C11.7119 17.4187 13.2939 16.8731 14.575 15.8675L17.6825 18.9842C17.7677 19.0701 17.8691 19.1383 17.9808 19.1848C18.0925 19.2314 18.2123 19.2553 18.3333 19.2553C18.4543 19.2553 18.5742 19.2314 18.6859 19.1848C18.7976 19.1383 18.899 19.0701 18.9842 18.9842C19.0701 18.899 19.1383 18.7976 19.1848 18.6859C19.2314 18.5742 19.2553 18.4543 19.2553 18.3333C19.2553 18.2123 19.2314 18.0925 19.1848 17.9808C19.1383 17.8691 19.0701 17.7677 18.9842 17.6825V17.6825ZM4.58334 10.0833C4.58334 8.99554 4.90591 7.93217 5.51025 7.0277C6.1146 6.12323 6.97358 5.41828 7.97858 5.002C8.98357 4.58572 10.0894 4.4768 11.1563 4.68902C12.2232 4.90124 13.2032 5.42506 13.9724 6.19425C14.7416 6.96344 15.2654 7.94345 15.4777 9.01034C15.6899 10.0772 15.581 11.1831 15.1647 12.1881C14.7484 13.1931 14.0434 14.0521 13.139 14.6564C12.2345 15.2608 11.1711 15.5833 10.0833 15.5833C8.62465 15.5833 7.2257 15.0039 6.19425 13.9724C5.1628 12.941 4.58334 11.542 4.58334 10.0833Z"
                                          fill="#86909C" />
                                </svg>
                                <input type="text" class="form-control " placeholder="Tìm theo tên sản phẩm" id="SearchProduct">
                            </div>
                        </div>
                        <div class="col-xl-4 col-lg-6 col-md-12 mb-2">
                            <label class="mb-1">Xuất kho <span class="text-danger">*</span></label>
                            @Html.DropDownListFor(model => model.WareHouseID, new SelectList(Model.ListWareHouse, "ID", "WareHouseName"), new { @class = "select2" })
                        </div>
                        <div class="col-xl-12 col-lg-12 col-md-12">
                            <div id="ShowSearchListProductView">
                                @if (Model.ListProduct.Count > 0)
                                {
                                    Html.RenderAction("SearchListProductView", "Order", new { model = Model.ListProduct });
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card" id="TabTransport">
                <div class="card-body">
                    <h5 class="card-title">Thông tin vận chuyển</h5>
                    <div class="row">
                        <div class="col-xl-12 col-lg-12 col-md-12 mb-2">
                            <label class="mb-1">Loại hình kinh doanh:</label>
                            <div class="form-check form-check-inline">
                                @Html.RadioButtonFor(m => m.IsTransport, "Y", new { @class = "form-check-input" })
                                @*<input type="radio" class="form-check-input" id="IsTransport" name="IsTransport" value="Y" @{if (Model.IsTransport == "Y") { Write("checked"); }} />*@
                                <label class="form-check-label" for="12">
                                    Vận chuyển hàng
                                </label>
                            </div>
                            <div class="form-check form-check-inline">
                                @Html.RadioButtonFor(m => m.IsTransport, "N", new { @class = "form-check-input" })
                                @*<input type="radio" class="form-check-input" id="IsTransport" name="IsTransport" value="N" @{if (Model.IsTransport == "N") { Write("checked"); }} />*@
                                <label class="form-check-label " for="22">
                                    Bán tại cửa hàng
                                </label>
                            </div>
                            <span class="text-danger" id="errIsTransport"></span>
                        </div>
                        <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                            <label class="mb-1">Mã đơn hàng</label>
                            @Html.EditorFor(model => model.OrderCode, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Mã đơn hàng", @maxlength = "70" } })
                            <span class="text-danger" id="errOrderCode"></span>
                        </div>
                        <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                            <label class="mb-1">Tên đơn hàng</label>
                            @Html.EditorFor(model => model.OrderName, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Tên đơn hàng", @maxlength = "150" } })
                            <span class="text-danger" id="errOrderName"></span>
                        </div>
                        <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                            <div class="custom-props">
                                <label class="mb-1">Giá trị đơn hàng</label>
                                @Html.EditorFor(model => model.OrderValue, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Giá trị đơn hàng", @maxlength = "11", @data_inputmask = "'alias': 'currency'" } })
                                <span class="props">đ</span>
                            </div>
                            <span class="text-danger" id="errOrderValue"></span>
                        </div>
                        <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                            <label class="mb-1">Số lượng sản phẩm</label>
                            @Html.EditorFor(model => model.Quantity, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Số lượng sản phẩm", @maxlength = "3", @data_inputmask = "'alias': 'PositiveNumber'" } })
                            <span class="text-danger" id="errQuantity"></span>
                        </div>
                    </div>
                    <div class="ShowTransport @{ if (Model.IsTransport == "N") { Write("d-none"); } }">
                        <div class="row">
                            <div class="col-xl-9 col-lg-9 col-md-9 mb-2">
                                <label class="mb-1">Kích thước (Dài x Rộng x Cao)</label>
                                <div class="row">
                                    <div class="col-xl-4 col-lg-4 col-md-4 mb-2">
                                        <div class="custom-props">
                                            @Html.EditorFor(model => model.Length, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Dài", @maxlength = "4", @data_inputmask = "'alias': 'PositiveDecimal'" } })
                                            <span class="props">cm</span>
                                        </div>
                                        <span class="text-danger" id="errLength"></span>
                                    </div>
                                    <div class="col-xl-4 col-lg-4 col-md-4 mb-2">
                                        <div class="custom-props">
                                            @Html.EditorFor(model => model.Width, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Rộng", @maxlength = "4", @data_inputmask = "'alias': 'PositiveDecimal'" } })
                                            <span class="props">cm</span>
                                        </div>
                                        <span class="text-danger" id="errWidth"></span>
                                    </div>
                                    <div class="col-xl-4 col-lg-4 col-md-4 mb-2">
                                        <div class="custom-props">
                                            @Html.EditorFor(model => model.Height, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Cao", @maxlength = "4", @data_inputmask = "'alias': 'PositiveDecimal'" } })
                                            <span class="props">cm</span>
                                        </div>
                                        <span class="text-danger" id="errHeight"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xl-3 col-lg-3 col-md-3 mb-2">
                                <div class="custom-props">
                                    <label class="mb-1">Khối lượng <span class="text-danger">*</span></label>
                                    @Html.EditorFor(model => model.Weight, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Khối lượng", @maxlength = "9", @data_inputmask = "'alias': 'PositiveNumber'" } })
                                    <span class="props">gr</span>
                                </div>
                                <span class="text-danger" id="errWeight"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xl-6 col-lg-6 col-md-6 mb-2">
                                <label class="mb-1">Hình thức thu gom <span class="text-danger">*</span></label>
                                <div>
                                    <div class="form-check form-check-inline">
                                        @Html.RadioButtonFor(m => m.CollectionType.ID, 1, new { @class = "form-check-input" })
                                        <label class="form-check-label" for="13">
                                            Thu gom tận nơi
                                        </label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        @Html.RadioButtonFor(m => m.CollectionType.ID, 2, new { @class = "form-check-input" })
                                        <label class="form-check-label " for="23">
                                            Gửi hàng tại bưu cục
                                        </label>
                                    </div>
                                </div>
                                <div id="ShowCollectionPostOfficeRecent" class="mt-2"></div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-6 mb-2">
                                <label class="mb-1">Người trả cước <span class="text-danger">*</span></label>
                                <div>
                                    <div class="form-check form-check-inline">
                                        @Html.RadioButtonFor(m => m.TransportPayer, 1, new { @class = "form-check-input", @id = "TransportPayer1" })
                                        <label class="form-check-label">
                                            Shop trả
                                        </label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        @Html.RadioButtonFor(m => m.TransportPayer, 2, new { @class = "form-check-input", @id = "TransportPayer2" })
                                        <label class="form-check-label ">
                                            Người nhận
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xl-6 col-lg-6 col-md-6 mb-2">
                                <label class="mb-1">Dịch vụ vận chuyển chính <span class="text-danger">*</span></label>
                                <select id="MainTransportServiceID" class="select2">
                                    <option value="0">-- Chọn --</option>
                                    @foreach (var item in Model.ListMainTransportService)
                                    {
                                        if (item.ID == Model.MainTransportServiceID)
                                        {
                                            <option value="@item.ID" title="@item.Description" selected>@item.Name</option>

                                        }
                                        else
                                        {
                                            <option value="@item.ID" title="@item.Description">@item.Name</option>
                                        }
                                    }
                                </select>
                                @*@Html.DropDownListFor(model => model.MainTransportServiceID, new SelectList(Model.ListMainTransportService, "ID", "Name"), "-- Chọn --", new { @class = "select2" })*@
                                <span class="text-danger" id="errMainTransportServiceID"></span>
                                <div class="text-italic" id="ShowExpectedDelivery" style="text-align: justify;">
                                    Thời gian giao hàng dự kiến:
                                    <span class="text-secondary">
                                        @if (!string.IsNullOrEmpty(Model.ExpectedDeliveryDate))
                                        {
                                            Write(Model.ExpectedDeliveryDate.Split(' ')[0]);
                                        }
                                    </span>
                                </div>
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-6 mb-2">
                                <label class="mb-1">Dịch vụ vận chuyển cộng thêm </label>
                                @Html.DropDownListFor(model => model.ExtraTransportServiceID, new SelectList(Model.ListExtraTransportService, "ID", "Name"), new { @class = "selectpicker form-control form-control-sm", @data_live_search = "true", @data_dropup_auto = "false", @data_size = "8", @data_selected_text_format = "count", @data_actions_box = "true", @multiple = "true" })
                                <span class="text-danger" id="errExtraTransportServiceID"></span>
                            </div>
                        </div>
                        <div class="row">
                            <div id="ShowTotalCOD" class="col-xl-6 col-lg-6 col-md-6 mb-2 @{if (!Model.ExtraTransportServiceID.Contains("108")){ Write("d-none"); }}">
                                <div class="custom-props">
                                    <label class="mb-1">Tiền thu hộ <span class="text-danger">*</span></label>
                                    @Html.EditorFor(model => model.TotalCOD, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Tiền thu hộ", @data_inputmask = "'alias': 'currency'", @maxlength = "10" } })
                                    <span class="props">đ</span>
                                </div>
                                <span class="text-danger" id="errTotalCOD"></span>
                            </div>
                            <div id="ShowTotalPHU" class="col-xl-6 col-lg-6 col-md-6 mb-2 @{if (!Model.ExtraTransportServiceID.Contains("421")){ Write("d-none"); }}">
                                <div class="custom-props">
                                    <label class="mb-1">Thu phí hủy đơn <span class="text-danger">*</span></label>
                                    @Html.EditorFor(model => model.TotalPHU, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Thu phí hủy đơn", @data_inputmask = "'alias': 'currency'", @maxlength = "11" } })
                                    <span class="props">đ</span>
                                </div>
                                <span class="text-danger" id="errTotalPHU"></span>
                            </div>
                        </div>
                        <div class="divider"></div>
                        <p class="font-w500">Cước tạm tính (Đã bao gồm VAT)</p>
                        <div class="row" id="TemporaryTransportServiceFee">
                            @{
                                Html.RenderAction("TemporaryTransportServiceFeeView", "Order", new { MainTransportServiceID = Model.MainTransportServiceID, ExtraTransportServiceID = Model.ExtraTransportServiceID, Sender = Model.Sender, Receiver = Model.Receiver, Weight = Model.Weight, Length = Model.Length, Width = Model.Width, Height = Model.Height, Quantity = Model.Quantity, OrderValue = Model.OrderValue, TotalCOD = Model.TotalCOD, IsLoad = "Y" });
                            }
                        </div>
                    </div>
                    <div class="divider"></div>
                    <div class="row">
                        <div class="col-xl-6 col-lg-6 col-md-6 mb-2">
                            <label class="mb-1">Ghi chú đơn hàng</label>
                            <textarea class="form-control" id="Note" placeholder="Nhập ghi chú đơn hàng. Tối đa 250 ký tự" maxlength="250" rows="2">@Model.Note.Replace("<br />", "\n")</textarea>
                        </div>
                        <div class="col-xl-6 col-lg-6 col-md-6 mb-2">
                            <label class="mb-1">Nội dung đơn hàng</label>
                            <textarea class="form-control" id="Message" placeholder="Nhập nội dung đơn hàng. Tối đa 250 ký tự" maxlength="250" rows="2">@Model.Message.Replace("<br />", "\n")</textarea>
                        </div>
                        <div class="col-xl-6 col-lg-6 col-md-6 mb-2">
                            <label class="mb-1">Kênh bán hàng</label>
                            @Html.DropDownListFor(model => model.Channel, new SelectList(Model.ListChannel, "Value", "Text"), new { @class = "select2" })
                        </div>
                        <div class="col-xl-6 col-lg-6 col-md-6 mb-2">
                            @*<label class="mb-1">Mã giảm giá</label>
                                <div class="input-group">
                                    <input type="text" class="form-control">
                                    <button class="btn btn-secondary" type="button">Áp dụng</button>
                                </div>*@
                        </div>
                        <div class="col-xl-6 col-lg-6 col-md-6 mt-3">
                            <table class="table table-clear">
                                <tbody>
                                    <tr>
                                        <td class="left"><strong>Tổng tiền hàng</strong></td>
                                        <td class="right"><span id="TotalMoney">@Model.TotalMoney.ToString("N0")</span>đ</td>
                                    </tr>
                                    @*<tr>
                                            <td class="left"><strong>Tổng giá giảm</strong></td>
                                            <td class="right"><span id="TotalDiscount">@Model.TotalDiscount.ToString("N0")</span>đ</td>
                                        </tr>
                                        <tr>
                                            <td class="left"><strong>Tổng sau giảm</strong></td>
                                            <td class="right">
                                                <strong id="TotalOrderValue">@Model.TotalOrderValue.ToString("N0")</strong><strong>đ</strong><br>
                                            </td>
                                        </tr>*@
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <div class="order-right">
            <div id="ListTab" class="list-group bg-white">
                <a class="list-group-item list-group-item-action" href="#TabCustomer">Thông tin khách hàng</a>
                <a class="list-group-item list-group-item-action" href="#TabProduct">Thông tin sản phẩm</a>
                <a class="list-group-item list-group-item-action" href="#TabTransport">Thông tin vận chuyển</a>
            </div>
        </div>
    </div>
</div>
<div class="bottom-group">
    <div class="float-end">
        @if (Model.OrderStatus == "D")
        {
            <button type="button" class="btn btn-outline-dark" onclick="btnAddOrder(3, 'DRAFT')">Cập nhật</button>
            <button type="button" class="btn btn-outline-primary" onclick="btnAddOrder(1, 'CREATE')">Tạo đơn hàng</button>
        }
        else
        {
            <button type="button" class="btn btn-primary" onclick="btnAddOrder(1, 'UPDATE')">Cập nhật</button>
        }
    </div>
</div>
@section scripts{
    <script>
        var TotalMoney = @Model.TotalMoney, TotalOrderValue = @Model.TotalOrderValue, TransportFee = 0, ExpectedDeliveryDate = "@Model.ExpectedDeliveryDate", ExpectedDeliveryDateTemp = "@Model.ExpectedDeliveryDate";

        CheckChangeValue("Quantity", "Vui lòng nhập số lượng sản phẩm", "Number", "Y");
        CheckChangeValue("OrderValue", "", "Number", "N");

        CheckChangeValue("OrderCode", "", "SpecialCharButNotVietnamese", "N");

        CustomerAutocomplete("SearchCustomer");

        $(document).ready(function () {
            $("#ExtraTransportServiceID").selectpicker("refresh");
            $("#ExtraTransportServiceID").selectpicker("val", @Html.Raw(Json.Encode(Model.ExtraTransportServiceID.Split(','))));
            //$('input[name="IsTransport"]').change();
            $("#footer").addClass("d-none");
            $(".content-body").css("min-height", "");
        });

        $('#ExtraTransportServiceID').on('refreshed.bs.select', function () {
            var ListExtraTransportService = @Html.Raw(Json.Encode(Model.ListExtraTransportService));
            ListExtraTransportService.forEach(function (value, index) {
                $("#bs-select-1-" + index).attr("title", value.Description);
            });
        });

        $("input[name='TransportPayer']").on("change", function () {
            var value = $(this).val();
            if (value == 2) {
                $("#MainTransportServiceID").change();
            }
        });

        $("input[name='CollectionType.ID']").on("change", function () {
            SearchCollectionPostOfficeRecent();
        });

        $('input[name="IsTransport"]').on('change', function (e) {
            var IsTransport = $(this).val();
            if (IsTransport == "Y") {
                $(".ShowTransport").removeClass("d-none");
            } else if (IsTransport == "N") {
                $(".ShowTransport").addClass("d-none");
            }
        });

        $('#SearchCustomer').on("change", function () {
            SearchCustomer($(this).val().trim());
        });

