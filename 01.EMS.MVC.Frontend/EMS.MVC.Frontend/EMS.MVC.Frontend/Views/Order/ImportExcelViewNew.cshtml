        function excelExport() {
            var listDataExcel = showJSpreadSheet[0].getData(false, false);
            var filterDataExcel = listDataExcel.filter(function (element) { return element[0] != ""; });
            var numberOfExcel = filterDataExcel.length;
            var listDataExport = [];
            for (var i = 0; i < numberOfExcel; i++) {
                var item = filterDataExcel[i];
                var messageError = "";
                if (item[0] == "Lỗi" || item[0] == "Không hợp lệ") {
                    messageError = showJSpreadSheet[0].getComments(arrColumn[0] + Number(i + 1));
                }
                var obj = {
                    Product: showJSpreadSheet[0].getValueFromCoords(1, i, false),
                    OrderCode: item[2],
                    FullName: item[3],
                    MobileNumber: item[4],
                    Street: item[5].includes("(Vmapcode)") == true ? item[5].replace("(Vmapcode)", "").trim() : item[5],
                    ProvinceName: showJSpreadSheet[0].getValueFromCoords(6, i, true),
                    //DistrictName: showJSpreadSheet[0].getValueFromCoords(7, i, true),
                    WardName: showJSpreadSheet[0].getValueFromCoords(7, i, true),
                    Message: item[8],
                    NumberOfProduct: item[9],
                    Weight: item[10],
                    TotalCOD: item[11],
                    OrderValue: item[12],
                    Note: item[13],
                    TransportMainService: showJSpreadSheet[0].getValueFromCoords(14, i, true),
                    TransportExtraService: showJSpreadSheet[0].getValueFromCoords(15, i, true),
                    SenderName: item[16],
                    SenderMobileNumber: item[17],
                    SenderStreet: item[18].includes("(Vmapcode)") == true ? item[18].replace("(Vmapcode)", "").trim() : item[18],
                    SenderProvinceName: showJSpreadSheet[0].getValueFromCoords(19, i, true),
                    //SenderDistrictName: showJSpreadSheet[0].getValueFromCoords(21, i, true),
                    SenderWardName: showJSpreadSheet[0].getValueFromCoords(20, i, true),
                    CollectionType: showJSpreadSheet[0].getValueFromCoords(21, i, true),
                    TransportPayer: showJSpreadSheet[0].getValueFromCoords(22, i, true),
                    Long: item[23],
                    Width: item[24],
                    Height: item[25],
                    Channel: showJSpreadSheet[0].getValueFromCoords(26, i, true),
                    TotalPHU: item[27],
                    MessageError: messageError
                };
                listDataExport.push(obj);
            }

            if (listDataExport.length == 0) {
                CreateCustomSwal("error", "Không có dữ liệu để xuất Excel. Vui lòng kiểm tra lại.");
                return;
            };

            $.ajax({
                type: 'POST',
                url: '@Url.Action("JExportExcel", "Order")',
                data: {
                    ListData: listDataExport
                },
                xhrFields: {
                    responseType: 'blob'
                },
                success: function (data) {
                    var link = document.createElement('a');
                    link.href = window.URL.createObjectURL(data);
                    link.download = 'DanhSachDonHang.xlsm';
                    link.click();
                },
                error: function (xhr, status, error) {
                    var err = eval("(" + xhr.responseText + ")");
                    swal({
                        title: 'Lỗi',
                        text: err.Message,
                        button: {
                            text: "ĐÓNG",
                        }
                    });
                    return;
                }
            });
        }

        $("#Document").on('click', function () {
            var fileInput = document.getElementById('Document');
