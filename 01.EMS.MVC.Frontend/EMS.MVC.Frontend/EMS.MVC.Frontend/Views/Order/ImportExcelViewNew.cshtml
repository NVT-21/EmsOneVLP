        function excelResetComment(worksheet, column, row) {
            for (var i = 0; i < arrColumn.length; i++) {
                worksheet.setComments(arrColumn[i] + row, "");
            };
            worksheet.setValue(arrColumn[0] + row, '', true);
            excelSetStyle(worksheet, column, row, "Success");
            countData(worksheet);
        }

        function excelSetComment(worksheet, column, row) {
            var commentError = "";
            for (var i = 1; i < arrColumn.length; i++) {
                var iComment = worksheet.getComments(arrColumn[i] + row);
                if (iComment) {
                    commentError += iComment;
                }
            };
            worksheet.setComments(arrColumn[0] + row, commentError);

            if (commentError) {
                worksheet.setValue(arrColumn[0] + row, 'Không hợp lệ', true);
                excelSetStyle(worksheet, column, row, "Error");
            } else {
                worksheet.setValue(arrColumn[0] + row, 'Hợp lệ', true);
                excelSetStyle(worksheet, column, row, "Success");
            }

            countData(worksheet);
        }

        function excelSetStyle(worksheet, column, row, Type) {
            for (var i = 1; i < arrColumn.length; i++) {
                if (Type == "Reset") {
                    worksheet.resetStyle(arrColumn[i] + row);
                } else {
                    if (Type == "Success") {
                        if (worksheet.getStyle(arrColumn[i] + row) != "background-color: white") {
                            worksheet.setStyle(arrColumn[i] + row, "background-color", "white");
                        }
                    } else {
                        if (worksheet.getStyle(arrColumn[i] + row) != "background-color: yellow") {
                            worksheet.setStyle(arrColumn[i] + row, "background-color", "yellow");
                        }
                    }
                }
            };
        }

        function excelSetRowBlank(worksheet, column, row) {
            for (var i = 0; i < arrColumn.length; i++) {
                worksheet.resetStyle(arrColumn[i] + row);
                worksheet.setComments(arrColumn[i] + row, "");
            };
        }

        function countData(worksheet) {
            var columnStatus = worksheet.getColumnData(0);
            var filterColumnStatus = columnStatus.filter(function (element) { return element != ""; });
            var NumberOfSuccess = 0, NumberOfInvalid = 0, NumberOfError = 0;
            for (var i = 0; i < filterColumnStatus.length; i++) {
                switch (filterColumnStatus[i]) {
                    case "Hợp lệ":
                        NumberOfSuccess++;
                        break;
                    case "Không hợp lệ":
                        NumberOfInvalid++;
                        break;
                    case "Lỗi":
                        NumberOfError++;
                        break;
                }
            }

            totalData = NumberOfSuccess + NumberOfInvalid + NumberOfError;

            $('#NumberOfSuccess').html(NumberOfSuccess + "/" + totalData);
            $('#NumberOfInvalid').html(NumberOfInvalid + "/" + totalData);
            $('#NumberOfError').html(NumberOfError + "/" + totalData);
        }

        function SearchListAddressAutoComplete(x, y, value) {
            if (!excelUpload) {
                if (value.length >= 10) {
                    excelUpload = true;
                    var Row = Number(y + 1);
                    var Data = {};
                    Data = PWDGetByEMSVMapsSearch(value);
                    var Response = Data.responseJSON;
                    if (Response.Code == "00") {
                        var JSONParse = JSON.parse(Response.Data);
                        var isCheck = 0;
                        if (x == 5) {
                            showJSpreadSheet[0].setValue('F' + Row, value);
                            showJSpreadSheet[0].setValue('G' + Row, JSONParse.ProvinceID, true);
                            showJSpreadSheet[0].setCells('H' + Row, { type: 'dropdown', title: 'Phường/Xã', width: 200, source: [{ 'id': JSONParse.WardID, 'name': JSONParse.WardName }], filterOptions: FilterListWard, autocomplete: true, align: 'left' });
                            showJSpreadSheet[0].setValue('H' + Row, JSONParse.WardID, true);

                        } else if (x == 18) {
                            showJSpreadSheet[0].setValue('S' + Row, value);
                            
                            showJSpreadSheet[0].setValue('T' + Row, JSONParse.ProvinceID, true);

                            showJSpreadSheet[0].setCells('U' + Row, { type: 'dropdown', title: 'Phường/Xã', width: 200, source: [{ 'id': JSONParse.WardID, 'name': JSONParse.WardName }], filterOptions: FilterListWard, autocomplete: true, align: 'left' });
                            showJSpreadSheet[0].setValue('U' + Row, JSONParse.WardID, true);

                        }
                        excelUpload = false;
                    } else {
                        console.log("Lỗi phân tích địa chỉ: " + Response.Code + "||" + Response.Message);
                        excelUpload = false;
                    }
                }
            }
        };

