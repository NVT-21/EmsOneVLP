                TransportFee: TransportFee,
                Note: $('#Note').val().replaceAll("\n", "<br />"),
                Message: $('#Message').val().replaceAll("\n", "<br />"),
                Channel: "WEB",
                TotalMoney: TotalMoney,
                TotalDiscount: 0,
                TotalOrderValue: TotalOrderValue,
                AddType: AddType,
                OrderStatus: AddType == 3 ? "D" : null,
                TransportPayer: $("input[name='TransportPayer']:checked").val(),
                RequestOrderID: $('#RequestOrderID').val(),
                IsRequestOrder: $('#RequestOrderID').val() == 0 ? "N" : "Y",
                ExpectedDeliveryDate: ExpectedDeliveryDate,
                CollectionPostOfficeRecentID: $("#SearchListCollectionPostOfficeRecent").val() == undefined ? 0 : $("#SearchListCollectionPostOfficeRecent").val()
            };

            if (data.AddType == 1 || data.AddType == 2) {
                isError = CheckNullValue(data.Receiver.MobileNumber, "Receiver_MobileNumber", "Vui lòng nhập số điện thoại và tìm kiếm.", isError);

                isError = CheckRegexValue(data.OrderCode, "SpecialCharButNotVietnamese", "OrderCode", Message, isError);

                if (data.OrderValue > 100000000) {
                    $('#errOrderValue').text('Giá trị đơn hàng không vượt quá 100 triệu đồng.');
                    $('#OrderValue').focus();
                    isError = true;
                }

                isError = CheckNullAndRegexValue(data.Receiver.FullName, "Vietnamese", "Receiver_FullName", "Vui lòng nhập Họ và tên.", Message, isError);
                isError = CheckNullAndRegexValue(data.Receiver.MobileNumber, "MobileNumber", "Receiver_MobileNumber", "Vui lòng nhập điện thoại.", "Số điện thoại không hợp lệ", isError);
                isError = CheckNullValue(data.Receiver.Province.ID, "Receiver_Province_ID", "Vui lòng chọn Tỉnh/ Thành phố.", isError);
                isError = CheckNullValue(data.Receiver.Ward.ID, "Receiver_Ward_ID", "Vui lòng chọn Phường/ Xã.", isError);
                isError = CheckNullValue(data.Receiver.Street, "Receiver_Street", "Vui lòng nhập địa chỉ.", isError);

                isError = CheckNullValue(data.Sender.PickUpAddressID, "PickUpAddressID", "Vui lòng chọn địa chỉ lấy hàng.", isError);
                isError = CheckNullValue(data.Sender.FullName, "Sender_FullName", "Vui lòng nhập Họ và tên.", isError);
                isError = CheckNullAndRegexValue(data.Sender.MobileNumber, "MobileNumber", "Sender_MobileNumber", "Vui lòng nhập điện thoại.", "Số điện thoại không hợp lệ", isError);
                isError = CheckNullValue(data.Sender.Province.ID, "Sender_Province_ID", "Vui lòng chọn Tỉnh/ Thành phố.", isError);
                isError = CheckNullValue(data.Sender.Ward.ID, "Sender_Ward_ID", "Vui lòng chọn Quận/ Huyện.", isError);
                isError = CheckNullValue(data.Sender.Street, "Sender_Street", "Vui lòng nhập địa chỉ.", isError);

                isError = CheckNullAndRegexValue(parseInt(data.Weight), "Number", "Weight", "Vui lòng nhập trọng lượng", "Chỉ được nhập số", isError);
                isError = CheckNullValue(data.MainTransportServiceID, "MainTransportServiceID", "Vui lòng chọn Dịch vụ vận chuyển chính", isError);

                if (data.ExtraTransportServiceID) {
                    //Dịch vụ khai giá
                    var isServiceKG = data.ExtraTransportServiceID.includes("103");
                    if (isServiceKG == true && data.OrderValue == 0) {
                        $("#errOrderValue").text("Vui lòng nhập giá trị đơn hàng.");
                        isError = true;
                    }

                    //Dịch vụ thu hộ
                    var isServiceCOD = data.ExtraTransportServiceID.includes("108");
                    if (isServiceCOD == true) {
                        //if (parseInt(data.TotalCOD) == 0 && data.TransportPayer == 1) {
                        //    $("#errTotalCOD").text("Vui lòng nhập số tiền COD.");
                        //    $('#TotalCOD').focus();
                        //    isError = true;
                        //} else if (parseInt(data.TotalCOD) > 50000000) {
                        //    $('#errTotalCOD').text('Số tiền COD tối đa 50 triệu đồng/BG.');
                        //    $('#TotalCOD').focus();
                        //    isError = true;
                        //}

                        if (data.TotalCOD > 50000000) {
                            $('#errTotalCOD').text('Số tiền COD tối đa 50 triệu đồng/BG.');
                            $('#TotalCOD').focus();
                            isError = true;
                        }

                        if (data.TotalCOD == 0) {
                            $('#errTotalCOD').text('Số tiền COD phải khác 0');
                            $('#TotalCOD').focus();
                            isError = true;
                        }
                    } else {
                        data.TotalCOD = 0;
                    }

                    //Dịch vụ thu phí hủy đơn
                    var isServicePHU = data.ExtraTransportServiceID.includes("421");
                    if (isServicePHU == true) {
                        if (data.TotalPHU == 0) {
                            $("#errTotalPHU").text("Vui lòng nhập thu phí hủy đơn.");
                            isError = true;
                        }
                    } else {
                        data.TotalPHU = 0;
                    }
                } else {
                    data.TotalCOD = 0;
                    data.TotalPHU = 0;
                    $("#errOrderValue").text("");
                    $("#errTotalCOD").text("");
                    $("#errTotalPHU").text("");
                }

                if (data.TransportPayer == 2) {
                    switch (data.MainTransportServiceID) {
                        //case "141": //CPN TMĐT đồng giá TMĐ
                        //case "360": //TMĐT đồng giá đường bộ
                        case "481": //Thương mại điện tử Đồng giá Nội tỉnh
                            if (data.ExtraTransportServiceID.includes("108") == false) {
                                if (data.ExtraTransportServiceID) {
                                    data.ExtraTransportServiceID += ",108";
                                } else {
                                    data.ExtraTransportServiceID = "108";
                                }

                                $("#ExtraTransportServiceID").selectpicker("val", data.ExtraTransportServiceID.split(","));
                                $("#ExtraTransportServiceID").change();
                            }
                            break;
                        default:
                            if (data.ExtraTransportServiceID.includes("300") == false && data.ExtraTransportServiceID.includes("221") == false) {
                                isError = true;
                                CreateCustomSwal("error", "Vui lòng sử dụng dịch vụ Thu phí ship hàng (PSH) hoặc dịch vụ PPA (PPA) để thu cước người nhận");
                                $("#TransportPayer1").click();
                            }
                            break;
                    }
                }

                if (data.MainTransportServiceID && data.ExtraTransportServiceID) {
                    if ((data.MainTransportServiceID == 102 || data.MainTransportServiceID == 141 || data.MainTransportServiceID == 502 || data.MainTransportServiceID == 541 || data.MainTransportServiceID == 542 || data.MainTransportServiceID == 543)
                        && (data.ExtraTransportServiceID.includes("104") == true || data.ExtraTransportServiceID.includes("105") == true || data.ExtraTransportServiceID.includes("106") == true)) {
                        //Nếu DV chính là Phát hỏa tốc, CPN TMĐT đồng giá TMĐ, CPN Tài liệu, EMS TCNH Bạc, EMS TCNH Vàng, EMS TCNH Tiêu chuẩn
                        //Thì không được chọn các DV cộng thêm là Hàng nhạy cảm EMS - VUN, Dịch vụ EMS cây cảnh, Dịch vụ EMS thực phẩm
                        isError = true;
                        $("#errMainTransportServiceID").text("Dịch vụ chính và Dịch vụ cộng thêm không phù hợp. Vui lòng điều chỉnh");
                    } else if ((data.MainTransportServiceID == 502 || data.MainTransportServiceID == 541 || data.MainTransportServiceID == 542 || data.MainTransportServiceID == 543)
                        && (data.ExtraTransportServiceID.includes("108") == true || data.ExtraTransportServiceID.includes("341") == true || data.ExtraTransportServiceID.includes("342") == true || data.ExtraTransportServiceID.includes("420") == true)) {
                        //Nếu DV chính là CPN Tài liệu, EMS TCNH Bạc, EMS TCNH Vàng, EMS TCNH Tiêu chuẩn
                        //Thì không được chọn các DV cộng thêm là Thu hộ - chi hộ, Bốc xếp khâu chấp nhận, Bốc xếp khâu phát hàng, Phát hàng siêu thị
                        isError = true;
                        $("#errMainTransportServiceID").text("Dịch vụ chính và Dịch vụ cộng thêm không phù hợp. Vui lòng điều chỉnh");
                    } else if ((data.MainTransportServiceID == 541 || data.MainTransportServiceID == 542 || data.MainTransportServiceID == 543) && (data.ExtraTransportServiceID.includes("462") == true)) {
                        //Nếu DV chính là EMS TCNH Bạc, EMS TCNH Vàng, EMS TCNH Tiêu chuẩn
                        //Thì không được chọn các DV cộng thêm là Phát hàng một phần chiều đến
                        isError = true;
                        $("#errMainTransportServiceID").text("Dịch vụ chính và Dịch vụ cộng thêm không phù hợp. Vui lòng điều chỉnh");
                    }
                }

                isError = CheckNullValue(data.WareHouseID, "WareHouseID", "Vui lòng chọn kho cần xuất", isError);

                if (!parseInt(data.Quantity)) {
                    data.Quantity = 1;
                }

            } else {
                isError = false;
            }

            if (isError == true) {
                return;
            }

            var MessageNotify = "";
            var MessageSuccess = "";
            switch (AddType) {
                case 1:
                    MessageNotify = "Bạn chắc chắn muốn tạo đơn hàng?";
                    MessageSuccess = "Tạo đơn hàng thành công";
                    break;
                case 2:
                    MessageNotify = "Bạn chắc chắn muốn tạo đơn hàng và gửi vận chuyển?";
                    MessageSuccess = "Tạo đơn hàng và gửi vận chuyển thành công";
                    break;
                case 3:
                    MessageNotify = "Bạn chắc chắn muốn lưu nháp đơn hàng?";
                    MessageSuccess = "Lưu nháp thành công";
                    break;
                default:
                    MessageNotify = "Bạn chắc chắn muốn tạo đơn hàng?";
                    MessageSuccess = "Tạo đơn hàng thành công";
                    break;
            };

            swal({
                title: 'Thông báo',
                text: MessageNotify,
                buttons: {
                    confirm: {
                        text: "Xác nhận",
                        value: true,
                        visible: true,
                        className: "btn btn-primary",
                        closeModal: true
                    },
                    cancel: {
                        text: "Đóng",
                        value: false,
                        visible: true,
                        className: "btn btn-danger",
                        closeModal: true,
                    }
                },
            }).then((value) => {
                if (value) {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("JAddOrder", "Order")',
                        dataType: 'json',
                        loading: true,
                        data: data,
                        success: function (res) {
                            if (res.Code == "00") {
                                CreateCustomSwal("success", MessageSuccess, '@Url.Action("OrderPaginationExpandView", "Order")');
                            } else {
                                CreateCustomSwal("error", res.Message);
                            }
                        },
                        error: function (xhr, status, error) {
                            var err = eval("(" + xhr.responseText + ")");
                            swal({
                                title: 'Lỗi',
                                text: err.Message,
                                button: {
                                    text: "ĐÓNG",
                                    value: true,
                                    visible: true,
                                    className: "btn btn-primary"
                                }
                            });
                            return;
                        }
                    });
                }
            });
        }
    </script>

}