        $('#MainTransportServiceID, #ExtraTransportServiceID, #Weight, #Length, #Width, #Height, #Quantity, #TotalCOD, #TotalPHU, #OrderValue').on('change', function () {
            var DivID = this.id;
            var isError = false;
            var data = {
                IsTransport: "Y",
                MainTransportServiceID: parseInt($('#MainTransportServiceID').val()),
                ExtraTransportServiceID: $('#ExtraTransportServiceID').val().toString(),
                Sender: {
                    Province: {
                        ID: $('#Sender_Province_ID').val()
                    },
                    Ward: {
                        ID: $('#Sender_Ward_ID').val()
                    },
                },
                Receiver: {
                    ID: $('#Receiver_ID').val(),
                    MobileNumber: $("#Receiver_MobileNumber").val(),
                    Province: {
                        ID: $('#Receiver_Province_ID').val()
                    },
                    Ward: {
                        ID: $('#Receiver_Ward_ID').val()
                    },
                },
                Weight: NumberReplace($('#Weight').val()),
                Length: $('#Length').val(),
                Width: $('#Width').val(),
                Height: $('#Height').val(),
                Quantity: NumberReplace($('#Quantity').val()),
                OrderValue: NumberReplace($('#OrderValue').val()),
                TotalCOD: NumberReplace($('#TotalCOD').val()),
                TotalPHU: NumberReplace($('#TotalPHU').val()),
                TransportPayer: $("input[name='TransportPayer']:checked").val(),
                IsLoad: "Y"
            };

            if (DivID == "MainTransportServiceID") {
                if (data.MainTransportServiceID) {
                    if (data.TransportPayer == 2) {
                        switch (data.MainTransportServiceID) {
                            //case "141": //CPN TMĐT đồng giá TMĐ
                            //case "360": //TMĐT đồng giá đường bộ
                            case "481": //Thương mại điện tử Đồng giá Nội tỉnh
                                if (data.ExtraTransportServiceID.includes("108") == false) {
                                    if (data.ExtraTransportServiceID) {
                                        data.ExtraTransportServiceID += ",108";
                                    } else {
                                        data.ExtraTransportServiceID = "108";
                                    }
                                    $("#ExtraTransportServiceID").selectpicker("val", data.ExtraTransportServiceID.split(","));
                                    $("#ExtraTransportServiceID").change();
                                }
                                break;
                            default:
                                if (data.ExtraTransportServiceID.includes("300") == false && data.ExtraTransportServiceID.includes("221") == false) {
                                    CreateCustomSwal("error", "Vui lòng sử dụng dịch vụ Thu phí ship hàng (PSH) hoặc dịch vụ PPA (PPA) để thu cước người nhận");
                                    $("#TransportPayer1").click();
                                }
                                break;
                        }
                    }
                    $('#errMainTransportServiceID').text("");
                    SearchDateExpectedDelivery();
                } else {
                    $('#errMainTransportServiceID').text("Vui lòng chọn dịch vụ vận chuyển chính");
                    isError = true;
                }
            } else if (DivID == "ExtraTransportServiceID") {
                if (data.TransportPayer == 2) {
                    switch (data.MainTransportServiceID) {
                        case "141": //CPN TMĐT đồng giá TMĐ
                        case "360": //TMĐT đồng giá đường bộ
                        case "481": //Thương mại điện tử Đồng giá Nội tỉnh
                            if (data.ExtraTransportServiceID.includes("108") == false) {
                                if (data.ExtraTransportServiceID) {
                                    data.ExtraTransportServiceID += ",108";
                                } else {
                                    data.ExtraTransportServiceID = "108";
                                }
                                $("#ExtraTransportServiceID").selectpicker("val", data.ExtraTransportServiceID.split(","));
                                $("#ExtraTransportServiceID").change();
                            }
                            break;
                        default:
                            $("#TransportPayer1").click();
                            break;
                    }
                }

                var isServiceCOD = data.ExtraTransportServiceID.includes("108");
                if (isServiceCOD == true) {
                    $("#ShowTotalCOD").removeClass("d-none");
                } else {
                    $("#ShowTotalCOD").addClass("d-none");
                    TotalMoney = data.OrderValue;
                    TotalOrderValue = data.OrderValue;
                }

                var isServicePHU = data.ExtraTransportServiceID.includes("421");
                if (isServicePHU == true) {
                    $("#ShowTotalPHU").removeClass("d-none");
                } else {
                    $("#ShowTotalPHU").addClass("d-none");
                }
            } else if (DivID == "TotalCOD") {
                if (data.TotalCOD > 50000000) {
                    $('#errTotalCOD').text('Số tiền COD tối đa 50 triệu đồng/BG.');
                    $('#TotalCOD').focus();
                    isError = true;
                }
                TotalMoney = data.TotalCOD;
                TotalOrderValue = data.TotalCOD;
            } else if (DivID == "TotalPHU") {
                if (data.TotalPHU == 0) {
                    $('#errTotalPHU').text("Vui lòng nhập tiền thu phí hủy đơn.");
                    isError = true;
                } else {
                    $('#errTotalPHU').text("");
                }
            } else if (DivID == "Weight") {
                if (data.Weight == 0) {
                    $('#errWeight').text("Vui lòng nhập trọng lượng.");
                    isError = true;
                } else {
                    $('#errWeight').text("");
                }
            } else if (DivID == "OrderValue") {
                if (data.Sender.Province.ID == undefined || data.Sender.Province.ID == "" || data.Receiver.Province.ID == undefined || data.Receiver.Province.ID == "") {
                    isError = true;
                } else {
                    if (data.OrderValue > 100000000) {
                        $('#errOrderValue').text('Giá trị đơn hàng không vượt quá 100 triệu đồng.');
                        isError = true;
                    }

                    if (data.TotalCOD == 0) {
                        TotalMoney = data.OrderValue;
                        TotalOrderValue = data.OrderValue;
                    }
                }
            }

            if (!data.Receiver.MobileNumber) {
                $('#errReceiver_MobileNumber').text("Vui lòng nhập số điện thoại và tìm kiếm.");
                isError = true;
            }

            if (data.IsTransport == "Y") {
                if (isError == true) {
                    $("#errTemporaryTransportServiceFee").text("Chưa đủ thông tin để tính cước");
                } else {
                    LoadTotalFee();
                }
            } else {
                $('#errMainTransportServiceID').text("");
                $('#errTotalCOD').text("");
                $('#errWeight').text("");
            }
        });

        $('#PickUpAddressID, #Sender_Province_ID, #Sender_Ward_ID, #Receiver_FullName, #Receiver_MobileNumber, #Receiver_Province_ID, #Receiver_Ward_ID').on('change', function () {
            if (this.id == "PickUpAddressID") {
                if ($(this).val()) {
                    $("#Sender_FullName").val($("option:selected", this).attr("data-FullName"));
                    $("#Sender_MobileNumber").val($("option:selected", this).attr("data-MobileNumber"));
                    $("#Sender_Province_ID").val($("option:selected", this).attr("data-ProvinceID"));
                    $("#Sender_Ward_ID").val($("option:selected", this).attr("data-WardID"));
                    $("#Sender_Street").val($("option:selected", this).attr("data-Address"));
                    $("#Sender_FullAddress").val($("option:selected", this).attr("data-FullAddress"));
                }
                SearchCollectionPostOfficeRecent();
                $("#ShowExpectedDelivery").html("");
            } else if (this.id == "Sender_Province_ID") {
                SearchCollectionPostOfficeRecent();
                $("#ShowExpectedDelivery").html("");
                $("#Sender_Street").val("");
            } else if (this.id == "Sender_Ward_ID") {
                $("#Sender_Street").val("");
            } else if (this.id == "Receiver_FullName") {
                if (ReceiverInfo != undefined) {
                    if ($(this).val() != ReceiverInfo.FullName) {
                        if ($("#ShowChangeReceiverInfo").hasClass("d-none") == true) {
                            $("#ShowChangeReceiverInfo").removeClass("d-none");
                        }
                    }
                }
            } else if (this.id == "Receiver_MobileNumber") {
                var value = $(this).val().trim();
                if (value) {
                    var IsValid = CheckNullAndRegexValue(value, "MobileNumber", "Receiver_MobileNumber", "Số điện thoại không được để trống.", "Số điện thoại không hợp lệ.", false);
                    if (!IsValid) {
                        $.ajax({
                            type: 'POST',
                            url: '@Url.Action("SearchCustomerByMobileNumber", "Handle")',
                            dataType: 'json',
                            loading: true,
                            data: {
                                MobileNumber: value,
                            },
                            beforeSend: function () {
                                ReceiverInfo = null;
                                $("#Receiver_ID").val(0);
                            },
                            success: function (res) {
                                if (res.Code == "00") {
                                    ReceiverInfo = JSON.parse(res.Data);
                                    IsDisabledCustomerInfo(false, ReceiverInfo);
                                }
                            },
                            error: function (xhr, status, error) {
                                var err = eval("(" + xhr.responseText + ")");
                                swal({
                                    title: 'Lỗi',
                                    text: err.Message,
                                    button: {
                                        text: "ĐÓNG",
                                        value: true,
                                        visible: true,
                                        className: "btn btn-primary"
                                    }
                                });
                                return;
                            }
                        });
                    } else {
                        IsDisabledCustomerInfo(false, null);
                    }
                } else {
                    IsDisabledCustomerInfo(true, null);
                }

                LoadTotalFee();
            } else if (this.id == "Receiver_Province_ID") {
                if (ReceiverInfo != null) {
                    if ($(this).val() != ReceiverInfo.Province.ID) {
                        if ($("#ShowChangeReceiverInfo").hasClass("d-none") == true) {
                            $("#ShowChangeReceiverInfo").removeClass("d-none");
                        }
                    }
                }

                $("#ShowExpectedDelivery").html("");

                //if (manualOverride) {
                //    manualOverride = false;  // Đặt lại flag
                //    $("#Receiver_Street").val("");
                //}
                
            } else if (this.id == "Receiver_Ward_ID") {
                if (ReceiverInfo != null) {
                    if ($(this).val() != ReceiverInfo.Ward.ID) {
                        if ($("#ShowChangeReceiverInfo").hasClass("d-none") == true) {
                            $("#ShowChangeReceiverInfo").removeClass("d-none");
                        }
                    }
                }
                //if (manualOverride) {
                //    manualOverride = false;  // Đặt lại flag
                //    $("#Receiver_Street").val("");
                //}
            }

            $('#MainTransportServiceID').change();
        });

        function IsDisabledCustomerInfo(IsBool, agrs) {
            isLoading = true;
            $("#Receiver_FullName").attr("disabled", IsBool);
            $("#Receiver_Street").attr("disabled", IsBool);
            $("#Receiver_Province_ID").attr("disabled", IsBool);
            $("#Receiver_Ward_ID").attr("disabled", IsBool);
            if (IsBool) {
                $("#Receiver_ID").val(0);
                $("#Receiver_FullName").val("");
                $("#Receiver_Province_ID").val(0).change();
                $("#Receiver_Ward_ID").val(0);
                $("#Receiver_Street").val("");
            } else {
                $("#Receiver_ID").val(agrs.ID);
                $("#Receiver_FullName").val(agrs.FullName);
                $("#Receiver_Province_ID").val(agrs.Province.ID).change();
                $("#Receiver_Ward_ID").val(agrs.Ward.ID);
                $("#Receiver_Street").val(agrs.Address);
            }
            // Sau khi điền, đánh dấu flag là loading xong
            isLoading = false;  // Đánh dấu load xong
            addressChange = true;  // Cho phép phân tích địa chỉ nếu thay đổi
        }

        function SearchCollectionPostOfficeRecent() {
            $("#ShowCollectionPostOfficeRecent").removeClass("d-none");
            if ($("input[name='CollectionType.ID']:checked").val() != "2") {
                $("#ShowCollectionPostOfficeRecent").addClass("d-none");
                return;
            }

            $.ajax({
                type: 'POST',
                url: '@Url.Action("SearchListRecentCollectionPostOffice", "Handle")',
                dataType: 'json',
                loading: true,
                data: {
                    ProvinceID: $("#Sender_Province_ID").val()
                },
                success: function (res) {
                    $("#ShowCollectionPostOfficeRecent").html("");
                    var responseData = res;
                    if (responseData.length) {
                        $("#ShowCollectionPostOfficeRecent").html('<select id="SearchListCollectionPostOfficeRecent" class="select2"></select>');
                        var CollectionPostOffice = [{
                            id: 0,
                            text: "Gợi ý bưu cục gần nhất"
                        }];
                        responseData.forEach(function (value, index) {
                            var obj = {
                                id: value.ID,
                                Code: value.Code,
                                Name: value.Name,
                                CodeAndName: value.CodeAndName,
                                FullAddress: value.FullAddress,
                                text: value.Name + " - " + value.FullAddress,
                            }
                            CollectionPostOffice.push(obj);
                        });

                        $("#SearchListCollectionPostOfficeRecent").select2({
                            data: CollectionPostOffice,
                            templateResult: function (state) {
                                if (state.id == 0) {
                                    return state.text;
                                }
                                var html = "";
                                html += "<div title='" + state.text + "'>";
                                html += "<div class='fw-bold'>" + state.Name + "</div>";
                                html += "<div class=''><i class='fas fa-map-marker-alt me-2'></i>" + state.FullAddress + "</div>";
                                html += "</div>";
                                return $(html);
                            },
                            selectOnClose: true,
                            width: '100%',
                            language: {
                                noResults: function () {
                                    return 'Không tìm thấy dữ liệu.';
                                },
                            },
                        });
                    } else {
                        $("#ShowCollectionPostOfficeRecent").html("<div class='text-italic' style='text-align: justify;'>Không có bưu cục EMS thu gom gần đây. Vui lòng chọn hình thức Thu gom tận nơi để bưu tá đến lấy hàng</div>");
                    }
                },
                error: function (xhr, status, error) {
                    var err = eval("(" + xhr.responseText + ")");
                    swal({
                        title: 'Lỗi',
                        text: err.Message,
                        button: {
                            text: "ĐÓNG",
                            value: true,
                            visible: true,
                            className: "btn btn-primary"
                        }
                    });
                    return;
                }
            });
        }

        function SearchDateExpectedDelivery() {
            var req = {
                Date: "",
                TransportServiceID: parseInt($('#MainTransportServiceID').val()),
                SenderProvinceID: parseInt($("#Sender_Province_ID").val()), 
                ReceiverProvinceID: parseInt($("#Receiver_Province_ID").val()),
            }

            if (req.TransportServiceID <= 0 || req.SenderProvinceID <= 0 ||  req.ReceiverProvinceID <= 0 ) {
                return;
            }

            $.ajax({
                type: 'POST',
                url: '@Url.Action("SearchDateExpectedDelivery", "Handle")',
                dataType: 'json',
                loading: true,
                data: req,
                beforeSend: function () {
                    ExpectedDeliveryDate = "";
                },
                success: function (res) {
                    if (res.Code == "00") {
                        ExpectedDeliveryDate = res.Data;
                        $("#ShowExpectedDelivery").html("Thời gian giao hàng dự kiến: <span class='text-secondary'>" + res.Data.split(' ')[0] + "</span>");
                    } else if (res.Code == "01") {
                        $("#ShowExpectedDelivery").html("Thời gian giao hàng dự kiến: <span class='text-secondary'>" + res.Message + "</span>");
                    } else {
                        $("#ShowExpectedDelivery").html("");
                    }
                },
                error: function (xhr, status, error) {
                    var err = eval("(" + xhr.responseText + ")");
                    swal({
                        title: 'Lỗi',
                        text: err.Message,
                        button: {
                            text: "ĐÓNG",
                            value: true,
                            visible: true,
                            className: "btn btn-primary"
                        }
                    });
                    return;
                }
            });
        }

