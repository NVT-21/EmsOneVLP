$('#MainTransportServiceID, #ExtraTransportServiceID, #Weight, #Length, #Width, #Height, #Quantity, #TotalCOD, #TotalPHU, #OrderValue').on('change', function () {
    var DivID = this.id;
    var isError = false;
    var data = {
        IsTransport: "Y",
        MainTransportServiceID: parseInt($('#MainTransportServiceID').val()),
        ExtraTransportServiceID: $('#ExtraTransportServiceID').val().toString(),
        Sender: {
            Province: {
                ID: $('#Sender_Province_ID').val()
            },
            Ward: {
                ID: $('#Sender_Ward_ID').val()
            },
        },
        Receiver: {
            ID: $('#Receiver_ID').val(),
            MobileNumber: $("#Receiver_MobileNumber").val(),
            Province: {
                ID: $('#Receiver_Province_ID').val()
            },
            Ward: {
                ID: $('#Receiver_Ward_ID').val()
            },
        },
        Weight: NumberReplace($('#Weight').val()),
        Length: $('#Length').val(),
        Width: $('#Width').val(),
        Height: $('#Height').val(),
        Quantity: NumberReplace($('#Quantity').val()),
        OrderValue: NumberReplace($('#OrderValue').val()),
        TotalCOD: NumberReplace($('#TotalCOD').val()),
        TotalPHU: NumberReplace($('#TotalPHU').val()),
        TransportPayer: $("input[name='TransportPayer']:checked").val(),
        IsLoad: "Y"
    };

    if (DivID == "MainTransportServiceID") {
        if (data.MainTransportServiceID) {
            if (data.TransportPayer == 2) {
                switch (data.MainTransportServiceID) {
                    //case "141": //CPN TMĐT đồng giá TMĐ
                    //case "360": //TMĐT đồng giá đường bộ
                    case "481": //Thương mại điện tử Đồng giá Nội tỉnh
                        if (data.ExtraTransportServiceID.includes("108") == false) {
                            if (data.ExtraTransportServiceID) {
                                data.ExtraTransportServiceID += ",108";
                            } else {
                                data.ExtraTransportServiceID = "108";
                            }
                            $("#ExtraTransportServiceID").selectpicker("val", data.ExtraTransportServiceID.split(","));
                            $("#ExtraTransportServiceID").change();
                        }
                        break;
                    default:
                        if (data.ExtraTransportServiceID.includes("300") == false && data.ExtraTransportServiceID.includes("221") == false && data.ExtraTransportServiceID.includes("221") == false) {
                            CreateCustomSwal("error", "Vui lòng sử dụng dịch vụ Thu phí ship hàng (PSH) để thu cước người nhận");
                            $("#TransportPayer1").click();
                        }
                        break;
                }
            }
            $('#errMainTransportServiceID').text("");
        } else {
            $('#errMainTransportServiceID').text("Vui lòng chọn dịch vụ vận chuyển chính");
            isError = true;
        }
    } else if (DivID == "ExtraTransportServiceID") {
        if (data.TransportPayer == 2) {
            switch (data.MainTransportServiceID) {
                case "141": //CPN TMĐT đồng giá TMĐ
                case "360": //TMĐT đồng giá đường bộ
                case "481": //Thương mại điện tử Đồng giá Nội tỉnh
                    if (data.ExtraTransportServiceID.includes("108") == false) {
                        if (data.ExtraTransportServiceID) {
                            data.ExtraTransportServiceID += ",108";
                        } else {
                            data.ExtraTransportServiceID = "108";
                        }
                        $("#ExtraTransportServiceID").selectpicker("val", data.ExtraTransportServiceID.split(","));
                        $("#ExtraTransportServiceID").change();
                    }
                    break;
                default:
                    $("#TransportPayer1").click();
                    break;
            }
        }

        var isServiceCOD = data.ExtraTransportServiceID.includes("108");
        if (isServiceCOD == true) {
            $("#ShowTotalCOD").removeClass("d-none");
        } else {
            $("#ShowTotalCOD").addClass("d-none");
            TotalMoney = data.OrderValue;
            TotalOrderValue = data.OrderValue;
        }

        var isServicePHU = data.ExtraTransportServiceID.includes("421");
        if (isServicePHU == true) {
            $("#ShowTotalPHU").removeClass("d-none");
        } else {
            $("#ShowTotalPHU").addClass("d-none");
        }
    } else if (DivID == "TotalCOD") {
        if (data.TotalCOD > 50000000) {
            $('#errTotalCOD').text('Số tiền COD tối đa 50 triệu đồng/BG.');
            $('#TotalCOD').focus();
            isError = true;
        }
        TotalMoney = data.TotalCOD;
        TotalOrderValue = data.TotalCOD;
    } else if (DivID == "TotalPHU") {
        if (data.TotalPHU == 0) {
            $('#errTotalPHU').text("Vui lòng nhập tiền thu phí hủy đơn.");
            isError = true;
        } else {
            $('#errTotalPHU').text("");
        }
    } else if (DivID == "Weight") {
        if (data.Weight == 0) {
            $('#errWeight').text("Vui lòng nhập trọng lượng.");
            isError = true;
        } else {
            $('#errWeight').text("");
        }
    } else if (DivID == "OrderValue") {
        if (data.Sender.Province.ID == undefined || data.Sender.Province.ID == "" || data.Receiver.Province.ID == undefined || data.Receiver.Province.ID == "") {
            isError = true;
        } else {
            if (data.OrderValue > 100000000) {
                $('#errOrderValue').text('Giá trị đơn hàng không vượt quá 100 triệu đồng.');
                isError = true;
            }

            if (data.TotalCOD == 0) {
                TotalMoney = data.OrderValue;
                TotalOrderValue = data.OrderValue;
            }
        }
    }

    if (!data.Receiver.MobileNumber) {
        $('#errReceiver_MobileNumber').text("Vui lòng nhập số điện thoại và tìm kiếm.");
        isError = true;
    }

    if (data.IsTransport == "Y") {
        if (isError == true) {
            $("#errTemporaryTransportServiceFee").text("Chưa đủ thông tin để tính cước");
        } else {
            LoadTotalFee();
        }
    } else {
        $('#errMainTransportServiceID').text("");
        $('#errTotalCOD').text("");
        $('#errWeight').text("");
    }
});
