@model List<EMS.MVC.Frontend.Models.SearchListExcelImportViewModel>
<div class="card border">
    <div class="card-body p-0">
        <div class="table-responsive" style="max-height: 420px; overflow-y: auto;">
            <table class="table table-bordered table-hover mb-0 align-middle">
                <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                    <tr>
                        <th style="width: 50px; text-align: center;">STT</th>
                        <th>Tên file</th>
                        <th style="width: 130px; text-align: center;">Trạng thái</th>
                        <th style="width: 90px; text-align: right;">Tổng</th>
                        <th style="width: 90px; text-align: right;">Lỗi</th>
                        <th style="width: 150px;">Thời gian</th>
                        <th style="width: 150px">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if(Model != null)
                    {
                        var index = 1;
                        foreach(var item in Model)
                        {
                    <tr>
                        <td class="text-center">@index</td>

                        <td>
                            <div class="fw-semibold text-truncate" style="max-width: 220px;" title="@item.FileName">
                                @item.FileName
                            </div>
                            <div class="text-muted small">
                                Job: @item.JobId
                            </div>
                        </td>

                        <td class="text-center">
                            @if(string.Equals(item.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-secondary">Chờ xử lý</span>
                            }
                            else if(string.Equals(item.Status, "Processing", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-primary">Đang xử lý</span>
                            }
                            else if(string.Equals(item.Status, "Completed", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-success">Hoàn tất</span>
                            }
                            else if(string.Equals(item.Status, "Failed", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-danger">Thất bại</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">@item.Status</span>
                            }
                        </td>

                        <td class="text-end">@item.TotalRows</td>
                        <td class="text-end">@item.FailedRows</td>
                        <td>
                            <span class="small">@item.CreatedAt</span>
                        </td>
                        <td>
                            @if(string.Equals(item.Status, "Completed", StringComparison.OrdinalIgnoreCase))
                            {
                                <button class="btn btn-primary btn-load-order-import" data-job-id="@item.JobId">Lấy dữ liệu</button>
                            }
                            else
                            {
                                <button class="btn btn-primary" disabled>Lấy dữ liệu</button>
                            }
                        </td>
                    </tr>
                            index++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                Chưa có file import nào
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>