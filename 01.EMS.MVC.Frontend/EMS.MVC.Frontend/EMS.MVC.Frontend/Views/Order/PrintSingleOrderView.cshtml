<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="keywords" content="" />
    <meta name="author" content="" />
    <meta name="robots" content="" />
    <meta name="format-detection" content="telephone=no">
    <title>EMSOne</title>
    <link rel="shortcut icon" type="image/png" href="~/favicon.png" />
    @Styles.Render("~/bundles/css")
    @Styles.Render("~/bundles/fonts")
    <script src="~/Assets/js/global.min.js"></script>
    <script src="~/Assets/js/MyJS.js?n=@XHelper.JavaScriptVersion"></script>
</head>
<body style="background-color: white;">
    <style>
        body {
            font-size: 14px;
            margin: 0;
            padding: 0;
        }

        .col-md-6 {
            float: left;
        }

        /*@@media print {
            .pagebreak {
                page-break-after: always;
            }

            tr {
                display: table-row-group;
                page-break-inside: avoid;
                page-break-after: auto;
            }

            .size-default {
                min-height: 18cm;
                max-height: 18cm;
            }*/
        /*#theTable td * {
                page-break-inside: avoid;
            }*/
        /*}*/
    </style>
    <!-- AJAX LOADER -->
    <input type="hidden" />
    <div id="ajax_loader" style="background-color: rgba(0, 0, 0, 0.5); z-index: 9999; position: fixed; left: 0px; top: 0px; width: 100%; height: 100%; display: none;" class="">
        <div id="ajax_loader_contend" style="position: fixed; left: 50%; top: 50%; color:white"><img src="~/Assets/images/default/loading.gif" style="width:30px; height:30px" /></div>
    </div>

    <div class="row" style="margin-right: 0;">
        <div class="offset-1 col-xl-2 col-lg-2 col-md-2 col-sm-12 d-print-none">
            <ul class="nav nav-pills flex-column" id="pills-tab" role="tablist" style="position: fixed; top: 10%; margin: 0; padding: 0;">
                <li class="nav-item mb-2" style="border: 1px solid gray; border-radius: 6px;">
                    <a onclick="RidirectType('A4')" class="nav-link @{ if (ViewBag.PrintType == "A4") { Write("active"); } }" data-bs-toggle="tab" href="#TypeA4" role="tab" aria-controls="pills-a4" aria-selected="true">
                        <i class="fa fa-file-o mr-1" aria-hidden="true"></i>
                        Kiểu A4
                    </a>
                </li>
                <li class="nav-item mb-2" style="border: 1px solid gray; border-radius: 6px;">
                    <a onclick="RidirectType('A61')" class="nav-link @{ if (ViewBag.PrintType == "A6") { Write("active"); } }" data-bs-toggle="tab" href="#TypeA61" role="tab" aria-controls="pills-a61" aria-selected="false">
                        <i class="fa fa-file-o mr-1" aria-hidden="true"></i>
                        Kiểu A6 (4.1x5.8)
                    </a>
                </li>
                <li class="nav-item mb-2" style="border: 1px solid gray; border-radius: 6px;">
                    <a onclick="RidirectType('A64')" class="nav-link" data-bs-toggle="tab" href="#TypeA64" role="tab" aria-controls="pills-a64" aria-selected="false">
                        <i class="fa fa-file-o mr-1" aria-hidden="true"></i>
                        Kiểu A6 (khổ A4)
                    </a>
                </li>
                <li class="nav-item mb-2" style="border: 1px solid gray; border-radius: 6px;">
                    <a onclick="RidirectType('B1')" class="nav-link @{ if (ViewBag.PrintType == "B1") { Write("active"); } }" data-bs-toggle="tab" href="#TypeB1" role="tab" aria-controls="pills-b1" aria-selected="false">
                        <i class="fa fa-file-o mr-1" aria-hidden="true"></i>
                        Kiểu B1
                    </a>
                </li>
                <li class="nav-item mb-2" style="border: 1px solid gray; border-radius: 6px;">
                    <a onclick="RidirectType('E5')" class="nav-link @{ if (ViewBag.PrintType == "E5") { Write("active"); } }" data-bs-toggle="tab" href="#TypeE5" role="tab" aria-controls="pills-b1" aria-selected="false">
                        <i class="fa fa-file-o mr-1" aria-hidden="true"></i>
                        Kiểu E5
                    </a>
                </li>
                <li class="nav-item mb-2" style="border: 1px solid gray; border-radius: 6px;">
                    <a onclick="RidirectType('B2')" class="nav-link @{ if (ViewBag.PrintType == "B2") { Write("active"); } }" data-bs-toggle="tab" href="#TypeB2" role="tab" aria-controls="pills-b2" aria-selected="false">
                        <i class="fa fa-file-o mr-1" aria-hidden="true"></i>
                        Kiểu B2
                    </a>
                </li>
                <li class="nav-item mb-2" style="border: 1px solid gray; border-radius: 6px;">
                    <a onclick="RidirectType('Label')" class="nav-link @{ if (ViewBag.PrintType == "Label") { Write("active"); } }" data-bs-toggle="tab" href="#TypeLabel" role="tab" aria-controls="pills-label" aria-selected="false">
                        <i class="fa fa-file-o mr-1" aria-hidden="true"></i>
                        Kiểu nhãn (3x5)
                    </a>
                </li>
                <li class="nav-item mb-2" style="border: 1px solid gray; border-radius: 6px;">
                    <a class="nav-link" onclick="Ctrl_P();" href="#">
                        <i class="fa fa-print mr-1" aria-hidden="true"></i>
                        In đơn hàng
                    </a>
                </li>
            </ul>
        </div>
        <div class="col-xl-8 col-lg-8 col-md-8 col-sm-12">
            <div class="tab-content-vertical" id="pills-tabContent" @*style="max-height: 950px; overflow: auto;"*@>
                <div class="tab-pane fade @{ if (ViewBag.PrintType == "A4") { Write("show active"); } }" data-type="A4" id="TypeA4" role="tabpanel" aria-labelledby="TypeA4Tab">
                </div>
                <div class="tab-pane fade @{ if (ViewBag.PrintType == "A6") { Write("show active"); } }" data-type="A6" id="TypeA61" role="tabpanel" aria-labelledby="TypeA61Tab">
                </div>
                <div class="tab-pane fade" id="TypeA64" role="tabpanel" aria-labelledby="TypeA64Tab" data-type="A4">
                </div>
                <div class="tab-pane fade @{ if (ViewBag.PrintType == "B1") { Write("show active"); } }" data-type="B1" id="TypeB1" role="tabpanel" aria-labelledby="TypeB1Tab">
                </div>
                <div class="tab-pane fade @{ if (ViewBag.PrintType == "E5") { Write("show active"); } }" data-type="E5" id="TypeE5" role="tabpanel" aria-labelledby="TypeE5Tab">
                </div>
                <div class="tab-pane fade @{ if (ViewBag.PrintType == "B2") { Write("show active"); } }" data-type="B2" id="TypeB2" role="tabpanel" aria-labelledby="TypeB2Tab">
                </div>
                <div class="tab-pane fade @{ if (ViewBag.PrintType == "Label") { Write("show active"); } }" data-type="Label" id="TypeLabel" role="tabpanel" aria-labelledby="TypeLabelTab">
                </div>
            </div>
        </div>
    </div>
    <script>

        var params = new URLSearchParams(window.location.search);
        var previosPrintType = "";
        var ShippingCodes = params.get("ShippingCodes");
        var CrmOrPayPostCode = params.get("CrmOrPayPostCode");
        var PrintType = params.get("PrintType");

        //window.addEventListener('afterprint', (event) => {
        //    UpdatePrintStatus();
        //});

        function Ctrl_P() {
            window.print();
        }

        Podium = {};
        Podium.keydown = function (k) {
            var oEvent = document.createEvent('KeyboardEvent');

            // Chromium Hack
            Object.defineProperty(oEvent, 'keyCode', {
                get: function () {
                    return this.keyCodeVal;
                }
            });
            Object.defineProperty(oEvent, 'which', {
                get: function () {
                    return this.keyCodeVal;
                }
            });

            if (oEvent.initKeyboardEvent) {
                oEvent.initKeyboardEvent("keydown", true, true, document.defaultView, true, true, true, true, k, k);
            } else {
                oEvent.initKeyEvent("keydown", true, true, document.defaultView, true, true, true, true, k, 0);
            }

            document.dispatchEvent(oEvent);
        }

        function UpdatePrintStatus() {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("JUpdatePrintStatus", "Order")',
                dataType: 'json',
                loading: true,
                global: true,
                async: true,
                data: {
                    IDs: $('#IDs').val()
                },
                success: function (res) {
                    if (res.Code != "00") {
                        console.log(res.Message);
                    }
                }
            });
        };

        $(document).ajaxStart(function () {
            $('#ajax_loader').show();
        });

        $(document).ajaxStop(function () {
            $('#ajax_loader').hide();
        });

        var CurrentType = PrintType;
        $(document).ready(function () {
            LoadData(PrintType);
        });

        function RidirectType(Type) {
            LoadData(Type);
        }

        function LoadData(Type) {

            $("#Type" + previosPrintType).html("");
            $.ajax({
                type: 'POST',
                url: '@Url.Action("PrintSingleOrderTypeView", "Order")',
                dataType: 'html',
                data: {
                    ShippingCodes: ShippingCodes,
                    CrmOrPayPostCode: CrmOrPayPostCode,
                    PrintType: Type
                },
                success: function (data) {
                    $("#Type" + Type).html(data);
                    previosPrintType = Type;
                },
            });
        }

    </script>
</body>
</html>
