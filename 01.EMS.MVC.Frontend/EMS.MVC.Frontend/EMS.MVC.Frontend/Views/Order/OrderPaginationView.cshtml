                                        <a class="dropdown-item" href="#" onclick="btnCancelOrder(null, null, null, null)">Hủy đơn hàng</a>
                                        <a class="dropdown-item" href="#" onclick="btnPrintOrder(null, null)">In đơn hàng</a>
                                        <a class="dropdown-item" href="#" onclick="btnSendTransport(null, null, null, null)">Gửi đơn vị vận chuyển</a>
                                        <a class="dropdown-item" href="#" onclick="btnCancelTransport(null, null, null, null)">Hủy yêu cầu vận chuyển</a>
                                    </div>
                                </div>

                                <div class="dropdown">
                                    <button class="btn ems-btn ems-btn-primary" type="button" id="add-order-dropdown"
                                            data-bs-toggle="dropdown" data-boundary="viewport"
                                            aria-haspopup="true" aria-expanded="false">
                                        <i class="fa-solid fa-plus"></i>
                                        Tạo đơn hàng
                                        <i class="icon-arrow-b fs-16"></i>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-end py-1" aria-labelledby="add-order-dropdown">
                                        <a class="dropdown-item" href="@Url.Action("AddOrderView", "Order")" data-redirect="true">Tạo đơn hàng</a>
                                        <a class="dropdown-item" href="@Url.Action("AddOrderBatchView", "OrderBatch")" data-redirect="true">Tạo đơn hàng lô</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="card ems-order-card">
                <div class="card-body">
                    <div class="ems-section-head">
                        <h6 class="ems-section-title">
                            <i class="fa-solid fa-list-check"></i>
                            Danh sách đơn hàng
                        </h6>
                        <span class="ems-section-note">Chọn tab để lọc nhanh theo trạng thái</span>
                    </div>

                    <div class="MouseScrollX ems-status-tabs-wrap">
                        <ul class="nav nav-tabs ems-status-tabs" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="ActiveTab_" data-bs-toggle="tab" href="#"
                                   role="tab" data-status="" onclick="btnSearch('ALL')">
                                    Tất cả
                                    <span id="StatusAll"></span>
                                </a>
                            </li>
                            @foreach(var item in Model.ListOrderStatus)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" id="ActiveTab_@item.Value" data-bs-toggle="tab" href="#"
                                       role="tab" data-status="@item.Value" onclick="btnSearch('@item.Value')">
                                        @item.Text
                                        <span id="OrderStatus@(item.Value)"></span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    <div id="tbl-data" class="table-primary table-responsive"></div>
                    <div class="ems-result-area">
                        <div class="row" id="data-wrapper"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        $(document).ajaxStart(function () {
           $('#ajax_loader').show();
        });

        $(document).ajaxStop(function () {
            $('#ajax_loader').hide();
        });

        var SearchListOrder = [];
        var currentOrderSearchRequest = null;
        var orderSearchSequence = 0;
        var suppressMultiSelectSearch = false;
        var multiSelectCloseTimer = null;

        $(document).ready(function () {
            var $multiSelects = $("#CrmOrPaypostCode, #MainTransportService, #ExtraTransportService");
            $multiSelects.selectpicker("refresh");
            CreateDateTimeRangePicker("AllDate", $("#FromDate").val(), $("#ToDate").val());

            /*
             * Bootstrap Select phát sinh sự kiện change sau MỖI lần chọn một giá trị.
             * Không tìm kiếm ngay ở change; chỉ đánh dấu có thay đổi và tìm một lần
             * khi người dùng đóng danh sách chọn.
             */
            $multiSelects.each(function () {
                var $select = $(this);
                $select.data("ems-selection-dirty", false);

                /*
                 * Ngăn các change handler dạng delegated ở script cũ nhận sự kiện
                 * sau từng lần tick. Việc tìm kiếm chỉ thực hiện khi menu đóng.
                 */
                $select.off("change.emsOrderGuard")
                    .on("change.emsOrderGuard", function (event) {
                        event.stopPropagation();
                    });

                $select.off("show.bs.select.emsOrder shown.bs.select.emsOrder")
                    .on("show.bs.select.emsOrder", function () {
                        clearTimeout(multiSelectCloseTimer);
                        $(this).closest('.ems-order-card-filter').addClass('ems-select-open');
                    })
                    .on("shown.bs.select.emsOrder", function () {
                        /* Giữ menu ở lớp trên cùng sau khi Popper hoàn tất định vị. */
                        $('.bs-container').css('z-index', 1095);
                    });

                $select.off("changed.bs.select.emsOrder")
                    .on("changed.bs.select.emsOrder", function () {
                        if (!suppressMultiSelectSearch) {
                            $(this).data("ems-selection-dirty", true);
                        }
                    });

                $select.off("hide.bs.select.emsOrder hidden.bs.select.emsOrder")
                    .on("hide.bs.select.emsOrder", function () {
                        clearTimeout(multiSelectCloseTimer);
                    })
                    .on("hidden.bs.select.emsOrder", function () {
                        var $current = $(this);
                        $current.closest('.ems-order-card-filter').removeClass('ems-select-open');

                        if (!$current.data("ems-selection-dirty")) {
                            return;
                        }

                        $current.data("ems-selection-dirty", false);

                        // Mã PP/CRM không được để rỗng: khôi phục giá trị mặc định như logic cũ.
                        if (this.id === "CrmOrPaypostCode" && (($current.val() || []).length === 0)) {
                            suppressMultiSelectSearch = true;
                            $current.selectpicker("val", "@Model.CrmOrPaypostCode");
                            $current.selectpicker("refresh");
                            suppressMultiSelectSearch = false;
                        }

                        /*
                         * Chờ menu và lớp backdrop kết thúc xử lý click rồi mới cập nhật
                         * vùng kết quả, tránh đóng/mở và nhấp nháy khi con trỏ đi xuống.
                         */
                        clearTimeout(multiSelectCloseTimer);
                        multiSelectCloseTimer = setTimeout(function () {
                            btnSearch();
                        }, 180);
                    });
            });

            var searchTimer = null;
            $("#SearchKey").on("input", function () {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(function () {
                    btnSearch();
                }, 500);
            });

            $("#SearchKey").on("keydown", function (event) {
                if (event.key === "Enter") {
                    event.preventDefault();
                    clearTimeout(searchTimer);
                    btnSearch();
                }
            });
        });

        ScrollX(".MouseScrollX");

        // Các select nhiều giá trị được xử lý bằng hidden.bs.select ở trên.
        // Chỉ các bộ lọc đơn giá trị mới tìm kiếm ngay khi change.
        $("#AllDate, #OrderStatus, #PrintStatus, #PostalType").on("change", function () {
            $("#btnAcceptOrder").addClass("d-none");
            var DivID = this.id;

            if (DivID == "AllDate") {
                var AllDateValue = $("#AllDate").val();
                if (AllDateValue) {
                    var SplitAllDateValue = AllDateValue.split('-');
                    $('#FromDate').val(SplitAllDateValue[0].trim());
                    $('#ToDate').val(SplitAllDateValue[1].trim());
                }
            } else if (DivID == "OrderStatus") {
                var OrderStatusValue = $("#OrderStatus").val();
                $(".nav-link").removeClass("active");
                $("#ActiveTab_" + OrderStatusValue).addClass("active");
            }

            btnSearch();
        });

        function btnSearch(OrderStatus, pageIndex, pageSize) {
            var OrderStatusValue = "";
            var ReloadStatusNumberValue = "";
            if (OrderStatus) {
                if (OrderStatus == "ALL") {
                    OrderStatus = "";
                }

                if ($("#OrderStatus").val() == "") {
                    OrderStatusValue = OrderStatus;
                } else if ($("#OrderStatus").val() != "") {
                    if (OrderStatus == $("#OrderStatus").val()) {
                        OrderStatusValue = $("#OrderStatus").val();
                    } else {
                        if (OrderStatus == "" && ($("#OrderStatus").val() != "C" && $("#OrderStatus").val() != "D" && $("#OrderStatus").val() != "L")) {
                            OrderStatusValue = $("#OrderStatus").val();
                        } else {
                            OrderStatusValue = "ERROR";
                        }
                    }
                }
                ReloadStatusNumberValue = "N";
            } else {
                OrderStatusValue = $("#OrderStatus").val();
                ReloadStatusNumberValue = "Y";
            }

            var req = {
                FromDate: $('#FromDate').val(),
                ToDate: $('#ToDate').val(),
                CrmOrPaypostCode: ($("#CrmOrPaypostCode").val() || []).join(","),
                OrderStatus: OrderStatusValue,
                PrintStatus: $('#PrintStatus').val(),
                PostalType: $("#PostalType").val(),
                MainTransportService: ($("#MainTransportService").val() || []).join(","),
                ExtraTransportService: ($("#ExtraTransportService").val() || []).join(","),
                SearchKey: ($("#SearchKey").val() || "").trim(),
                ReloadStatusNumber: ReloadStatusNumberValue,
                PageNumber: pageIndex || 1,
                PageLimit: pageSize || 20
            };

            var requestSequence = ++orderSearchSequence;

            // Hủy request cũ nếu người dùng đổi bộ lọc trước khi request đó hoàn tất.
            if (currentOrderSearchRequest && currentOrderSearchRequest.readyState !== 4) {
                currentOrderSearchRequest.abort();
            }

            $('#data-wrapper').addClass('is-loading');

            currentOrderSearchRequest = $.ajax({
                type: 'POST',
                url: '@Url.Action("SearchListOrderPaginationView", "Order")',
                data: req,
                global: false // Không bật/tắt ajax_loader toàn trang gây nhấp nháy.
            }).done(function (data) {
                // Chỉ request mới nhất được phép cập nhật giao diện.
                if (requestSequence !== orderSearchSequence) {
                    return;
                }

                $('#data-wrapper').html(data);

                if (req.OrderStatus == "D") {
                    $("#btnAcceptOrder").removeClass("d-none");
                } else {
                    $("#btnAcceptOrder").addClass("d-none");
                }
            }).fail(function (xhr, status) {
                if (status !== 'abort') {
                    console.error('Lỗi tải danh sách đơn hàng:', status, xhr);
                }
            }).always(function () {
                if (requestSequence === orderSearchSequence) {
                    $('#data-wrapper').removeClass('is-loading');
                }
            });
        }

        function btnExportExcel() {
            var req = {
                FromDate: $('#FromDate').val(),
                ToDate: $('#ToDate').val(),
                CrmOrPaypostCode: ($("#CrmOrPaypostCode").val() || []).join(","),
                OrderStatus: $("#OrderStatus").val(),
                PrintStatus: $('#PrintStatus').val(),
                PostalType: $("#PostalType").val(),
                MainTransportService: ($("#MainTransportService").val() || []).join(","),
                ExtraTransportService: ($("#ExtraTransportService").val() || []).join(","),
                SearchKey: ($("#SearchKey").val() || "").trim(),
            };
            var param = String.format("FromDate={0}&ToDate={1}&CrmOrPaypostCode={2}&OrderStatus={3}&PrintStatus={4}&PostalType={5}&MainTransportService={6}&ExtraTransportService={7}&SearchKey={8}",
                req.FromDate, req.ToDate, req.CrmOrPaypostCode, req.OrderStatus, req.PrintStatus, req.PostalType, req.MainTransportService, req.ExtraTransportService, req.SearchKey);
            window.location.href = '@Url.Action("ExportListOrder","Order")?' + param;
        }

        function btnAcceptOrder(OrderID, OrderCode, BatchCode, OrderStatus) {
            var arr = [];
            if (OrderID) {
                var obj = {};
                obj.OrderID = OrderID;
                obj.OrderCode = OrderCode;
                obj.BatchCode = BatchCode;
                obj.OrderStatus = OrderStatus;
                arr.push(obj);
            } else {
                var table = $('#SearchListDataTable').DataTable();
                table.$('input:checked').each(function () {
                    var obj = {};
                    obj.OrderID = $(this).val();
                    obj.OrderCode = $(this).attr("data-OrderCode");
                    obj.BatchCode = $(this).attr("data-BatchCode");
                    obj.OrderStatus = $(this).attr("data-OrderStatus");
                    arr.push(obj);
                });
            }

            if (arr.length == 0) {
                CreateCustomSwal("error", "Vui lòng chọn đơn hàng cần duyệt.");
                return;
            }

            swal({
                title: 'Thông báo',
                text: "Bạn có chắc chắn muốn duyệt đơn hàng?",
                html: true,
                buttons: {
                    confirm: {
                        text: "Xác nhận",
                        value: true,
                        visible: true,
                        className: "btn btn-primary",
                        closeModal: true
                    },
                    cancel: {
                        text: "Đóng",
                        value: false,
                        visible: true,
                        className: "btn btn-danger",
                        closeModal: true,
                    }
                },
            }).then((value) => {
                if (value) {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("JNewOrder", "Order")',
                        dataType: 'json',
                        loading: true,
                        data: {
                            req: arr
                        },
                        success: function (res) {
                            if (res.Code == "00") {
                                CreateCustomSwal("success", res.Message);
                            } else
                            if (res.Code == "10") {
                                swal({
                                    title: 'Thông báo',
                                    text: res.Message,
                                    buttons: {
                                        confirm: {
                                            text: "Xem chi tiết",
                                            value: true,
                                            visible: true,
                                            className: "btn btn-primary",
                                            closeModal: true
                                        },
                                        cancel: {
                                            text: "Đóng",
                                            value: false,
                                            visible: true,
                                            className: "btn btn-danger",
                                            closeModal: true,
                                        }
                                    },
                                }).then((value) => {
                                    if (value) {
                                        $.post('@Url.Action("ShowListErrorMultipleSelect", "Handle")', {
                                            Error: res.Data,
                                            Controller: "Order"
                                        }, function (data) {
                                            $('#modal-ViewModal-html').html(data);
                                            $('#ViewModal').modal('show');
                                        });
                                    } else {
                                        window.location.reload();
                                    }
                                });
                            } else {
                                CreateCustomSwal("error", res.Message);
                            }
                        }
                    });
                }
            });
        }

        function btnCancelOrder(OrderID, OrderCode, BatchCode, OrderStatus) {
            var arr = [];
            if (OrderID) {
                var obj = {};
                obj.OrderID = OrderID;
                obj.OrderCode = OrderCode;
                obj.BatchCode = BatchCode;
                obj.OrderStatus = OrderStatus;
                arr.push(obj);
            } else {
                var table = $('#SearchListDataTable').DataTable();
                table.$('input:checked').each(function () {
                    var obj = {};
                    obj.OrderID = $(this).val();
                    obj.OrderCode = $(this).attr("data-OrderCode");
                    obj.BatchCode = $(this).attr("data-BatchCode");
                    obj.OrderStatus = $(this).attr("data-OrderStatus");
                    arr.push(obj);
                });
            }

            if (arr.length == 0) {
                CreateCustomSwal("error", "Vui lòng chọn đơn hàng cần hủy.");
                return;
            }

            $.post('@Url.Action("RejectOrderView", "Order")', { SearchKey: JSON.stringify(arr) }, function (data) {
                $('#modal-ViewModal-html').html(data);
                $('#ViewModal').modal('show');
            });
        }

        function btnPrintOrder(EMSOneCode, ShopID) {
            var arr = [];

            if (EMSOneCode && ShopID) {
                var obj = {};
                obj.EMSOneCode = EMSOneCode;
                obj.ShopID = ShopID;
                arr.push(obj);
            } else {
                var table = $('#SearchListDataTable').DataTable();
                table.$('input:checked').each(function () {
                    var obj = {};
                    obj.EMSOneCode = $(this).attr("data-EMSOneCode");
                    obj.ShopID = $(this).attr("data-ShopID");
                    arr.push(obj);
                });
            }

            if (arr.length == 0) {
                CreateCustomSwal("error", "Vui lòng chọn đơn hàng cần in.");
                return;
            }

            localStorage.setItem('ListDataOrderPrint', JSON.stringify(arr));
            var link = document.createElement('a');
            link.target = "_blank";
            //link.href = '@Url.Action("PrintOrderView", "Handle")';
            link.href = '@Url.Action("PrintOrderView", "Order")';
            link.click();
        }

