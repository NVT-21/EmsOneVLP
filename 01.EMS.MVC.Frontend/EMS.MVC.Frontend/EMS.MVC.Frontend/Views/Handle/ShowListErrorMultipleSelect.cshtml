@model List<EMS.MVC.Frontend.Models.ShowListErrorMultipleSelectViewModel>
@if (ViewBag.Controller == "Order")
{
    <div class="modal-dialog modal-medium modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Danh sách lỗi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal">
                </button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr class="table-info text-center">
                                <th>Mã lô</th>
                                <th>Mã đơn hàng</th>
                                <th style="max-width: 400px;">Nội dung</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var Item in Model)
                            {
                                <tr>
                                    <td class="text-center">@Item.BatchCode</td>
                                    <td class="text-center">@Item.OrderCode</td>
                                    <td style="max-width: 400px; white-space: pre-line; line-height: inherit; text-align: justify; vertical-align: middle;">@Item.Description</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-dark light" onclick="window.location.reload();">Đóng</button>
            </div>
        </div>
    </div>
}
