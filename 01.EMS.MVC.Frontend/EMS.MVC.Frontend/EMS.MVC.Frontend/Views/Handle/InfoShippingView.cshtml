        <div class="col-12 col-lg-4 ems-history-column">
            <div class="ems-timeline-sticky">
                        <!-- Lịch sử trạng thái -->
                        @if(Model.ListSearchHistory != null && Model.ListSearchHistory.Count > 0)
                        {
                                <div class="shipping-card ems-collapsible">
                                    <div class="card-body">
                                        <h6><i class="fa-solid fa-route"></i>Lịch sử trạng thái</h6>
                                        <div class="timeline">
                                            @{
                                                int deliveryHistoryIndex = 0;
                                            }
                                            @foreach(var item in Model.ListSearchHistory)
                
                                            {
                                                var time = string.IsNullOrEmpty(item.StatusTimePartner) ? item.CreatedDate : item.StatusTimePartner;
                                                var statusClass = "";
                                                var statusIcon = "fa-circle-dot";
                                                var isSuccess = !string.IsNullOrEmpty(item.StatusName) && item.StatusName.ToLower().Contains("phát thành công");
                                                var isFailed = !string.IsNullOrEmpty(item.StatusName) && item.StatusName.ToLower().Contains("phát không thành công");
                                                var isInProgress = !string.IsNullOrEmpty(item.StatusName) &&
                                                                  (item.StatusName.ToLower().Contains("đang phát") ||
                                                                   item.StatusName.ToLower().Contains("đang vận chuyển") ||
                                                                   item.StatusName.ToLower().Contains("xác nhận đến"));
                                                var isPending = !string.IsNullOrEmpty(item.StatusName) && item.StatusName.ToLower().Contains("chờ lấy hàng");
                                                var isCreated = !string.IsNullOrEmpty(item.StatusName) && item.StatusName.ToLower().Contains("đã tạo");
                                                if(isSuccess)
                                                {
                                                    statusClass = "status-success";
                                                    statusIcon = "fa-circle-check";
                                                }
                                                else if(isFailed)
                                                {
                                                    statusClass = "status-failed";
                                                    statusIcon = "fa-circle-xmark";
                                                }
                                                else if(isInProgress)
                                                {
                                                    statusClass = "status-in-progress";
                                                    statusIcon = "fa-truck-fast";
                                                }
                                                else if(isPending)
                                                {
                                                    statusClass = "status-pending";
                                                    statusIcon = "fa-clock";
                                                }
                                                else if(isCreated)
                                                {
                                                    statusClass = "status-created";
                                                    statusIcon = "fa-file-circle-plus";
                                                }
                                                var isCurrentStatus = deliveryHistoryIndex == 0;
                                                <div class="timeline-item @(isCurrentStatus ? "is-current" : "")">
                                                    <div class="timeline-icon @statusClass"><i class="fa-solid @statusIcon"></i></div>
                                                    <div class="timeline-content">
                                                        <div class="timeline-time">
                                                            @time
                                                            @if(isCurrentStatus)
                                                            {
                                                                <span class="timeline-badge-current">Mới nhất</span>
                                                            }
                                                        </div>
                                                        <div class="timeline-status fw-semibold @statusClass">
                                                            <span>@item.StatusName</span>
                
                                                            @if(!string.IsNullOrEmpty(item.StatusNote) && item.StatusNote != item.StatusName)
                                                            {
                                                                <span class="timeline-note"> - @item.StatusNote</span>
                                                            }
                                                            @if(!string.IsNullOrEmpty(item.PosCode) && !string.IsNullOrEmpty(item.PosName))
                                                            {
                                                                var posText = item.PosCode + ": " + item.PosName +
                                                                              (string.IsNullOrEmpty(item.PosTel) ? "" : " (" + item.PosTel + ")") +
                                                                              (string.IsNullOrEmpty(item.PosAddress) ? "" : ", " + item.PosAddress);
                                                                <span class="timeline-pos">
                                                                    - @posText
                                                                    <button class="copy-btn" onclick="copyToClipboard('@Html.Raw(HttpUtility.JavaScriptStringEncode(posText))', this)" aria-label="Sao chép thông tin bưu cục">
                                                                        <i class="fa-solid fa-copy"></i>
                
                                                                    </button>
                                                                </span>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                deliveryHistoryIndex++;
                                            }
                                        </div>
                                    </div>
                                </div>
                        }
            </div>
        </div>
    </div>
}
else
{
    <div class="col-12">
        <div class="shipping-card">
            <div class="card-body ems-empty-state">
                <i class="fa-solid fa-box-open"></i>
                <p class="text-danger">Dữ liệu không tồn tại.</p>
            </div>
        </div>
    </div>
}
