@model EMS.MVC.Frontend.Models.InfoShippingViewModel
@using Newtonsoft.Json
<!-- Thêm CDN của Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<style>
    :root {
        --ems-navy: #0b3866;
        --ems-blue: #1768b3;
        --ems-blue-dark: #0b4c86;
        --ems-blue-soft: #eef5fc;
        --ems-blue-line: #d7e6f4;
        --ems-orange: #ef7d22;
        --ems-orange-dark: #cf6712;
        --ems-orange-soft: #fef2e7;
        --ems-surface: #ffffff;
        --ems-page: #f3f6fb;
        --ems-text: #1f2937;
        --ems-muted: #64748b;
        --ems-border: #e4e9f1;
        --ems-success: #15803d;
        --ems-danger: #dc2626;
        --ems-info: #2563eb;
        --ems-warning: #d97706;
        --ems-created: #6b7280;
        --ems-shadow: 0 6px 18px rgba(11, 56, 102, .08);
        --ems-shadow-hover: 0 12px 28px rgba(11, 56, 102, .13);
    }

    .ems-tracking {
        font-family: inherit;
        box-sizing: border-box;
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 12px;
        border-radius: 16px;
        background:
            linear-gradient(180deg, rgba(23, 104, 179, .04), rgba(23, 104, 179, 0) 200px),
            var(--ems-page);
    }

    .ems-tracking *,
    .ems-tracking *::before,
    .ems-tracking *::after {
        box-sizing: border-box;
    }

    /* Bố cục 2 cột luôn chiếm trọn chiều rộng khả dụng */
    .ems-main-column,
    .ems-history-column,
    .ems-main-column .row,
    .ems-main-column [class*="col-"] {
        min-width: 0;
    }

    /* ===== Card chung ===== */
    .shipping-card {
        position: relative;
        overflow: visible;
        border: 1px solid var(--ems-border);
        border-radius: 14px;
        background: var(--ems-surface);
        box-shadow: var(--ems-shadow);
        margin-bottom: 8px;
        width: 100%;
        transition: box-shadow .15s ease;
    }

        .shipping-card:hover {
            box-shadow: var(--ems-shadow-hover);
        }

        .shipping-card.shipping-card-hero {
            border-top: 4px solid var(--ems-orange);
            background: linear-gradient(135deg, #ffffff 0%, #f8fbff 65%, #fff8f2 100%);
        }

        .shipping-card .card-body {
            min-width: 0;
            padding: 12px 14px;
            width: 100%;
        }

        .shipping-card h6 {
            display: flex;
            align-items: center;
            gap: 8px;
            min-height: 32px;
            font-size: .8rem;
            font-weight: 800;
            letter-spacing: .3px;
            margin-bottom: 10px;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--ems-blue-line);
            color: var(--ems-navy);
            text-transform: uppercase;
        }

            .shipping-card h6 > i:first-child {
                width: 26px;
                height: 26px;
                flex: 0 0 26px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 8px;
                background: var(--ems-orange-soft);
                color: var(--ems-orange-dark);
                font-size: .9em;
            }

        .shipping-card label {
            font-size: .68rem;
            color: var(--ems-muted);
            margin-bottom: .2rem;
            display: inline-block;
        }

        .shipping-card span, .shipping-card p {
            font-size: .72rem;
            font-weight: 500;
            color: var(--ems-text);
            line-height: 1.35;
        }

    /* ===== Mã bưu gửi ===== */
    .ems-code-row {
        display: flex;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 6px 8px;
        min-width: 0;
        padding: 7px 8px;
        border: 1px dashed var(--ems-blue-line);
        border-radius: 10px;
        background: rgba(238, 245, 252, .65);
    }

        .ems-code-row label {
            margin: 0;
            white-space: nowrap;
        }

    .ems-code-hint {
        max-width: 100%;
        font-size: .62rem;
        color: var(--ems-muted);
        white-space: normal;
        overflow-wrap: anywhere;
    }

    .clickable-shipping-code {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        max-width: 100%;
        padding: 5px 10px;
        margin: 0;
        border-radius: 8px;
        border: 1.5px dashed var(--ems-blue);
        background: #fff;
        color: var(--ems-blue) !important;
        font-weight: 700;
        font-family: "Courier New", monospace;
        font-size: .76rem !important;
        letter-spacing: .3px;
        line-height: 1.3;
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: break-word;
        cursor: pointer;
        text-decoration: none !important;
        transition: background-color .15s ease, color .15s ease, border-color .15s ease;
    }

        .clickable-shipping-code:hover {
            background: var(--ems-orange);
            border-color: var(--ems-orange);
            color: #fff !important;
        }

        .clickable-shipping-code:focus {
            outline: 2px solid var(--ems-orange);
            outline-offset: 2px;
        }

        .clickable-shipping-code i {
            font-size: .72em;
        }

    /* ===== Tổng quan bưu gửi: lấp đầy chiều rộng bằng auto-fit ===== */
    .ems-stat-grid {
        width: 100%;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 10px;
        margin-top: 10px;
    }

    .ems-stat {
        min-width: 0;
        display: flex;
        align-items: flex-start;
        gap: 8px;
        min-height: 58px;
        padding: 9px 10px;
        border-radius: 11px;
        background: linear-gradient(180deg, #fff 0%, #f9fcff 100%);
        border: 1px solid var(--ems-blue-line);
        transition: border-color .15s ease, background-color .15s ease;
    }

        .ems-stat:hover {
            border-color: #bfd7ef;
            background: var(--ems-blue-soft);
        }

    .ems-stat-full {
        grid-column: 1 / -1;
    }

    .ems-stat-icon {
        flex: 0 0 30px;
        width: 30px;
        height: 30px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--ems-blue-soft);
        color: var(--ems-blue);
        font-size: 12px;
    }

    .ems-stat-body {
        flex: 1 1 auto;
        min-width: 0;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .ems-stat-label {
        font-size: .64rem;
        font-weight: 600;
        color: var(--ems-muted);
        white-space: normal;
    }

    .ems-stat-value {
        font-size: .78rem;
        font-weight: 700;
        color: var(--ems-text);
        line-height: 1.35;
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: break-word;
        cursor: default;
    }

    .ems-copy-field {
        cursor: copy;
    }

        .ems-copy-field:hover {
            color: var(--ems-blue);
        }

    /* ===== Người gửi / người nhận ===== */
    .ems-person-card-sender,
    .ems-person-card-receiver {
        height: 100%;
    }

    .ems-person-head {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px !important;
        border-bottom: none !important;
        padding-bottom: 0 !important;
    }

    .ems-person-avatar {
        flex: 0 0 26px;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 12px;
    }

    .ems-person-card-sender .ems-person-avatar {
        background: linear-gradient(135deg, var(--ems-blue) 0%, var(--ems-navy) 100%);
    }

    .ems-person-card-receiver .ems-person-avatar {
        background: linear-gradient(135deg, var(--ems-orange) 0%, var(--ems-orange-dark) 100%);
    }

    .ems-person-field {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 8px;
        min-width: 0;
        padding: 6px 0;
        border-bottom: 1px dashed var(--ems-blue-line);
    }

        .ems-person-field:last-child {
            border-bottom: none;
        }

        .ems-person-field .ems-person-field-main {
            display: flex;
            align-items: flex-start;
            flex-wrap: nowrap;
            gap: 7px;
            flex: 1 1 0;
            min-width: 0;
        }

        .ems-person-field .ems-person-field-main i {
            color: var(--ems-blue);
            font-size: .75em;
            flex: 0 0 auto;
            margin-top: .2em;
        }

        .ems-person-field .ems-person-field-main > div {
            flex: 1 1 0;
            width: 100%;
            min-width: 0;
        }

        .ems-person-field label {
            margin: 0;
            white-space: normal;
            color: var(--ems-muted);
            font-weight: 600;
        }

            .ems-person-field label::after {
                content: ":";
                margin-right: 2px;
            }

        .ems-person-field span {
            display: inline;
            max-width: 100%;
            color: var(--ems-text);
            line-height: 1.45;
            white-space: normal;
            overflow-wrap: anywhere;
            word-break: break-word;
        }

    .copy-btn {
        flex: 0 0 auto;
        border: 1px solid var(--ems-blue-line);
        background: var(--ems-blue-soft);
        color: var(--ems-blue);
        font-size: .68rem;
        cursor: pointer;
        margin-left: 2px;
        padding: 4px 7px;
        border-radius: 6px;
        transition: background-color .15s ease, color .15s ease;
    }

        .copy-btn:hover {
            background: var(--ems-orange);
            border-color: var(--ems-orange);
            color: #fff;
        }

    /* ===== Hình ảnh báo phát & xác thực ===== */
    .ems-media-row {
        display: flex;
        flex-wrap: wrap;
        min-width: 0;
        margin-bottom: 8px;
        border: 1px solid var(--ems-blue-line);
        border-radius: 10px;
        overflow: hidden;
    }

        .ems-media-row:last-child {
            margin-bottom: 0;
        }

    .ems-media-col {
        flex: 1 1 210px;
        min-width: 170px;
        overflow: hidden;
        padding: 9px 11px;
        border-right: 1px solid var(--ems-blue-line);
        background: #fbfdff;
    }

        .ems-media-col:last-child {
            border-right: none;
        }

        .ems-media-col label {
            display: block;
            margin-bottom: 6px;
            font-size: .66rem;
            font-weight: 700;
            color: var(--ems-navy);
        }

    .ems-image-label {
        display: flex !important;
        align-items: center;
        gap: 6px;
    }

    .ems-image-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 21px;
        height: 19px;
        padding: 0 6px;
        border-radius: 999px;
        background: var(--ems-blue-soft);
        color: var(--ems-blue) !important;
        font-size: .6rem !important;
        font-weight: 800 !important;
        line-height: 1;
    }

    .ems-media-empty {
        font-size: .7rem;
        color: #9aa7bb;
        font-style: italic;
    }

    .ems-download-all-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-bottom: 7px;
        padding: 3px 10px;
        border: 1px solid var(--ems-blue);
        border-radius: 999px;
        background: #fff;
        color: var(--ems-blue);
        font-size: .62rem;
        font-weight: 600;
        cursor: pointer;
        transition: background-color .15s ease, color .15s ease;
    }

        .ems-download-all-btn:hover {
            background: var(--ems-blue);
            color: #fff;
        }

        .ems-download-all-btn:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

    .image-gallery {
        display: flex;
        flex-wrap: wrap;
        gap: .35rem;
    }

        .image-gallery img {
            width: 58px;
            height: 58px;
            max-width: 100%;
            object-fit: cover;
            border-radius: 7px;
            border: 1px solid var(--ems-border);
            cursor: pointer;
            transition: transform .2s, box-shadow .2s;
        }

            .image-gallery img:hover {
                transform: scale(1.08);
                box-shadow: 0 6px 16px rgba(11, 56, 102, .18);
            }

    /* ===== Bảng "Thông tin phát" ===== */
    .ems-table-wrap {
        width: 100%;
        border-radius: 10px;
        border: 1px solid var(--ems-border);
        overflow: auto;
    }

    .ems-delivery-wrap {
        max-height: min(52vh, 520px);
        border: 1px solid var(--ems-blue-line);
        border-radius: 12px;
        background: #fff;
        scrollbar-width: thin;
        scrollbar-color: #9dbbd8 #eef4fa;
    }

        .ems-delivery-wrap::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        .ems-delivery-wrap::-webkit-scrollbar-thumb {
            background: #9dbbd8;
            border-radius: 999px;
        }

    .table-shipping {
        width: 100%;
        margin-bottom: 0;
        font-size: .7rem;
    }

        .table-shipping th {
            font-weight: 700;
            color: #fff;
            background: linear-gradient(180deg, var(--ems-blue) 0%, var(--ems-navy) 100%);
            padding: .6rem .65rem;
            white-space: nowrap;
        }

        .table-shipping td {
            padding: .55rem .65rem;
            min-width: 120px;
            max-width: 360px;
            vertical-align: top;
            white-space: normal;
            overflow-wrap: anywhere;
            word-break: break-word;
        }

        .table-shipping tbody tr {
            border-bottom: 1px solid var(--ems-border);
        }

            .table-shipping tbody tr:nth-child(even) {
                background-color: #f8fafc;
            }

            .table-shipping tbody tr:hover {
                background-color: var(--ems-blue-soft);
            }

    .ems-delivery-table {
        min-width: 900px;
        table-layout: fixed;
    }

        .ems-delivery-table thead th {
            position: sticky;
            top: 0;
            z-index: 4;
            border-bottom: 3px solid var(--ems-orange);
            font-size: .66rem;
            line-height: 1.25;
        }

            .ems-delivery-table thead th i {
                margin-right: 6px;
                color: #ffd1b5;
            }

        .ems-delivery-table th:nth-child(1) { width: 13%; }
        .ems-delivery-table th:nth-child(2) { width: 13%; }
        .ems-delivery-table th:nth-child(3) { width: 20%; }
        .ems-delivery-table th:nth-child(4) { width: 15%; }
        .ems-delivery-table th:nth-child(5) { width: 20%; }
        .ems-delivery-table th:nth-child(6) { width: 19%; }

        .ems-delivery-table tbody td {
            background: #fff;
            line-height: 1.42;
        }

            .ems-delivery-table tbody tr:nth-child(even) td {
                background: #f8fbff;
            }

            .ems-delivery-table tbody tr:hover td {
                background: #eef7ff;
            }

            .ems-delivery-table tbody td:nth-child(1),
            .ems-delivery-table tbody td:nth-child(2) {
                color: var(--ems-navy);
                font-weight: 700;
            }

            .ems-delivery-table tbody tr:last-child td {
                border-bottom: 0;
            }

    .no-wrap {
        white-space: nowrap;
    }

    /* ===== Lịch sử trạng thái - timeline ===== */
    .ems-timeline-sticky .shipping-card {
        overflow: hidden;
        border-top: 4px solid var(--ems-blue);
    }

        .ems-timeline-sticky .shipping-card h6 {
            margin: -12px -14px 10px;
            padding: 11px 14px 9px;
            border-bottom: 3px solid var(--ems-orange);
            background: linear-gradient(135deg, var(--ems-blue) 0%, var(--ems-navy) 100%);
            color: #fff;
        }

            .ems-timeline-sticky .shipping-card h6 > i:first-child {
                background: rgba(255, 255, 255, .15);
                color: #ffb27f;
            }

        .ems-timeline-sticky .ems-section-toggle {
            border-color: rgba(255, 255, 255, .3);
            background: rgba(255, 255, 255, .12);
            color: #fff;
        }

    .timeline {
        position: relative;
        min-width: 0;
        margin-left: 0;
        padding: 4px 3px 4px 34px;
        max-height: 280px;
        overflow-y: auto;
        scroll-behavior: smooth;
    }

        .timeline::before {
            content: "";
            position: absolute;
            left: 15px;
            top: 6px;
            bottom: 6px;
            width: 2px;
            background: linear-gradient(180deg, var(--ems-orange) 0%, var(--ems-blue-line) 20%, var(--ems-blue-line) 100%);
        }

    .timeline-item {
        position: relative;
        min-width: 0;
        margin-bottom: 9px;
        padding: 8px 9px;
        border: 1px solid var(--ems-border);
        border-radius: 10px;
        background: #fff;
    }

        .timeline-item:last-child {
            margin-bottom: 0;
        }

        .timeline-item.is-current {
            border-color: #f7c5a5;
            background: linear-gradient(135deg, #fff 0%, #fff7f1 100%);
            box-shadow: 0 4px 14px rgba(239, 125, 34, .12);
        }

    .timeline-icon {
        position: absolute;
        left: -31px;
        top: 8px;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #fff;
        border: 2px solid #cfd9e6;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        color: #9aa7bb;
        box-shadow: 0 0 0 3px #fff;
    }

        .timeline-icon.status-success { border-color: var(--ems-success); color: var(--ems-success); }
        .timeline-icon.status-failed { border-color: var(--ems-danger); color: var(--ems-danger); }
        .timeline-icon.status-in-progress { border-color: var(--ems-info); color: var(--ems-info); }
        .timeline-icon.status-pending { border-color: var(--ems-warning); color: var(--ems-warning); }
        .timeline-icon.status-created { border-color: var(--ems-created); color: var(--ems-created); }

    .timeline-content,
    .timeline-status,
    .timeline-note,
    .timeline-pos {
        min-width: 0;
        max-width: 100%;
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    .timeline-content {
        font-size: .75rem;
        color: var(--ems-text);
        line-height: 1.4;
        padding-top: 2px;
    }

    .timeline-time {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 5px 8px;
        font-weight: 700;
        color: var(--ems-navy);
        margin-bottom: .15rem;
    }

    .timeline-badge-current {
        font-size: .6rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .3px;
        color: #fff;
        background: var(--ems-orange);
        padding: 1px 7px;
        border-radius: 999px;
    }

    .timeline-status {
        color: var(--ems-navy);
        line-height: 1.5;
    }

    .timeline-note {
        font-style: italic;
        color: #52709c;
        font-weight: normal;
    }

    .timeline-pos {
        color: #52709c;
        font-weight: normal;
    }

    .status-success { color: var(--ems-success) !important; }
    .status-failed { color: var(--ems-danger) !important; }
    .status-in-progress { color: var(--ems-info) !important; }
    .status-pending { color: var(--ems-warning) !important; }
    .status-created { color: var(--ems-created) !important; }

    /* ===== Trạng thái rỗng ===== */
    .ems-empty-state {
        text-align: center;
        padding: 46px 20px;
        color: var(--ems-muted);
    }

        .ems-empty-state i {
            font-size: 34px;
            color: var(--ems-blue);
            margin-bottom: 10px;
            display: block;
        }

        .ems-empty-state p {
            font-size: .85rem !important;
            font-weight: 600 !important;
            color: #445572 !important;
        }

    /* ===== Toast ===== */
    .toast {
        position: fixed;
        bottom: 24px;
        right: 24px;
        display: flex;
        align-items: center;
        background: linear-gradient(135deg, var(--ems-navy) 0%, var(--ems-blue) 100%);
        color: #fff;
        padding: 11px 18px;
        border-radius: 10px;
        box-shadow: 0 12px 26px rgba(11, 56, 102, .3);
        opacity: 0;
        transform: translateY(8px);
        transition: opacity .25s ease, transform .25s ease;
        z-index: 1000;
        font-size: .82rem;
    }

        .toast i {
            color: var(--ems-orange);
            margin-right: 8px;
        }

        .toast.show {
            opacity: 1;
            transform: translateY(0);
        }

    /* ===== Thu gọn / mở rộng từng khối ===== */
    .ems-section-heading {
        cursor: default;
    }

    .ems-section-toggle {
        flex: 0 0 auto;
        width: 29px;
        height: 27px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-left: auto;
        padding: 0;
        border: 1px solid var(--ems-blue-line);
        border-radius: 7px;
        background: var(--ems-blue-soft);
        color: var(--ems-blue);
        cursor: pointer;
        transition: all .15s ease;
    }

        .ems-section-toggle:hover {
            border-color: var(--ems-blue);
            background: #e2eefb;
        }

        .ems-section-toggle i {
            color: inherit !important;
            transition: transform .2s ease;
        }

    .ems-collapsible.is-collapsed .ems-section-toggle i {
        transform: rotate(-90deg);
    }

    .ems-section-content {
        display: block;
    }

    .ems-collapsible.is-collapsed .ems-section-content {
        display: none;
    }

    .ems-collapsible.is-collapsed .card-body > h6 {
        margin-bottom: 0;
        padding-bottom: 0;
        border-bottom-color: transparent;
    }

    /* ===== Mở khung chi tiết ra gần hết màn hình khi hiển thị trong modal ===== */
    .modal-dialog:has(.ems-tracking),
    .modal-dialog.ems-detail-modal-dialog {
