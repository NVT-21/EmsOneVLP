</style>
<script>
    async function copyToClipboard(text, successMessage, btn) {
        if (text === null || text === undefined || String(text).trim() === '') {
            showToast('Không có dữ liệu để sao chép!');
            return;
        }

        var value = String(text).trim();
        var originalHtml = btn ? btn.innerHTML : null;

        try {
            if (navigator.clipboard && window.isSecureContext) {
                await navigator.clipboard.writeText(value);
            } else {
                var textarea = document.createElement('textarea');
                textarea.value = value;
                textarea.style.position = 'fixed';
                textarea.style.opacity = '0';
                textarea.style.pointerEvents = 'none';
                document.body.appendChild(textarea);
                textarea.focus();
                textarea.select();
                var copied = document.execCommand('copy');
                textarea.remove();
                if (!copied) {
                    throw new Error('Không thể sao chép bằng phương thức dự phòng');
                }
            }

            if (btn) {
                btn.innerHTML = '<i class="fa-solid fa-check"></i>';
                setTimeout(function () { btn.innerHTML = originalHtml; }, 1200);
            }
            showToast(successMessage || 'Đã sao chép!');
        } catch (err) {
            console.error('Lỗi sao chép:', err);
            showToast('Lỗi khi sao chép!');
        }
    }

    function showToast(message) {
        let toast = document.querySelector('.toast');
        if (!toast) {
            toast = document.createElement('div');
            toast.className = 'toast';
            document.body.appendChild(toast);
        }
        toast.innerHTML = '<i class="fa-solid fa-circle-check"></i><span></span>';
        toast.querySelector('span').textContent = message;
        toast.classList.add('show');
        setTimeout(() => {
            toast.classList.remove('show');
        }, 2000);
    }

    // Ghi nhớ toàn bộ ảnh của mục (gallery) đang được mở xem phóng to,
    // để nút "Tải tất cả" trong khung zoom (ImageZoomModal, nằm ở DetailShippingView.cshtml)
    // biết cần tải những ảnh nào.
    function setCurrentZoomGallery(imgEl) {
        var gallery = imgEl.closest('.image-gallery');
        var imgs = gallery ? gallery.querySelectorAll('img') : [imgEl];
        window.__emsCurrentGalleryImages = Array.prototype.map.call(imgs, function (im) { return im.src; });
    }

    // Tải toàn bộ ảnh của gallery đang mở trong khung zoom (được gọi từ nút
    // trong #image-controls). Dùng chung hàm downloadSingleImage bên dưới.
    async function downloadCurrentZoomGallery(btn) {
        var list = window.__emsCurrentGalleryImages || [];
        if (!list.length) {
            showToast('Không có ảnh để tải!');
            return;
        }

        var originalHtml = btn ? btn.innerHTML : null;
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
        }

        try {
            for (var i = 0; i < list.length; i++) {
                await downloadSingleImage(list[i], i + 1);
                if (i < list.length - 1) {
                    await new Promise(function (resolve) { setTimeout(resolve, 300); });
                }
            }
            showToast('Đã tải ' + list.length + ' ảnh!');
        } catch (err) {
            console.error('Lỗi khi tải ảnh:', err);
            showToast('Lỗi khi tải ảnh, vui lòng thử lại!');
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        }
    }

    // Tải toàn bộ ảnh trong 1 mục (Chữ ký / Hình ảnh báo phát / Ảnh HA / Ảnh bổ sung).
    // Nút được đặt ngay trước khối .image-gallery nên lấy ảnh từ nextElementSibling.
    // Mỗi ảnh được tải về thành 1 file riêng (không nén zip).
    async function downloadAllImagesInColumn(btn) {
        var gallery = btn.nextElementSibling;
        if (!gallery) { return; }
        var imgs = gallery.querySelectorAll('img');
        if (!imgs.length) { return; }

        var originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang tải...';

        try {
            for (var i = 0; i < imgs.length; i++) {
                await downloadSingleImage(imgs[i].src, i + 1);
                // Giãn cách nhẹ giữa các lần tải để trình duyệt không chặn tải nhiều file cùng lúc
                if (i < imgs.length - 1) {
                    await new Promise(function (resolve) { setTimeout(resolve, 300); });
                }
            }
            showToast('Đã tải ' + imgs.length + (imgs.length > 1 ? ' ảnh!' : ' ảnh!'));
        } catch (err) {
            console.error('Lỗi khi tải ảnh:', err);
            showToast('Lỗi khi tải ảnh, vui lòng thử lại!');
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        }
    }

    async function downloadSingleImage(src, index) {
        var ext = (src.split('.').pop() || 'jpg').split('?')[0];
        var fileName = 'anh-bao-phat' + (index ? '-' + index : '') + '.' + ext;

        try {
            // Cách 1: fetch ảnh về dạng blob rồi tải - cho tên file chính xác,
            // nhưng chỉ hoạt động nếu ảnh cùng domain hoặc server ảnh có bật CORS.
            var res = await fetch(src);
            if (!res.ok) { throw new Error('HTTP ' + res.status); }
            var blob = await res.blob();
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = fileName;
            document.body.appendChild(a);
            a.click();
            a.remove();
            URL.revokeObjectURL(url);
        } catch (err) {
            console.warn('Không thể fetch ảnh (có thể do CORS khác domain), chuyển sang tải trực tiếp:', err);
            // Cách 2 (dự phòng): tải thẳng bằng thẻ <a href="..." download>, không qua fetch
            // nên không bị chặn bởi CORS. Một số trình duyệt có thể mở ảnh ở tab mới thay vì
            // tải về ngay nếu ảnh khác domain và server không hỗ trợ, nhưng sẽ không báo lỗi.
            var a2 = document.createElement('a');
            a2.href = src;
            a2.download = fileName;
            a2.target = '_blank';
            a2.rel = 'noopener';
            document.body.appendChild(a2);
            a2.click();
            a2.remove();
        }
    }

    function ImageError(img) {
        let retries = parseInt(img.getAttribute('data-retries'));
        if (retries < 3) {
            img.setAttribute('data-retries', retries + 1);
            setTimeout(() => { img.src = img.src; }, 1000);
        } else {
            img.src = '/images/fallback.png';
            img.alt = 'Hình ảnh không tải được';
        }
    }
    function lookupShippingCode(shippingCode, shopID) {
        if (!shippingCode || !shopID) {
            showToast('Thiếu mã bưu gửi hoặc ShopID!');
            return;
        }
        showToast('Đang tra cứu mã bưu gửi: ' + shippingCode);

        const url = '/tra-cuu-buu-gui?ShippingCode=' + encodeURIComponent(shippingCode) +
            '&ShopID=' + encodeURIComponent(shopID);

        // Mở tab mới
        window.open(url, '_blank');
    }

    // ===== Xử lý click 1 lần (tra cứu) / click đúp (sao chép) cho mã bưu gửi =====
    // Trình duyệt luôn phát sinh sự kiện click trước cả khi người dùng double-click
    // (thứ tự: click -> click -> dblclick). Vì vậy ta phải trì hoãn hành động của
    // click đơn bằng setTimeout; nếu dblclick xảy ra trong khoảng chờ đó, ta hủy
    // timer để click đơn không kích hoạt tra cứu nữa.
    var __emsShippingCodeClickTimer = null;
    var EMS_CLICK_DELAY_MS = 250;

    function handleShippingCodeClick(event, el, shippingCode, shopID, code) {
        event.preventDefault();
        if (__emsShippingCodeClickTimer) {
            // Đây là click thứ 2 liên tiếp -> để ondblclick xử lý, không làm gì thêm
            return;
        }
        __emsShippingCodeClickTimer = setTimeout(function () {
            __emsShippingCodeClickTimer = null;
            lookupShippingCode(shippingCode, shopID);
        }, EMS_CLICK_DELAY_MS);
    }

    function handleShippingCodeDblClick(event, el, code) {
        event.preventDefault();
        if (__emsShippingCodeClickTimer) {
            clearTimeout(__emsShippingCodeClickTimer);
            __emsShippingCodeClickTimer = null;
        }
        copyToClipboard(code, 'Đã sao chép mã bưu gửi!', null);
    }




    function normalizeEmsText(value) {
        return (value || '').replace(/\s+/g, ' ').trim();
    }

    function initializeEmsCollapsibleCards() {
        var cards = document.querySelectorAll('.ems-collapsible');
        Array.prototype.forEach.call(cards, function (card) {
            if (card.getAttribute('data-collapse-ready') === 'true') {
                return;
            }

            var body = card.querySelector('.card-body');
            if (!body) { return; }

            var heading = body.querySelector('h6');
            if (!heading) { return; }

            var content = document.createElement('div');
            content.className = 'ems-section-content';

            while (heading.nextSibling) {
                content.appendChild(heading.nextSibling);
            }
            body.appendChild(content);

            heading.classList.add('ems-section-heading');

            var toggle = document.createElement('button');
            toggle.type = 'button';
            toggle.className = 'ems-section-toggle';
            toggle.setAttribute('aria-label', 'Thu gọn hoặc mở rộng');
            toggle.setAttribute('title', 'Thu gọn hoặc mở rộng');
            toggle.innerHTML = '<i class="fa-solid fa-chevron-down"></i>';
            toggle.addEventListener('click', function (event) {
                event.preventDefault();
                event.stopPropagation();
                card.classList.toggle('is-collapsed');
                updateCollapseAllButton();
            });
            heading.appendChild(toggle);

            if (card.getAttribute('data-collapsed') === 'true') {
                card.classList.add('is-collapsed');
            }

            card.setAttribute('data-collapse-ready', 'true');
        });

        updateCollapseAllButton();
    }

    function updateCollapseAllButton(btn) {
        var button = btn || document.getElementById('emsToggleAllSections');
        if (!button) { return; }

        var cards = Array.prototype.slice.call(document.querySelectorAll('.ems-collapsible'));
        var allCollapsed = cards.length > 0 && cards.every(function (card) {
            return card.classList.contains('is-collapsed');
        });

        button.innerHTML = allCollapsed
            ? '<i class="fa-solid fa-angles-down"></i> Mở tất cả'
            : '<i class="fa-solid fa-angles-up"></i> Thu gọn';
    }

    function initializeEmsCopyFields() {
        var fields = document.querySelectorAll('.ems-copy-field[data-copy-label]');
        Array.prototype.forEach.call(fields, function (field) {
            if (field.getAttribute('data-copy-ready') === 'true') { return; }
            field.setAttribute('title', 'Nhấn để sao chép');
            field.setAttribute('tabindex', '0');
            field.setAttribute('role', 'button');

            var doCopy = function () {
                var label = field.getAttribute('data-copy-label') || 'thông tin';
                copyToClipboard(normalizeEmsText(field.textContent), 'Đã sao chép ' + label.toLowerCase() + '!');
            };

            field.addEventListener('click', doCopy);
            field.addEventListener('keydown', function (event) {
                if (event.key === 'Enter' || event.key === ' ') {
                    event.preventDefault();
                    doCopy();
                }
            });
            field.setAttribute('data-copy-ready', 'true');
        });
    }

    // Gắn class mở rộng cho modal chứa màn hình tra cứu.
    // Cách này hỗ trợ cả trường hợp trình duyệt chưa hỗ trợ CSS :has().
    function applyEmsWideLayout() {
        var roots = document.querySelectorAll('.ems-tracking');
        for (var i = 0; i < roots.length; i++) {
            var dialog = roots[i].closest('.modal-dialog');
            if (dialog) {
                dialog.classList.add('ems-detail-modal-dialog');
            }
        }
    }

    function initializeEmsShippingView() {
        applyEmsWideLayout();
        initializeEmsCollapsibleCards();
        initializeEmsCopyFields();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeEmsShippingView);
    } else {
        setTimeout(initializeEmsShippingView, 0);
    }

</script>

@if(Model != null)
{
    <div class="row g-2 gy-0 ems-tracking">
        <div class="col-12 col-lg-8 ems-main-column">
            <div class="row g-2 gy-0">
                <!-- Thông tin bưu gửi -->
                <div class="col-12">
                    <div class="shipping-card shipping-card-hero">
                        <div class="card-body">
                            <h6><i class="fa-solid fa-box-open"></i>Thông tin bưu gửi <span class="ems-code-hint" style="margin-left:auto;text-transform:none;font-weight:500;">Nhấn vào giá trị để sao chép</span></h6>
                            <div class="row">
                                <div class="col-12 mb-0">
                                    <div class="ems-code-row">
                                        <label><i class="fa-solid fa-barcode"></i>Mã bưu gửi:</label>
                                        @if(!string.IsNullOrEmpty(Model.ShippingCode))
                                        {
                                            var shippingCodes = Model.ShippingCode.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries);
                                            for(int i = 0; i < shippingCodes.Length; i++)
                                            {
                                                var code = shippingCodes[i].Trim();
                                                var itemHash = Model.ListShippingCode[i];
                                                <span class="clickable-shipping-code"
                                                      onclick="handleShippingCodeClick(event, this, '@Html.Raw(HttpUtility.JavaScriptStringEncode(itemHash))', '@Html.Raw(HttpUtility.JavaScriptStringEncode(ViewBag.ShopID))', '@Html.Raw(HttpUtility.JavaScriptStringEncode(code))')"
                                                      ondblclick="handleShippingCodeDblClick(event, this, '@Html.Raw(HttpUtility.JavaScriptStringEncode(code))')"
                                                      onkeypress="if(event.key === 'Enter') lookupShippingCode('@Html.Raw(HttpUtility.JavaScriptStringEncode(itemHash))', '@Html.Raw(HttpUtility.JavaScriptStringEncode(ViewBag.ShopID))')"
                                                      role="button"
                                                      tabindex="0"
                                                      aria-label="Nhấn 1 lần để tra cứu, nhấn đúp để sao chép mã bưu gửi @Html.Raw(HttpUtility.JavaScriptStringEncode(code))">
                                                    <i class="fa-solid fa-magnifying-glass"></i>@code
                                                </span>
                                            }
                                            <span class="ems-code-hint">Nhấn 1 lần để tra cứu, nhấn đúp để sao chép</span>
                                        }
                                        else
                                        {
                                            <span>Không có mã bưu gửi</span>
                                        }
                                    </div>
                                </div>
                            </div>
        
                            <div class="ems-stat-grid">
                                <div class="ems-stat">
                                    <div class="ems-stat-icon"><i class="fa-solid fa-shopping-cart"></i></div>
                                    <div class="ems-stat-body">
                                        <span class="ems-stat-label">Mã đơn hàng</span>
                                        <span class="ems-stat-value ems-copy-field" data-copy-label="Mã đơn hàng" title="@Model.OrderCode">@Html.DisplayFor(m => m.OrderCode)</span>
                                    </div>
                                </div>
                                <div class="ems-stat">
                                    <div class="ems-stat-icon"><i class="fa-solid fa-clock"></i></div>
                                    <div class="ems-stat-body">
                                        <span class="ems-stat-label">Thời gian tạo</span>
                                        <span class="ems-stat-value ems-copy-field" data-copy-label="Thời gian tạo" title="@Model.CreatedDate">@Html.DisplayFor(m => m.CreatedDate)</span>
                                    </div>
                                </div>
                                <div class="ems-stat">
                                    <div class="ems-stat-icon"><i class="fa-solid fa-weight-hanging"></i></div>
                                    <div class="ems-stat-body">
                                        <span class="ems-stat-label">Khối lượng thực tế</span>
                                        <span class="ems-stat-value ems-copy-field" data-copy-label="Khối lượng thực tế" title="@(Model.TransportWeight) gr">@Html.DisplayFor(m => m.TransportWeight) gr</span>
                                    </div>
                                </div>
                                <div class="ems-stat">
                                    <div class="ems-stat-icon"><i class="fa-solid fa-balance-scale"></i></div>
                                    <div class="ems-stat-body">
                                        <span class="ems-stat-label">Khối lượng quy đổi</span>
                                        <span class="ems-stat-value ems-copy-field" data-copy-label="Khối lượng quy đổi" title="@(Model.ExchangeTransportWeight) gr">@Html.DisplayFor(m => m.ExchangeTransportWeight) gr</span>
                                    </div>
                                </div>
                                <div class="ems-stat">
                                    <div class="ems-stat-icon"><i class="fa-solid fa-ruler"></i></div>
                                    <div class="ems-stat-body">
                                        <span class="ems-stat-label">Kích thước (D x R x C)</span>
                                        <span class="ems-stat-value ems-copy-field" data-copy-label="Kích thước" title="@(Model.Length) x @(Model.Width) x @(Model.Height)">@Html.DisplayFor(m => m.Length) x @Html.DisplayFor(m => m.Width) x @Html.DisplayFor(m => m.Height)</span>
                                    </div>
                                </div>
                                <div class="ems-stat ems-stat-full">
                                    <div class="ems-stat-icon"><i class="fa-solid fa-truck"></i></div>
                                    <div class="ems-stat-body">
                                        <span class="ems-stat-label">Dịch vụ</span>
                                        <span class="ems-stat-value ems-copy-field" data-copy-label="Dịch vụ">
                                            @Html.DisplayFor(m => m.MainTransportService.Name)
                                            @{
                                                if(Model.ExtraTransportService != null && !string.IsNullOrEmpty(Model.ExtraTransportService.Name))
                                                {
                                                    var names = Model.ExtraTransportService.Name.Split(',');
                                                    var codes = string.IsNullOrEmpty(Model.ExtraTransportService.Code) ? new string[0] : Model.ExtraTransportService.Code.Split(',');
                                                    var extraServiceText = new List<string>();
                                                    for(var i = 0; i < names.Length; i++)
                                                    {
                                                        var name = names[i].Trim();
                                                        var code = (i < codes.Length) ? codes[i].Trim() : "";
                                                        var info = name;
                                                        decimal cod, phu;
                                                        if(code == "COD" && decimal.TryParse(Model.TotalCOD, out cod))
                                                        {
                                                            info += " (Tiền COD: " + cod.ToString("N0") + ")";
                                                        }
                                                        else if(code == "PHU" && decimal.TryParse(Model.TotalPHU, out phu))
                                                        {
                                                            info += " (Tiền PHU: " + phu.ToString("N0") + ")";
                                                        }
                                                        extraServiceText.Add(info);
                                                    }
                                                    if(extraServiceText.Count > 0)
                                                    {
                                                        <text>, @string.Join(", ", extraServiceText)</text>
                                                    }
                                                }
                                            }
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Người gửi -->
                <div class="col-md-6 col-12">
                    <div class="shipping-card ems-person-card-sender ems-collapsible">
                        <div class="card-body">
                            <h6 class="ems-person-head">
                                <span class="ems-person-avatar"><i class="fa-solid fa-arrow-up-from-bracket"></i></span>
                                Người gửi
                            </h6>
                            <div class="ems-person-field">
                                <div class="ems-person-field-main">
                                    <i class="fa-solid fa-user"></i>
                                    <div>
                                        <label>Họ tên</label>
                                        <span class="ems-copy-field" data-copy-label="Người gửi">@Html.DisplayFor(m => m.Sender.FullName)</span>
                                    </div>
                                </div>
