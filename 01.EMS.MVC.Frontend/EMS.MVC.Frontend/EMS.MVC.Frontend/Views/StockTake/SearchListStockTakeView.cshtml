@model List<EMS.MVC.Frontend.Models.SearchListStockTakeViewModel>

<table id="ListDataTableSearch" class="table table-responsive-md" style="width: 100%;">
    <thead>
        <tr>
            <th class="">STT</th>
            <th class="">Mã phiếu <br /> kiểm kho</th>
            <th class="">Kho hàng</th>
            <th class="">Số lượng</th>
            <th class="">Số lượng <br /> chênh lệch</th>
            <th class="">Giá trị <br /> chênh lệch</th>
            <th class="">Trạng thái </th>
            <th class="">Người <br /> kiểm kho </th>
            <th class="">Người <br /> xác nhận</th>
            <th class="text-center" style="max-width: 110px;"> Thao tác </th>
        </tr>
    </thead>
    <tbody>
        @{
            var stt = 1;
            foreach (var item in Model)
            {
                <tr>
                    <td class="text-center">@(stt++)</td>
                    <td><a href="@Url.Action("DetailStockTakeView","StockTake", new { SearchKey = EMS.Library.Security.EncodeBase64(item.StockTakeID.ToString()) })">@item.StockTakeCode</a></td>
                    <td>@item.WareHouseName</td>
                    <td>
                        <span>SL sản phẩm: @item.TotalProduct.ToString("N0")</span>
                        <br />
                        <span>SL tồn kho: @item.TotalInventory.ToString("N0")</span>
                        <br />
                        <span>SL thực tế: @item.TotalActual.ToString("N0")</span>
                    </td>
                    <td>@item.TotalDifferent.ToString("N0")</td>
                    <td>@item.TotalMoneyDifferent.ToString("N0")</td>
                    <td>@item.Status.Name</td>
                    <td class="">
                        @{
                            <span style="line-height: 1.4rem;">@item.CreatedName</span>
                            <br />
                            <span style="line-height: 1.4rem;">@item.CreatedDate</span>
                        }
                    </td>
                    <td class="">
                        @{
                            <span style="line-height: 1.4rem;">@item.UpdatedName</span>
                            <br />
                            <span style="line-height: 1.4rem;">@item.UpdatedDate</span>
                        }
                    </td>
                    <td class="text-center">
                        @if (item.Status.Code == "N" || item.Status.Code == "D")
                        {
                            <button class="btn" type="button" id="btnStockTakeDropDown" data-bs-toggle="dropdown" data-boundary="viewport" aria-haspopup="true" aria-expanded="false">
                                <span>Chọn</span>
                                <i class="icon-arrow-b"></i>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end border py-0" aria-labelledby="btnStockTakeDropDown">
                                <div class="py-2">
                                    <a class="dropdown-item" title="Sửa phiếu" onclick="window.location.href = '@Url.Action("EditStockTakeView", "StockTake", new { SearchKey = EMS.Library.Security.EncodeBase64(item.StockTakeID.ToString()) })'">
                                        <i class="fas fa-edit me-1"></i>Sửa phiếu
                                    </a>

                                    @if (item.Status.Code == "N")
                                    {
                                        <a class="dropdown-item" title="Xác nhận" onclick="window.location.href = '@Url.Action("DetailStockTakeView","StockTake", new { SearchKey = EMS.Library.Security.EncodeBase64(item.StockTakeID.ToString()) })'">
                                            <i class="fa fa-check me-1"></i>Xác nhận
                                        </a>
                                    }

                                    <a class="dropdown-item" title="Xoá" onclick="btnRemove(@item.StockTakeID)">
                                        <i class="fa fa-trash me-1"></i>Xoá
                                    </a>
                                </div>
                            </div>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<script>
    $(document).ready(function () {
        MyCreateDataTable("ListDataTableSearch");
    });

    function btnAccept(ID) {
        window.location.href = '@Url.Action("DetailStockTakeView", "StockTake")?ID=' + ID;
    }

    function btnRemove(ID) {
        swal({
            title: 'Thông báo',
            text: "Bạn chắc chắn muốn xoá phiếu kiểm kê?",
            buttons: {
                confirm: {
                    text: "CÓ",
                    value: true,
                    visible: true,
                    className: "btn btn-primary",
                    closeModal: true
                },
                cancel: {
                    text: "KHÔNG",
                    value: false,
                    visible: true,
                    className: "btn btn-danger",
                    closeModal: true,
                }
            },
        }).then((value) => {
            if (value) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("JRemoveStockTake", "StockTake")',
                    data: {
                        ID: ID
                    },
                    dataType: 'json',
                    success: function (res) {
                        if (res.Code == "00") {
                            swal({
                                title: "Thông báo",
                                text: res.Message,
                                html: true,
                                button: false,
                                timer: 1500
                            }).then(function () {
                                window.location.href = "@Url.Action("StockTakeView", "StockTake")";
                            });
                        } else {
                            swal({
                                title: "Thông báo",
                                text: res.Message,
                                button: {
                                    text: "ĐÓNG"
                                }
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        var err = eval("(" + xhr.responseText + ")");
                        swal({
                            title: 'Lỗi',
                            text: err.Message,
                            button: {
                                text: "ĐÓNG",
                                value: true,
                                visible: true,
                                className: "btn btn-primary"
                            }
                        });
                        return;
                    }
                });
            }
        });
    }
</script>
