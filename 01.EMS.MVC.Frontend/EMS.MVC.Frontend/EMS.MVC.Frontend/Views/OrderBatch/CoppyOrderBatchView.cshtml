        //    //var content = "";
        //    //content += "<div class='row'>";
        //    //content += "<div class='col-xl-3 col-lg-3 col-md-3'><img src='/Assets/images/default/avatar.jpg' class='img-fluid' /></div>";
        //    //content += "<div class='col-xl-9 col-lg-9 col-md-9'>";
        //    //content += "<div class='row'>";
        //    //content += "<div class='col-xl-12 col-lg-12 col-md-12'>" + data.text + "</div>";
