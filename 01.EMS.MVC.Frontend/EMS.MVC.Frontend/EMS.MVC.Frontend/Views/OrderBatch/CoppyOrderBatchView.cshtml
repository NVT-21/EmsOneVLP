        function FillTotalMoney(EventChange) {
            var isProduct = false;
            var isTotalCOD = false;
            var TotalAmount = 0;
            var TotalOrderValue = 0;
            $('.row-item').each(function () {
                var NumberOfDetail = $(this).closest('tr').find('.NumberOfDetail').html().trim();
                var NumberOfProduct = $(".row-item-product-" + NumberOfDetail).length;
                var OrderValue = NumberReplace($("#OrderValue_" + NumberOfDetail).val());
                if (NumberOfProduct > 0) {
                    TotalAmount += OrderValue;
                    isProduct = true;
                }
                TotalOrderValue += OrderValue;
            });

            if ($("#ExtraTransportServiceID").val().toString().includes("108") == true) {
                isTotalCOD = true;
            }

            var TotalMoney = 0;
            if (isProduct == true) {
                switch (EventChange) {
                    case "TotalCOD":
                        TotalMoney = TotalAmount;
                        break;
                    case "OrderValue":
                        TotalMoney = TotalOrderValue;
                        break;
                    case "Product":
                        TotalMoney = TotalAmount;
                        $("#TotalCOD").val(TotalMoney);
                        break;
                };
            } else {
                switch (EventChange) {
                    case "TotalCOD":
                        TotalMoney = NumberReplace($("#TotalCOD").val());
                        break;
                    case "OrderValue":
                        TotalMoney = isTotalCOD == true ? NumberReplace($("#TotalCOD").val()) : TotalOrderValue;
                        break;
                };
            }

            $("#TotalMoney").text(NumberFormat(TotalMoney));
        }

        function HandleDataCharged() {
            var isError = false, isMessage = "";
            var data = {
                MainServiceID: $("#MainTransportServiceID").val(),
                ExtraServiceIDs: $("#ExtraTransportServiceID").val().toString(),
                FromProvinceID: $("#Sender_Province_ID").val() === undefined ? 0 : $("#Sender_Province_ID").val(),
                FromDistrictID: $("#Sender_District_ID").val() === undefined ? 0 : $("#Sender_District_ID").val(),
                FromWardID: $("#Sender_Ward_ID").val() === undefined ? 0 : $("#Sender_Ward_ID").val(),
                ToProvinceID: $("#Receiver_Province_ID").val() === undefined ? 0 : $("#Receiver_Province_ID").val(),
                ToDistrictID: $("#Receiver_District_ID").val() === undefined ? 0 : $("#Receiver_District_ID").val(),
                ToWardID: $("#Receiver_Ward_ID").val() === undefined ? 0 : $("#Receiver_Ward_ID").val(),
                Weight: 0,
                TransportSizeLength: 0,
                TransportSizeWidth: 0,
                TransportSizeHeight: 0,
                Quantity: 0,
                Amount: 0,
                COD: 0,
            };

            if (data.ExtraServiceIDs.includes("108") == true) {
                data.COD = NumberReplace($("#TotalCOD").val());
            }

            if (!data.MainServiceID || !data.FromProvinceID || !data.ToProvinceID) {
                $("#errTemporaryTransportServiceFee").text("Chưa đủ thông tin để tính cước");
                return;
            }

            var TotalFee = 0;
            var MainFee = 0;
            var ExtraFee = 0;
            $('.row-item').each(function () {
                var NumberOfDetail = $(this).closest('tr').find('.NumberOfDetail').html().trim();
                data.Quantity = NumberReplace($("#OrderQuantity_" + NumberOfDetail).val());
                //data.TransportSizeLength = NumberReplace($("#Length_" + NumberOfDetail).val());
                //data.TransportSizeWidth = NumberReplace($("#Width_" + NumberOfDetail).val());
                //data.TransportSizeHeight = NumberReplace($("#Height_" + NumberOfDetail).val());
                data.TransportSizeLength = $("#Length_" + NumberOfDetail).val();
                data.TransportSizeWidth = $("#Width_" + NumberOfDetail).val();
                data.TransportSizeHeight = $("#Height_" + NumberOfDetail).val();
                data.Weight = NumberReplace($("#Weight_" + NumberOfDetail).val());
                data.Amount = NumberReplace($("#OrderValue_" + NumberOfDetail).val());

                if (data.Weight > 0) {
                    $("#errWeight_" + NumberOfDetail).text("");
                } else {
                    $("#errWeight_" + NumberOfDetail).text("Vui lòng nhập khối lượng.");
                    isError = true;
                }

                if (isError == true) {
                    isMessage = "Chưa đủ thông tin để tính cước";
                } else {
                    var res = TransportPostageCharged(data).responseJSON;
                    if (res.Code == "00") {
                        var responseData = JSON.parse(res.Data);
                        TotalFee += responseData.TotalAmount;
                        MainFee += responseData.MainFee + responseData.Surcharge;
                        ExtraFee += responseData.ExtraFee;
                        DisplayMoneyFee(NumberOfDetail, responseData.TotalAmount, responseData.MainFee + responseData.Surcharge, responseData.ExtraFee, "");
                    } else {
                        isMessage = res.Message;
                        isError = true;
                        return false;
                    }
                }
            });

            if (isError == true) {
                DisplayMoneyFee(0, 0, 0, 0, isMessage);
                return;
            }

            DisplayMoneyFee(0, TotalFee, MainFee, ExtraFee, "");
        }

        function DisplayMoneyFee(NumberOfDetail, TotalFee, MainFee, ExtraFee, Message) {
            if (NumberOfDetail > 0) {
                $("#TotalFee_" + NumberOfDetail).text(TotalFee);
                $("#MainFee_" + NumberOfDetail).text(MainFee);
                $("#ExtraFee_" + NumberOfDetail).text(ExtraFee);
            } else {
                $("#TotalFee").text(NumberFormat(TotalFee));
                $("#MainFee").text(NumberFormat(MainFee));
                $("#ExtraFee").text(NumberFormat(ExtraFee));
            }
            $("#errTemporaryTransportServiceFee").text(Message);
        }

