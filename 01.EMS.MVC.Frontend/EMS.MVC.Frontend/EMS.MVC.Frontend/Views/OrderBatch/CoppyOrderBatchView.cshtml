        //function formatRepoSelected(data) {
        //    var Title = "";
        //    if (data.id) {
        //        Title = data.text + " - " + data.id;
        //    } else {
        //        Title = data.text;
        //    }
        //    return Title;
        //}

        ScrollX(".MouseScrollX");

        //OnlyNumber("#SearchCustomer");

        var TotalRow = @Model.NumberOfDetail;

        $("#btnAddRow").on("click", function () {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("AddOrderBatchOrderInfoView", "OrderBatch")',
                dataType: 'html',
                loading: true,
                data: {
                    NumberOfDetail: TotalRow,
                },
                beforeSend: function () {
                    $("#btnAddRow").attr("disabled", true).append("<i class= 'fa fa-spinner fa-spin ms-1' id='iLoading'></i>");
                },
                success: function (data) {
                    TotalRow = TotalRow + 1;
                    $('#tBody').append(data);

                    var ExtraTransportServiceID = $("#ExtraTransportServiceID").val();

                    var isServicePHU = ExtraTransportServiceID.includes("421");
                    if (isServicePHU == true) {
                        $('.row-item').each(function () {
                            var NumberOfDetail = $(this).closest('tr').find('.NumberOfDetail').html().trim();
                            $("#ShowTotalPHU_" + NumberOfDetail).removeClass("d-none");
                        });
                    }

                    $("#errListOrderInfo").text("");

                    HandleDataCharged();
                },
                complete: function () {
                    $("#btnAddRow").attr("disabled", false).find("i#iLoading").remove();
                }
            })
        });

        $("input[name='TransportPayer']").on("change", function () {
            var value = $(this).val();
            if (value == 2) {
                $("#MainTransportServiceID").change();
            }
        });

        //$('#SearchCustomer').keypress(function (event) {
        //    if (event.keyCode == 13) {
        //        SearchCustomer($(this).val().trim());
        //    }
        //});

        $('#SearchCustomer').on("change", function () {
            SearchCustomer($(this).val().trim());
        });

        $("input").on("focus", function () {
            $("#btnAddOrderType1, #btnAddOrderType2").attr("disabled", true);
        });

        $("input").on("focusout", function () {
            $("#btnAddOrderType1, #btnAddOrderType2").attr("disabled", false);
        });

        $('#MainTransportServiceID, #ExtraTransportServiceID, #TotalCOD').on('change', function () {
            var DivID = this.id;
            var isError = false;
            var data = {
                MainTransportServiceID: $('#MainTransportServiceID').val(),
                ExtraTransportServiceID: $('#ExtraTransportServiceID').val().toString(),
                TotalCOD: NumberReplace($('#TotalCOD').val()),
                TransportPayer: $("input[name='TransportPayer']:checked").val()
            };

            if (DivID == "MainTransportServiceID") {
                if (data.MainTransportServiceID) {
                    if (data.TransportPayer == 2) {
                        switch (data.MainTransportServiceID) {
                            //case "141":
                            //case "360":
                            case "481":
                                if (data.ExtraTransportServiceID.includes("108") == false) {
                                    if (data.ExtraTransportServiceID) {
                                        data.ExtraTransportServiceID += ",108";
                                    } else {
                                        data.ExtraTransportServiceID = "108";
                                    }

                                    $("#ExtraTransportServiceID").selectpicker("val", data.ExtraTransportServiceID.split(","));
                                    $("#ExtraTransportServiceID").change();
                                }
                                break;
                            default:
                                if (data.ExtraTransportServiceID.includes("300") == false && data.ExtraTransportServiceID.includes("221") == false) {
                                    CreateCustomSwal("error", "Vui lòng sử dụng dịch vụ Thu phí ship hàng (PSH) để thu cước người nhận");
                                    $("#TransportPayer1").click();
                                }
                                break;
                        }
                    }
                    $('#errMainTransportServiceID').text("");
                } else {
                    $('#errMainTransportServiceID').text("Vui lòng chọn dịch vụ vận chuyển chính");
                    isError = true;
                }
            } else if (DivID == "ExtraTransportServiceID") {
                if (data.TransportPayer == 2) {
                    switch (data.MainTransportServiceID) {
                        case "141":
                        case "360":
                        case "481":
                            if (data.ExtraTransportServiceID.includes("108") == false) {
                                if (data.ExtraTransportServiceID) {
                                    data.ExtraTransportServiceID += ",108";
                                } else {
                                    data.ExtraTransportServiceID = "108";
                                }

                                $("#ExtraTransportServiceID").selectpicker("val", data.ExtraTransportServiceID.split(","));
                                $("#ExtraTransportServiceID").change();
                            }
                            break;
                        default:
                            $("#TransportPayer1").click();
                            break;
                    }
                }

                var isServiceCOD = data.ExtraTransportServiceID.includes("108");
                if (isServiceCOD == true) {
                    $("#ShowTotalCOD").removeClass("d-none");

                    var TotalMoney = 0;
                    $('.row-item').each(function () {
                        var NumberOfDetail = $(this).closest('tr').find('.NumberOfDetail').html().trim();
                        var OrderValue = NumberReplace($("#OrderValue_" + NumberOfDetail).val());
                        TotalMoney += OrderValue;
                    });

                    $("#TotalMoney").text(NumberFormat(TotalMoney));
                } else {
                    $("#ShowTotalCOD").addClass("d-none");

                    var TotalMoney = 0;
                    $('.row-item').each(function () {
                        var NumberOfDetail = $(this).closest('tr').find('.NumberOfDetail').html().trim();
                        var OrderValue = NumberReplace($("#OrderValue_" + NumberOfDetail).val());
                        TotalMoney += OrderValue;
                    });

                    $("#TotalMoney").text(NumberFormat(TotalMoney));
                }

                var isServicePHU = data.ExtraTransportServiceID.includes("421");
                if (isServicePHU == true) {
                    $('.row-item').each(function () {
                        var NumberOfDetail = $(this).closest('tr').find('.NumberOfDetail').html().trim();
                        $("#ShowTotalPHU_" + NumberOfDetail).removeClass("d-none");
                    });
                } else {
                    $('.row-item').each(function () {
                        var NumberOfDetail = $(this).closest('tr').find('.NumberOfDetail').html().trim();
                        $("#ShowTotalPHU_" + NumberOfDetail).addClass("d-none");
                    });
                }

                var isServiceKG = data.ExtraTransportServiceID.includes("103");
                if (isServiceKG == true) {
                    $('.row-item').each(function () {
                        var NumberOfDetail = $(this).closest('tr').find('.NumberOfDetail').html().trim();
                        var OrderValue = NumberReplace($("#OrderValue_" + NumberOfDetail).val());
                        if (OrderValue == 0) {
                            isError = true;
                            $("#errOrderValue_" + NumberOfDetail).text("Vui lòng nhập giá trị đơn hàng");
                        } else if (OrderValue > 100000000) {
                            isError = true;
                            $("#errOrderValue_" + NumberOfDetail).text("Giá trị đơn hàng không vượt quá 100 triệu đồng.");
                        } else {
                            $("#errOrderValue_" + NumberOfDetail).text("");
                        }
                    });
                } else {
                    $('.row-item').each(function () {
                        var NumberOfDetail = $(this).closest('tr').find('.NumberOfDetail').html().trim();
                        $("#errOrderValue_" + NumberOfDetail).text("");
                    });
                }

            } else if (DivID == "TotalCOD") {
                if (data.TotalCOD > 50000000) {
                    isError = true;
                    $('#errTotalCOD').text('Số tiền COD tối đa 50 triệu đồng/BG.');
                } else {
                    $('#errTotalCOD').text('');
                }

                FillTotalMoney("TotalCOD");
            }

            if (isError == true) {
                return;
            } else {
                HandleDataCharged();
            }
        });

        function btnRemoveRow(this1) {
            var NumberOfRow = $(".row-item").length;
            if (NumberOfRow > 2) {
                $(this1).parents("tr").remove();
                HandleDataCharged();
            } else {
                CreateCustomSwal("error", "Đơn hàng tối thiếu 2 bưu gửi");
            }
        }

        function btnPlus(VariantID, Type) {
            var value = $("#NumberOfProduct_" + VariantID).val();
            $("#NumberOfProduct_" + VariantID).val(parseInt(value) + 1);
            $("#NumberOfProduct_" + VariantID).change();
        }

