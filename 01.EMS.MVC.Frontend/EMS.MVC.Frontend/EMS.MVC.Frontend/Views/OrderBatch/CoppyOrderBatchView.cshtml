                }

                if (objOrderInfo.Length > 0 && objOrderInfo.Width > 0 && objOrderInfo.Height > 0) {
                    var convertWeight = 0;
                    if (data.MainTransportServiceID == 581 || data.MainTransportServiceID == 601) {
                        convertWeight = Math.round((objOrderInfo.Length * objOrderInfo.Width * objOrderInfo.Height) / 5);
                    } else {
                        convertWeight = Math.round((objOrderInfo.Length * objOrderInfo.Width * objOrderInfo.Height) / 6);
                    }
                    if (data.MainTransportServiceID == 141 || data.MainTransportServiceID == 360) {
                        var getMax = Math.max(objOrderInfo.Length, objOrderInfo.Width, objOrderInfo.Height);
                        if (getMax > 50) {
                            objOrderInfo.ExchangeWeight = convertWeight;
                        }
                    } else {
                        if (convertWeight > objOrderInfo.Weight) {
                            objOrderInfo.ExchangeWeight = convertWeight;
                        }
                    }
