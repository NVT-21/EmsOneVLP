                if ((data.MainTransportServiceID == 102 || data.MainTransportServiceID == 141 || data.MainTransportServiceID == 502 || data.MainTransportServiceID == 541 || data.MainTransportServiceID == 542 || data.MainTransportServiceID == 543)
                    && (data.ExtraTransportServiceID.includes("104") == true || data.ExtraTransportServiceID.includes("105") == true || data.ExtraTransportServiceID.includes("106") == true)) {
                    //Nếu DV chính là Phát hỏa tốc, CPN TMĐT đồng giá TMĐ, CPN Tài liệu, EMS TCNH Bạc, EMS TCNH Vàng, EMS TCNH Tiêu chuẩn
                    //Thì không được chọn các DV cộng thêm là Hàng nhạy cảm EMS - VUN, Dịch vụ EMS cây cảnh, Dịch vụ EMS thực phẩm
                    isError = true;
                    $("#errMainTransportServiceID").text("Dịch vụ chính và Dịch vụ cộng thêm không phù hợp. Vui lòng điều chỉnh");
                } else if ((data.MainTransportServiceID == 502 || data.MainTransportServiceID == 541 || data.MainTransportServiceID == 542 || data.MainTransportServiceID == 543)
                    && (data.ExtraTransportServiceID.includes("108") == true || data.ExtraTransportServiceID.includes("341") == true || data.ExtraTransportServiceID.includes("342") == true || data.ExtraTransportServiceID.includes("420") == true)) {
                    //Nếu DV chính là CPN Tài liệu, EMS TCNH Bạc, EMS TCNH Vàng, EMS TCNH Tiêu chuẩn
                    //Thì không được chọn các DV cộng thêm là Thu hộ - chi hộ, Bốc xếp khâu chấp nhận, Bốc xếp khâu phát hàng, Phát hàng siêu thị
                    isError = true;
                    $("#errMainTransportServiceID").text("Dịch vụ chính và Dịch vụ cộng thêm không phù hợp. Vui lòng điều chỉnh");
                } else if ((data.MainTransportServiceID == 541 || data.MainTransportServiceID == 542 || data.MainTransportServiceID == 543) && (data.ExtraTransportServiceID.includes("462") == true)) {
                    //Nếu DV chính là EMS TCNH Bạc, EMS TCNH Vàng, EMS TCNH Tiêu chuẩn
                    //Thì không được chọn các DV cộng thêm là Phát hàng một phần chiều đến
                    isError = true;
                    $("#errMainTransportServiceID").text("Dịch vụ chính và Dịch vụ cộng thêm không phù hợp. Vui lòng điều chỉnh");
                }
            }

            switch (ActionType) {
                case 1:
                    data.ActionType = "N";
                    MessageNotify = "Bạn chắc chắn muốn tạo đơn hàng?";
                    MessageSuccess = "Tạo đơn hàng thành công";
                    break;
                case 2:
                    data.ActionType = "W";
                    MessageNotify = "Bạn chắc chắn muốn tạo đơn hàng và gửi vận chuyển?";
                    MessageSuccess = "Tạo đơn hàng và gửi vận chuyển thành công";
                    break;
                case 3:
                    isError = false;
                    data.ActionType = "D";
                    MessageNotify = "Bạn chắc chắn muốn lưu nháp đơn hàng?";
                    MessageSuccess = "Lưu nháp thành công";
                    break;
            };

            if (isError == true) {
                return;
            }

            swal({
                title: 'Thông báo',
                text: MessageNotify,
                buttons: {
                    confirm: {
                        text: "Xác nhận",
                        value: true,
                        visible: true,
                        className: "btn btn-primary",
                        closeModal: true
                    },
                    cancel: {
                        text: "Đóng",
                        value: false,
                        visible: true,
                        className: "btn btn-danger",
                        closeModal: true,
                    }
                },
            }).then((value) => {
                if (value) {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("JCoppyOrderBatch", "OrderBatch")',
                        dataType: 'json',
                        loading: true,
                        data: data,
                        success: function (res) {
                            if (res.Code == "00") {
                                CreateCustomSwal("success", MessageSuccess, '@Url.Action("OrderView", "Order")');
                            } else {
                                CreateCustomSwal("error", res.Message);
                            }
                        },
                        error: function (xhr, status, error) {
                            var err = eval("(" + xhr.responseText + ")");
                            swal({
                                title: 'Lỗi',
                                text: err.Message,
                                button: {
                                    text: "ĐÓNG",
                                    value: true,
                                    visible: true,
                                    className: "btn btn-primary"
                                }
                            });
                            return;
                        }
                    });
                }
            });
        }
    </script>
}

