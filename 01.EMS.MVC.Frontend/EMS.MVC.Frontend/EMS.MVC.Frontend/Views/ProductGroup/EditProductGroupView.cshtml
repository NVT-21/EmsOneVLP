@model EMS.MVC.Frontend.Models.EditProductGroupViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="pb-100">
    <div class="container-medium">
        <div class="card">
            <div class="card-body">
                @Html.HiddenFor(m => m.ProductGroupID)
                <div class="mb-3">
                    <label class="mb-1">Mã nhóm sản phẩm <span class="text-danger">(*)</span></label>
                    @Html.EditorFor(model => model.ProductGroupCode, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Mã nhóm sản phẩm", @maxlength = "20", @disabled="disabled" } })
                    <span class="text-danger" id="errProductGroupCode"></span>
                </div>
                <div class="mb-3">
                    <label class="mb-1">Tên nhóm sản phẩm <span class="text-danger">(*)</span></label>
                    @Html.EditorFor(model => model.ProductGroupName, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Tên nhóm sản phẩm", @maxlength = "250" } })
                    <span class="text-danger" id="errProductGroupName"></span>
                </div>
                <div class="mb-3">
                    <label class="mb-1">Mô tả</label>
                    @Html.TextAreaFor(model => model.Description, new { @class = "form-control", @rows = "4", @placeholder = "Mô tả", @maxlength = "250" })
                    <div class="text-end">
                        <span class="fs-12 font-w300 text-3"><span id="ShowLengthDescription">@Model.Description.Length</span>/250</span>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="float-end">
                    <button type="button" class="btn btn-outline-dark" onclick="window.location.href = '@Url.Action("ProductGroupView", "ProductGroup")'">Hủy bỏ</button>
                    <button type="button" class="btn btn-primary" id="btnSubmit">Cập nhật</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts{
    <script type="text/javascript">
        ShowInputLength("Description", "ShowLengthDescription", 250);
        CheckChangeValue("Description", "", "Note", "N");
        CheckChangeValue("ProductGroupName", "Vui lòng nhập tên nhóm sản phẩm", "Vietnamese", "Y");

        $("#btnSubmit").on("click", function () {
            var isError = false;
            var isMessage = "Giá trị hợp lệ không bao gồm ký tự đặc biệt.";
            var data = {
                ProductGroupID: $('#ProductGroupID').val(),
                ProductGroupName: $('#ProductGroupName').val().trim(),
                Description: $('#Description').val().trim()
            };

            isError = CheckNullAndRegexValue(data.ProductGroupName, 'Vietnamese', 'ProductGroupName', 'Vui lòng nhập tên nhóm sản phẩm.', isMessage, isError);

            if (isError == true) {
                return;
            };

            swal({
                title: 'Thông báo',
                text: "Bạn có muốn sửa nhóm sản phẩm?",
                buttons: {
                    confirm: {
                        text: "Xác nhận",
                        value: true,
                        visible: true,
                        className: "btn btn-primary",
                        closeModal: true
                    },
                    cancel: {
                        text: "Đóng",
                        value: false,
                        visible: true,
                        className: "btn btn-danger",
                        closeModal: true,
                    }
                },
            }).then((value) => {
                if (value) {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("JEditProductGroup", "ProductGroup")',
                        data: data,
                        dataType: 'json',
                        success: function (res) {
                            if (res.Code == "00") {
                                CreateCustomSwal("success", res.Message, '@Url.Action("ProductGroupView", "ProductGroup")');
                            } else {
                                CreateCustomSwal("error", res.Message);
                            }
                        },
                        error: function (xhr, status, error) {
                            var err = eval("(" + xhr.responseText + ")");
                            swal({
                                icon: 'error',
                                title: 'Lỗi',
                                text: err.Message,
                                button: {
                                    text: "ĐÓNG",
                                    value: true,
                                    visible: true,
                                    className: "btn btn-primary"
                                }
                            });
                            return;
                        }
                    });
                }
            });
        });
    </script>
}
