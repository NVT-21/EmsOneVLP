@{
    Layout = null;
}


<div class="modal-dialog modal-search modal-dialog-centered" role="document">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Tìm kiếm sản phẩm</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal">
            </button>
        </div>
        <div class="modal-body">
            <div class="  mb-4">
                <form data-bs-target="#search" data-bs-toggle="modal">
                    <div class="form-search">
                        <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M18.9842 17.6825L15.8675 14.575C16.8731 13.2939 17.4187 11.7119 17.4167 10.0833C17.4167 8.63294 16.9866 7.21512 16.1808 6.00916C15.375 4.80319 14.2297 3.86326 12.8897 3.30822C11.5497 2.75318 10.0752 2.60795 8.65268 2.89091C7.23015 3.17387 5.92347 3.8723 4.89789 4.89789C3.8723 5.92347 3.17387 7.23015 2.89091 8.65268C2.60795 10.0752 2.75318 11.5497 3.30822 12.8897C3.86326 14.2297 4.80319 15.375 6.00916 16.1808C7.21512 16.9866 8.63294 17.4167 10.0833 17.4167C11.7119 17.4187 13.2939 16.8731 14.575 15.8675L17.6825 18.9842C17.7677 19.0701 17.8691 19.1383 17.9808 19.1848C18.0925 19.2314 18.2123 19.2553 18.3333 19.2553C18.4543 19.2553 18.5742 19.2314 18.6859 19.1848C18.7976 19.1383 18.899 19.0701 18.9842 18.9842C19.0701 18.899 19.1383 18.7976 19.1848 18.6859C19.2314 18.5742 19.2553 18.4543 19.2553 18.3333C19.2553 18.2123 19.2314 18.0925 19.1848 17.9808C19.1383 17.8691 19.0701 17.7677 18.9842 17.6825V17.6825ZM4.58334 10.0833C4.58334 8.99554 4.90591 7.93217 5.51025 7.0277C6.1146 6.12323 6.97358 5.41828 7.97858 5.002C8.98357 4.58572 10.0894 4.4768 11.1563 4.68902C12.2232 4.90124 13.2032 5.42506 13.9724 6.19425C14.7416 6.96344 15.2654 7.94345 15.4777 9.01034C15.6899 10.0772 15.581 11.1831 15.1647 12.1881C14.7484 13.1931 14.0434 14.0521 13.139 14.6564C12.2345 15.2608 11.1711 15.5833 10.0833 15.5833C8.62465 15.5833 7.2257 15.0039 6.19425 13.9724C5.1628 12.941 4.58334 11.542 4.58334 10.0833Z"
                                    fill="#86909C" />
                        </svg>
                        <input type="text" class="form-control" onkeyup="FuncSearchProduct()" id="textSearchProduct" placeholder="Tìm theo tên sản phẩm" value="@ViewBag.textSearch">
                        <span class="text-danger" id="errtextSearchProduct"></span>
                    </div>
                </form>
            </div>
            <div class="table-responsive table-search">

                <div class="thead">
                    <div style="width:50px;" class="th">
                        <div class="form-check custom-checkbox  check-lg me-3">
                            <input type="checkbox" class="form-check-input" id="checkAll" required="">
                            <label class="form-check-label" for="checkAll"></label>
                        </div>
                    </div>
                    <div class="th">Tên sản phẩm</div>
                    <div class="th">Tồn kho</div>
                    <div class="th">Đơn giá</div>
                    <div class="th">Số lượng</div>
                </div>
                @{ Html.RenderAction("SearchProductDataView", "RequestOrder", new { textSearch = "" });}
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline-dark light" data-bs-dismiss="modal">Hủy bỏ</button>
            <button type="button" class="btn btn-primary" id="btnCompleteSelection">Chọn</button>
        </div>
    </div>
</div>

<script type="text/javascript">
    var arrCheckedList = [];
    FuncSearchProduct();

    function FuncSearchProduct() {
        var textSearch = $("#textSearchProduct").val().trim();
        var input, filter, div, li, spanVariant, i;
        input = document.getElementById("textSearchProduct");
        filter = input.value.toUpperCase().trim();
        div = document.getElementById("ListProduct");
        li = $(div).find('li[name="Product"]');
        // Loop through all list items, and hide those who don't match the search query
        for (i = 0; i < li.length; i++) {
            //spanVariant = $(li[i]).find('span[name="VariantName"]');
            spanVariant = $(li[i]).find('span[name="ProductName"]');
            if (spanVariant.html().toUpperCase().indexOf(filter) > -1) {
                li[i].style.display = "block";
                $(li[i]).attr('data-d', 'block');
                $(li[i]).parents("ul").css("borderTop", "1px solid #d9d9d9");
                //$(li[i]).parents("ul").css("display", "block");
                $(li[i]).parents("ul").addClass("d-block");
                $(li[i]).parents("ul").removeClass("d-none");
            } else {
                li[i].style.display = "none";
                $(li[i]).attr('data-d', 'none');
                $(li[i]).parents("ul").css("borderTop", "none");
                //$(li[i]).parents("ul").css("display", "none");
                $(li[i]).parents("ul").addClass("d-none");
                $(li[i]).parents("ul").removeClass("d-block");
            }
        }
        if (textSearch != "") {
            var li_parent_block = $(div).find('ul[class="d-block"]');
            if (li_parent_block.length > 0) {
                $('#NoData').css("display", "none");
                $('#NoData').text("");
            } else {
                $('#NoData').css("display", "block");
                $('#NoData').text("Không tìm thấy dữ liệu");
            }
        } else {
            $('#NoData').css("display", "none");
        }
    }

    function FuncCheck(ctl) {
        var ProductID = $(ctl).attr("data-ProductID");
        var VariantID = $(ctl).attr("data-VariantID");
        if ($(ctl).is(':checked')) {
            var obj = {};
            obj.ProductID = ProductID;
            obj.VariantID = VariantID;
            arrCheckedList.push(obj);
        }
        else {
            var i = arrCheckedList.length;
            while (i--) {
                if (arrCheckedList[i]
                    //&& arrCheckedList[i].hasOwnProperty('ProductID')
                    && (/*arguments.length > 2 && */arrCheckedList[i]['ProductID'] === ProductID && arrCheckedList[i]['VariantID'] === VariantID)) {
                    arrCheckedList.splice(i, 1);
                    break;
                }
            }
        }
    }
    function FuncCheckParent(ctl) {
        var list = $(ctl).parent().parent().find('input[name="itemProduct"]');
        for (var i = 0; i < list.length; i++) {
            var ProductID = list[i].getAttribute("data-ProductID");
            var VariantID = list[i].getAttribute("data-VariantID");
            if (list[i].checked == false && list[i].disabled == false) {
                var check = 0;
                for (var j = 0; j < arrCheckedList.length; j++) {
                    if (arrCheckedList[j].ProductID == ProductID && arrCheckedList[j].VariantID == VariantID) {
                        check = 1;
                        break;
                    }
                }
                if (check == 0) {
                    var obj = {};
                    obj.ProductID = ProductID;
                    obj.VariantID = VariantID;
                    arrCheckedList.push(obj);
                }
            }
            else {
                var k = arrCheckedList.length;
                while (k--) {
                    if (arrCheckedList[k]
                        && (arrCheckedList[k]['ProductID'] === ProductID && arrCheckedList[k]['VariantID'] === VariantID)) {
                        arrCheckedList.splice(k, 1);
                        break;
                    }
                }
            }
        }
    }

    $("#btnCompleteSelection").on('click', function () {
        debugger
        var url = "";
        var isRequestOrder = '@ViewBag.IsRequestOrder';
        var textSearch = $('#textSearchProduct').val().trim();
        var array = new Array();
        var checkboxes = document.getElementsByName("itemProduct");
        var isError = false;
        for (var i = 0; i < checkboxes.length; i++) {
            if (checkboxes[i].checked == true || checkboxes[i].disabled == true) {
                var obj = {};
                obj.ProductID = checkboxes[i].getAttribute('data-ProductID');
                obj.VariantID = checkboxes[i].getAttribute('data-VariantID');
                var Key = obj.ProductID + "-" + obj.VariantID;
                if ($("#OrderQuantity_" + Key).val() == "" || parseInt($("#OrderQuantity_" + Key).val()) == 0) {
                    $("#errMessage_" + Key).text("Vui lòng nhập số lượng sản phẩm.");
                    isError = true;
                    break;
                }
                obj.WareHouseQuantity = parseInt($("#Quantity_" + Key).data("value"));
                obj.NumberOfProduct = parseInt($("#OrderQuantity_" + Key).val());
                if (obj.NumberOfProduct > obj.WareHouseQuantity) {
                    $("#errMessage_" + Key).text("Số lượng mua vượt quá số lượng trong kho");
                    isError = true;
                    break;
                }
                array.push(obj);
            }
        }
        if (isError == true) {
            return;
        }

        if (array.length == 0) {
            $("#errtextSearchProduct").text("Vui lòng chọn sản phẩm");
            return;
        } else {
            $("#errtextSearchProduct").text("");
        }

        /*$("#btn-close").click();*/
        var strCheckedList = JSON.stringify(array);
        if (isRequestOrder == "Y") {
            url = '@Url.Action("OrderedProduct_V2", "RequestOrder")';
        } else {
            url = '@Url.Action("OrderedProduct", "RequestOrder")';
        }

        //$.get(url, {
        //    textSearch: textSearch,
        //    strCheckedList: strCheckedList
        //}, function (data) {
        //    if ($("#HideOutOfStock").val() != undefined) {
        //        $('#OrderedProducts').empty();
        //    }
        //    $('#OrderedProducts').append(data);
        //    $('#errOrderedProducts').text("");
        //});
        $.ajax({
            type: 'GET',
            url: url,
            data: {
                textSearch: textSearch,
                strCheckedList: strCheckedList
            },
            dataType: 'html',
            success: function (res) {
                if ($("#HideOutOfStock").val() != undefined) {
                    $('#OrderedProducts').empty();
                }
                $('#OrderedProducts').append(res);
                $('#errOrderedProducts').text("");

                $('#ViewModal').modal('hide');
            }
        });
    });
</script>
