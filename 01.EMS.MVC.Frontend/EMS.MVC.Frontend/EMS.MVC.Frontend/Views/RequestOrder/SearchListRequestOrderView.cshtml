@using EMS.Library
@model List<EMS.MVC.Frontend.Models.RequestOrderListViewModel>
@{
    Layout = null;
}
<table class="table table-responsive-md" id="tableRequestOrderView">
    <thead>
        <tr>
            <th>Thông tin khách hàng</th>
            <th>Sản phẩm</th>
            <th>Trạng thái</th>
            <th>Tình trạng xử lý</th>
            <th>Người xử lý</th>
            <th>Thời gian tạo</th>
            <th>Thời gian cập nhật</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>
                        <ul>
                            <li>@item.FullName</li>
                            <li class="fs-12 text-3">
                                @item.MobileNumber
                            </li>
                            <li class="fs-12 text-3">
                                @item.Channel
                            </li>
                        </ul>
                    </td>
                    <td>
                        @{
                            var ProductName = item.Product.Split('|');
                            if (ProductName.Length > 0)
                            {
                                for (var i = 0; i < ProductName.Length - 1; i++)
                                {
                                    <span style="line-height: 1.4rem;">@ProductName[i]</span>
                                    if (i + 1 <= ProductName.Length - 2)
                                    {
                                        <br />
                                    }
                                }
                            }
                        }
                    </td>
                    <td>
                        @if (item.Status == "Đã tạo đơn hàng")
                        {
                            <span style="line-height: 1.4rem;">@item.Status</span>
                            <br />
                            <a style="cursor: pointer; color: #007bff;" onclick="btnOrderDetail(@item.OrderID)">@item.OrderCode</a>
                        }
                        else
                        {
                            <span>@item.Status</span>
                        }
                    </td>
                    <td><span>@item.Reason</span></td>
                    <td>
                        @if (item.RecieverName == "")
                        {
                            Write("Không xác định");
                        }
                        else
                        {
                            Write(item.RecieverName);
                        }
                    </td>
                    <td>
                        @{
                            var splitCreatedDate = item.CreatedDate.Split(' ');
                            <span style="line-height: 1.4rem;">@splitCreatedDate[0]</span>
                            <br />
                            <span style="line-height: 1.4rem;">@splitCreatedDate[1]</span>
                        }
                    </td>
                    <td>
                        @if (item.UpdatedDate != "")
                        {
                            var splitUpdatedDate = item.UpdatedDate.Split(' ');
                            <span style="line-height: 1.4rem;">@splitUpdatedDate[0]</span>
                            <br />
                            <span style="line-height: 1.4rem;">@splitUpdatedDate[1]</span>
                        }
                    </td>
                    <td>
                        <button type="button" class="btn btn-info light ">
                            <i class="icon-edit fs-18"></i>
                        </button>
                    </td>
                </tr>
            }
        }

    </tbody>
</table>


<script type="text/javascript">
    $(document).ready(function () {
        MyCreateDataTable("tableRequestOrderView");
    })

    $("#AllDate").on('change', function () {
        //debugger
        var AllDateValue = $("#AllDate").val();
        if (AllDateValue) {
            var SplitAllDateValue = AllDateValue.split('-');
            $('#FromDate').val(SplitAllDateValue[0].trim());
            $('#ToDate').val(SplitAllDateValue[1].trim());
            var FromDate = $('#FromDate').val();
            var ToDate = $('#ToDate').val();
            var listFromDate = FromDate.split("/");
            var fromDate = listFromDate[2] + listFromDate[1] + listFromDate[0];
            var listToDate = ToDate.split("/");
            var toDate = listToDate[2] + listToDate[1] + listToDate[0];
            table = document.getElementById("tableRequestOrderView");
            tr = table.getElementsByTagName("tr");
            for (i = 0; i < tr.length; i++) {
                td = tr[i].getElementsByTagName("td")[5];
                if (td) {
                    txtValue = td.textContent.split("\n")[1].trim() || td.innerText.split("\n")[1].trim();
                    var listtxtValue = txtValue.split("/");
                    var intValue = listtxtValue[2] + listtxtValue[1] + listtxtValue[0];
                    if (parseInt(fromDate) == parseInt(toDate)) {
                        if (parseInt(intValue) == parseInt(fromDate)) {
                            tr[i].style.display = "";
                        } else {
                            tr[i].style.display = "none";
                        }
                    }
                    else {
                        if (parseInt(fromDate) <= parseInt(intValue) && parseInt(intValue) <= parseInt(toDate)) {
                            tr[i].style.display = "";
                        } else {
                            tr[i].style.display = "none";
                        }
                    }
                }
            }
        }
    })

    $("#Status").on('change', function () {
        debugger
        var status = $("#Status :selected").text().toUpperCase();
        table = document.getElementById("tableRequestOrderView");
        tr = table.getElementsByTagName("tr");
        for (i = 0; i < tr.length; i++) {
            td = tr[i].getElementsByTagName("td")[2];
            if (td) {
                txtValue = td.textContent || td.innerText;
                if (txtValue.toUpperCase().indexOf(status) > -1) {
                    tr[i].style.display = "";
                }
                else if (status == "TẤT CẢ") {
                    tr[i].style.display = "";
                }
                else {
                    tr[i].style.display = "none";
                }
            }
        }
    })
</script>

