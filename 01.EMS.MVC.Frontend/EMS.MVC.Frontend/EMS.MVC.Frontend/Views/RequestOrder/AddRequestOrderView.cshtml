            url: '@Url.Action("ProductSearchView", "RequestOrder")',
            data: {
                textSearch: textSearch,
                isRequestOrder: "Y"
            },
            dataType: 'json',
            success: function (res) {
                if (res.Code == "00") {
                    $('#modal-ViewModal-html').html(res);
                    $('#ViewModal').modal('show');
                } else {
                    swal({
