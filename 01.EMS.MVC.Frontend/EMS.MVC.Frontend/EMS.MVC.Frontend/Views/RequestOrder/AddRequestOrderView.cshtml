
@{
    ViewBag.Title = "AddRequestOrderView";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    #footer{
        display: none;
    }
</style>
<div class="container-medium">
    <div class="gr-top">

        <a type="button" href="./yeu-cau-import-file.html" class="btn btn-upload ">
            <i class="icon-up fs-18"></i>
            Nhập file
        </a>
    </div>
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">
                Thông tin khách hàng
            </h4>
            <form>
                <div class="row">

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">Họ và tên <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="Họ và tên" required>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">Số điện thoại<span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="Số điện thoại">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" placeholder="Email">
                        </div>
                    </div>
                    <div class="col-8">
                        <div class="mb-3">
                            <label class="form-label">Địa chỉ</label>
                            <input type="text" class="form-control" placeholder="Địa chỉ">
                        </div>
                    </div>
                    <div class="col-md-4">
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">Tỉnh/Thành phố</label>
                            <select id="ProvinceID" class="select2-with-label-single select2" onchange="LoadListDistrict('ProvinceID', 'DistrictID', 'WardID')">
                                <option value="">
                                    Chọn Tỉnh/Thành phố
                                </option>
                            </select>
                            <span class="text-danger" id="errProvinceID"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">Quận/Huyện</label>
                            <select id="DistrictID" class="select2-with-label-single-1 select2" onchange="LoadListWard('DistrictID', 'WardID')">
                                <option value="">
                                    Chọn Quận/Huyện
                                </option>
                            </select>
                            <span class="text-danger" id="errDistrictID"></span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label">Phường/Xã</label>
                            <select id="WardID" class="select2-with-label-single-2 select2">
                                <option value="">
                                    Chọn Phường/Xã
                                </option>
                            </select>
                            <span class="text-danger" id="errWardID"></span>
                        </div>
                    </div>

                    <div class="col-4">
                        <div class="mb-3">
                            <label class="form-label">Kênh bán hàng</label>
                            <select class="select2-with-label-single-2 select2" id="Channel">
                                @foreach (var item in ViewBag.ListChannel)
                                {
                                    <option value="@item.Value" @{if (item.Value == "TT") { Write("selected"); } }>@item.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="mb-3 mt-3">
                            <label class="form-label">Ghi chú</label>
                            <textarea class="form-control" rows="4" id="Description" placeholder="Mô tả" maxlength="250"></textarea>
                            <div class="text-end">
                                <span class="fs-12 font-w300 text-3"><span id="ShowLengthNote">0</span>/250</span>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div class="card">
        <div class="card-body ">
            <h4 class="card-title">
                Thông tin sản phẩm
            </h4>
            <div class="col-md-4">
                <div class="mb-3">
                    <label class="form-label">Sản phẩm<span class="text-danger">*</span></label>

