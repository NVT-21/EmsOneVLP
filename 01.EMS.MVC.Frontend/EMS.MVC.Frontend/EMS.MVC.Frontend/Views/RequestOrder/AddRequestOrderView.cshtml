                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="bottom-group">
    <div class="float-end">
        <button type="button" class="btn btn-outline-dark">Hủy bỏ</button>
        <button type="button" class="btn btn-outline-dark" data-bs-toggle="modal" data-bs-target="#update">
            Cập nhật trạng thái
        </button>
        <button type="button" class="btn btn-primary">Xác nhận</button>
    </div>
</div>

<script type="text/javascript">
    ShowInputLength("Description", "ShowLengthNote", 250);
    $(document).ready(function () {
        $('select.select2').select2({
            selectOnClose: true,
            width: '100%',
            language: {
                noResults: function () {
                    return 'Không tìm thấy dữ liệu.';
                },
            },
        });
        LoadListProvince("ProvinceID");
    })

    function searchProduct() {
        //debugger
        var textSearch = $('#textSearch').val().trim();

        $.ajax({
            type: 'GET',
            url: '@Url.Action("ProductSearchView", "RequestOrder")',
            data: {
                textSearch: textSearch,
                isRequestOrder: "Y"
            },
            dataType: 'html',
            success: function (res) {
                //debugger
                $('#modal-ViewModal-html').html(res);
                $('#ViewModal').modal('show');
            }
        });
    }

