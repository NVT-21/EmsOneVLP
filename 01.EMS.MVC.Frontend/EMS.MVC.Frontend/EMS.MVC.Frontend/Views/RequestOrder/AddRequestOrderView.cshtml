                        </svg>
                        <input type="text" class="form-control" id="textSearch" onkeyup="searchProduct()" placeholder="Tìm theo tên sản phẩm">
                    </div>
                </div>
            </div>
            <span class="text-danger" id="errOrderedProducts"></span>
            <div class="table-responsive table-primary table-border-1" id="showTableOrderedProduct">
                <table class="table table-responsive-md">
                    <thead>
                        <tr>
                            <th>Tên sản phẩm</th>
                            <th>Tên biến thể</th>
                            <th>Số lượng</th>
                            <th>Giá tiền</th>
                            <th>Thành tiền</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="OrderedProducts">
                        @*<tr>
                            <td>
                                <img src="./images/2.png" alt="">
                                Mr. Bobby
                            </td>
                            <td>Mr. Bobby</td>
                            <td>
                                <div class="quantity-block">
                                    <button class=" btn quantity-arrow-minus"> - </button>
