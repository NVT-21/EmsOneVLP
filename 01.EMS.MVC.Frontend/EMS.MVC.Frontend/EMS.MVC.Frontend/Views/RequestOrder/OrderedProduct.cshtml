
@model List<EMS.MVC.Frontend.Models.OrderedProductViewModel>
@{
    Layout = null;
}
@if (Model.Count > 0)
{
    foreach (var item in Model)
    {
        var Key = item.ProductID.ToString() + "-" + item.VariantID.ToString();
        <tr name="row-item" id="tr_@Key" class="border">
            <td class="text-center border">
                <button class="badge badge-outline-danger" onclick="FuncDeleteOrderedProduct(this)" title="Xoá sản phẩm">
                    <i class="fa fa-times"></i>
                </button>
            </td>
            <td class="border">
                <div name="OrderedProduct" style="display:none;" data-key="@Key" data-ProductID="@item.ProductID" data-VariantID="@item.VariantID" data-SKU="@item.SKU" data-Weight="@item.Weight" data-ProductName="@item.ProductName" data-WareHouseQuantity="@item.WareHouseQuantity"></div>
                <span>@item.ProductName</span>
            </td>
            <td class="border">
                <span>@item.VariantName</span>
            </td>
            <td class="border text-center" style="vertical-align: middle;">
                @*<input type="text" class="form-control w-auto OnlyNumber" name="NumberOfProduct" id="NumberOfProduct_@Key" value="@item.NumberOfProduct" onkeydown="return NoNegativeNumbers(event)" onkeyup="FuncUpdateIntoMoney('@Key')" onchange="checkProductNumber('@Key')" style="max-width: 150px;" />*@
                <div class="input-group justify-content-center">
                    <div class="input-group-prepend">
                        <button class="btn btn-warning btn-sm" onclick="minus(this,'@Key')">
                            <i class="fa fa-minus" style="color:white;"></i>
                        </button>
                    </div>
                    <input type="text" class="form-control text-center w-auto OnlyNumber" name="NumberOfProduct" id="NumberOfProduct_@Key" value="@item.NumberOfProduct" onkeydown="return NoNegativeNumbers(event)" onkeyup="FuncUpdateIntoMoney('@Key')" onchange="checkProductNumber('@Key')" data-id="@item.NumberOfProduct" style="min-width: 100px; max-width: 100px; vertical-align: middle;" im-insert="true" />
                    <div class="input-group-prepend">
                        <button class="btn btn-primary btn-sm" onclick="plus(this,'@Key')">
                            <i class="fa fa-plus"></i>
                        </button>
                    </div>
                </div>
                <div class="text-danger mt-1" id="errNumberOfProduct_@Key"></div>
            </td>
            <td id="Price_@Key" class="text-right border" name="Price" data-value="@item.Price">@item.Price.ToString("N0") ₫</td>
            <td id="Discount_@Key" class="text-right border" name="Discount" data-value="0">0 ₫</td>
            <td id="IntoMoney_@Key" class="text-right border" name="IntoMoney" data-value="@(item.Price * item.NumberOfProduct)">
                @{
                    var totalPrice = item.Price * item.NumberOfProduct;
                    Write(totalPrice.ToString("N0") + " ₫");
                }
            </td>
        </tr>
    }
}
else
{
    <tr id="HideOutOfStock">
        <td colspan="10">
            <span>Sản phẩm yêu cầu hết hàng</span>
        </td>
    </tr>
}
@*<script src="~/Assets/js/select2.js"></script>*@
