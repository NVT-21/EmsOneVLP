    //function loadWeight() {
    //    var lstProduct = document.getElementsByName('OrderedProduct');
    //    var lstNumberOfProduct = document.getElementsByName('NumberOfProduct');
    //    var TotalWeight = 0;
    //    for (var i = 0; i < lstProduct.length; i++) {
