    $(".OnlyNumber").on("keypress keyup blur", function (event) {
        $(this).val($(this).val().replace(/[^\d].+/, ""));
        if ((event.which < 48 || event.which > 57)) {
            event.preventDefault();
        }
    });

    function FuncUpdateIntoMoney(Key) {
        //var ID = $(ctl).parents("tr").find("input.OrderedProductID").value;

        var Price = $("#Price_" + Key).attr("data-value");
        var Discount = $("#Discount_" + Key).attr("data-value");

        var NumberOfProduct = $("#NumberOfProduct_" + Key).val();

        var TotalDiscount = Discount * NumberOfProduct;

        var IntoMoney = (Price * NumberOfProduct) - TotalDiscount;

        var fIntoMoney = CurrencyFormatVND(IntoMoney);

        $("#IntoMoney_" + Key).html(fIntoMoney);
        $("#IntoMoney_" + Key).attr("data-value", IntoMoney);

        PaymentReload();
    }
    function FuncDeleteOrderedProduct(this1) {
        swal({
            title: 'Thông báo',
            text: "Bạn có chắc chắn muốn xoá sản phẩm này?",
            buttons: {
                confirm: {
                    text: "CÓ",
                    value: true,
                    visible: true,
                    className: "btn btn-primary",
                    closeModal: true
                },
                cancel: {
                    text: "KHÔNG",
                    value: false,
                    visible: true,
                    className: "btn btn-danger",
                    closeModal: true,
                }
            },
        }).then((value) => {
            if (value) {
                $(this1).parents("tr").remove();
                PaymentReload();
                //checkOrderedProducts();
                var RowItem = document.getElementsByName('row-item');
                if (RowItem.length == 0) {
                    $("#OrderedProducts").css("display", "none");
                }
            }
        });
    }
    function checkProductNumber(Key) {
        var NumberOfProduct = $("#NumberOfProduct_" + Key).val();
        if (NumberOfProduct == "" || parseInt(NumberOfProduct) == 0) {
            $("#errNumberOfProduct_" + Key).text("Vui lòng nhập số lượng sản phẩm.");
        } else {
            $("#errNumberOfProduct_" + Key).text("");
        }

        //var ID = "#NumberOfProduct_" + Key;
        //var errID = "#errNumberOfProduct_" + Key;
        //if ($(ID).val() == "" || $(ID).val() == 0) {
        //    $(errID).text("Vui lòng nhập số lượng sản phẩm.");
        //    $(ID).focus();
        //} else {
        //    $(errID).text("");
        //}
    }
    function minus(ctl, key) {
        var $input = $(ctl).parent().parent().find('input');
        var value = $input.val() == "" ? 1 : $input.val();
        var count = parseInt(value) - 1;
        count = count <= 0 ? 1 : count;
        $input.val(count);
        $input.change();
        FuncUpdateIntoMoney(key);
        //loadWeight();
        return false;
    };

    function plus(ctl, key) {
        var $input = $(ctl).parent().parent().find('input');
        var value = $input.val() == "" ? 0 : $input.val();
        var count = parseInt(value) + 1;
        $input.val(count);
        $input.change();
        FuncUpdateIntoMoney(key);
        //loadWeight();
        return false;
    };
</script>
