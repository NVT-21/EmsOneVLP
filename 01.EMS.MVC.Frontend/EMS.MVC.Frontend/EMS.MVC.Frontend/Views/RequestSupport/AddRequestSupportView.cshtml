@model EMS.MVC.Frontend.Models.AddRequestSupportViewModel
<div class="modal-dialog modal-medium modal-dialog-centered" role="document">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Thêm yêu cầu hỗ trợ</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal">
            </button>
        </div>
        <div class="modal-body" id="ClearModal">
            <div class="row">
                @Html.HiddenFor(m => m.ShopID)
                @Html.HiddenFor(m => m.TotalCOD)
                @Html.HiddenFor(m => m.Sender.Province.ID)
                @Html.HiddenFor(m => m.Sender.District.ID)
                @Html.HiddenFor(m => m.Sender.Ward.ID)
                @Html.HiddenFor(m => m.Sender.Street)
                @Html.HiddenFor(m => m.Receiver.MobileNumber)
                @Html.HiddenFor(m => m.Receiver.Province.ID)
                @Html.HiddenFor(m => m.Receiver.District.ID)
                @Html.HiddenFor(m => m.Receiver.Ward.ID)
                @Html.HiddenFor(m => m.Receiver.Street)
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="mb-1">Mã bưu gửi <span class="text-danger">*</span></label>
                        @Html.EditorFor(model => model.EShippingCode, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Mã bưu gửi" } })
                        <span class="text-danger" id="errEShippingCode"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="mb-1">Nhóm yêu cầu <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(model => model.RequestSupportGroup, new SelectList(Model.ListRequestSupportGroup, "ID", "Name"), "-- Chọn --", new { @class = "select2", @disabled="true" })
                        <span class="text-danger" id="errRequestSupportGroup"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="mb-1">Loại yêu cầu <span class="text-danger" id="RequiredRequestType">*</span></label>
                        @Html.DropDownListFor(model => model.RequestSupportType, new SelectList(Model.ListRequestSupportType, "ID", "Name"), "-- Chọn --", new { @class = "select2", @disabled = "true" })
                        <span class="text-danger" id="errRequestSupportType"></span>
                        <div id="ShowRequestTypeDifferent" style="display: none;">
                            @Html.EditorFor(model => model.RequestSupportTypeDifferent, new { htmlAttributes = new { @type = "text", @class = "form-control" } })
                        </div>
                        <span class="text-danger" id="errRequestSupportTypeDifferent"></span>
                    </div>
                </div>
                <div id="ShowInfoRequestTypeView" style="display: none;">

                </div>
                <div class="col-12">
                    <div class="mb-3">
                        <label class="mb-1">Nội dung</label>
                        @Html.TextAreaFor(model => model.Description, new { @class = "form-control", @placeholder = "Nội dung", @rows = "4", @maxlength = "250", @disabled = "true" })
                        <div class="text-end">
                            <span class="fs-12 font-w300 text-3"><span id="ShowLengthDescription">0</span>/250</span>
                        </div>
                        <span class="text-danger" id="errDescription"></span>
                    </div>
                </div>
                <div class="col-12">
                    <div class="mb-3">
                        <label class="mb-1">Ghi chú</label>
                        @Html.TextAreaFor(model => model.Note, new { @class = "form-control", @placeholder = "Ghi chú", @rows = "4", @maxlength = "250", @disabled = "true" })
                        <div class="text-end">
                            <span class="fs-12 font-w300 text-3"><span id="ShowLengthNote">0</span>/250</span>
                        </div>
                        <span class="text-danger" id="errNote"></span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="mb-3">
                        <label class="mb-1">Tài liệu đính kèm</label>
                        <form id="DocumentUpload" enctype="multipart/form-data">
                            @Html.EditorFor(model => model.Document, new { htmlAttributes = new { @type = "file", @class = "", @disabled = "true" } })
                        </form>
                        <span id="errDocument"></span>
                        @Html.HiddenFor(m => m.FileName)
                    </div>
                </div>
                @*<div class="col-6">
                        <div class="mb-3">
                            <label class="mb-1">Tài liệu đính kèm</label>
