                            </div>
                            <span class="text-danger" id="errDocument"></span>
                        </div>
                    </div>*@
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-outline-dark light" data-bs-dismiss="modal">Hủy bỏ</button>
            <button type="button" class="btn btn-primary" id="btnAddRequestSupport">Thêm mới</button>
        </div>
    </div>
</div>
<script>
    CheckChangeValue("EShippingCode", "Vui lòng mã bưu gửi", "UserName", "Y");
    CheckChangeValue("RequestSupportGroup", "Vui lòng chọn nhóm yêu cầu", "", "Y");
    CheckChangeValue("RequestSupportType", "Vui lòng loại yêu cầu", "", "Y");
    CheckChangeValue("RequestSupportTypeDifferent", "", "Vietnamese", "N");
    ShowInputLength("Description", "ShowLengthDescription", 250);
    ShowInputLength("Note", "ShowLengthNote", 250);
    $(document).ready(function () {
        if ($("#EShippingCode").val().trim()) {
            $("#EShippingCode").change();
        }
        $('select.select2').select2(AttributeSelect2);
    });

    $("#EShippingCode").on("change", function () {
        var ShippingCode = $("#EShippingCode").val().trim();
        if (ShippingCode) {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("DetailOrderByShippingCode", "Handle")',
                dataType: 'json',
                loading: true,
                data: {
                    ShippingCode: ShippingCode,
                    ShopID: $("#ShopID").val()
                },
                success: function (res) {
                    if (res.Code == "00") {
                        var item = JSON.parse(res.Data);
                        $("#TotalCOD").val(item.TotalCOD);
                        $("#Sender_Province_ID").val(item.SenderProvinceID);
                        $("#Sender_District_ID").val(item.SenderDistrictID);
                        $("#Sender_Ward_ID").val(item.SenderWardID);
                        $("#Sender_Street").val(item.SenderAddress);

                        $("#Receiver_MobileNumber").val(item.ReceiverPhone);
                        $("#Receiver_Province_ID").val(item.ReceiverProvinceID);
                        $("#Receiver_District_ID").val(item.ReceiverDistrictID);
                        $("#Receiver_Ward_ID").val(item.ReceiverWardID);
                        $("#Receiver_Street").val(item.ReceiverAddress);

                        $("#RequestSupportGroup").attr("disabled", false);
                        $("#RequestSupportType").attr("disabled", false);
                        $("#Description").attr("disabled", false);
                        $("#Note").attr("disabled", false);
                        $("#Document").attr("disabled", false);

                        var RequestSupportTypeValue = $("#RequestSupportType").val();
                        if (RequestSupportTypeValue == "6" || RequestSupportTypeValue == "7" || RequestSupportTypeValue == "8" || RequestSupportTypeValue == "9") {
                            $("#RequestSupportType").change();
                        }
                    } else {
                        $("#errEShippingCode").text(res.Message);

                        $("#RequestSupportGroup").attr("disabled", true);
                        $("#RequestSupportType").attr("disabled", true);
                        $("#Description").attr("disabled", true);
                        $("#Note").attr("disabled", true);
                        $("#Document").attr("disabled", true);
                    }
                },
                error: function (xhr, status, error) {
                    var err = eval("(" + xhr.responseText + ")");
                    swal({
                        title: 'Lỗi',
                        text: err.Message,
                        button: {
                            text: "ĐÓNG"
                        }
                    });
                    return;
                }
            });
        }
    });

    $("#RequestSupportGroup").on("change", function () {
        var RequestSupportGroupValue = $("#RequestSupportGroup").val();
        $('#RequestSupportType').empty();
        $("#ShowInfoRequestTypeView").css("display", "none");
        if (RequestSupportGroupValue) {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("SearchListRequestSupportGroup", "Handle")',
                data: {
                    ParentID: RequestSupportGroupValue
                },
                loading: true,
                dataType: 'json',
                success: function (data) {
                    if (RequestSupportGroupValue == "5") {
                        $("#RequiredRequestType").css("visibility", "hidden");
                        $("#ShowRequestTypeDifferent").css("display", "block");
                        $('#RequestSupportType').next(".select2-container").hide();
                    } else {
                        $("#RequiredRequestType").css("visibility", "visible");
                        $("#ShowRequestTypeDifferent").css("display", "none");
                        $('#RequestSupportType').next(".select2-container").show();
                        $("<option/>", {
                            value: "",
                            text: "--- Chọn ---"
                        }).appendTo("#RequestSupportType");
                        $.each(data, function (index, value) {
                            $("<option/>", {
                                value: value.ID,
                                text: value.Name
                            }).appendTo("#RequestSupportType");
                        });
                    }
                },
                error: function (xhr, status, error) {
                    var err = eval("(" + xhr.responseText + ")");
                    swal({
                        title: 'Lỗi',
                        text: err.Message,
                        button: {
                            text: "ĐÓNG"
                        }
                    });
                    return;
                }
            });
        } else {
            $("<option/>", {
                value: "",
                text: "--- Chọn ---"
            }).appendTo("#RequestSupportType");
        }
    });

    $("#RequestSupportType").on('change', function () {
        var RequestSupportTypeValue = $("#RequestSupportType").val();
        if (RequestSupportTypeValue == "6" || RequestSupportTypeValue == "7" || RequestSupportTypeValue == "8" || RequestSupportTypeValue == "9") {
            var req = {
                RequestSupportType: RequestSupportTypeValue,
                TotalCOD: $("#TotalCOD").val(),
                Sender: {
                    Province: {
                        ID: $('#Sender_Province_ID').val()
                    },
                    District: {
                        ID: $('#Sender_District_ID').val()
                    },
                    Ward: {
                        ID: $('#Sender_Ward_ID').val()
                    },
                    Street: $('#Sender_Street').val()
                },
                Receiver: {
                    MobileNumber: $('#Receiver_MobileNumber').val(),
                    Province: {
                        ID: $('#Receiver_Province_ID').val()
                    },
                    District: {
                        ID: $('#Receiver_District_ID').val()
                    },
                    Ward: {
                        ID: $('#Receiver_Ward_ID').val()
                    },
                    Street: $('#Receiver_Street').val()
                },
            }
            $.post('@Url.Action("SearchInfoByRequestSupportTypeView", "RequestSupport")', req, function (data) {
                $("#ShowInfoRequestTypeView").css("display", "block");
                $("#ShowInfoRequestTypeView").html(data);
            });
        }
    });

    $("#Document").on("click", function () {
        $("#errDocument").text("");
        $('#DocumentUpload')[0].reset();
    });

    $("#Document").on("change", function () {
        var TypeFile = ["JPG", "JPEG", "PNG", "DOC", "DOCX", "XLS", "XLSX", "XLSM" ,"PDF"];
        var formdata = new FormData(); //FormData object
        var fileInput = document.getElementById('Document');
        var filename = fileInput.files[0].name;
        var filesize = fileInput.files[0].size;
        var extension = filename.split('.').pop().toUpperCase();
        var check = TypeFile.includes(extension);
        if (check == false) {
            FileName = "";
            $('#DocumentUpload')[0].reset();
            $("#errDocument").text("Hệ thống chỉ hỗ trợ tải tập tin dạng ảnh, Word, Excel, PDF.");
            $("#errDocument").css("color", "red");
        } else if (filesize >= 5242880) {
            //5MB
            FileName = "";
            $('#DocumentUpload')[0].reset();
            $("#errDocument").text("Hệ thống hỗ trợ tải tệp tin kích thước tối đa 5 MB.");
            $("#errDocument").css("color", "red");
        } else {
            for (i = 0; i < fileInput.files.length; i++) {
                formdata.append(fileInput.files[i].name, fileInput.files[i]);
            }
            $.ajax({
                url: '@Url.Action("UploadFile", "DataFile")',
                type: 'POST',
                data: formdata,
                async: false,
                cache: false,
                contentType: false,
                processData: false,
                success: function (res) {
                    if (res.Code == '00') {
                        var resData = JSON.parse(res.Data);
                        $("#FileName").val(resData[0].FileName);
                        $("#errDocument").text(res.Message);
                        $("#errDocument").css("color", "green");
                    } else {
                        $("#FileName").val("");
                        $("#errDocument").text(res.Message);
                        $("#errDocument").css("color", "red");
                        $('#DocumentUpload')[0].reset();
                    };
                },
                error: function (xhr, status, error) {
                    //var err = eval("(" + xhr.responseText + ")");
                    swal({
                        title: 'Lỗi',
                        text: error,
                        button: {
                            text: "Đóng",
                            value: true,
                            visible: true,
                            className: "btn btn-primary"
                        }
                    });
                    return;
                },
                //complete: function (data) {
                //    $('#PDFUpload')[0].reset(); // this will reset the form fields
                //}
            });
        }
    });

    $("#btnAddRequestSupport").on("click", function () {
        var isError = false;
        var Message = "Giá trị hợp lệ không bao gồm ký tự đặc biệt.";
        var data = {
            RequestSupportGroup: $("#RequestSupportGroup").val() == "" ? "" : $("#RequestSupportGroup option:selected").text(),
            RequestSupportType: $("#RequestSupportType").val(),
            RequestSupportTypeDifferent: $("#RequestSupportTypeDifferent").val().trim(),
            EShippingCode: $("#EShippingCode").val().trim(),
            Description: $("#Description").val().trim(),
            Note: $("#Note").val().trim(),
            Document: $("#FileName").val().trim(),
            UpdateInformation: ""
        };

        if (data.RequestSupportType) {
            data.RequestSupportType = $("#RequestSupportType option:selected").text();
        } else {
            if (data.RequestSupportGroup == "Yêu cầu khác") {
                data.RequestSupportType = data.RequestSupportTypeDifferent;
            } else {
                data.RequestSupportType = "";
            }
        }

        isError = CheckNullValue(data.RequestSupportGroup, "RequestSupportGroup", "Vui lòng chọn nhóm yêu cầu", isError);
        if (isError == false) {
            if (data.RequestSupportGroup == "Yêu cầu khác") {
                if (RequestSupportTypeDifferent) {
                    isError = CheckRegexValue(data.RequestSupportTypeDifferent, "Vietnamese", "RequestSupportTypeDifferent", Message, isError);
                } else {
                    $("#errRequestSupportTypeDifferent").text("");
                }
            }
        }

        if (data.RequestSupportType == "") {
            if (data.RequestSupportGroup != "Yêu cầu khác") {
                $("#errRequestSupportType").text("Vui lòng chọn loại yêu cầu.");
                $("#RequestSupportType").focus();
                isError = true;
            }
        } else {
            if (data.RequestSupportType == "Sửa tiền đơn hàng (tiền COD)") {
                data.UpdateInformation = parseInt(NumberReplace($("#MainTotalCOD").val().trim()));
                if (data.UpdateInformation) {
                    if (data.UpdateInformation > 50000000) {
                        $("#errMainTotalCOD").text("Số tiền COD tối đa 50 triệu đồng/BG.");
                        $("#MainTotalCOD").focus();
                        isError = true;
                    }
                } else {
                    $("#errMainTotalCOD").text("Vui lòng nhập số tiền COD.");
                    $("#MainTotalCOD").focus();
                    isError = true;
                }
                //isError = CheckNullValue(data.UpdateInformation, "MainTotalCOD", "Vui lòng nhập số tiền COD", isError);
            } else if (data.RequestSupportType == "Sửa số điện thoại giao hàng") {
                data.UpdateInformation = $("#ReceiverMobileNumber").val().trim();
                isError = CheckNullAndRegexValue(data.UpdateInformation, "MobileNumber", "ReceiverMobileNumber", "Vui lòng nhập số điện thoại", "Số điện thoại không hợp lệ", isError);
            } else if (data.RequestSupportType == "Sửa địa chỉ giao hàng (có thể thu phí hoặc không)") {
                var ProvinceID = $("#ReceiverProvinceID").val();
                var DistrictID = $("#ReceiverDistrictID").val();
                var WardID = $("#ReceiverWardID").val();
                var Address = $("#ReceiverStreet").val().trim();

                isError = CheckNullValue(ProvinceID, "ReceiverProvinceID", "Vui lòng chọn Tỉnh/ Thành phố", isError);
                isError = CheckNullValue(DistrictID, "ReceiverDistrictID", "Vui lòng chọn Quận/ Huyện", isError);
                isError = CheckNullValue(WardID, "ReceiverWardID", "Vui lòng chọn Phường/ Xã", isError);
                isError = CheckNullValue(Address, "ReceiverStreet", "Vui lòng nhập Địa chỉ", isError);

                data.UpdateInformation = ProvinceID + '|' + DistrictID + '|' + WardID + '|' + Address;
            } else if (data.RequestSupportType == "Sửa thông tin lấy hàng") {
                var ProvinceID = $("#SenderProvinceID").val();
                var DistrictID = $("#SenderDistrictID").val();
                var WardID = $("#SenderWardID").val();
                var Address = $("#SenderStreet").val().trim();

                isError = CheckNullValue(ProvinceID, "SenderProvinceID", "Vui lòng chọn Tỉnh/ Thành phố", isError);
                isError = CheckNullValue(DistrictID, "SenderDistrictID", "Vui lòng chọn Quận/ Huyện", isError);
                isError = CheckNullValue(WardID, "SenderWardID", "Vui lòng chọn Phường/ Xã", isError);
                isError = CheckNullValue(Address, "SenderStreet", "Vui lòng nhập Địa chỉ", isError);

                data.UpdateInformation = ProvinceID + '|' + DistrictID + '|' + WardID + '|' + Address;
            }
        }

        isError = CheckNullAndRegexValue(data.EShippingCode, "UserName", "EShippingCode", "Vui lòng nhập mã bưu gửi", Message, isError);

        if (isError == true) {
            return;
        }

        $.ajax({
            type: 'POST',
            url: '@Url.Action("JAddRequestSupport", "RequestSupport")',
            dataType: 'json',
            loading: true,
            data: data,
            beforeSend: function () {
                $("#btnAddRequestSupport").attr("disabled", true).append("<i class= 'fa fa-spinner fa-spin ms-1' id='iLoading'></i>");
            },
            success: function (res) {
                if (res.Code == "00") {
                    CreateCustomSwal("success", res.Message);
                } else {
                    CreateCustomSwal("error", res.Message);
                }
            },
            complete: function () {
                $("#btnAddRequestSupport").attr("disabled", false).find("i#iLoading").remove();
            },
            error: function (xhr, status, error) {
                var err = eval("(" + xhr.responseText + ")");
                swal({
                    title: 'Lỗi',
                    text: err.Message,
                    button: {
                        text: "ĐÓNG"
                    }
                });
                return;
            }
        });
    });
</script>