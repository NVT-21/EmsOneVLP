@model EMS.MVC.Frontend.Models.RequestSupportViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-9">
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label class="mb-1">Thời gian</label>
                                <div class="datepicker-form">
                                    @Html.EditorFor(model => model.AllDate, new { htmlAttributes = new { @type = "text", @class = "form-control input-daterange-datepicker" } })
                                    @Html.HiddenFor(m => m.FromDate)
                                    @Html.HiddenFor(m => m.ToDate)
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="mb-1">Nhóm yêu cầu</label>
                                @Html.DropDownListFor(model => model.RequestSupportGroup, new SelectList(Model.ListRequestSupportGroup, "ID", "Name"), "--- Tất cả ---", new { @class = "select2", id = "SearchRequestSupportGroup" })

                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="mb-1">Loại yêu cầu </label>
                                @Html.DropDownListFor(model => model.RequestSupportType, new SelectList(Model.ListRequestSupportType, "ID", "Name"), "--- Tất cả ---", new { @class = "select2", id = "SearchRequestSupportType" })
                            </div>
                            <div class="col-md-3 mb-3">
                                <label class="mb-1">Trạng thái </label>
                                @Html.DropDownListFor(model => model.RequestSupportStatus, new SelectList(Model.ListRequestSupportStatus, "Value", "Text"), "--- Trạng thái ---", new { @class = "select2", id = "SearchRequestSupportStatus" })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3 d-flex justify-content-end align-items-end">
                        <div class="mb-3 d-flex">
                            <div class="dropdown ">
                                <button class="btn btn-upload " type="button" onclick="btnExportExcel()">
                                    <i class="icon-down fs-18"></i>
                                    Xuất file
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="mb-3">
                            <div class="form-search">
                                <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M18.9842 17.6825L15.8675 14.575C16.8731 13.2939 17.4187 11.7119 17.4167 10.0833C17.4167 8.63294 16.9866 7.21512 16.1808 6.00916C15.375 4.80319 14.2297 3.86326 12.8897 3.30822C11.5497 2.75318 10.0752 2.60795 8.65268 2.89091C7.23015 3.17387 5.92347 3.8723 4.89789 4.89789C3.8723 5.92347 3.17387 7.23015 2.89091 8.65268C2.60795 10.0752 2.75318 11.5497 3.30822 12.8897C3.86326 14.2297 4.80319 15.375 6.00916 16.1808C7.21512 16.9866 8.63294 17.4167 10.0833 17.4167C11.7119 17.4187 13.2939 16.8731 14.575 15.8675L17.6825 18.9842C17.7677 19.0701 17.8691 19.1383 17.9808 19.1848C18.0925 19.2314 18.2123 19.2553 18.3333 19.2553C18.4543 19.2553 18.5742 19.2314 18.6859 19.1848C18.7976 19.1383 18.899 19.0701 18.9842 18.9842C19.0701 18.899 19.1383 18.7976 19.1848 18.6859C19.2314 18.5742 19.2553 18.4543 19.2553 18.3333C19.2553 18.2123 19.2314 18.0925 19.1848 17.9808C19.1383 17.8691 19.0701 17.7677 18.9842 17.6825V17.6825ZM4.58334 10.0833C4.58334 8.99554 4.90591 7.93217 5.51025 7.0277C6.1146 6.12323 6.97358 5.41828 7.97858 5.002C8.98357 4.58572 10.0894 4.4768 11.1563 4.68902C12.2232 4.90124 13.2032 5.42506 13.9724 6.19425C14.7416 6.96344 15.2654 7.94345 15.4777 9.01034C15.6899 10.0772 15.581 11.1831 15.1647 12.1881C14.7484 13.1931 14.0434 14.0521 13.139 14.6564C12.2345 15.2608 11.1711 15.5833 10.0833 15.5833C8.62465 15.5833 7.2257 15.0039 6.19425 13.9724C5.1628 12.941 4.58334 11.542 4.58334 10.0833Z"
                                          fill="#86909C" />
                                </svg>
                                @Html.EditorFor(model => model.SearchKey, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Tìm theo mã bưu gửi, mã yêu cầu" } })
                            </div>
                        </div>
                    </div>
                    <div class="col-8 d-flex justify-content-end align-items-end">
                        <div class="mb-3 d-flex">
                            <button type="button" href="#" id="ShowAddRequestSupportView" class="btn btn-primary d-flex align-items-center ms-3">
                                <i class="ti-plus"></i>
                                Thêm mới
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <div id="tbl-data" class="table-responsive table-primary">
                @*@{
                    Html.RenderAction("SearchListRequestSupportView", "RequestSupport", Model);
                }*@
            </div>
        </div>
    </div>
</div>
@section scripts{
    <script>
        $(document).ready(function () {
            CreateDateRangePicker("AllDate", $("#FromDate").val(), $("#ToDate").val());
        });

        $("#AllDate, #SearchRequestSupportGroup, #SearchRequestSupportType, #SearchRequestSupportStatus").on("change", function () {
            var DivID = this.id;
            if (DivID == "AllDate") {
                var AllDateValue = $("#AllDate").val();
                if (AllDateValue) {
                    var SplitAllDateValue = AllDateValue.split('-');
                    $('#FromDate').val(SplitAllDateValue[0].trim());
                    $('#ToDate').val(SplitAllDateValue[1].trim());
                }
            } else if (DivID == "SearchRequestSupportGroup") {
                $('#SearchRequestSupportType').empty();
                var RequestSupportGroupValue = $("#SearchRequestSupportGroup").val();
                if (RequestSupportGroupValue) {
                    LoadListRequestSupportType(RequestSupportGroupValue);
                } else {
                    $("<option/>", {
                        value: "",
                        text: "--- Chọn ---"
                    }).appendTo("#SearchRequestSupportType");
                }
            }
            btnSearch();
        });

        function btnSearch() {
            var req = {
                FromDate: $('#FromDate').val(),
                ToDate: $('#ToDate').val(),
                RequestSupportGroup: $("#SearchRequestSupportGroup").val() == "" ? "" : $("#SearchRequestSupportGroup option:selected").text(),
                RequestSupportType: $("#SearchRequestSupportType").val() == "" ? "" : $("#SearchRequestSupportType option:selected").text(),
                RequestSupportStatus: $("#SearchRequestSupportStatus").val(),
                SearchKey: "",
            };

            $.post('@Url.Action("SearchListRequestSupportView", "RequestSupport")', req, function (data) {
                $("#tbl-data").html(data);
            });
        }

        function LoadListRequestSupportType(RequestSupportGroup) {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("SearchListRequestSupportGroup", "Handle")',
                data: {
                    ParentID: RequestSupportGroup
                },
                loading: true,
                dataType: 'json',
                success: function (data) {
                    $("<option/>", {
                        value: "",
                        text: "--- Tất cả ---"
                    }).appendTo("#SearchRequestSupportType");
                    $.each(data, function (index, value) {
                        $("<option/>", {
                            value: value.ID,
                            text: value.Name
                        }).appendTo("#SearchRequestSupportType");
                    });
                },
                error: function (xhr, status, error) {
                    var err = eval("(" + xhr.responseText + ")");
                    swal({
                        title: 'Lỗi',
                        text: err.Message,
                        button: {
                            text: "Đóng",
                            value: true,
                            visible: true,
                            className: "btn btn-primary"
                        }
                    });
                    return;
                }
            });
        }

        $("#ShowAddRequestSupportView").on("click", function (event) {
            event.preventDefault();
            $.post('@Url.Action("AddRequestSupportView", "RequestSupport")', function (data) {
                $('#modal-ViewModal-html').html(data);
                $('#ViewModal').modal('show');
            });
        });

        $("#SearchKey").on("keyup keydown", function () {
            var input, filter, table, tr, td, i, txtValue;
            input = document.getElementById("SearchKey");
            filter = input.value.trim().toUpperCase();
            table = document.getElementById("SearchListDataTable");
            tr = table.getElementsByTagName("tr");
            for (i = 0; i < tr.length; i++) {
                td = tr[i].getElementsByTagName("td")[0];
                if (td) {
                    txtValue = td.textContent || td.innerText;
                    if (txtValue.toUpperCase().indexOf(filter) > -1) {
                        tr[i].style.display = "";
                    } else {
                        tr[i].style.display = "none";
                    }
                }
            }
        });

        function btnExportExcel() {
            var req = {
                FromDate: $('#FromDate').val(),
                ToDate: $('#ToDate').val(),
                RequestSupportGroup: $("#SearchRequestSupportGroup").val() == "" ? "" : $("#SearchRequestSupportGroup option:selected").text(),
                RequestSupportType: $("#SearchRequestSupportType").val() == "" ? "" : $("#SearchRequestSupportType option:selected").text(),
                RequestSupportStatus: $("#SearchRequestSupportStatus").val(),
                SearchKey: "",
            };
            var param = String.format("FromDate={0}&ToDate={1}&RequestSupportGroup={2}&RequestSupportType={3}&RequestSupportStatus={4}",
                req.FromDate, req.ToDate, req.RequestSupportGroup, req.RequestSupportType, req.RequestSupportStatus);
            window.location.href = '@Url.Action("ExportListRequestSupport", "RequestSupport")?' + param;
        }
    </script>

}
