                                <option value="2">Tổng giá trị sản phẩm</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3" id="AFO-Type-4-3" style="display: none">
                        <div class="mb-3 custom-props">
                            <label class="form-label">&nbsp;</label>
                            <input type="text" class="form-control" id="AfoCaValue-Type-4" onchange="removeErrorMsg()" name="currency-field" data-inputmask="'alias': 'currency'" onkeydown="return NoNegativeNumbers(event)">
                        </div>
                    </div>
                </div>
                <!-- Biến thể -->
                <div class="mb-3 row">
