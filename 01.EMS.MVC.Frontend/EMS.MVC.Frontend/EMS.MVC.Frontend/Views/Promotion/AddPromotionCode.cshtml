                            <div class="mb-3">
                                <label>&nbsp;</label>
                                <select class="select2 form-control" id="AfoChild-Type-4-5" onchange="reload_dataAC_Type('Type-7')" multiple>
                                    <option value="0">--- Chọn ---</option>
                                    @if (ViewBag.ListProductVariant != null)
                                    {
                                        foreach (var item in ViewBag.ListProductVariant)
