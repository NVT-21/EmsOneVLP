@model EMS.MVC.Frontend.Models.AddPromotionCodeViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h5 class="fs-16 font-w600">Mã giảm giá</h5>
                        <p class="text-3 text-italic">Khách hàng sẽ nhập mã này khi thực hiện thanh toán</p>
                        <div class="input-group mb-3">
                            <input type="text" class="form-control" placeholder="Nhập mã giảm giá hoặc chọn mã ngâu nhiên" id="PromotionCode" onchange="RemoveErrorMessage(this);">
                            <button class="btn btn-secondary" type="button">Tạo mã ngẫu nhiên</button>
                        </div>
                        <span class="error-message" id="errPromotionCode"></span>
                    </div>
                </div>
                <div class="divider"></div>
                <div class="row">
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label class="form-label">Loại khuyến mãi</label>
                            <select class="select2 form-control" id="PromotionTypeOption">
                                @foreach (var item in ViewBag.ListPromotionCodeType)
                                {
                                    if (item.Value == "1")
                                    {
                                        <option value="@item.Value" selected>@item.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value" title="a">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3" id="Promotion-Type-1" style="display: block">
                        <div class="mb-3 custom-props">
                            <label class="form-label">Mức giảm</label>
                            <input type="text" class="form-control" id="Reduction-Type-1" onchange="removeErrorMsg()" data-inputmask="'alias': 'currency'" onkeydown="return NoNegativeNumbers(event)" placeholder="Mức giảm">
                            <span class="props">đ</span>
                        </div>
                    </div>
                    <div class="col-md-3" id="Promotion-Type-2-1" style="display: none">
                        <div class="mb-3 custom-props">
                            <label class="form-label">Mức giảm</label>
                            <input type="text" class="form-control" id="Reduction-Type-2" onchange="removeErrorMsg()" placeholder="Mức giảm" maxlength="2">
                            <span class="props">đ</span>
                        </div>
                    </div>
                    <div class="col-md-3" id="Promotion-Type-2-2" style="display: none">
                        <div class="mb-3 custom-props">
                            <input type="checkbox" class="form-check-input" id="CheckMaxReduction">
                            <label class="form-check-label" for="CheckMaxReduction">
                                Giá cao nhất
                            </label>
                            <input type="text" class="form-control" id="MaxReduction" onchange="removeErrorMsg()" disabled="disabled" data-inputmask="'alias': 'currency'" onkeydown="return NoNegativeNumbers(event)">
                            <span class="props">đ</span>
                        </div>
                    </div>
                    <div class="col-md-3" id="Promotion-Type-3" style="display: none">
                        <div class="mb-3 custom-props">
                            <label class="form-label">Đối với mức phí vận chuyển nhỏ hơn hoặc bằng</label>
                            <input type="text" class="form-control" id="Reduction-Type-3" onchange="removeErrorMsg()" name="currency-field" data-inputmask="'alias': 'currency'" onkeydown="return NoNegativeNumbers(event)">
                            <span class="props">đ</span>
                        </div>
                    </div>
                    <div class="col-md-3" id="Promotion-Type-4" style="display: none">
                        <div class="mb-3 custom-props">
                            <label class="form-label">Mức đồng giá</label>
                            <input type="text" class="form-control" id="Reduction-Type-4" onchange="removeErrorMsg()" name="currency-field" data-inputmask="'alias': 'currency'" onkeydown="return NoNegativeNumbers(event)">
                            <span class="props">đ</span>
                        </div>
                    </div>
                    <!-- Apply For Option-->
                    <div class="col-md-3" id="PTO-Type-1">
                        <div class="mb-3">
                            <label class="form-label">Áp dụng cho</label>
                            <select class="select2 form-control" id="ApplyForOption-Type-12">
                                @foreach (var item in ViewBag.ListPromotionCodeApplyForOption)
                                {
                                    if (item.Value == "1")
                                    {
                                        <option value="@item.Value" selected>@item.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3" id="PTO-Type-3" style="display: none">
                        <div class="mb-3">
                            <label class="form-label">Áp dụng cho</label>
                            @Html.DropDownListFor(model => model.ProvinceID, new SelectList(Model.ListProvince, "ID", "Name"), "--- Tỉnh/Thành phố ---", new { @class = "select2", @id = "ApplyForOption-Type-3-3" })
                        </div>
                    </div>
                    <!-- Trị giá đơn hàng từ -->
                    <div class="col-md-3" id="AFO-Type-2" style="display: none">
                        <div class="mb-3 custom-props">
                            <label class="form-label">&nbsp;</label>
                            <input type="text" class="form-control" id="AfoChild-Type-2" onchange="removeErrorMsg()" name="currency-field" data-inputmask="'alias': 'currency'" onkeydown="return NoNegativeNumbers(event)">
                            <span class="props">đ</span>
                        </div>
                    </div>
                    <!-- Nhóm sản phẩm -->
                    <div class="col-md-3" id="AFO-Type-3-1" style="display: none">
                        <div class="mb-3">
                            <label>&nbsp;</label>
                            @Html.DropDownListFor(model => model.ProductGroupID, new SelectList(Model.ListProductGroup, "ID", "Name"), "--- Chọn ---", new { @class = "select2", @id = "AfoChild-Type-3" })
                        </div>
                    </div>
                    <!-- Sản phẩm -->
                    <div class="col-md-3" id="AFO-Type-4-1" style="display: none">
                        <div class="mb-3">
                            <label>&nbsp;</label>
                            <select class="select2 form-control" id="AfoChild-Type-4">
                                <option value="0" disabled selected>Chọn sản phẩm</option>
                                @if (ViewBag.ListProduct != null)
                                {
                                    foreach (var item in ViewBag.ListProduct)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <!-- Nhóm khách hàng -->
                    <div class="col-md-3" id="AFO-Type-5" style="display: none">
                        <div class="mb-3">
                            <label>&nbsp;</label>
                            @Html.DropDownListFor(model => model.CustomerGroupID, new SelectList(Model.ListCustomerGroup, "ID", "Name"), "--- Chọn ---", new { @class = "select2", @id = "AfoChild-Type-5" })
                        </div>
                    </div>
                    <!-- Khách hàng -->
                    <div class="col-md-3" id="AFO-Type-6" style="display: none">
                        <div class="mb-3">
                            <label>&nbsp;</label>
                            @Html.DropDownListFor(model => model.CustomerID, new SelectList(Model.ListCustomer, "ID", "Email"), "--- Chọn ---", new { @class = "select2", @id = "AfoChild-Type-6" })
                        </div>
                    </div>
                    <!-- Biến thể -->
                    <div class="col-md-3" id="AFO-Type-7-1" style="display: none">
                        <div class="mb-3">
                            <label>&nbsp;</label>
                            <select class="select2 form-control" id="AfoChild-Type-7" onchange="reload_dataAC_Type('Type-7')" multiple>
                                @if (ViewBag.ListProductVariant != null)
                                {
                                    foreach (var item in ViewBag.ListProductVariant)
                                    {
                                        <option value="@item.Value" @*onclick="selectedItem('@item.Value','@item.Text')"*@>@item.Text</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-9"></div>
                    <div class="list-group col-md-3" id="data-AC-Type-7" style=" padding-left: calc(var(--bs-gutter-x)/2);"></div>
                </div>
                <!-- Nhóm sản phẩm -->
                <div class="mb-3 row">
                    <div class="col-md-3" id="AFO-Type-3-4" style="display: none">
                        <div class="form-group">
                            <div class="form-check" style="padding-top: 40px">
                                <label class="">
                                    <input type="radio" name="checkScope-Type-3" checked value="Y" id="ScopeOfUse-Type-3">
                                    Một lần trên một đơn hàng
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3" id="AFO-Type-3-5" style="display: none">
                        <div class="form-check" style="padding-top: 40px">
                            <label class="">
                                <input type="radio" name="checkScope-Type-3" value="N">
                                Cho từng mặt hàng trong giỏ hàng
                            </label>
                        </div>
                    </div>
                    <div class="col-md-3" id="AFO-Type-3-2" style="display: none">
