@section scripts{
    <script type="text/javascript">
        $(document).ready(function () {
            CreateDateRangePicker("AllDate", $("#FromDate").val(), $("#ToDate").val());
        })

        function reload_dataAC_Type(TypeName) {
            var selectID = "#AfoChild-" + TypeName;
            var data = $(selectID).val();

            if (data != "") {
                $.post('@Url.Action("PromotionProductVariant", "Promotion", new { })', { list: data, selectID: selectID }, function (htmlString) {
                    $('#data-AC-' + TypeName).html(htmlString);
                })

                //$(selectID).val("");
            }
            else {
                $('#data-AC-' + TypeName).html("");
