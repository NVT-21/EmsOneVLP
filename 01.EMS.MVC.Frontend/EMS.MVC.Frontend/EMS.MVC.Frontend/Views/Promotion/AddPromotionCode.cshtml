                                <option value="2">Tổng giá trị sản phẩm</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3" id="AFO-Type-7-3" style="display: none">
                        <div class="mb-3 custom-props">
                            <label class="form-label">&nbsp;</label>
                            <input type="text" class="form-control" id="AfoCaValue-Type-7" onchange="removeErrorMsg()" name="currency-field" data-inputmask="'alias': 'currency'" onkeydown="return NoNegativeNumbers(event)">
                        </div>
                    </div>
                </div>

                <div class="mb-3 row" id="PTO-Type-4" style="display: none">
                    <div class="col-md-3">
                        <div class="mb-3">
                            <label class="form-label">Áp dụng cho</label>
                            <select class="select2 form-control" id="ApplyForOption-Type-4">
                                <option value="1">Nhóm sản phẩm</option>
                                <option value="2">Sản phẩm</option>
                                <option value="3">Biến thể</option>
                            </select>
                        </div>
                    </div>
                    <!-- Nhóm sản phẩm -->
                    <div class="col-md-3" id="AFO-Type-4-3-1" style="display: block">
                        <div class="mb-3">
                            <label>&nbsp;</label>
                            <select class="select2 form-control" id="AfoChild-Type-3-4">
                                <option value="0" disabled selected>Chọn nhóm sản phẩm</option>
