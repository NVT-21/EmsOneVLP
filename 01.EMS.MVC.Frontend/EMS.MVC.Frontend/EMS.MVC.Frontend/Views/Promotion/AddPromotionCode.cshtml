                                <input type="checkbox" class="form-check-input" id="cbNumberOfUse" checked>
                                <label class="form-check-label" for="cbNumberOfUse">
                                    Giới hạn số lần sử dụng của khuyến
                                    mãi
                                </label>
                            </div>
                        </div>
                        <input type="text" class="form-control NoNegativeNumbers" placeholder="Nhập giới hạn số lần sử dụng" id="NumberOfUse" style="display: block;" data-inputmask="'alias': 'currency'" onchange="RemoveErrorMessage(this)">
