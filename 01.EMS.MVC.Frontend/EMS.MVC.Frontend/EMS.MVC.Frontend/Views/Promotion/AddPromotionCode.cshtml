                            <div class="datepicker-form">
                                <div class="datepicker-form">
                                    <input type="text" class="form-control input-daterange-datepicker" id="AllDate">
                                    <input type="hidden" id="FromDate" value="@DateTime.Now.ToString("dd/MM/yyyy")" />
                                    <input type="hidden" id="ToDate" value="@DateTime.Now.ToString("dd/MM/yyyy")" />
                                </div>
                            </div>
                        </div>
                        <span class="error-message" id="errEndDate"></span>
                        <div class="form-check custom-checkbox ms-1">
                            <input type="checkbox" class="form-check-input" id="CheckEndDate">
                            <label class="form-check-label" for="CheckEndDate">Không bao giờ hết hạn</label>
