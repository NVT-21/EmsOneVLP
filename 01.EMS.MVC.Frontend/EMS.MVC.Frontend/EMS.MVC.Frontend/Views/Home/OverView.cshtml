@foreach (var item in Model)
{
    <div class="card">
        <div class="card-body ">
            <div class="card-data">
                <h5 class="fs-14">@item.StatusName</h5>
                <div class="d-flex">
                    <span class="font-w600 me-1">@item.Quantity đơn - </span>
                    <span class="@if(item.Status == "G") { Write("text-green"); }else if(item.Status == "F") { Write("text-red"); } font-w600">@item.TotalCOD.ToString("N0").Replace(",", ".")đ COD</span>
                </div>
            </div>
        </div>
    </div>
}

