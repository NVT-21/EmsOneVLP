@model EMS.MVC.Frontend.Models.TemporaryTransportServiceFeeViewModel

<div class="col-xl-8 col-lg-8 col-md-8 d-flex justify-content-between">
    <label class="text-muted">Cước chính</label>
    <span>@Model.MainServiceTotalAmount.ToString("N0")đ</span>
</div>
<div class="col-xl-8 col-lg-8 col-md-8 d-flex justify-content-between">
    <label class="text-muted">Cước cộng thêm</label>
    <span>@Model.ExtraServiceTotalAmount.ToString("N0")đ</span>
</div>
<div class="col-xl-8 col-lg-8 col-md-8 d-flex justify-content-between">
    <label class="fw-bold">Tổng cước</label>
    <b>@Model.TotalAmount.ToString("N0")đ</b>
</div>

<span class="text-danger" id="errTemporaryTransportServiceFee">@Model.Message</span>

<script>
    $(document).ready(function () {
        TransportFee = @Model.TotalAmount;
    });
</script>