@model List<EMS.MVC.Frontend.Areas.Zalo.Models.ZAL_SearchListFollowerViewModel>


<table id="SearchListDataTable" class="table table-responsive-md">
    <thead>
        <tr class="table-info text-center">
            <th> STT </th>
            <th> Ảnh đại diện </th>
            <th> Tên </th>
            <th> Số điện thoại </th>
            <th> Giới tính </th>
            <th> Ngày sinh </th>
            <th> Thao tác </th>
        </tr>
    </thead>
    <tbody>
        @{
            var stt = 1;
            foreach (var item in Model)
            {
                <tr>
                    <td class="text-center">@(stt++)</td>
                    <td class="text-center"><img class="img-fluid" src="@item.Avatar" /></td>
                    <td class="text-center">@item.FullName</td>
                    <td class="text-center">@item.MobileNumber</td>
                    <td class="text-center">@item.UserGender</td>
                    <td class="text-center">
                        @if (!string.IsNullOrEmpty(item.BirthDay))
                        {
                            <span>@item.BirthDay.Split(' ')[0]</span>
                        }
                    </td>
                    <td class="text-center"></td>
                </tr>
            }
        }
    </tbody>
</table>

<script>
    $(document).ready(function () {
        MyCreateDataTable("SearchListDataTable");
    });
</script>
