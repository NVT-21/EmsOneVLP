@model EMS.MVC.Frontend.Areas.Zalo.Models.ZAL_LiveChatViewModel
@{
    Layout = "~/Areas/Zalo/Views/Shared/_Layout.cshtml";
}
@Html.HiddenFor(m => m.PageID)
@Html.HiddenFor(m => m.PageName)
@Html.HiddenFor(m => m.PageAvatar)

<div class="d-none" id="Info-@Model.PageID" data-DisplayName="@Model.PageName" data-Avatar="@Model.PageAvatar"></div>
<div class="container-fluid">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 col-lg-4 col-xl-3 border-right p-0">
                        <div class="px-4 d-none d-md-block">
                            <div class="d-flex align-items-center">
                                <div class="flex-grow-1">
                                    <input type="text" class="form-control my-3" placeholder="Search...">
                                </div>
                            </div>
                        </div>
                        <div id="ListConversion" class="CustomScrollBar" style="height: 750px; overflow-y: scroll; overflow-x: hidden; width: 400px;">
                            @{
                                Html.RenderAction("ZAL_SearchListConversionView", "ZAL_LiveChat", new { area = "Zalo" });
                            }
                        </div>
                        <hr class="d-block d-lg-none mt-1 mb-0">
                    </div>
                    <div class="col-md-8 col-lg-8 col-xl-9" id="MessageOfConversion" style="height: 750px; ">

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        $(document).ready(function () {
            $("div.nav-control").click();
            $("#footer").addClass("d-none");
            $(".content-body").css("min-height","");
        });

        var ZaloHubProxy = $.connection.ZaloHub;

        $.connection.hub.url = 'https://social-webhook.somee.com/signalr/hubs';
        //$.connection.hub.url = 'https://localhost:44321/signalr/hubs';
        //$.connection.hub.url = 'https://webhook.emsone.com.vn/signalr/hubs';

        //var ConnectionID = $.connection.hub.id;

        var PageID = $("#PageID").val();

        $.connection.hub.qs = { 'name': PageID };

        $.connection.hub.start()
            .done(function () { console.log('Now connected'); })
            .fail(function () { console.log('Could not Connect!'); });

        //ZaloHubProxy.on("UserSendMessageToPage", (data) => {
        //    console.log(data);
        //});

        ZaloHubProxy.client.UserSendMessageToPage = function (data) {
            var ResponseData = JSON.parse(data);

            switch (ResponseData.event_name) {
                case "user_send_text":
                    LoadConversion(ResponseData.sender.id, ResponseData.message.text, "TEXT").then(function () {
                        var CheckConversionActive = $("#conversion-" + ResponseData.sender.id).hasClass("active");
                        if (CheckConversionActive == true) {
                            LoadMessageOfConversion(ResponseData.message.msg_id, 0, ResponseData.sender.id, ResponseData.message.text, "TEXT", ResponseData.timestamp);
                        }
                    }).catch(function () {
                        console.log("Error LoadConversion");
                    });
                    break;
                case "user_send_sticker":
                    LoadConversion(ResponseData.sender.id, "", "STICKER").then(function () {
                        var CheckConversionActive = $("#conversion-" + ResponseData.sender.id).hasClass("active");
                        if (CheckConversionActive == true) {
                            LoadMessageOfConversion(ResponseData.message.attachments[0].payload.id, 0, ResponseData.sender.id, "", "STICKER", "", ResponseData.message.attachments[0].payload.url);
                        }
                    }).catch(function () {
                        console.log("Error LoadConversion");
                    });
                    break;
                case "user_send_image":
                    LoadConversion(ResponseData.sender.id, "", "IMAGE").then(function () {
                        var CheckConversionActive = $("#conversion-" + ResponseData.sender.id).hasClass("active");
                        if (CheckConversionActive == true) {
                            LoadMessageOfConversion(ResponseData.message.msg_id, 0, ResponseData.sender.id, ResponseData.message.text, "IMAGE", ResponseData.timestamp, ResponseData.message.attachments[0].payload.thumbnail);
                        }
                    }).catch(function () {
                        console.log("Error LoadConversion");
                    });
                    break;
            }
        };

        ZaloHubProxy.client.PageSendMessageToUser = function (data) {
            var ResponseData = JSON.parse(data);
            switch (ResponseData.event_name) {
                case "oa_send_text":
                    LoadConversion(ResponseData.recipient.id, ResponseData.message.text, "TEXT").then(function () {
                        var CheckConversionActive = $("#conversion-" + ResponseData.recipient.id).hasClass("active");
                        if (CheckConversionActive == true) {
                            LoadMessageOfConversion(ResponseData.message.msg_id, 1, ResponseData.sender.id, ResponseData.message.text, "TEXT", ResponseData.timestamp, "");
                        }
                    }).catch(function () {
                        console.log("Error LoadConversion");
                    });
                    break;
            }
        };

        //var srcIconDoubleCheck = "data:image/gif;base64,";

        ZaloHubProxy.client.UserReceivedMessage = function (data) {
            $("#StatusMessage").text("Đã nhận");
        };

        ZaloHubProxy.client.UserSeenMessage = function (data) {
            //$("#StatusMessage").html("<img class='vertical-mid' src='~/Assets/images/icon/icon_double_check.png' width='16' /> Đã xem");
            $("#StatusMessage").text("Đã xem");
        };

        async function LoadConversion(UserID, MessageText, MessageType) {
            var CheckConversionExist = $("#conversion-" + UserID).length;
            if (CheckConversionExist == 1) {
                var CheckConversionIndex = $("#conversion-" + UserID).attr("data-index");
                var CheckConversionActive = $("#conversion-" + UserID).hasClass("active");
                if (CheckConversionIndex == 1) {
                    var NumberOfMessage = parseInt($("#NumberOfMessage-" + UserID).text());

                    if (CheckConversionActive == true) {
                        $("#NumberOfMessage-" + UserID).addClass("d-none");
                        $("#NumberOfMessage-" + UserID).text("0");
                    } else {
                        $("#NumberOfMessage-" + UserID).text(NumberOfMessage + 1);
                        if ($("#NumberOfMessage-" + UserID).hasClass("d-none")) {
                            $("#NumberOfMessage-" + UserID).removeClass("d-none");
                        }
                    }

                    switch (MessageType) {
                        case "STICKER":
                            $("#MessageOfConversion-" + UserID).html('<img src="~/Assets/images/icon/sticker.ico" width="13" height="13" style="opacity: 0.7;" /> [Sticker]');
                            break;
                        case "IMAGE":
                            $("#MessageOfConversion-" + UserID).html('<i class="fas fa-image"></i> [Hình ảnh]');
                            break;
                        default:
                            $("#MessageOfConversion-" + UserID).text(MessageText);
                            break;
                    };
                } else {
                    var NumberOfMessage = parseInt($("#NumberOfMessage-" + UserID).text()) + 1;
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("ZAL_ConversionView", "ZAL_LiveChat", new { area = "Zalo" })',
                        dataType: 'html',
                        async: false,
                        data: {
                            ConversionID: $("#Info-" + UserID).attr("data-ConversionID"),
                            UserID: $("#Info-" + UserID).attr("data-UserID"),
                            SenderID: UserID,
                            DisplayName: $("#Info-" + UserID).attr("data-DisplayName"),
                            Avatar: $("#Info-" + UserID).attr("data-Avatar"),
                            MessageText: MessageText,
                            MessageType: MessageType,
                            NumberOfMessage: NumberOfMessage,
                            UpdatedDate: '@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")',
                            ConversionIndex: 1,
                        },
                        success: function (html) {
                            $("#conversion-" + UserID).remove();
                            $("#ListConversion").prepend(html);
                            if (CheckConversionActive == true) {
                                $("#conversion-" + UserID).addClass("active");
                            }
                        },
                        error: function (xhr, status, error) {
                            var err = eval("(" + xhr.responseText + ")");
                            swal({
                                title: 'Lỗi',
                                text: err.Message,
                                button: {
                                    text: "ĐÓNG",
                                }
                            });
                            return;
                        }
                    });
                }
            } else {
                //Nếu chưa có cuộc hội thoại
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("SearchListConversion", "Handle", new { area = "" })',
                    dataType: 'json',
                    async: false,
                    data: {
                        Channel: "ZA",
                        UserID: UserID,
                    },
                    success: function (res) {
                        if (res.Code == "00") {
                            var ResponseData = JSON.parse(res.Data);
                            $.ajax({
                                type: 'POST',
                                url: '@Url.Action("ZAL_ConversionView", "ZAL_LiveChat", new { area = "Zalo" })',
                                dataType: 'html',
                                async: false,
                                data: {
                                    ConversionID: ResponseData[0].ConversionID,
                                    UserID: ResponseData[0].UserID,
                                    SenderID: UserID,
                                    DisplayName: ResponseData[0].DisplayName,
                                    Avatar: ResponseData[0].Avatar,
                                    MessageText: MessageText,
                                    MessageType: MessageType,
                                    NumberOfMessage: 1,
                                    UpdatedDate: moment().format('DD/MM/YYYY HH:mm:ss'),
                                    ConversionIndex: 1,
                                },
                                success: function (html) {
                                    $("#conversion-" + UserID).remove();
                                    $("#ListConversion").prepend(html);
                                },
                                error: function (xhr, status, error) {
                                    var err = eval("(" + xhr.responseText + ")");
                                    swal({
                                        title: 'Lỗi',
                                        text: err.Message,
                                        button: {
                                            text: "ĐÓNG",
                                        }
                                    });
                                    return;
                                }
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        var err = eval("(" + xhr.responseText + ")");
                        swal({
                            title: 'Lỗi',
                            text: err.Message,
                            button: {
                                text: "ĐÓNG",
                            }
                        });
                        return;
                    }
                });
            }
        }

        function LoadMessageOfConversion(MessageID, FromWhom, UserID, MessageText, MessageType, TimeStamp, Url) {
            if (!TimeStamp) {
                TimeStamp = moment().format('DD/MM/YYYY HH:mm:ss');
            } else {
                TimeStamp = moment(parseInt(TimeStamp)).format('DD/MM/YYYY HH:mm:ss');
            }

            var arr = [{
                FromWhom: FromWhom,
                MessageID: MessageID,
                DisplayName: $("#Info-" + UserID).attr("data-DisplayName"),
                Avatar: $("#Info-" + UserID).attr("data-Avatar"),
                MessageType: MessageType,
                MessageText: MessageText,
                CreatedDate: TimeStamp,
                LinkURL: Url,
                Thumbnail: Url,
                Status: {
                    Code: "N",
                    Name: "Đã gửi"
                }
            }];
            $.ajax({
                type: 'POST',
                url: '@Url.Action("ZAL_MessageOfConversionView", "ZAL_LiveChat", new { area = "Zalo" })',
                dataType: 'html',
                async: false,
                data: {
                    model: arr
                },
                beforeSend: function () {
                    $(".IsStatusMessage").remove();
                },
                success: function (html) {
                    $(html).appendTo("#ContentMessage");
                },
                error: function (xhr, status, error) {
                    var err = eval("(" + xhr.responseText + ")");
                    swal({
                        title: 'Lỗi',
                        text: err.Message,
                        button: {
                            text: "ĐÓNG",
                        }
                    });
                    return;
                }
            });
        }

        //ZaloHubProxy.client.UserSendMessageToPage = function (data) {
        //    var ResponseData = JSON.parse(data);
        //    switch (ResponseData.event_name) {
        //        case "user_send_text":          //Sự kiện người dùng gửi tin nhắn
        //        case "user_send_image":         //Sự kiện người dùng gửi tin nhắn hình ảnh
        //        case "user_send_link":          //Sự kiện người dùng gửi tin nhắn liên kết
        //        case "user_send_sticker":       //Sự kiện người dùng gửi tin nhắn sticker
        //        case "user_send_gif":           //Sự kiện người dùng gửi tin nhắn gif
        //        case "user_send_location":      //Sự kiện người dùng gửi vị trí
        //        case "user_send_audio":         //Sự kiện người dùng gửi tin nhắn voice
        //        case "user_reacted_message":    //Sự kiện người dùng thả biểu tượng cảm xúc lên tin nhắn
        //            break;
        //    }
        //    console.log(JSON.parse(data));
        //};
    </script>
}
