@model EMS.MVC.Frontend.Areas.Zalo.Models.ZAL_SearchListConversionViewModel

<a id="conversion-@Model.UserID" data-Index="@Model.ConversionIndex" onclick="LoadContentConversion(@Model.ConversionID, '@Model.UserID', '@Model.DisplayName', '@Model.Avatar')" class="text-black d-block m-1 p-2 bg-conversion-box">
    <div class="d-none" id="Info-@Model.UserID" data-ConversionID="@Model.ConversionID" data-UserID="@Model.UserID" data-SenderID="@Model.SenderID" data-DisplayName="@Model.DisplayName" data-Avatar="@Model.Avatar"></div>
    <div class="d-flex align-items-start">
        <img src="@Model.Avatar" class="rounded-circle me-1" alt="@Model.DisplayName" width="40" height="40">
        <div class="flex-grow-1 me-3">
            <span>@Model.DisplayName</span>
            <div class="small text-muted mt-1" id="MessageOfConversion-@Model.UserID" style="overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;" @*style="text-overflow: ellipsis; margin-top: 3px; overflow: hidden; white-space: nowrap; width: 80%;"*@>
                @{
                    if (Model.UserID != Model.SenderID)
                    {
                        Model.MessageText = "Bạn: " + Model.MessageText;
                    }

                    switch (Model.MessageType)
                    {
                        case "STICKER":
                            <img src="~/Assets/images/icon/sticker.ico" width="13" height="13" style="opacity: 0.7;" /> Write("[Sticker]");
                            break;
                        case "IMAGE":
                            <i class="fas fa-image"></i> Write("[Hình ảnh]");
                            break;
                        case "GIF":
                            <i class='fa fa-combined-shape'></i> Write("[GIF]");
                            break;
                        case "LINK":
                            <i class='fa fa-link'></i> Write("[Link]");
                            break;
                        case "VIDEO":
                            <i class='fa fa-file-video-o'></i> Write("[Video]");
                            break;
                        case "AUDIO":
                            <i class='fa fa-file-audio-o'></i> Write("[Ghi âm]");
                            break;
                        case "LOCATION":
                            <i class='fa fa-map-marker'></i> Write("[Vị trí]");
                            break;
                        default:
                            Write(Model.MessageText);
                            break;
                    }
                }
            </div>
        </div>
        <div class="m-auto">
            <span class="badge badge-pill badge-danger @{if (Model.NumberOfMessage == 0) { Write("d-none"); } }" id="NumberOfMessage-@Model.UserID">@Model.NumberOfMessage</span>
        </div>
    </div>
</a>
