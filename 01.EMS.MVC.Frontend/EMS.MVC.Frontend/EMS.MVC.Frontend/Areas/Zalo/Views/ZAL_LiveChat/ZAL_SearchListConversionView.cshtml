@model List<EMS.MVC.Frontend.Areas.Zalo.Models.ZAL_SearchListConversionViewModel>
@*@{
        var UpdatedDateSearch = "";
    }*@

@foreach (var item in Model)
{
    Html.RenderAction("ZAL_ConversionView", "ZAL_LiveChat", new { model = item, area = "Zalo" });
}
<script>
    function ConversionBoxActive(UserID) {
        $(".bg-conversion-box").removeClass("active");
        $("#conversion-" + UserID).addClass("active");
    }

    function LoadContentConversion(ConversionID, UserID, DisplayName, Avatar) {
        $.ajax({
            type: 'POST',
            url: '@Url.Action("ZAL_SearchListMessageOfConversionView", "ZAL_LiveChat", new { area = "Zalo" })',
            dataType: 'html',
            loading: true,
            global: false,
            data: {
                ConversionID: ConversionID,
                UserID: UserID,
                DisplayName: DisplayName,
                Avatar: Avatar
            },
            success: function (data) {
                ConversionBoxActive(UserID);
                $("#MessageOfConversion").html(data);
                $("#NumberOfMessage-" + UserID).text("0");
                $("#NumberOfMessage-" + UserID).addClass("d-none");
            },
            error: function (xhr, status, error) {
                var err = eval("(" + xhr.responseText + ")");
                swal({
                    title: 'Lỗi',
                    text: err.Message,
                    button: {
                        text: "ĐÓNG",
                    }
                });
                return;
            }
        });
    }

