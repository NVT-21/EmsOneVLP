<input type="hidden" id="LastTimeMessage-@Model.UserID"/>
<div class="position-relative" style="height: 700px;">
    <div class="chat-messages-zalo p-4 CustomScrollBar" id="ContentMessage" @*style="scroll-behavior: smooth;"*@>
        @{
            Html.RenderAction("ZAL_MessageOfConversionView", "ZAL_LiveChat", new { model = Model.ListMessage, area = "Zalo" });
        }
    </div>
</div>

<div class="flex-grow-0 py-3 px-4 border-top">
    <div class="input-group">
        <input type="text" class="form-control" id="MessageContent" placeholder="Type your message">
        <button class="btn btn-primary" id="btnSend" onclick="btnSend()">Send</button>
    </div>
</div>

<script>
    $(document).ready(function () {
        //$('#ContentMessage').scrollTop($('#ContentMessage')[0].scrollHeight);
        //var objDiv = document.getElementById("ContentMessage");
        //objDiv.scrollTop = objDiv.scrollHeight;
        //clearInterval(IntervalLoadListConversion);
    });

    var input = document.getElementById("MessageContent");
    // Execute a function when the user releases a key on the keyboard
    input.addEventListener("keyup", function (event) {
        // Number 13 is the "Enter" key on the keyboard
        if (event.keyCode === 13) {
            // Cancel the default action, if needed
            event.preventDefault();
            // Trigger the button element with a click
            document.getElementById("btnSend").click();
        }
    });

    $(document).keypress(function (event) {
        var keycode = (event.keyCode ? event.keyCode : event.which);
        if (keycode == '13') {
            document.getElementById("btnSend").click();
        }
    });

    function btnSend() {
        if ($("#MessageContent").val() == "") {
            return;
        }
        $.ajax({
            type: 'POST',
            url: '@Url.Action("ZAL_JSendMessage", "ZAL_LiveChat", new { area = "Zalo" })',
            dataType: 'json',
            data: {
                recipient: {
                    user_id: $("#UserID").val()
                },
                message: {
                    text: $("#MessageContent").val()
                }
            },
            loading: true,
            global: false,
            beforeSend: function () {
                $("#btnSend").attr("disabled", true);
            },
            success: function (res) {
                if (res.Code == "00") {
                    $("#MessageContent").val('');
                    $("#btnSend").attr("disabled", false);
                    $('#ContentMessage').scrollTop($('#ContentMessage')[0].scrollHeight);
                } else if (res.Code == "-216") {
                    $.ajax({
                        url: '@Url.Action("JRedirectZalo", "Channel", new { area = ""})',
                        type: "POST",
                        dataType: 'json',
                        global: false,
                        data: {
                            PageID: '@XHelper.Session.ZaloProfile.PageID'
                        },
                        success: function (res) {
                            if (res.Code == "00") {
                                swal({
                                    title: "Thông báo",
                                    text: "Gửi tin nhắn thất bại, vui lòng thử lại.",
                                    button: {
                                        text: "Đóng"
                                    }
                                }).then(function () {
                                    $("#btnSend").attr("disabled", false);
                                });
                            }
                        }
                    });
                } else {
                    console.log(res);
                }
            },
            error: function (xhr, status, error) {
                var err = eval("(" + xhr.responseText + ")");
                swal({
                    title: 'Lỗi',
                    text: err.Message,
                    button: {
                        text: "ĐÓNG",
                    }
                });
                return;
            }
        });
    }

    var TimeForLoadDetailConversion = "";

    var CreatedDate = '@CreatedDateSearch';

