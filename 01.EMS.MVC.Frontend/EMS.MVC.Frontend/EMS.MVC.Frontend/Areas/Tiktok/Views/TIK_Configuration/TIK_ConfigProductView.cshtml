        var Status = "";
        var TypeUpdate = "";
        switch (Type) {
            case 1:
                Status = $("#btnToggleSyncProduct").attr('aria-pressed') == "true" ? "N" : "Y";
                TypeUpdate = "SYNC_PRODUCT";
                //$("#btnToggleSyncProduct").removeClass("active");
                //$("#btnToggleSyncProduct").removeAttr("aria-pressed");
                //if (Status == "Y") {
                //    $("#btnToggleSyncProduct").addClass("active");
                //    $("#btnToggleSyncProduct").attr("aria-pressed", true);
                //}
                //else {
                //    $("#btnToggleSyncProduct").addClass("focus");
                //    $("#btnToggleSyncProduct").attr("aria-pressed", false);
                //}
                break;
            case 2:
                Status = $("#btnToggleSyncProductPrice").attr('aria-pressed') == "true" ? "N" : "Y";
                TypeUpdate = "SYNC_PRODUCT_PRICE";
                //$("#btnToggleSyncProductPrice").removeClass("active");
                //$("#btnToggleSyncProductPrice").removeAttr("aria-pressed");
                //if (Status == "Y") {
                //    $("#btnToggleSyncProductPrice").addClass("active");
                //    $("#btnToggleSyncProductPrice").attr("aria-pressed", true);
                //}
                //else {
                //    $("#btnToggleSyncProductPrice").addClass("focus");
                //    $("#btnToggleSyncProductPrice").attr("aria-pressed", false);
                //}
                break;
            case 3:
                Status = $("#btnToggleSyncProductStock").attr('aria-pressed') == "true" ? "N" : "Y";
                TypeUpdate = "SYNC_PRODUCT_STOCK";
                //$("#btnToggleSyncProductStock").removeClass("active");
                //$("#btnToggleSyncProductStock").removeAttr("aria-pressed");
                //if (Status == "Y") {
                //    $("#btnToggleSyncProductStock").addClass("active");
                //    $("#btnToggleSyncProductStock").attr("aria-pressed", true);
                //}
                //else {
                //    $("#btnToggleSyncProductStock").addClass("focus");
                //    $("#btnToggleSyncProductStock").attr("aria-pressed", false);
                //}
                break;
            default:
                break;
        }
        fnUpdate(ID, Status, TypeUpdate);
    }
    function fnUpdate(ID, Status, Type) {
        swal({
            text: "Bạn chắc chắn muốn thay đổi trạng thái?",
            html: true,
            buttons: {
                cancel: {
                    text: "Không",
                    value: false,
                    visible: true,
                    className: "btn btn-light",
                    closeModal: true,
                },confirm: {
                    text: "Có",
                    value: true,
                    visible: true,
                    className: "btn btn-primary",
                    closeModal: true
                }
            },
        }).then((value) => {
            if (value) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("TIK_JConfigProductChange", "TIK_Configuration", new { area = "Tiktok" })',
                    dataType: 'json',
                    loading: true,
                    data: {
                        ID: ID,
                        Status: Status,
                        Type: Type
                    },
                    success: function (res) {
                        if (res.Code == "00") {
                            CreateCustomSwal("success", res.Message);
                        }
                        else {
                            CreateCustomSwal("error", res.Message);
                        }
                    }
                });
            } else {
                switch (Type) {
                    case 1:
                        $("#btnToggleSyncProduct").removeClass("active");
                        $("#btnToggleSyncProduct").removeAttr("aria-pressed");
                        if (status == "Y") {
                            $("#btnToggleSyncProduct").addClass("focus");
                            $("#btnToggleSyncProduct").attr("aria-pressed", false);
                        }
                        else {
                            $("#btnToggleSyncProduct").addClass("active");
                            $("#btnToggleSyncProduct").attr("aria-pressed", true);
                        }
                        break;
                    case 2:
                        $("#btnToggleSyncProductPrice").removeClass("active");
                        $("#btnToggleSyncProductPrice").removeAttr("aria-pressed");
                        if (status == "Y") {
                            $("#btnToggleSyncProductPrice").addClass("focus");
                            $("#btnToggleSyncProductPrice").attr("aria-pressed", false);
                        }
                        else {
                            $("#btnToggleSyncProductPrice").addClass("active");
                            $("#btnToggleSyncProductPrice").attr("aria-pressed", true);
                        }
                        break;
                    case 3:
                        $("#btnToggleSyncProductStock").removeClass("active");
                        $("#btnToggleSyncProductStock").removeAttr("aria-pressed");
                        if (status == "Y") {
                            $("#btnToggleSyncProductStock").addClass("focus");
                            $("#btnToggleSyncProductStock").attr("aria-pressed", false);
                        }
                        else {
                            $("#btnToggleSyncProductStock").addClass("active");
                            $("#btnToggleSyncProductStock").attr("aria-pressed", true);
                        }
                        break;
                    default:
                        break;
                }
            }
        });
    }
</script>