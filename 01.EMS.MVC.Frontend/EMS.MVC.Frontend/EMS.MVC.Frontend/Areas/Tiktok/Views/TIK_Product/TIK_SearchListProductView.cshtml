@model List<EMS.MVC.Frontend.Areas.Tiktok.Models.TIK_SearchListProductViewModel>
<table id="SearchListDataTable" class="table table-responsive-md" style="width: 100%; overflow: auto">
    <thead>
        <tr>
            <th class="text-center">
                <div class="form-check custom-checkbox">
                    <input type="checkbox" class="form-check-input" id="SelectAll">
                    <label class="form-check-label" for="checkAll"></label>
                </div>
            </th>
            <th class="text-start">Sản phẩm EMSOne</th>
            <th class="text-start">SKU</th>
            <th class="text-start">Tổng tồn kho</th>
            <th class="text-start">Giá bán lẻ</th>
            <th class="text-start">Ngày cập nhật</th>
            <th class="text-start" style="min-width: 200px">ID SKU sản phẩm Tiktok</th>
            <th class="text-start" style="width: 150px;">Tình trạng</th>
            <th class="text-start" style="max-width: 260px;">Lý do</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.TiktokProductID) && !string.IsNullOrEmpty(item.TiktokSKUID))
                    {
                        <div class="form-check custom-checkbox ">
                            <input type="checkbox" class="form-check-input" id="SelectData" data-ProductID="@item.ProductID" value="@item.SKU">
                            <label class="form-check-label" for="checkbox1"></label>
                        </div>
                    }
                </td>
                <td class="text-start" style="min-width: 220px; white-space: inherit; text-align: left; vertical-align: baseline;">
                    <div class="media">
                        @if (item.Channel == "TIK")
                        {
                            <img class="mt-2" style="width:60px;height:60px;" src="@item.ProductAvatar" alt="image">
                        }
                        else
                        {
                            <img class="mt-2" style="width:60px;height:60px;" src="@XHelper.pathImages@item.ProductAvatar" alt="image">
                        }
                        <div class="media-body p-3">
                            <h6 class="mt-0">
                                @item.ProductCode - @item.ProductName<br />
                                <small class="text-muted text-3">Biến thể: @item.Options</small>
                            </h6>
                        </div>
                    </div>
                </td>
                <td class="text-start text-muted pt-4">
                    @item.SKU
                </td>
                <td class="text-start text-muted pt-4">
                    @item.Quantity.ToString("N0")
                </td>
                <td class="text-start text-muted pt-4">
                    @item.Price.ToString("N0")
                </td>
                <td class="text-start text-muted pt-4">
                    @item.UpdatedDate
                </td>
                <td class="text-start text-muted pt-4">
                    @item.TiktokSKUID
                </td>
                <td class="text-start pt-4" style="width: 150px;">
                    @if (item.TiktokStatusUpdatePrice == "Y")
                    {
                        <span title="Trạng thái cập nhật giá">
