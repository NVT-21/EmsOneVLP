@model EMS.MVC.Frontend.Areas.Tiktok.Models.TIK_ProductViewModel
@{
    Layout = "~/Areas/Tiktok/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid">
    <div class="row">
        <div class="col-lg-12">
            <h4 class="font-w700">Quản lý sản phẩm</h4>
            <div class="card">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-search">
                                <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M18.9842 17.6825L15.8675 14.575C16.8731 13.2939 17.4187 11.7119 17.4167 10.0833C17.4167 8.63294 16.9866 7.21512 16.1808 6.00916C15.375 4.80319 14.2297 3.86326 12.8897 3.30822C11.5497 2.75318 10.0752 2.60795 8.65268 2.89091C7.23015 3.17387 5.92347 3.8723 4.89789 4.89789C3.8723 5.92347 3.17387 7.23015 2.89091 8.65268C2.60795 10.0752 2.75318 11.5497 3.30822 12.8897C3.86326 14.2297 4.80319 15.375 6.00916 16.1808C7.21512 16.9866 8.63294 17.4167 10.0833 17.4167C11.7119 17.4187 13.2939 16.8731 14.575 15.8675L17.6825 18.9842C17.7677 19.0701 17.8691 19.1383 17.9808 19.1848C18.0925 19.2314 18.2123 19.2553 18.3333 19.2553C18.4543 19.2553 18.5742 19.2314 18.6859 19.1848C18.7976 19.1383 18.899 19.0701 18.9842 18.9842C19.0701 18.899 19.1383 18.7976 19.1848 18.6859C19.2314 18.5742 19.2553 18.4543 19.2553 18.3333C19.2553 18.2123 19.2314 18.0925 19.1848 17.9808C19.1383 17.8691 19.0701 17.7677 18.9842 17.6825V17.6825ZM4.58334 10.0833C4.58334 8.99554 4.90591 7.93217 5.51025 7.0277C6.1146 6.12323 6.97358 5.41828 7.97858 5.002C8.98357 4.58572 10.0894 4.4768 11.1563 4.68902C12.2232 4.90124 13.2032 5.42506 13.9724 6.19425C14.7416 6.96344 15.2654 7.94345 15.4777 9.01034C15.6899 10.0772 15.581 11.1831 15.1647 12.1881C14.7484 13.1931 14.0434 14.0521 13.139 14.6564C12.2345 15.2608 11.1711 15.5833 10.0833 15.5833C8.62465 15.5833 7.2257 15.0039 6.19425 13.9724C5.1628 12.941 4.58334 11.542 4.58334 10.0833Z"
                                          fill="#86909C" />
                                </svg>
                                @Html.EditorFor(model => model.SearchKey, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Tìm theo mã sản phẩm, tên sản phẩm, ... " } })
                            </div>
                        </div>
                        <div class="col-md-8 d-flex align-items-end justify-content-end">
                            <div id="ActionProduct">
                                <div class="me-2">
                                    <button type="button" class="btn btn-primary" onclick="btnProductRemoveConnection()">
                                        <i class="ti-unlink"></i>
                                        &nbsp;Bỏ liên kết sản phẩm
                                    </button>
                                </div>
                            </div>
                            <div id="ActionProductProcess">
                                <div class="me-2">
                                    <button type="button" class="btn btn-primary" onclick="btnProductLinkConnection()">
                                        <i class="ti-link"></i>
                                        &nbsp;Liên kết thủ công
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <div class="profile">
                        <!-- Nav tabs -->
                        <div class="custom-tab-1">
                            <ul class="nav nav-tabs" role="tablist">
                                <li class="nav-item" onclick="fnProductviewClick('listProduct')">
                                    <a class="nav-link active" data-bs-toggle="tab" href="#listProduct" id="p_Tab_listProduct">Danh sách sản phẩm</a>
                                </li>
                                <li class="nav-item" onclick="fnProductviewClick('listProductProcess')">
                                    <a class="nav-link" data-bs-toggle="tab" href="#listProductProcess" id="p_Tab_listProductProcess"> Danh sách sản phẩm cần xử lý @*<small class="text-danger text-2 fw-bold">(10)</small>*@</a>
                                </li>
                            </ul>
                        </div>
                        <div class="tab-content">
                            <div class="alert alert-warning alert-dismissible fade show mt-4 mb-4">
                                <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none"
                                     stroke-linecap="round" stroke-linejoin="round" class="me-2">
                                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                                    <line x1="12" y1="9" x2="12" y2="13"></line>
                                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                                </svg>
                                Lưu ý: Thời gian đồng bộ thông tin giá và tồn kho của sản phẩm là 5 phút. Thời gian đồng bộ các thông tin khác của sản phẩm là 12 giờ.
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="btn-close">
                                </button>
                            </div>
                            <div class="tab-pane fade show active" id="listProduct" role="tabpanel">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div id="tab-data" class="table-responsive table-primary">

                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade " id="listProductProcess">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div id="tab-data-process" class="table-responsive table-primary">

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts{
    <script>
        $(document).ajaxStart(function () {
            $('#ajax_loader').show();
        });

        $(document).ajaxStop(function () {
            $('#ajax_loader').hide();
        });

        $(document).ready(function () {
            var arrLastTab = ["listProduct", "listProductProcess"];
            var lastTab = "";
            if (sessionStorage.getItem('lastTabProductView') != null) {
                lastTab = sessionStorage.getItem('lastTabProductView');
            } else {
                lastTab = "listProduct";
            }
            var arrLastTabFilter = arrLastTab.filter((item) => item !== lastTab);
            for (var i = 0; i < arrLastTabFilter.length; i++) {
                $("#" + arrLastTabFilter[i]).removeClass("show");
                $("#" + arrLastTabFilter[i]).removeClass("active");
                $("#p_Tab_" + arrLastTabFilter[i]).removeClass("active");
            }
            $("#" + lastTab).addClass("show");
            $("#" + lastTab).addClass("active");
            $("#p_Tab_" + lastTab).addClass("active");
            if (lastTab) {
                if (lastTab == "listProduct") {
                    $("#ActionProduct").css("display", "block");
                } else if (lastTab == "listProductProcess") {
                    $("#ActionProduct").css("display", "none");
                }
            }
            fnProductviewClick(lastTab);
        });
        $('#SearchKey').on('change', function () {
            var lastTab = sessionStorage.getItem('lastTabProductView');
            if (lastTab == null || lastTab == "") {
                lastTab = "listProduct";
            }
            var req = {
                SearchKey: $("#SearchKey").val().trim()
            };
            $('#tab-data').html("");
            $('#tab-data-process').html("");
            if (lastTab == "listProduct") {
                $.get('@Url.Action("TIK_SearchListProductView", "TIK_Product")', req, function (data) {
                    $('#tab-data').html(data);
                });
            } else {
                $.get('@Url.Action("TIK_SearchListProductProcessView", "TIK_Product")', req, function (data) {
                    $('#tab-data-process').html(data);
                });
            }
        });
        function fnProductviewClick(id) {
            sessionStorage.setItem('lastTabProductView', id);
            var req = {
                SearchKey: $("#SearchKey").val().trim()
            };
            $('#tab-data').html("");
            $('#tab-data-process').html("");
            if (id == "listProduct") {
                $("#ActionProduct").css("display", "block");
                $("#ActionProductProcess").css("display", "none");
                $.get('@Url.Action("TIK_SearchListProductView", "TIK_Product")', req, function (data) {
                    $('#tab-data').html(data);
                });
            } else {
                $("#ActionProduct").css("display", "none");
                $("#ActionProductProcess").css("display", "block");
                $.get('@Url.Action("TIK_SearchListProductProcessView", "TIK_Product")', req, function (data) {
                    $('#tab-data-process').html(data);
                });
            }
        }
    </script>
}