<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="shortcut icon" type="image/png" href="~/favicon.png" />
    <meta name="keywords" content="" />
    <meta name="author" content="" />
    <meta name="robots" content="" />
    <meta name="format-detection" content="telephone=no">
    <title>EMSOne</title>
    @Styles.Render("~/bundles/css")
    @Styles.Render("~/bundles/fonts")
    <script src="~/Assets/js/global.min.js"></script>
    <script src="~/Assets/js/MyJS.js?n=@XHelper.JavaScriptVersion"></script>
</head>
<body>
    <!-- WINDOW LOADER -->
    <div id="preloader">
        <img src="~/Assets/images/logo/logo-full.svg" />
    </div>
    <!-- AJAX LOADER -->
    <div id="ajax_loader" style="background-color: rgba(0, 0, 0, 0.5); z-index: 99999999; position: fixed; left: 0px; top: 0px; width: 100%; height: 100%; display: none;" class="">
        <div id="ajax_loader_contend" style="position: fixed; left: 50%; top: 50%; color:white"><img src="~/Assets/images/default/loading.gif" style="width:30px; height:30px" /></div>
    </div>
    <!-- MODAL -->
    <div id="ViewModal" class="modal fade" role="dialog" aria-labelledby="mySmallModalLabel" aria-hidden="true">
        <div id="modal-ViewModal-html"></div>
    </div>
    <!-- MODAL ZOOM IMAGE -->
    <div id="ImageZoomModal" class="image-zoom-modal">
        <span class="image-zoom-close">&times;</span>
        <div id="ImageZoom">

        </div>
    </div>
    <div id="main-wrapper">
        <div class="nav-header">
            <a href="@Url.Action("Index","Home", new { area = "" })" class="brand-logo">
                <img class="logo-abbr" src="~/Assets/images/logo/logo-abbr.svg" />
                <img class="brand-title" src="~/Assets/images/logo/logo-title.svg" />
            </a>
            <div class="nav-control">
                <div class="hamburger">
                    <span class="line"></span><span class="line"></span><span class="line"></span>
                </div>
            </div>
        </div>
        <div id="header" class="header">
            <div class="header-content">
                <nav class="navbar navbar-expand">
                    <div class="header-left">
                        <div class="nav-item me-4">
                            @{ Html.RenderAction("FAB_SelectPageView", "FAB_Handle"); }
                        </div>
                        <div class="nav-item" style="min-width:250px;">
                            <button class="btn btn-primary" id="btnSyncData">
                                <i class="fa fa-refresh"></i>
                                Đồng bộ dữ liệu
                            </button>
                        </div>
                    </div>
                    <div class="collapse navbar-collapse justify-content-end">
                        <ul class="navbar-nav header-right">
                            <li class="nav-item dropdown header-profile">
                                <a class="nav-link" href="javascript:void(0);" role="button" data-bs-toggle="dropdown">
                                    <img src="~/Assets/images/default/avatar.jpg" width="20" alt="" />
                                    <div class="header-info me-3">
                                        <span class="fs-16 d-flex align-items-center">
                                            @XHelper.Session.EmployeeProfile.FullName
                                            <i class="icon-arrow-b fs-20"></i>
                                        </span>
                                    </div>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end">
                                    <a href="@Url.Action("ShopView","Shop", new { area = "" })" class="dropdown-item ai-icon">
                                        <span class="ms-2">Thông tin tài khoản </span>
                                    </a>
                                    <a href="#" id="ShowChangePasswordView" class="dropdown-item ai-icon">
                                        <span class="ms-2">Đổi mật khẩu </span>
                                    </a>

                                    <a href="@Url.Action("LogOut","Account", new { area = "" })" class="dropdown-item ai-icon">
                                        <span class="ms-2">Đăng xuất </span>
                                    </a>
                                </div>
                            </li>
                            <li class="nav-item"></li>
                        </ul>
                    </div>
                </nav>
            </div>
        </div>
        <div id="sidebar" class="deznav">
            <div class="deznav-scroll">
                <ul class="metismenu" id="menu">
                    @RenderPage("~/Areas/Facebook/Views/Shared/_MenuLeft.cshtml")
                </ul>
            </div>
        </div>

        <div class="content-body">
            @RenderBody()
        </div>
    </div>
    <div id="footer" class="footer">
        <div class="footer-content">
            @RenderPage("~/Views/Shared/_Footer.cshtml")
        </div>
    </div>

    <a href="" target="_blank" class="DZ-bt-support-now DZ-theme-btn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M18.1182 14.702L14 15.5C11.2182 14.1038 9.49995 12.5 8.49995 10L9.26991 5.8699L7.81447 2L4.06355 2C2.936 2 2.04809 2.93178 2.21649 4.04668C2.6369 6.83 3.87648 11.8765 7.49995 15.5C11.3052 19.3052 16.7857 20.9564 19.802 21.6127C20.9667 21.8662 22 20.9575 22 19.7655L21.9999 16.1812L18.1182 14.702Z"
                  fill="white" />
        </svg>

        <span>Hotline: <b>1900 54 54 33</b></span>
    </a>
    @Scripts.Render("~/bundles/js")
    @*<script src="https://localhost:44321/signalr/hubs"></script>*@
    @*<script src="https://webhook.emsone.com.vn/signalr/hubs"></script>*@
    <script src="https://social-webhook.somee.com/signalr/hubs"></script>
    <script>
        $(document).ready(function () {
            $('select.select2').select2(AttributeSelect2);
        });

        $("#ShowChangePasswordView").on("click", function (event) {
            $.get('@Url.Action("ChangePasswordView", "Account", new { area = "" })', function (data) {
                $('#modal-ViewModal-html').html(data);
                $('#ViewModal').modal('show');
            });
        });

        $(".modal").on("hidden.bs.modal", function () {
            $("#ClearModal").html("");
        });

        $(document).ajaxError(function (xhr, props) {
            var message = "";
            switch (props.status) {
                case 1:
                    message = "Dữ liệu không tồn tại.";
                    break;
                case 2:
                    message = "Cửa hàng đã bị xóa. Vui lòng liên hệ quản trị viên.";
                    break;
                case 3:
                    message = "Cửa hàng đã bị khoá. Vui lòng liên hệ quản trị viên.";
                    break;
                case 4:
                    message = "Cửa hàng đã hết thời hạn sử dụng. Vui lòng liên hệ quản trị viên.";
                    break;
                case 5:
                    message = "Nhân viên đã bị xóa. Vui lòng liên hệ quản trị viên.";
                    break;
                case 6:
                    message = "Nhân viên đã bị khóa. Vui lòng liên hệ quản trị viên.";
                    break;
                case 7:
                    message = "Hết thời gian hoạt động. Vui lòng liên hệ quản trị viên.";
                    break;
                case 403:
                    message = "Không có quyền thực hiện chức năng này.";
                    break;
                case 408:
                    message = "Thời gian đăng nhập đã hết, vui lòng đăng nhập lại.";
                    break;
                case 413:
                    message = "Hệ thống hỗ trợ tải tệp tin kích thước tối đa 5 MB.";
                    break;
                default:
                    message = props.statusText;
                    break;
            }
            if (props.status == 403) {
                CreateCustomSwal("error", message);
            } else {
                CreateCustomSwal("success", message, '@Url.Action("LogOut", "Account", new { area = "" })');
            }
        });
        $("#btnSyncData").on('click', function () {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("SyncData", "FAB_Handle")',
                dataType: 'json',
                loading: true,
                data: "",
                success: function (res) {
                    if (res.Code == "00") {
                        //CreateCustomSwal("success", res.Message,'@Url.Action("LiveChat", "Facebook")');
                        window.location.reload();
                    } else {
                        CreateCustomSwal("error", res.Message);
                        return;
                    }
                },
                error: function (xhr, status, error) {
                    var err = eval("(" + xhr.responseText + ")");
                    CreateCustomSwal("error", err.Message);
                    return;
                }
            });
        });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>