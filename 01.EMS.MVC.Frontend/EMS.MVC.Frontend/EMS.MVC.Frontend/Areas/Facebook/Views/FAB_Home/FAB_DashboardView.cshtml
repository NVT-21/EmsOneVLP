@model EMS.MVC.Frontend.Areas.Facebook.Models.FAB_DashboardViewModel
@{
    Layout = "~/Areas/Facebook/Views/Shared/_Layout.cshtml";
}
<style>
    #profile-upper {
        position: relative;
    }

    #profile-d {
        position: absolute;
        left: 59px;
        bottom: 0px;
        right: 0px;
        height: 80px;
        z-index: 2;
    }

    #profile-banner-image {
        max-height: 360px;
        overflow: hidden;
        z-index: 1;
        border-radius: 5px;
    }

        #profile-banner-image img {
            width: 100%;
            /*margin-top: -20%;*/
        }

    #profile-pic {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        margin-top: 28px;
        overflow: hidden;
        box-shadow: 0 0 0 5px #fff;
    }

        #profile-pic img {
            width: 100%;
        }

    #u-name {
        position: absolute;
        top: 90px;
        left: 140px;
        color: black;
        font-size: 24px;
        font-weight: bold;
    }

    #edit-profile {
        position: absolute;
        right: 20px;
        bottom: 21px;
        line-height: 1;
        cursor: pointer;
    }

        #edit-profile i {
            display: block;
            color: rgba(255, 255, 255, 0.8);
            margin-right: 5px;
        }

    #black-grd {
        position: absolute;
        left: 15px;
        bottom: 15px;
        right: 15px;
        height: 300px;
        z-index: 1;
    }

    .faq-container {
        max-width: 100%;
        margin: 0 auto;
        border-radius: 10px;
        background-color: #fff;
        overflow: hidden;
        box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 12px;
    }

    .faq {
        box-sizing: border-box;
        background: transparent;
        padding: 20px;
        position: relative;
        overflow: hidden;
    }

        .faq:not(:first-child) {
            border-top: 1px solid #e6e6e6;
        }

    .faq-title {
        margin: 0 35px 5px 0;
        font-weight: bold;
        font-size: 16px;
    }

    .faq-text {
        margin: 30px 0 0;
        display: none;
        line-height: 1.9rem;
    }

    .faq.active {
        background-color: #f8f8f8;
        box-shadow: inset 4px 0px 0px 0px #f5821f;
    }

        .faq.active .faq-title {
            color: #f5821f;
        }

        .faq.active .faq-text {
            display: block;
        }

    .faq-toggle {
        background-color: transparent;
        border: none;
        color: inherit;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        padding-top: 3px;
        position: absolute;
        top: 30px;
        right: 30px;
        height: 30px;
        width: 30px;
        transition: 0.3s ease;
    }

        .faq-toggle:focus {
            outline: none;
        }

    .faq.active .faq-toggle {
        transform: rotate(180deg);
        background-color: #f5821f;
        border-color: #f5821f;
        color: #fff;
    }

    .faq-viewall {
        background-color: transparent;
        border: none;
        color: inherit;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        padding-top: 3px;
        position: absolute;
        top: 30px;
        right: 80px;
        height: 30px;
        width: 80px;
        transition: 0.3s ease;
    }
    /*@@media only screen and (min-width: 1024px) {
        #profile-banner-image img {
            height: 500px;
        }
    }
    @@media only screen and (max-width: 1024px) {
        #profile-banner-image img {
            height: 300px;
        }
    }
    @@media only screen and (max-width: 600px) {
        #profile-banner-image img {
            height: 200px;
        }
    }*/
</style>
<div class="container-fluid">
    <div class="row rounded-bottom">
        <div id="profile-upper">
            <div id="profile-banner-image">
                @if (string.IsNullOrEmpty(XHelper.Session.FacebookProfile.PageCover))
                {
                    <img class="img-fluid" src="~/Assets/images/default/CoverImage.jpg" alt="Banner image" @*style="max-width: 100%; height: auto; margin: 0 auto;"*@>
                }
                else
                {
                    <img class="img-fluid" src="@XHelper.Session.FacebookProfile.PageCover" alt="Banner image" @*style="max-width: 100%; height: auto; margin: 0 auto;"*@>
                }
            </div>
            <div id="profile-d">
                <div id="profile-pic">
                    <img src="@XHelper.Session.FacebookProfile.PageAvatar">
                </div>
                <div id="u-name">
                    <span class="text-uppercase">@XHelper.Session.FacebookProfile.PageName</span>
                    <br />
                    <small><a href="#" onclick="fnOnclickRedirect('ManagePage','@XHelper.Session.FacebookProfile.PageID')" style="font-size:14px;">Quản lý Trang Facebook</a></small>
                </div>
                <div id="edit-profile"><i id="file-icon" class="material-icons">camera_alt</i></div>
            </div>
            <div id="black-grd"></div>
        </div>
    </div>
    <div class="row" style="margin-top: 130px;">
        <div class="col-12">
            <div class="row">
                <div class="col-3">
                    <button class="btn btn-primary" type="button" style="width: 100%;" onclick="fnOnclickRedirect('CreatePostFeed','@XHelper.Session.FacebookProfile.PageID')">
                        <i class="icon-icon03"></i>
                        &nbsp;Tạo bài viết
                    </button>
                </div>
                <div class="col-3">
                    <div class="mb-3">
                        <button class="btn btn-secondary" type="button" style="width: 100%;" onclick="fnOnclickRedirect('CreateAds','@XHelper.Session.FacebookProfile.PageID')">
                            <i class="icon-icon09"></i>
                            &nbsp;Tạo quảng cáo
                        </button>
                    </div>
                </div>
                <div class="col-3s">
                    <button class="btn btn-upload btn-skype" type="button" id="export-dropdown"
                            data-bs-toggle="dropdown" data-boundary="viewport" aria-haspopup="true" aria-expanded="false">
                        Xem thêm&nbsp;<i class="icon-arrow-b"></i>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end border py-0" aria-labelledby="export-dropdown">
                        <div class="py-2">
                            <a class="dropdown-item" href="javascript:void(0);">Nhật ký hoạt động</a>
                            <a class="dropdown-item" href="javascript:void(0);">Bắt đầu khám phá</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <h4 style="font-weight: bold;">Danh sách việc cần làm</h4>
                    <span>Kiểm tra tin nhắn và bình luận chưa đọc cũng như những điều khác mà bạn có thể cần chú ý.</span>
                </div>
                <div class="col-12 mt-4 mb-5">
                    <div class="faq-container">
                        <div class="faq active">
                            <h3 class="faq-title">
                                Tin nhắn
                            </h3>
                            <div class="faq-text">
                                <div class="mb-0  bg-white table-primary">
                                    <table class="table ">
                                        <thead>
                                            <tr>
                                                <th style="width:10px;"></th>
                                                <th style="width:20px;"></th>
                                                <th></th>
                                                <th></th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.ListConversion.Count > 0)
                                            {
                                                foreach (var itemConversion in Model.ListConversion)
                                                {
                                                    <tr>
                                                        <td><svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" fill="currentColor" style="color:blue;" class="bi bi-dot" viewBox="0 0 16 16"><path d="M8 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z" /></svg></td>
                                                        <td>
                                                            <img class="mr-3 rounded-circle" style="width:30px;height:30px;" src="~/Assets/images/default/img_messenger.png" alt="Image Messenger default">
                                                        </td>
                                                        <td>
                                                            <div class="media mt-2">
                                                                <img class="mr-3 rounded-circle" style="width:40px;height:40px;margin-top: 8px;" src="@itemConversion.Avatar" alt="FacebookProfile">
                                                                <div class="media-body p-3">
                                                                    <h5 class="mt-0 fw-bold">@itemConversion.DisplayName</h5>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td class="fw-bold"><a href="#" onclick="fnOnclickRedirect('LiveChatViewUserID','@itemConversion.UserID')">@itemConversion.MessageText</a></td>
                                                        <td>
                                                            <div class="d-flex justify-content-end">
                                                                @itemConversion.UpdatedDate
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <span>Bạn đã xem hết các thông tin.</span>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="faq-viewall">
                                <small><a href="#" onclick="fnOnclickRedirect('LiveChatView','@XHelper.Session.FacebookProfile.PageID')" style="font-size:14px;">Xem tất cả</a></small>
                            </div>
                            <button class="faq-toggle">
                                <i class="fas fa-angle-down"></i>
                            </button>
                        </div>

                        <div class="faq">
                            <h3 class="faq-title">
                                Bình luận
                            </h3>
                            <div class="faq-text">
                                <div class="mb-0  bg-white table-primary">
                                    <table class="table ">
                                        <thead>
                                            <tr>
                                                <th style="width:10px;"></th>
                                                <th style="width:20px;"></th>
                                                <th></th>
                                                <th></th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.ListFeed.Count > 0)
                                            {
                                                foreach (var itemFeed in Model.ListFeed)
                                                {
                                                    <tr>
                                                        <td><svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" fill="currentColor" style="color:blue;" class="bi bi-dot" viewBox="0 0 16 16"><path d="M8 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3z" /></svg></td>
                                                        <td>
                                                            <img class="mr-3 rounded-circle" style="width:30px;height:30px;margin-top: 8px;" src="~/Assets/images/default/img_facebook.png" alt="Image Messenger default">
                                                        </td>
                                                        <td>
                                                            <div class="media mt-2">
                                                                <img class="mr-3 rounded-circle" style="width:40px;height:40px;" src="@itemFeed.Avatar" alt="FacebookProfile">
                                                                <div class="media-body p-3">
                                                                    <h5 class="mt-0 fw-bold">@itemFeed.CreatedBy</h5>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td class="fw-bold"><a href="#" onclick="fnOnclickRedirect('CommentViewFeedID','@itemFeed.ID')">@itemFeed.Content</a></td>
                                                        <td>
                                                            <div class="d-flex justify-content-end">
                                                                @itemFeed.UpdatedDate
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <span>Bạn đã xem hết các thông tin.</span>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="faq-viewall">
                                <small><a href="#" onclick="fnOnclickRedirect('CommentView','@XHelper.Session.FacebookProfile.PageID')" style="font-size:14px;">Xem tất cả</a></small>
                            </div>
                            <button class="faq-toggle">
                                <i class="fas fa-angle-down"></i>
                            </button>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    const buttons = document.querySelectorAll(".faq-toggle");
    buttons.forEach((button) => {
        button.addEventListener("click", () =>
            button.parentElement.classList.toggle("active")
        );
    });
    function fnOnclickRedirect(UrlType,PageID) {
        switch (UrlType) {
            case "ManagePage":
                window.location.href = 'https://www.facebook.com/profile.php?id=' + PageID;
                break;
            case "CreatePostFeed":
                window.location.href = 'https://business.facebook.com/latest/composer?asset_id=' + PageID + '&nav_ref=page_composer_interruption&ref=biz_web_content_manager_calendar_view&context_ref=CONTENT_CALENDAR';
                break;
            case "CreateAds":
                window.location.href = 'https://www.facebook.com/ad_center/create/ad/?entry_point=www_profile_plus_promote_as_primary_action&page_id=' + PageID;
                break;
            case "LiveChatView":
                window.location.href = '@Url.Action("FAB_LiveChatView", "FAB_LiveChat", new { area = "Facebook" })';
                break;
            case "CommentView":
                window.location.href = '@Url.Action("FAB_CommentView", "FAB_Comment", new { area = "Facebook" })';
                break;
            case "LiveChatViewUserID":
                sessionStorage.setItem('LiveChatViewUserID', PageID);
                window.location.href = '@Url.Action("FAB_LiveChatView", "FAB_LiveChat", new { area = "Facebook" })';
                break;
            case "CommentViewFeedID":
                sessionStorage.setItem('CommentViewFeedID', PageID);
                window.location.href = '@Url.Action("FAB_CommentView", "FAB_Comment", new { area = "Facebook" })';
                break;
            default:
                CreateCustomSwal("error", "Không tồn tại liên kết.");
                break;
        };
    }
</script>