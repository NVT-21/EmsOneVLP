@model List<EMS.MVC.Frontend.Areas.Facebook.Models.FAB_SearchOrderSuccessHistoryOfUserViewModel>

@if (Model.Count > 0)
{
    <table id="ListDataTableOrderHistory" class="table table-responsive-md">
        <thead>
            <tr class="table-info text-center">
                <th> Mã đơn hàng </th>
                <th> Mã bưu gửi </th>
                <th> Trạng thái </th>
                <th> Số tiền (VNĐ)</th>
            </tr>
        </thead>
        <tbody id="context-menu-test">
            @{
                foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center" style="max-width: 150px">
                            <a class="text-primary" style="cursor:pointer;" onclick="btnDetailOrder(@item.ID,@XHelper.Session.EmployeeProfile.ShopInformation.ID)">@item.OrderCode</a>
                        </td>
                        <td class="text-center">@item.ShippingCode</td>
                        <td class="text-center">@item.Status.Name</td>
                        <td class="text-end">@item.TotalProductValue.ToString("N0")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
}
else
{
    <span>Không có lịch sử đơn hàng.</span>
}
<script>
    $(document).ready(function () {
        MyCreateDataTable("ListDataTableOrderHistory");
    });
    function btnDetailOrder(OrderID, ShopID) {
        $.post('@Url.Action("DetailOrderView", "Order", new{ area = "" })', {
            OrderID: OrderID, ShopID: ShopID
        }, function (data) {
            $('#modal-ViewModal-html').html(data);
            $('#ViewModal').modal('show');
        });
    }
</script>
