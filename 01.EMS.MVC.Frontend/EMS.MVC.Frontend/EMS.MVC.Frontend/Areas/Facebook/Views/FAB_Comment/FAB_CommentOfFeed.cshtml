                        $("#DeleteHiddenComment_TagA_" + ChannelCommentID).remove();
                        $(html).appendTo("#HiddenComment_" + ChannelCommentID);
                    } else {
                        var html = `<a href="#" id="DeleteHiddenComment_TagA_` + ChannelCommentID + `" class="small text-muted fw-bold me-2" onclick="HiddenComment('` + ChannelCommentID + `','false')" style="color:grey;"><i class="fa fa-eye-slash" aria-hidden="true"></i>&nbsp;Đang ẩn</a>`;
                        $("#HiddenComment_TagA_" + ChannelCommentID).remove();
                        $(html).appendTo("#HiddenComment_" + ChannelCommentID);
                    }
                    swal({
                        title: "Thông báo",
