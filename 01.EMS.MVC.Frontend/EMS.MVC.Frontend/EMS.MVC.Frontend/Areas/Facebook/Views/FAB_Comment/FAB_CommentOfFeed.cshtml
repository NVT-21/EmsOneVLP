@model EMS.MVC.Frontend.Areas.Facebook.Models.FAB_CommentOfFeedViewModel
<style>
    .btn-light {
        background-color: white;
    }
</style>
<div class="p-2 border-bottom d-none d-lg-block">
    <div class="d-flex align-items-center py-1">
        <div class="position-relative me-2">
            <img src="@Model.Feed.Avatar" class="rounded-circle mr-1" alt="@Model.Feed.CreatedBy" width="52" height="52">
        </div>
        <div class="flex-grow-1 pl-2">
            @if (Model.Feed.FromWhom == 0)
            {
                if (Model.Feed.Content.Length > 0)
                {
                    if (Model.Feed.Content.Length > 80)
                    {
                        <strong>@Model.Feed.Content.Substring(0, 80) ... </strong>
                    }
                    else
                    {
                        <strong>@Model.Feed.Content</strong>
                    }
                }
                else
                {
                    <strong>@Model.Feed.Content</strong>
                }
            }
            else
            {
                <strong>@Model.Feed.CreatedBy</strong>
            }
            <div class="text-muted small">
                @Model.Feed.NumberOfComment bình luận - @Model.Feed.Day Tháng @Model.Feed.Month
            </div>
        </div>
        @if (Model.Feed.FromWhom == 0)
        {
            <div style="float:right;">
                <button class="btn btn-sm btn-light form-control text-gray border-0" style="color: red; border: none;" onclick="DeleteFeed('@Model.Feed.ChannelFeedID')">
                    <i class="fa fa-trash mr-2" aria-hidden="true"></i>
                    Xoá bài đăng
                </button>
            </div>
        }
    </div>
</div>
<div class="position-relative">
    <div class="chat-comment-facebook CustomScrollBar" id="ContentComment">
        <div class="row p-0 m-0">
            <div class="offset-3 col-md-6 mt-2" style="min-height: fit-content; background-color: white; border-radius: 14px;">
                <div class="m-3">
                    <div class="row mb-2">
                        <div class="d-flex align-items-center py-1">
                            <div class="position-relative">
                                <img src="@Model.Feed.Avatar" class="rounded-circle mr-1 me-3" alt="@Model.Feed.CreatedBy" width="52" height="52">
                            </div>
                            <div class="flex-grow-1 pl-2">
                                @if (Model.Feed.CreatedBy != XHelper.Session.FacebookProfile.PageName)
                                {
                                    <strong>
                                        @Model.Feed.CreatedBy <i class="fa fa-arrow-right" aria-hidden="true"></i> @XHelper.Session.FacebookProfile.PageName
                                    </strong>
                                }
                                else
                                {
                                    <strong>@Model.Feed.CreatedBy</strong>
                                }
                                <div class="text-muted small">
                                    @Model.Feed.Day Tháng @Model.Feed.Month
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row mb-2 ms-2">
                        @Model.Feed.Content
                    </div>
                    <img src="@Model.Feed.FullPicture" class="rounded img-fluid mt-2 mb-2">
                    <div class="row mb-2">
                        <div class="d-flex flex-row-reverse bd-highlight">
                            <div class="text-muted">
                                <span><a href="#" class="text-gray fw-bold" onclick="DisplayOrHiddenComment()" id="NumberOfComment">@Model.Feed.NumberOfComment bình luận</a></span>
                            </div>
                        </div>
                    </div>
                </div>
                <hr style="width: 100%;margin-bottom: 5px;" />
                <div class="row">
                    <div class="col-md-4">
                        <button class="btn btn-sm btn-light form-control" style="color: gray; border: none;">
                            <i class="fa fa-thumbs-o-up mr-2" aria-hidden="true"></i>
                            Thích
                        </button>
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-sm btn-light form-control text-gray border-0" style="color: gray; border: none;">
                            <i class="fa fa-comment-o mr-2" aria-hidden="true"></i>
                            Bình luận
                        </button>
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-sm btn-light form-control text-gray border-0" style="color: gray; border: none;">
                            <i class="fa fa-share mr-2" aria-hidden="true"></i>
                            Chia sẽ
                        </button>
                    </div>
                </div>
                <hr style="width: 100%; margin-top: 5px;" />
                <div class="m-3">
                    <div class="row">
                        <div class="col-xl-1 col-lg-1 col-md-1 p-0 m-0" style="margin-left:10px;">
                            <img src="@XHelper.Session.FacebookProfile.PageAvatar" class="rounded-circle" width="42" height="42">
                        </div>
                        <div class="col-xl-11 col-lg-11 col-md-11 pl-0" style="margin-left:0px;">
                            <input type="text" class="form-control form-control-sm" placeholder="Nhập nội dung bình luận" id="txtComment" onkeydown="SendComment('@Model.Feed.ChannelFeedID')" style="border-radius: 20px; background-color: rgb(240,242,245); border: none;" />
                        </div>
                    </div>
                </div>
                <div class="m-3" id="ShowListComment">
                    @if (Model.Comment != null)
                    {
                        foreach (var ItemCommentLevel0 in Model.Comment.OrderBy(m => m.CreatedDate))
                        {
                            <div class="row" id="row_@ItemCommentLevel0.ChannelCommentID">
                                <div class="col-xl-1 col-lg-1 col-md-1 p-0 m-0">
                                    <img src="@ItemCommentLevel0.Avatar" class="rounded-circle" width="42" height="42">
                                </div>
                                <div class="col-xl-11 col-lg-11 col-md-11">
                                    <div class="row mb-2">
                                        <div class="col-xl-12 col-lg-12 col-md-12 pl-0">
                                            <div class="p-2" style="border-radius: 20px; background-color: rgb(240,242,245); width: fit-content;">
                                                @if (ItemCommentLevel0.CreatedBy == Model.Feed.CreatedBy)
                                                {
                                                    <span class="text-small text-muted">
                                                        <i class="fa fa-user me-1" aria-hidden="true"></i>Tác giả
                                                    </span>
                                                    <br />
                                                }
                                                <span class="fw-bold">@ItemCommentLevel0.CreatedBy</span>
                                                <br />
                                                <span>@ItemCommentLevel0.Content</span>
                                            </div>
                                        </div>
                                        <div class="col-xl-12 col-lg-12 col-md-12 pl-0">
                                            @if (ItemCommentLevel0.IsLike == "Y")
                                            {
                                                <span id="LikeComment_@ItemCommentLevel0.ChannelCommentID">
                                                    <a href="#" id="DeleteLikeComment_TagA_@ItemCommentLevel0.ChannelCommentID" class="small text-secondary fw-bold me-2" onclick="DeleteLikeComment('@ItemCommentLevel0.ChannelCommentID')"><i class="fa fa-thumbs-up" aria-hidden="true"></i>&nbsp;Thích</a>
                                                </span>
                                            }
                                            else
                                            {
                                                <span id="LikeComment_@ItemCommentLevel0.ChannelCommentID">
                                                    <a href="#" id="LikeComment_TagA_@ItemCommentLevel0.ChannelCommentID" class="small text-muted fw-bold me-2" onclick="LikeComment('@ItemCommentLevel0.ChannelCommentID')"><i class="fa fa-thumbs-up" aria-hidden="true"></i>&nbsp;Thích</a>
                                                </span>
                                            }
                                            @if (ItemCommentLevel0.IsHidden == "Y")
                                            {
                                                <span id="HiddenComment_@ItemCommentLevel0.ChannelCommentID">
                                                    <a href="#" id="DeleteHiddenComment_TagA_@ItemCommentLevel0.ChannelCommentID" class="small text-muted fw-bold me-2" onclick="HiddenComment('@ItemCommentLevel0.ChannelCommentID','false')" style="color:grey;"><i class="fa fa-eye-slash" aria-hidden="true"></i>&nbsp;Đang ẩn</a>
                                                </span>
                                            }
                                            else
                                            {
                                                <span id="HiddenComment_@ItemCommentLevel0.ChannelCommentID">
                                                    <a href="#" id="HiddenComment_TagA_@ItemCommentLevel0.ChannelCommentID" onclick="HiddenComment('@ItemCommentLevel0.ChannelCommentID','true')" class="small text-secondary fw-bold me-2"><i class="fa fa-eye" aria-hidden="true"></i>&nbsp;Hiện</a>
                                                </span>
                                            }
                                            @if (ItemCommentLevel0.CreatedBy == Model.Feed.CreatedBy)
                                            {
                                                <a href="#" class="small text-muted fw-bold me-2" onclick="DeleteComment('@ItemCommentLevel0.ChannelCommentID')">Xóa</a>
                                            }
                                            <a href="#" onclick="DisplayReplyComment('@ItemCommentLevel0.ChannelCommentID')" style="cursor: pointer;" class="small text-muted fw-bold me-2">Phản hồi</a>
                                            <span class="small text-muted fw-bold" title="@ItemCommentLevel0.CreatedDate">@ItemCommentLevel0.FormatCreatedDate</span>
                                        </div>
                                    </div>
                                    @if (ItemCommentLevel0.ListReplyComment.Count > 0)
                                    {
                                        foreach (var ItemCommentLevel1 in ItemCommentLevel0.ListReplyComment.OrderBy(m => m.CreatedDate))
                                        {
                                            <div class="row" id="row_@ItemCommentLevel1.ChannelCommentID">
                                                <div class="col-xl-1 col-lg-1 col-md-1 p-0 m-0">
                                                    <img src="@ItemCommentLevel1.Avatar" class="rounded-circle" width="42" height="42">
                                                </div>
                                                <div class="col-xl-11 col-lg-11 col-md-11 pl-0">
                                                    <div class="row">
                                                        <div class="col-xl-12 col-lg-12 col-md-12">
                                                            <div class="p-2" style="border-radius: 20px; background-color: rgb(240,242,245); width: fit-content;">
                                                                @if (ItemCommentLevel1.CreatedBy == Model.Feed.CreatedBy)
                                                                {
                                                                    <span class="text-small text-muted">
                                                                        <i class="fa fa-user mr-1" aria-hidden="true"></i>Tác giả
                                                                    </span>
                                                                    <br />
                                                                }
                                                                <span class="fw-bold">@ItemCommentLevel1.CreatedBy</span>
                                                                <br />
                                                                <span>@ItemCommentLevel1.Content</span>
                                                            </div>
                                                        </div>
                                                        <div class="col-xl-12 col-lg-12 col-md-12">
                                                            @if (ItemCommentLevel1.IsLike == "Y")
                                                            {
                                                                <span id="LikeComment_@ItemCommentLevel1.ChannelCommentID">
                                                                    <a href="#" id="DeleteLikeComment_TagA_@ItemCommentLevel1.ChannelCommentID" class="small text-secondary fw-bold me-2" onclick="DeleteLikeComment('@ItemCommentLevel1.ChannelCommentID')"><i class="fa fa-thumbs-up" aria-hidden="true"></i>&nbsp;Thích</a>
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span id="LikeComment_@ItemCommentLevel1.ChannelCommentID">
                                                                    <a href="#" id="LikeComment_TagA_@ItemCommentLevel1.ChannelCommentID" class="small text-muted fw-bold me-2" onclick="LikeComment('@ItemCommentLevel1.ChannelCommentID')"><i class="fa fa-thumbs-up" aria-hidden="true"></i>&nbsp;Thích</a>
                                                                </span>
                                                            }
                                                            @*<a href="#" class="small text-muted fw-bold me-2">Thích</a>*@
                                                            @if (ItemCommentLevel1.CreatedBy == Model.Feed.CreatedBy)
                                                            {
                                                                <a href="#" class="small text-muted fw-bold me-2" onclick="DeleteComment('@ItemCommentLevel1.ChannelCommentID')">Xóa</a>
                                                            }
                                                            <span class="small text-muted fw-bold">@ItemCommentLevel1.FormatCreatedDate</span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        <div class="row mb-2 d-none" id="ReplyComment-@ItemCommentLevel0.ChannelCommentID">
                                            <div class="col-xl-1 col-lg-1 col-md-1 p-0 m-0">
                                                <img src="@XHelper.Session.FacebookProfile.PageAvatar" class="rounded-circle" width="42" height="42">
                                            </div>
                                            <div class="col-xl-11 col-lg-11 col-md-11 pl-0">
                                                <input type="text" class="form-control form-control-sm" placeholder="Nhập nội dung bình luận" id="txtReplyComment-@ItemCommentLevel0.ChannelCommentID" onkeydown="SendReplyComment('@ItemCommentLevel0.ChannelCommentID')" style="border-radius: 20px; background-color: rgb(240,242,245); border: none;" />
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="row mb-2 d-none" id="ReplyComment-@ItemCommentLevel0.ChannelCommentID">
                                            <div class="col-xl-1 col-lg-1 col-md-1 p-0 m-0">
                                                <img src="@XHelper.Session.FacebookProfile.PageAvatar" class="rounded-circle" width="42" height="42">
                                            </div>
                                            <div class="col-xl-11 col-lg-11 col-md-11 pl-0">
                                                <input type="text" class="form-control form-control-sm" placeholder="Nhập nội dung bình luận" id="txtReplyComment-@ItemCommentLevel0.ChannelCommentID" onkeydown="SendReplyComment('@ItemCommentLevel0.ChannelCommentID')" style="border-radius: 20px; background-color: rgb(240,242,245); border: none;" />
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<div>
    <p>&nbsp;</p>
</div>
<script>
    $(document).ajaxStart(function () {
        $('#ajax_loader').show();
    });

    $(document).ajaxStop(function () {
        $('#ajax_loader').hide();
    });

    function DisplayOrHiddenComment() {
        if ($("#ShowListComment").hasClass("d-none") == false) {
            $("#ShowListComment").addClass("d-none");
            $("#ShowListComment").removeClass("d-block");
        } else {
            $("#ShowListComment").removeClass("d-none");
            $("#ShowListComment").addClass("d-block");
        }
    }

    function DisplayReplyComment(ChannelCommentID) {
        $("#ReplyComment-" + ChannelCommentID).removeClass("d-none");
    }

    function SendComment(ChannelFeedID) {
        if (event.key === 'Enter') {
            var data = {
                ChannelFeedID: ChannelFeedID,
                Message: $("#txtComment").val().trim()
            }
            $.ajax({
                type: 'POST',
                url: '@Url.Action("FAB_SendComment", "FAB_Comment", new { area = "Facebook" })',
                dataType: 'json',
                loading: true,
                global: false,
                data: data,
                beforeSend: function () {
                    $("#txtComment").attr("disabled", true);
                },
                success: function (res) {
                    if (res.Code == "00") {
                    var response = JSON.parse(res.Data);
                    //console.log("success");
                    var html = `<div class="row">
                            <div class="col-xl-1 col-lg-1 col-md-1 p-0 m-0" >
                                <img src="@XHelper.Session.FacebookProfile.PageAvatar" class="rounded-circle" width="42" height="42">
                            </div>
                            <div class="col-xl-11 col-lg-11 col-md-11">
                            <div class="row mb-2">
                                <div class="col-xl-12 col-lg-12 col-md-12 pl-0">
                                    <div class="p-2" style="border-radius: 20px; background-color: rgb(240,242,245); width: fit-content;">
                                        <i class="fa fa-user mr-1" aria-hidden="true"></i>Tác giả
                            <br/>
                            <span class="fw-bold">@XHelper.Session.FacebookProfile.PageName</span>
                                <br>
                                    <span>`+ data.Message + `</span>
                                </div>
                            </div>
                            <div class="col-xl-12 col-lg-12 col-md-12 pl-0">
                                <a href="#" class="small text-muted fw-bold mr-2">Thích</a>
                                <a href="#" onclick="DisplayReplyComment('` + response.id +`')" style="cursor: pointer;" class="small text-muted fw-bold mr-2">Phản hồi</a>
                                <span class="small text-muted fw-bold" title="Vừa xong">Vừa xong</span>
                            </div>
                            </div>
                            <div class="row mb-2 d-none" id="ReplyComment-` + response.id +`">
                            <div class="col-xl-1 col-lg-1 col-md-1 p-0 m-0">
                                <img src="@XHelper.Session.FacebookProfile.PageAvatar" class="rounded-circle" width="42" height="42">
                                        </div>
                                <div class="col-xl-11 col-lg-11 col-md-11 pl-0">
                                    <input type="text" class="form-control form-control-sm" placeholder="Nhập nội dung bình luận" id="txtReplyComment-` + response.id + `" onkeydown="SendReplyComment('` + response.id +`')" style="border-radius: 20px; background-color: rgb(240,242,245); border: none;">
                                        </div>
                                </div>
                            </div>
                        </div>`;
                    $(html).appendTo("#ShowListComment");
                    const text = document.getElementById("NumberOfComment").innerText;
                    const arr = text.split(" ");
                    $("#NumberOfComment").html("");
                    $("#NumberOfComment").append((parseInt(arr[0]) + 1) + " bình luận");
                    $("#txtComment").val('');
                    $("#txtComment").attr("disabled", false);
                    } else {
                        console.log("error");
                    }
                },
                error: function (xhr, status, error) {
                    var err = eval("(" + xhr.responseText + ")");
                    swal({
                        title: 'Lỗi',
                        text: err.Message,
                        button: {
                            text: "ĐÓNG",
                        }
                    });
                    return;
                }
            });
        }
    }

    function SendReplyComment(ChannelCommentID) {
        if (event.key === 'Enter') {
            var data = {
                ChannelCommentID: ChannelCommentID,
                Message: $("#txtReplyComment-" + ChannelCommentID).val().trim()
            }
            var html =
                `<div class="row">
                    <div class="col-xl-1 col-lg-1 col-md-1 p-0 m-0" >
                        <img src="@XHelper.Session.FacebookProfile.PageAvatar" class="rounded-circle" width="42" height="42">
                    </div>
                    <div class="col-xl-11 col-lg-11 col-md-11 pl-0">
                        <div class="row">
                            <div class="col-xl-12 col-lg-12 col-md-12">
                                <div class="p-2" style="border-radius: 20px; background-color: rgb(240,242,245); width: fit-content;">
                                <span class="small text-muted">
                                    <i class="fa fa-user mr-1" aria-hidden="true"></i>Tác giả
                                </span>
                                <br />
                                <span class="fw-bold">@XHelper.Session.FacebookProfile.PageName</span>
                                <br>
                                <span>`+ data.Message + `</span>
                            </div>
                        </div>
                        <div class="col-xl-12 col-lg-12 col-md-12">
                            <a href="#" class="small text-muted fw-bold mr-2">Thích</a>
                            <span class="small text-muted fw-bold" title="Vừa xong">Vừa xong</span>
                        </div>
                    </div>
                </div>
            </div>`;
            $.ajax({
                type: 'POST',
                url: '@Url.Action("FAB_SendReplyComment", "FAB_Comment", new { area = "Facebook" })',
                dataType: 'json',
                loading: true,
                global: false,
                data: data,
                beforeSend: function () {
                    $("#txtReplyComment-" + ChannelCommentID).attr("disabled", true);
                },
                success: function (res) {
                    if (res.Code == "00") {
                        //console.log("success");
                        $("#ReplyComment-" + ChannelCommentID).before(html);
                        const text = document.getElementById("NumberOfComment").innerText;
                        const arr = text.split(" ");
                        $("#NumberOfComment").html("");
                        $("#NumberOfComment").append((parseInt(arr[0]) + 1) + " bình luận");
                        $("#txtReplyComment-" + ChannelCommentID).val('');
                        $("#txtReplyComment-" + ChannelCommentID).attr("disabled", false);
                    } else {
                        console.log("error");
                    }
                },
                error: function (xhr, status, error) {
                    var err = eval("(" + xhr.responseText + ")");
                    swal({
                        title: 'Lỗi',
                        text: err.Message,
                        button: {
                            text: "ĐÓNG",
                        }
                    });
                    return;
                }
            });
        }
    }

    function DeleteComment(ChannelCommentID) {
        var data = {
            ChannelCommentID: ChannelCommentID
        }
        $.ajax({
            type: 'POST',
            url: '@Url.Action("FAB_DeleteComment", "FAB_Comment", new { area = "Facebook" })',
            dataType: 'json',
            loading: true,
            global: false,
            data: data,
            success: function (res) {
                if (res.Code == "00") {
                    //console.log("success");
                    $("#row_" + ChannelCommentID).remove();
                    swal({
                        title: "Thông báo",
                        text: res.Message,
                        button: false,
                        timer: 1500
                    });
                } else {
                    console.log("error");
                }
            },
            error: function (xhr, status, error) {
                var err = eval("(" + xhr.responseText + ")");
                swal({
                    title: 'Lỗi',
                    text: err.Message,
                    button: {
                        text: "ĐÓNG",
                    }
                });
                return;
            }
        });
    }

    function DeleteFeed(ChannelFeedID) {
        var data = {
            FeedID: ChannelFeedID
        }
        $.ajax({
            type: 'POST',
            url: '@Url.Action("FAB_DeleteFeed", "FAB_Comment", new { area = "Facebook" })',
            dataType: 'json',
            loading: true,
            global: false,
            data: data,
            success: function (res) {
                if (res.Code == "00") {
                    //console.log("success");
                    //window.location.reload();
                    window.location.href = '@Url.Action("FAB_CommentView", "FAB_Comment", new { area = "Facebook" })';
                } else {
                    console.log("error");
                }
            },
            error: function (xhr, status, error) {
                var err = eval("(" + xhr.responseText + ")");
                swal({
                    title: 'Lỗi',
                    text: err.Message,
                    button: {
                        text: "ĐÓNG",
                    }
                });
                return;
            }
        });
    }

    function DeleteLikeComment(ChannelCommentID) {
        var data = {
            ChannelCommentID: ChannelCommentID
        }
        $.ajax({
            type: 'POST',
            url: '@Url.Action("FAB_DeleteLikeComment", "FAB_Comment", new { area = "Facebook" })',
            dataType: 'json',
            loading: true,
            global: false,
            data: data,
            success: function (res) {
                if (res.Code == "00") {
                    var html = `<a href="#" id="LikeComment_TagA_` + ChannelCommentID + `" class="small text-muted fw-bold me-2" onclick="LikeComment('` + ChannelCommentID + `')"><i class="fa fa-thumbs-up" aria-hidden="true"></i>&nbsp;Thích</a>`;
                    $("#DeleteLikeComment_TagA_" + ChannelCommentID).remove();
                    $(html).appendTo("#LikeComment_" + ChannelCommentID);
                    swal({
                        title: "Thông báo",
                        text: res.Message,
                        button: false,
                        timer: 1500
                    });
                } else {
                    console.log("error");
                }
            },
            error: function (xhr, status, error) {
                var err = eval("(" + xhr.responseText + ")");
                swal({
                    title: 'Lỗi',
                    text: err.Message,
                    button: {
                        text: "ĐÓNG",
                    }
                });
                return;
            }
        });
    }
    function LikeComment(ChannelCommentID) {
        var data = {
            ChannelCommentID: ChannelCommentID
        }
        $.ajax({
            type: 'POST',
            url: '@Url.Action("FAB_LikeComment", "FAB_Comment", new { area = "Facebook" })',
            dataType: 'json',
            loading: true,
            global: false,
            data: data,
            success: function (res) {
                if (res.Code == "00") {
                    var html = `<a href="#" id="DeleteLikeComment_TagA_` + ChannelCommentID + `" class="small text-secondary fw-bold me-2" onclick="DeleteLikeComment('` + ChannelCommentID + `')"><i class="fa fa-thumbs-up" aria-hidden="true"></i>&nbsp;Thích</a>`;
                    $("#LikeComment_TagA_" + ChannelCommentID).remove();
                    $(html).appendTo("#LikeComment_" + ChannelCommentID);
                    swal({
                        title: "Thông báo",
                        text: res.Message,
                        button: false,
                        timer: 1500
                    });
                } else {
                    console.log("error");
                }
            },
            error: function (xhr, status, error) {
                var err = eval("(" + xhr.responseText + ")");
                swal({
                    title: 'Lỗi',
                    text: err.Message,
                    button: {
                        text: "ĐÓNG",
                    }
                });
                return;
            }
        });
    }

    function HiddenComment(ChannelCommentID, Type) {
        var data = {
            ChannelCommentID: ChannelCommentID,
            Type: Type
        }
        $.ajax({
            type: 'POST',
            url: '@Url.Action("FAB_HiddentComment", "FAB_Comment", new { area = "Facebook" })',
            dataType: 'json',
            loading: true,
            global: false,
            data: data,
            success: function (res) {
                if (res.Code == "00") {
