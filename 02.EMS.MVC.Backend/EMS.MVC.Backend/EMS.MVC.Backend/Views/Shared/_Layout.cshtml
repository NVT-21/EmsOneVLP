        const intervalLoadRequestSupport = setInterval(LoadRequestSupport, 300000);

        function LoadRequestSupport() {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("NotifyList", "Handle")',
                data: {
                    MaxRequestSupportID: MaxRequestSupportID
                },
                dataType: 'json',
                loading: true,
                global: false,
                success: function (res) {
                    if (res.Code == "00") {
                        var data = JSON.parse(res.Data);
                        if (data.MaxRequestSupportID > MaxRequestSupportID) {
                            if (data.CountRequestSupport > 0) {
                                $.each(data.ListRequestSupportNotify, function (index, value) {
                                    $.toast({
                                        heading: 'Thông báo',
                                        text: '<div class="text-left">Bạn có yêu cầu hỗ trợ ' + value.RequestSupportCode + ' của bưu gửi ' + value.EShippingCode + ' cần được xử lý. Vui lòng xử lý <a style="cursor: pointer;" data-RequestSupportID="' + value.ID + '" data-ShopID="' + value.ShopID + '" data-RequestSupportCode="' + value.RequestSupportCode + '" onclick="UpdateClickNotify(this)">tại đây</a></div>',
                                        showHideTransition: 'slide',
                                        stack: 3, // hien toi thieu la 3 thong bao
                                        allowToastClose: true, // cho phep tat thong bao
                                        position: 'bottom-right',
                                        bgColor: '#0072BC',
                                        textColor: 'white',
                                        textAlign: 'center',
                                        hideAfter: 10000 // thoi gian ton tai 10s
                                    })
                                });
                                var NotifyCountTemp = parseInt(data.CountRequestSupport) + parseInt($("#NotifyCount").text().split('+')[0]) /*parseInt($("#CountRequestSupport").val())*/;
                                if (NotifyCountTemp >= 100) {
                                    $("#NotifyCount").text("99+");
                                    $("#NotifyCount").css("display", "block");
                                } else {
                                    $("#NotifyCount").text(NotifyCountTemp);
                                    $("#NotifyCount").css("display", "block");
                                }
                            }
                            MaxRequestSupportID = data.MaxRequestSupportID;
                        }
                    } else {
                        if (res.Code == "99") {
                            clearInterval(intervalLoadRequestSupport);
                        }
                    }
                },
                error: function () {
                    clearInterval(intervalLoadRequestSupport);
                },
            });
        };

