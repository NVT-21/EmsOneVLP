        $("#notificationDropdown").on("click", function () {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("NotifyListView", "Handle", new { IsLoad = "Y"})',
                dataType: 'html',
                loading: true,
                global: false,
                success: function (data) {
