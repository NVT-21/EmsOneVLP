        $('#btnPassword').on('click', function () {
            $.get('@Url.Action("ChangePasswordView", "User")', function (data) {
                $('#modal-common-container').html(data);
                $('#modal-common').modal('show');
            });
        });

        $(document).ajaxStart(function () {
            $('#ajax_loader').show();
        });

        $(document).ajaxStop(function () {
            $('#ajax_loader').hide();
        });

        $(document).ajaxError(function (xhr, props) {
            var message = "";
            switch (props.status) {
                case 1:
                    message = "Cửa hàng đã bị khoá. Vui lòng liên hệ quản trị viên.";
                    break;
                case 2:
                    message = "Tài khoản không tồn tại. Vui lòng liên hệ quản trị viên.";
                    break;
                case 3:
                    message = "Tài khoản đã bị khoá. Vui lòng liên hệ quản trị viên.";
                    break;
                case 4:
                    message = "Chi nhánh đã bị khoá. Vui lòng liên hệ quản trị viên.";
                    break;
                case 5:
                    message = "Hết thời gian hoạt động. Vui lòng liên hệ quản trị viên.";
                    break;
                case 6:
                    message = "Cửa hàng đã hết thời hạn sử dụng. Vui lòng liên hệ quản trị viên.";
                    break;
                case 7:
                    message = "Tải danh sách menu thất bại. Vui lòng kiểm tra lại nhóm quyền.";
                    break;
                case 401:
                    message = "Thời gian đăng nhập đã hết, vui lòng đăng nhập lại.";
                    break;
                case 413:
                    message = "Hệ thống hỗ trợ tải tệp tin kích thước tối đa 5 MB.";
                    break;
                default:
                    message = "Vui lòng đăng nhập lại";
                    break;
            }
            swal({
                title: "Thông báo",
                text: message,
                button: {
                    text: "Đóng"
                }
            }).then(function () {
                window.location.href = '@Url.Action("Logout","Login")';
            });
