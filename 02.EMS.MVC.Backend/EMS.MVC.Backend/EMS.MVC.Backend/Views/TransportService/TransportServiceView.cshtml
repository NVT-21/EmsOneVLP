@model EMS.MVC.Backend.Models.TransportServiceViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="template-demo">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-custom">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index","Transport")">Quản lý cước vận chuyển</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index","Transport")">Cấu hình</a></li>
                        <li class="breadcrumb-item active" aria-current="page"><span>Dịch vụ</span></li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <ul class="nav nav-tabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" id="MainService" data-toggle="tab" role="tab" aria-controls="MainService" aria-selected="true" onclick="redirectTab(1)">Dịch vụ chính</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="ExtraService" data-toggle="tab" role="tab" aria-controls="ExtraService" aria-selected="false" onclick="redirectTab(2)">Dịch vụ cộng thêm</a>
                </li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane fade show active" id="showData" role="tabpanel" aria-labelledby="MainService">
                    @{
                        Html.RenderAction("SearchListTransportServiceView", "TransportService", Model);
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        function redirectTab(ParentID) {
            $.get('@Url.Action("SearchListTransportServiceView", "TransportService")', {
                ParentID: ParentID
            }, function (htmlString) {
                $('#showData').html(htmlString);
            });
        };
    </script>
}
