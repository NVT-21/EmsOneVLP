@model EMS.MVC.Backend.Models.RequestSupportViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="template-demo">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-custom">
                        <li class="breadcrumb-item"><a href="@Url.Action("RequestSupportView","RequestSupport")">Yêu cầu hỗ trợ</a></li>
                        <li class="breadcrumb-item active" aria-current="page"><span></span></li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>
<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Thống kê</h4>
            <div class="row">
                @foreach (var item in Model.ListRequestSupportStatus)
                {
                    <div class="col-xl-3 col-lg-3 col-md-3 col-6 mb-2">
                        <div class="card">
                            <div class="card-body" style="padding-top:0.5rem; padding-bottom: 0.5rem; text-align: center;">
                                <h4 class="card-title mb-2" style="font-size: 0.74rem;">@item.Text</h4>
                                <h3 class="m-0" id="Status_@item.Value"></h3>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-lg-3 mb-2">
                    <label for="">Thời gian</label>
                    @Html.DropDownListFor(model => model.TypeDate, new SelectList(Model.ListTypeDate, "Value", "Text"), new { @class = "select2" })
                </div>
                <div class="col-lg-3 mb-2">
                    <label for="">Từ ngày</label>
                    @Html.EditorFor(model => model.FromDate, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Ngày/ Tháng/ Năm" } })
                </div>
                <div class="col-lg-3 mb-2">
                    <label for="">Đến ngày</label>
                    @Html.EditorFor(model => model.ToDate, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Ngày/ Tháng/ Năm" } })
                </div>
                <div class="col-lg-3 mb-2">
                    <label for="">Mã yêu cầu</label>
                    @Html.EditorFor(model => model.RequestSupportCode, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Mã yêu cầu", @autocomplete = "off" } })
                </div>
                <div class="col-lg-3 mb-2">
                    <label for="">Mã bưu gửi</label>
                    @Html.EditorFor(model => model.EShippingCode, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Mã bưu gửi", @autocomplete = "off" } })
                </div>
                <div class="col-lg-3 mb-2">
                    <label for="">Mã khách hàng</label>
                    @Html.EditorFor(model => model.CrmOrPaypostCode, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Mã khách hàng", @autocomplete = "off" } })
                </div>
                <div class="col-lg-3 mb-2">
                    <label for="">Nhóm yêu cầu</label>
                    @Html.DropDownListFor(model => model.RequestSupportGroup, new SelectList(Model.ListRequestSupportGroup, "ID", "Name"), "-- Chọn --", new { @class = "select2" })
                </div>
                <div class="col-lg-3 mb-2">
                    <label for="">Loại yêu cầu</label>
                    @Html.DropDownListFor(model => model.RequestSupportType, new SelectList("", "Value", "Text"), "-- Chọn --", new { @class = "select2" })
                </div>
                <div class="col-lg-3 mb-2">
                    <label for="">Trạng thái</label>
                    @Html.DropDownListFor(model => model.RequestSupportStatus, new SelectList(Model.ListRequestSupportStatus, "Value", "Text"), "-- Chọn --", new { @class = "select2" })
                </div>
                <div class="col-lg-3 mb-2">
                    <label for="">&nbsp;</label>
                    <button type="button" id="btnSearch" class="btn btn-sm btn-secondary form-control text-white">
                        <i class="fa fa-search mr-2"></i>TÌM KIẾM
                    </button>
                </div>
            </div>
            <hr />
            <div class="mb-2">
                <div class="row">
                    <div class="col-lg-8 col-md-8">
                        <div class="row">
                            <div class="col-lg-12">
                                <button type="button" id="btnAcceptedStatus" title="Duyệt" class="badge badge-outline-primary mb-2" style="width: 40px; height: 30px; background-color: white;">
                                    <i class="fa fa-check" aria-hidden="true"></i>
                                </button>
                                <button type="button" id="btnUnAcceptedStatus" title="Không duyệt" class="badge badge-outline-danger ml-2 mb-2" style="width: 40px; height: 30px; background-color: white;">
                                    <i class="fa fa-times" aria-hidden="true"></i>
                                </button>
                                <button type="button" id="btnCloseStatus" title="Đóng yêu cầu" class="badge badge-outline-warning ml-2 mb-2" style="width: 40px; height: 30px; background-color: white;">
                                    <i class="fa fa-thumb-tack" aria-hidden="true"></i>
                                </button>
                                <button type="button" id="btnReOpenStatus" title="Mở lại" class="badge badge-outline-secondary ml-2 mb-2" style="width: 40px; height: 30px; background-color: white;">
                                    <i class="fa fa-refresh" aria-hidden="true"></i>
                                </button>
                                <button type="button" id="btnSearchResultRequestSupport" title="Lấy KQ từ CMS" class="badge badge-outline-info ml-2 mb-2" style="width: 40px; height: 30px; background-color: white;">
                                    <i class="fa fa-exchange" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4 col-md-8">
                        <div class="row">
                            <div class="col-xl-12 col-lg-12 col-md-12 d-flex justify-content-end">
                                <button class="btn btn-sm btn-primary" title="Xuất Excel" onclick="btnExportExcel()">Xuất Excel</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div id="tbl-data" class="table-responsive">
                @{
                    Html.RenderAction("SearchListRequestSupportView", "RequestSupport", Model);
                }
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        $(document).ready(function () {
            CreateDatePicker("#FromDate, #ToDate");
        });

        $('#btnSearch').on('click', function () {
            var data = {
                TypeDate: $("#TypeDate").val(),
                FromDate: $("#FromDate").val(),
                ToDate: $("#ToDate").val(),
                RequestSupportCode: $("#RequestSupportCode").val().trim(),
                EShippingCode: $("#EShippingCode").val().trim(),
                CrmOrPaypostCode: $("#CrmOrPaypostCode").val().trim(),
                RequestSupportGroup: $("#RequestSupportGroup").val() == "" ? "" : $("#RequestSupportGroup option:selected").text(),
                RequestSupportType: $("#RequestSupportType").val() == "" ? "" : $("#RequestSupportType option:selected").text(),
                RequestSupportStatus: $("#RequestSupportStatus").val()
            };

            $.post('@Url.Action("SearchListRequestSupportView", "RequestSupport")', data, function (data) {
                $('#tbl-data').html(data);
            });
        });

        $("#RequestSupportGroup").on("change", function () {
            var RequestSupportGroup = $("#RequestSupportGroup").val();
            if (RequestSupportGroup != "") {
                $('#RequestSupportType').empty();
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("SearchListRequestSupportGroup", "Handle")',
                    data: {
                        ParentID: RequestSupportGroup
                    },
                    loading: true,
                    dataType: 'json',
                    success: function (data) {
                        $("<option/>", {
                            value: "",
                            text: "--- Chọn ---"
                        }).appendTo("#RequestSupportType");
                        $.each(data, function (index, value) {
                            $("<option/>", {
                                value: value.ID,
                                text: value.Name
                            }).appendTo("#RequestSupportType");
                        });
                    },
                    error: function (xhr, status, error) {
                        var err = eval("(" + xhr.responseText + ")");
                        swal({
                            title: 'Lỗi',
                            text: err.Message,
                            button: {
                                text: "Đóng",
                                value: true,
                                visible: true,
                                className: "btn btn-primary"
                            }
                        });
                        return;
                    }
                });
            } else {
                $('#RequestSupportType').empty();
                $("<option/>", {
                    value: "",
                    text: "--- Chọn ---"
                }).appendTo("#RequestSupportType");
            }
        });

        function btnExportExcel() {
            var req = {
                TypeDate: $("#TypeDate").val(),
                FromDate: $("#FromDate").val(),
                ToDate: $("#ToDate").val(),
                RequestSupportCode: $("#RequestSupportCode").val().trim(),
                EShippingCode: $("#EShippingCode").val().trim(),
                CrmOrPaypostCode: $("#CrmOrPaypostCode").val().trim(),
                RequestSupportGroup: $("#RequestSupportGroup").val() == "" ? "" : $("#RequestSupportGroup option:selected").text(),
                RequestSupportType: $("#RequestSupportType").val() == "" ? "" : $("#RequestSupportType option:selected").text(),
                RequestSupportStatus: $("#RequestSupportStatus").val()
            };
            var param = String.format("TypeDate={0}&FromDate={1}&ToDate={2}&RequestSupportCode={3}&EShippingCode={4}&CrmOrPaypostCode={5}&RequestSupportGroup={6}&RequestSupportType={7}&RequestSupportStatus={8}",
                req.TypeDate, req.FromDate, req.ToDate, req.RequestSupportCode, req.EShippingCode, req.CrmOrPaypostCode, req.RequestSupportGroup, req.RequestSupportType, req.RequestSupportStatus);
            window.location.href = '@Url.Action("ExportListRequestSupport", "RequestSupport")?' + param;
        }
    </script>
}


