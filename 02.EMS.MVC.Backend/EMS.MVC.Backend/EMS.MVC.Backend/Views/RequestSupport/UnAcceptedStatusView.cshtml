@model List<EMS.MVC.Backend.Models.SearchListRequestSupportViewModel>
<div class="modal-dialog" role="document">
    <div class="modal-content">
        <div class="modal-header">
            <h4 class="modal-title">Không duyệt yêu cầu</h4>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body" id="ClearModal">
            <div class="row">
                <div class="col-lg-12 mb-2">
                    <label for="">Lý do <span class="text-danger">(*)</span></label>
                    <textarea class="form-control" id="Reason" placeholder="Vui lòng nhập lý do" rows="2"></textarea>
                    <span class="text-danger" id="errReason"></span>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <div class="col-lg-12 col-md-12">
                <div class="row justify-content-between">
                    <button type="button" class="btn btn-sm btn-danger form-control col-lg-3 col-md-4" id="btnCloseModalUnAcceptedStatus" data-dismiss="modal" aria-label="Close">HUỶ BỎ</button>
                    <button type="button" class="btn btn-sm btn-primary form-control col-lg-3 col-md-4" id="btnModalUnAcceptedStatus">XÁC NHẬN</button>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    CheckChangeValue("Reason", "Vui lòng nhập lý do", "", "Y");

    $("#btnModalUnAcceptedStatus").on("click", function () {
        var isError = false;
        var data = {
            model: JSON.parse('@Html.Raw(Json.Encode(Model))'),
            Reason: $("#Reason").val().trim()
        }

        isError = CheckNullValue(data.Reason, "Reason", "Vui lòng nhập lý do", isError);

        if (isError == true) {
            return;
        }

        $.ajax({
            type: 'POST',
            url: '@Url.Action("JUnAcceptedStatus", "RequestSupport")',
            dataType: 'json',
            loading: true,
            data: data,
            success: function (res) {
                if (res.Code == "00") {
                    CreateCustomSwal("success", res.Message);
                } else
                if (res.Code == "10") {
                    swal({
                        title: 'Thông báo',
                        text: res.Message,
                        buttons: {
                            confirm: {
                                text: "XEM CHI TIẾT",
                                value: true,
                                visible: true,
                                className: "btn btn-primary",
                                closeModal: true
                            },
                            cancel: {
                                text: "KHÔNG",
                                value: false,
                                visible: true,
                                className: "btn btn-danger",
                                closeModal: true,
                            }
                        },
                    }).then((value) => {
                        if (value) {
                            $.post('@Url.Action("ShowListErrorMultipleSelect", "Handle")', {
                                Error: res.Data,
                                Controller: "RequestSupport"
                            }, function (data) {
                                $('#modal-common-container').html(data);
                                $('#modal-common').modal('show');
                            });
                        } else {
                            window.location.reload();
                        }
                    });
                } else {
                    CreateCustomSwal("error", res.Message);
                }
            },
            error: function (xhr, status, error) {
                var err = eval("(" + xhr.responseText + ")");
                swal({
                    title: 'Lỗi',
                    text: err.Message,
                    button: {
                        text: "ĐÓNG",
                        value: true,
                        visible: true,
                        className: "btn btn-primary"
                    }
                });
                return;
            }
        });
    });
</script>