@model EMS.MVC.Backend.Models.DetailRequestSupportViewModel
@using Newtonsoft.Json;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<input type="hidden" id="RequestSupportID" value="@Model.RequestSupportID" />
<input type="hidden" id="ShopID" value="@Model.ShopID" />
<input type="hidden" id="RequestSupportCode" value="@Model.RequestSupportCode" />

<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="template-demo">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-custom">
                        <li class="breadcrumb-item"><a href="@Url.Action("RequestSupportView","RequestSupport")">Yêu cầu hỗ trợ</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("RequestSupportView","RequestSupport")">Danh sách</a></li>
                        <li class="breadcrumb-item active" aria-current="page"><span>Mã yêu cầu hỗ trợ - @Model.RequestSupportCode</span></li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>
<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-12 grid-margin stretch-card">
                    <div class="card">
                        <div class="card-body">
                            <h4 class="card-title">I. Thông tin yêu cầu</h4>
                            <div class="row">
                                <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                                    <label>Nhóm yêu cầu</label>
                                    <input class="form-control form-control-sm" value="@Model.RequestGroup" disabled />
                                </div>
                                <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                                    <label>Loại yêu cầu</label>
                                    <textarea class="form-control form-control-sm" disabled>@Model.RequestType</textarea>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.NewUpdateInformation))
                                {
                                    <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                                        <label>Thông tin ban đầu</label>
                                        <textarea class="form-control form-control-sm" disabled>
                                            @if(Model.RequestType == "Sửa tiền đơn hàng (tiền COD)")
                                            {
                                                Write(Convert.ToInt64(Model.OldUpdateInformation).ToString("N0"));
                                            }
                                            else
                                            {
                                                Write(Model.OldUpdateInformation);
                                            }
                                        </textarea>
                                    </div>
                                    <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                                        <label>Thông tin thay đổi</label>
                                        <textarea class="form-control form-control-sm" disabled>
                                            @if(Model.RequestType == "Sửa tiền đơn hàng (tiền COD)")
                                            {
                                                Write(Convert.ToInt64(Model.NewUpdateInformation).ToString("N0"));
                                            }
                                            else
                                            {
                                                Write(Model.NewUpdateInformation);
                                            }
                                        </textarea>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(Model.RequestSupportDocument))
                                {
                                    <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                                        <label>File đính kèm (<a target="_blank" href="@XHelper.pathRequestSupport@Model.RequestSupportDocument" download>Xem</a>)</label>
                                    </div>
                                }
                                <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                                    <label>Nội dung yêu cầu</label>
                                    <textarea class="form-control form-control-sm" disabled>@Model.RequestSupportDescription</textarea>
                                </div>
                                <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                                    <label>Người yêu cầu</label>
                                    <input class="form-control form-control-sm" value="@Model.EmployeeName" disabled />
                                </div>
                                <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                                    <label>Thời gian yêu cầu</label>
                                    <input class="form-control form-control-sm" value="@Model.CreatedDate" disabled />
                                </div>
                                <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                                    <label>Trạng thái</label>
                                    <input class="form-control form-control-sm" value="@Model.RequestSupportStatus.Name" disabled />
                                </div>
                                <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                                    <label>Đơn vị tiếp nhận</label>
                                    <input class="form-control form-control-sm" value="@Model.PosC" disabled />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 grid-margin stretch-card">
                    <div class="card">
                        <div class="card-body">
                            <h4 class="card-title">II. Thông tin bưu gửi</h4>
                            <div class="row">
                                <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                                    <label>Mã bưu gửi</label>
                                    <a href="#" onclick="btnDetailShippingCode('@Model.EShippingCode',@Model.ShopID)" style="text-decoration: none;"><input class="form-control form-control-sm" style="cursor: pointer;" value="@Model.EShippingCode" disabled /></a>
                                </div>
                                <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                                    <label>Mã đơn hàng</label>
                                    <a href="#" onclick="btnDetailOrderCode(@Model.OrderID, @Model.ShopID)" style="text-decoration: none;"><input class="form-control form-control-sm" style="cursor: pointer;" value="@Model.OrderCode" disabled /></a>
                                </div>
                                <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                                    <label>Khối lượng (g)</label>
                                    <input class="form-control form-control-sm" value="@Model.WeightBefore" disabled />
                                </div>
                                <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                                    <label>Khối lượng thực tế (g)</label>
                                    <input class="form-control form-control-sm" value="@Model.WeightAfter" disabled />
                                </div>
                                <div class="col-xl-6 col-lg-6 col-md-6 mb-2 grid-margin stretch-card">
                                    <div class="card">
                                        <div class="card-body">
                                            <h4 class="card-title">Người gửi</h4>
                                            <div class="row">
                                                <div class="col-xl-6 col-lg-12 col-md-12 mb-2">
                                                    <label>Họ và tên</label>
                                                    <input class="form-control form-control-sm" value="@Model.SenderName" disabled />
                                                </div>
                                                <div class="col-xl-6 col-lg-12 col-md-12 mb-2">
                                                    <label>Số điện thoại</label>
                                                    <input class="form-control form-control-sm" value="@Model.SenderPhone" disabled />
                                                </div>
                                                <div class="col-xl-12 col-lg-12 col-md-12 mb-2">
                                                    <label>Địa chỉ</label>
                                                    <textarea class="form-control form-control-sm" id="SenderFullAddress" disabled>@Model.SenderFullAddress</textarea>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xl-6 col-lg-6 col-md-6 mb-2 grid-margin stretch-card">
                                    <div class="card">
                                        <div class="card-body">
                                            <h4 class="card-title">Người nhận</h4>
                                            <div class="row">
                                                <div class="col-xl-6 col-lg-12 col-md-12 mb-2">
                                                    <label>Họ và tên</label>
                                                    <input class="form-control form-control-sm" value="@Model.ReceiverName" disabled />
                                                </div>
                                                <div class="col-xl-6 col-lg-12 col-md-12 mb-2">
                                                    <label>Số điện thoại</label>
                                                    <input class="form-control form-control-sm" value="@Model.ReceiverPhone" disabled />
                                                </div>
                                                <div class="col-xl-12 col-lg-12 col-md-12 mb-2">
                                                    <label>Địa chỉ</label>
                                                    <textarea class="form-control form-control-sm" id="ReceiverFullAddress" disabled>@Model.ReceiverFullAddress</textarea>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                                    <label>Nội dung</label>
                                    <textarea class="form-control form-control-sm" id="OrderMessage" rows="2" disabled>@Model.OrderMessage</textarea>
                                </div>
                                <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                                    <label>Trạng thái</label>
                                    <input class="form-control form-control-sm" value="@Model.OrderStatus.Name" disabled />
                                </div>
                                <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                                    <label>Giá trị (VNĐ)</label>
                                    <input class="form-control form-control-sm" value="@Model.TransportOrderValue.ToString("N0")" disabled />
                                </div>
                                <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                                    <label>COD (VNĐ)</label>
                                    <input class="form-control form-control-sm" value="@Model.TotalCOD.ToString("N0")" disabled />
                                </div>
                                <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                                    <label>Cước (VNĐ)</label>
                                    <input class="form-control form-control-sm" value="@Model.TransportFee.ToString("N0")" disabled />
                                </div>
                                <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                                    <label>Dịch vụ chính</label>
                                    <input class="form-control form-control-sm" value="@Model.TransportMainService" disabled />
                                </div>
                                <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                                    <label>Dịch vụ cộng thêm</label>
                                    <textarea class="form-control form-control-sm" id="TransportExtraService" disabled>@Model.TransportExtraService</textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 grid-margin stretch-card">
                    <div class="card">
                        <div class="card-body">
                            <h4 class="card-title">III. Thông tin khách hàng</h4>
                            <div class="row">
                                <div class="col-xl-3 col-lg-4 col-md-12 mb-2">
                                    <label>Mã KH</label>
                                    <input class="form-control form-control-sm" value="@Model.ShopCode" disabled />
                                </div>
                                <div class="col-xl-3 col-lg-4 col-md-12 mb-2">
                                    <label>Mã CRM</label>
                                    <input class="form-control form-control-sm" value="@Model.CrmOrPaypostCode" disabled />
                                </div>
                                <div class="col-xl-3 col-lg-4 col-md-12 mb-2">
                                    <label>SĐT KH</label>
                                    <input class="form-control form-control-sm" value="@Model.ShopPhone" disabled />
                                </div>
                                <div class="col-xl-9 col-lg-9 col-md-12 mb-2">
                                    <label>Địa chỉ KH</label>
                                    <textarea class="form-control form-control-sm" id="ShopFullAddress" disabled>@Model.ShopFullAddress</textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 grid-margin stretch-card">
                    <div class="card">
                        <div class="card-body">
                            <h4 class="card-title">IV. Tiến trình xử lý yêu cầu</h4>
                            <div class="table-responsive">
                                <table class="table table-hover table-bordered">
                                    <thead>
                                        <tr>
                                            <th class="vertical-mid text-center">STT</th>
                                            <th class="vertical-mid text-center">Thời gian</th>
                                            <th class="vertical-mid text-center">Người xử lý</th>
                                            <th class="vertical-mid text-center">Nội dung xử lý</th>
                                            <th class="vertical-mid text-center">Kết quả</th>
                                            <th class="vertical-mid text-center">Tài liệu</th>
                                            <th class="vertical-mid text-center">Hình thức xử lý</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.ListSearchProcess.Count > 0)
                                        {
                                            var stt = 1;
                                            foreach (var item in Model.ListSearchProcess)
                                            {
                                                <tr>
                                                    <td class="text-center">@(stt++)</td>
                                                    <td class="text-center">@item.CreatedDate</td>
                                                    <td class="text-center">@item.CreatedName</td>
                                                    <td style="max-width: 260px; white-space: inherit; text-align: justify; vertical-align: middle; line-height: 1.4rem;">@item.Description</td>
                                                    <td style="max-width: 260px; white-space: inherit; text-align: justify; vertical-align: middle; line-height: 1.4rem;">@item.Result</td>
                                                    <td class="text-center">
                                                        @if (item.ResultDocument != "")
                                                        {
                                                            <a target="_blank" href="@item.ResultDocument">Xem</a>
                                                        }
                                                    </td>
                                                    <td class="text-center">@item.Type.Name</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="7">Dữ liệu không tồn tại.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-12 grid-margin stretch-card">
                    <div class="card">
                        <div class="card-body">
                            <h4 class="card-title">V. Lịch sử luân chuyển trạng thái</h4>
                            <div class="table-responsive">
                                <table class="table table-hover table-bordered">
                                    <thead>
                                        <tr>
                                            <th class="vertical-mid text-center">STT</th>
                                            <th class="vertical-mid text-center">Thời gian</th>
                                            <th class="vertical-mid text-center">Người xử lý</th>
                                            <th class="vertical-mid text-center">Nội dung xử lý</th>
                                            <th class="vertical-mid text-center">Lý do</th>
                                            <th class="vertical-mid text-center">Tài liệu</th>
                                            <th class="vertical-mid text-center">Trạng thái</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.ListSearchHistory.Count > 0)
                                        {
                                            var stt = 1;
                                            foreach (var item in Model.ListSearchHistory)
                                            {
                                                <tr>
                                                    <td class="text-center">@(stt++)</td>
                                                    <td class="text-center">@item.CreatedDate</td>
                                                    <td class="text-center">@item.CreatedName</td>
                                                    <td style="max-width: 260px; white-space: inherit; text-align: justify; vertical-align: middle; line-height: 1.4rem;">@item.Description</td>
                                                    <td style="max-width: 260px; white-space: inherit; text-align: justify; vertical-align: middle; line-height: 1.4rem;">@item.Reason</td>
                                                    <td class="text-center">
                                                        @if (item.ResultDocument != "")
                                                        {
                                                            <a target="_blank" href="@XHelper.pathRequestSupport@item.ResultDocument">Xem</a>
                                                        }
                                                    </td>
                                                    <td class="text-center">@item.Status.Name</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="7">Dữ liệu không tồn tại.</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model.RequestSupportStatus.Code == "P")
                {
                    <div class="col-md-12 grid-margin stretch-card">
                        <div class="card">
                            <div class="card-body">
                                <h4 class="card-title">VII. Nội dung xử lý</h4>
                                <div class="row">
                                    <div class="col-lg-12 mb-2">
                                        <label for="">Kết quả yêu cầu <span class="text-danger">(*)</span></label>
                                        <textarea class="form-control form-control-sm" id="ResultRequestSupport"></textarea>
                                        <span class="text-danger" id="errResultRequestSupport"></span>
                                    </div>
                                    <div class="col-lg-12 mb-2">
                                        <label for="">Tài liệu đính kèm</label>
                                        <form id="DocumentUpload" enctype="multipart/form-data">
                                            <input type="file" class="form-control" id="Document" style="height: 2.9rem;">
                                        </form>
                                        <span id="notifyDocument"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                <div class="col-md-12">
                    <div class="card border-0">
                        <div class="card-body">
                            <div class="row justify-content-between">
                                <button type="button" class="btn btn-sm btn-danger form-control col-xl-2 col-lg-3 col-md-3" onclick="window.location.href = '@Url.Action("RequestSupportView","RequestSupport")'">QUAY LẠI</button>
                                @{
                                    List<EMS.MVC.Backend.Models.SearchListRequestSupportViewModel> oListTemp = new List<EMS.MVC.Backend.Models.SearchListRequestSupportViewModel>();
                                    oListTemp.Add(new EMS.MVC.Backend.Models.SearchListRequestSupportViewModel()
                                    {
                                        RequestSupportID = Model.RequestSupportID,
                                        RequestSupportCode = Model.RequestSupportCode,
                                        ShopID = Model.ShopID
                                    });
                                }
                                @if (Model.RequestSupportStatus.Code == "W")
                                {
                                    <button type="button" title="Không duyệt" class="btn btn-sm btn-warning form-control col-xl-2 col-lg-3 col-md-4 text-white" onclick="UnAcceptedStatus('@JsonConvert.SerializeObject(oListTemp)')">
                                        KHÔNG DUYỆT
                                    </button>
                                    <button type="button" title="Duyệt" class="btn btn-sm btn-primary form-control col-xl-2 col-lg-3 col-md-3" onclick="AcceptedStatus('@JsonConvert.SerializeObject(oListTemp)')">
                                        DUYỆT
                                    </button>
                                }
                                else if (Model.RequestSupportStatus.Code == "P")
                                {
                                    <button type="button" title="Xử lý" class="btn btn-sm btn-primary form-control col-xl-2 col-lg-3 col-md-3" onclick="ProcessStatus()">
                                        XỬ LÝ
                                    </button>
                                }
                                else if (Model.RequestSupportStatus.Code == "T")
                                {
                                    <button type="button" title="Đóng yêu cầu" class="btn btn-sm btn-warning form-control col-xl-2 col-lg-3 col-md-3" onclick="CloseStatus('@JsonConvert.SerializeObject(oListTemp)')">
                                        ĐÓNG YÊU CẦU
                                    </button>
                                }
                                else if (Model.RequestSupportStatus.Code == "F" && Model.RequestGroup == "Sửa thông tin đơn hàng")
                                {
                                    <button type="button" title="Mở lại" class="btn btn-sm btn-secondary form-control col-xl-2 col-lg-3 col-md-3 text-white" onclick="ReOpenStatus('@JsonConvert.SerializeObject(oListTemp)')">
                                        MỞ LẠI
                                    </button>
                                }
                                else if (Model.RequestSupportStatus.Code == "O")
                                {
                                    <button type="button" title="Không duyệt" class="btn btn-sm btn-warning form-control col-xl-2 col-lg-3 col-md-3 text-white" onclick="UnAcceptedStatus('@JsonConvert.SerializeObject(oListTemp)')">
                                        KHÔNG DUYỆT
                                    </button>
                                    <button type="button" title="Duyệt" class="btn btn-sm btn-primary form-control col-xl-2 col-lg-3 col-md-3" onclick="AcceptedStatus('@JsonConvert.SerializeObject(oListTemp)')">
                                        DUYỆT
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts{
    <script>
        CheckChangeValue("ResultRequestSupport", "Vui lòng nhập kết quả yêu cầu", "", "Y");

        function UnAcceptedStatus(oListTemp) {
            swal({
                title: 'Thông báo',
                text: "Bạn chắc chắn muốn không duyệt yêu cầu hỗ trợ?",
                icon: 'warning',
                buttons: {
                    confirm: {
                        text: "Có",
                        value: true,
                        visible: true,
                        className: "btn btn-primary",
                        closeModal: true
                    },
                    cancel: {
                        text: "Không",
                        value: false,
                        visible: true,
                        className: "btn btn-danger",
                        closeModal: true,
                    }
                },
            }).then((value) => {
                if (value) {
                    $.post('@Url.Action("UnAcceptedStatusView", "RequestSupport")', { model: JSON.parse(oListTemp) }, function (data) {
                        $('#modal-common-container').html(data);
                        $('#modal-common').modal('show');
                    });
                }
            });
        }

        function AcceptedStatus(oListTemp) {
            swal({
                title: 'Thông báo',
                text: "Bạn có chắc chắn muốn duyệt yêu cầu hỗ trợ?",
                html: true,
                buttons: {
                    confirm: {
                        text: "CÓ",
                        value: true,
                        visible: true,
                        className: "btn btn-primary",
                        closeModal: true
                    },
                    cancel: {
                        text: "KHÔNG",
                        value: false,
                        visible: true,
                        className: "btn btn-danger",
                        closeModal: true,
                    }
                },
            }).then((value) => {
                if (value) {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("JAcceptedStatus", "RequestSupport")',
                        dataType: 'json',
                        loading: true,
                        data: {
                            model: JSON.parse(oListTemp)
                        },
                        success: function (res) {
                            if (res.Code == "00") {
                                CreateCustomSwal("success", res.Message);
                            } else
                            if (res.Code == "10") {
                                swal({
                                   title: 'Thông báo',
                                   text: res.Message,
                                   buttons: {
                                       confirm: {
                                           text: "XEM CHI TIẾT",
                                           value: true,
                                           visible: true,
                                           className: "btn btn-primary",
                                           closeModal: true
                                       },
                                       cancel: {
                                           text: "KHÔNG",
                                           value: false,
                                           visible: true,
                                           className: "btn btn-danger",
                                           closeModal: true,
                                       }
                                   },
                                }).then((value) => {
                                    if (value) {
                                       $.post('@Url.Action("ShowListErrorMultipleSelect", "Handle")', {
                                           Error: res.Data,
                                           Controller: "RequestSupport"
                                       }, function (data) {
                                           $('#modal-common-container').html(data);
                                           $('#modal-common').modal('show');
                                       });
                                   } else {
                                       window.location.reload();
                                   }
                                });
                            } else {
                                CreateCustomSwal("error", res.Message);
                            }
                        },
                        error: function (xhr, status, error) {
                            var err = eval("(" + xhr.responseText + ")");
                            swal({
                                title: 'Lỗi',
                                text: err.Message,
                                button: {
                                    text: "ĐÓNG",
                                    value: true,
                                    visible: true,
                                    className: "btn btn-primary"
                                }
                            });
                            return;
                        }
                    });
                }
            });
        }

        function CloseStatus(oListTemp) {
            swal({
                title: 'Thông báo',
                text: "Bạn có chắc chắn muốn đóng yêu cầu hỗ trợ?",
                html: true,
                buttons: {
                    confirm: {
                        text: "CÓ",
                        value: true,
                        visible: true,
                        className: "btn btn-primary",
                        closeModal: true
                    },
                    cancel: {
                        text: "KHÔNG",
                        value: false,
                        visible: true,
                        className: "btn btn-danger",
                        closeModal: true,
                    }
                },
            }).then((value) => {
                if (value) {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("JCloseStatus", "RequestSupport")',
                        dataType: 'json',
                        loading: true,
                        data: {
                            model: JSON.parse(oListTemp)
                        },
                        success: function (res) {
                            if (res.Code == "00") {
