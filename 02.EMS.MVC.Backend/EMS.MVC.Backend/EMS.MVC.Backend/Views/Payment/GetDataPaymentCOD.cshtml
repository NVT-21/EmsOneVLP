@model IEnumerable<EMS.MVC.Backend.Models.PaymentListCODViewModel>
@{
    Layout = null;
    var stt = 1;
}
<table id="ListDataTableSearch" class="table table-bordered table-hover text-center">
    <thead>
        <tr>
            <th class="align-middle"></th>
            <th class="align-middle" colspan="5"></th>
            <th class="text-right"> @ViewBag.SumCOD.ToString("N0") ₫</th>
            <th class="align-middle" colspan="3"></th>
        </tr>
        <tr class="table-info text-center">
            <th class="align-middle">
                <p>Chọn tất cả</p>
                <input class="dt-body-center" type="checkbox" name="select_all" value="1" id="SelectAll">
            </th>
            <th class="align-middle"> STT </th>
            <th class="align-middle"> Mã khách hàng </th>
            <th class="align-middle"> Mã PP/CRM </th>
            <th class="align-middle"> Mã bưu gửi </th>
            <th class="align-middle"> Mã đơn hàng </th>
            <th class="align-middle"> Tiền COD </th>
            <th class="align-middle"> Trạng thái đối soát </th>
            <th class="align-middle"> Trạng thái thanh toán </th>
            <th class="align-middle"> Thao tác </th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td class="text-center">
                        @if (item.IsAgree == "Y" && item.IsPayment == "N")
                        {
                            <input type="checkbox" id="SelectData" data-EMSBarCode="@item.EmsBarCode" value="@item.ID" />
                        }
                    </td>
                    <td class="text-center">@(stt++)</td>
                    <td class="text-center">@item.CustomerCode</td>
                    <td class="text-center">@item.CustomerPPCRM</td>
                    <td class="text-center">
                        <span style="line-height: 1.4rem;"><a href="#" onclick="btnDetailShippingCode('@item.EmsBarCode',@item.ShopID)">@item.EmsBarCode</a></span>
                    </td>
                    @if (item.OrderID == 0)
                    {
                        <td class="text-center">
                            @item.OrderCode
                        </td>
                    }
                    else
                    {
                        <td class="text-center">
                            <a style="cursor: pointer; color:#007bff;" onclick="Detail(@item.OrderID, @item.ShopID)">@item.OrderCode</a>
                        </td>
                    }
                    <td class="text-right">@item.CODMoney.ToString("N0")</td>
                    <td class="text-center text-success">
                        @if (item.IsAgree == "Y")
                        {
                            <b class="text-success">@item.StatusIsAgree</b>
                        }
                        else if (item.IsAgree == "N")
                        {
                            <b class="text-danger">@item.StatusIsAgree</b>
                        }
                        else if (item.IsAgree == "W")
                        {
                            <b class="text-warning">@item.StatusIsAgree</b>
                        }
                        else if (item.IsAgree == "C")
                        {
                            <b class="text-info">@item.StatusIsAgree</b>
                        }
                        else if (item.IsAgree == "D")
                        {
                            <b class="text-gray">@item.StatusIsAgree</b>
                        }
                    </td>
                    <td class="text-center text-success">
                        @if (item.IsPayment == "Y")
                        {
                            <b class="text-success">Đã thanh toán</b>
                        }
                        else if (item.IsPayment == "N")
                        {
                            <b class="text-danger">Chờ thanh toán</b>
                        }
                    </td>
                    <td>
                        @if (item.IsAgree == "Y")
                        {
                            if (item.IsPayment == "N")
                            {
                                <button onclick="btnIsPayment(@item.ID)" title="Xác nhận thanh toán" class="badge badge-outline-primary">
                                    <i class="fa fa-paypal"></i>
                                </button>
                            }
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
    <tfoot>
        <tr>
            <th class="align-middle"></th>
            <th class="align-middle" colspan="5"></th>
            <th class="text-right">  </th>
            <th class="align-middle" colspan="3"></th>
        </tr>
    </tfoot>
</table>
@*<script src="~/Assets/js/tooltips.js"></script>
<script src="~/Assets/js/popover.js"></script>*@
<script>
    $(document).ready(function () {
        var table = $('#ListDataTableSearch').dataTable({
            "aLengthMenu": [
                [20, 30, 50, 100, -1],
                [20, 30, 50, 100, "Tất cả"]
            ],
            "iDisplayLength": 20,
            'language': {
                sSearch: 'Tìm kiếm ',
                emptyTable: "Không có dữ liệu",
                zeroRecords: "Không có dữ liệu",
                sInfo: 'Hiển thị từ _START_ đến _END_ của _TOTAL_ bản ghi',
                infoEmpty: "Hiển thị từ _START_ đến _END_ của _TOTAL_ bản ghi",
                infoFiltered: "(Tìm kiếm từ _MAX_ bản ghi)",
                oPaginate: {
                    'sFirst': 'Trang đầu',
                    'sPrevious': 'Trang trước',
                    'sNext': 'Trang sau',
                    'sLast': 'Trang cuối'
                },
                lengthMenu: "Hiển thị _MENU_ bản ghi"
            },
            "ordering": false,
            "footerCallback": function (row, data, start, end, display) {
                var api = this.api(), data;

                // Remove the formatting to get integer data for summation
                var intVal = function (i) {
                    return typeof i === 'string' ?
                        i.replace(/[\$,]/g, '') * 1 :
                        typeof i === 'number' ?
                            i : 0;
                };
                // Total over all pages
                total = api
                    .column(6)
                    .data()
                    .reduce(function (a, b) {
                        return intVal(a) + intVal(b);
                    }, 0);

                // Total over this page
                pageTotal = api
                    .column(6, { page: 'current' })
                    .data()
                    .reduce(function (a, b) {
                        return intVal(a) + intVal(b);
                    }, 0);

                // Update footer
                $(api.column(6).footer()).html(
                    CurrencyFormatVND(pageTotal)
                );
            }
        });
        var allPages = table.fnGetNodes();
        $('#SelectAll').click(function () {
            if ($(this).hasClass('allChecked')) {
                $('input[type="checkbox"]', allPages).prop('checked', false);
            } else {
                $('input[type="checkbox"]', allPages).prop('checked', true);
            }
            $(this).toggleClass('allChecked');
        });
        $('#ListDataTableSearch').each(function () {
            var datatable = $(this);
            // SEARCH - Add the placeholder for Search and Turn this into in-line form control
            var search_input = datatable.closest('.dataTables_wrapper').find('div[id$=_filter] input');
            search_input.attr('placeholder', 'Tìm kiếm nhanh');
            search_input.removeClass('form-control-sm');
            // LENGTH - Inline-Form control
            var length_sel = datatable.closest('.dataTables_wrapper').find('div[id$=_length] select');
            length_sel.removeClass('form-control-sm');
            length_sel.css('color', 'black');
        });
        $("#btnAcceptIsPayment").on('click', function () {
            var arr = [];

            var rowSelected = table.$("#SelectData:checked", allPages);

            rowSelected.each(function (index, value) {
                var obj = {};
                obj.ID = $(value).val();
                obj.EmsBarCode = $(value).attr("data-EMSBarCode");
                arr.push(obj);
            });
            if (arr.length == 0) {
                swal({
                    title: 'Thông báo',
                    text: "Vui lòng chọn đơn hàng xác nhận thanh toán.",
                    button: {
                        text: "ĐÓNG",
                        value: true,
                        visible: true,
                        className: "btn btn-primary"
                    }
                });
                return;
            }

            swal({
                title: 'Thông báo',
                text: "Bạn có chắc chắn muốn xác nhận thanh toán?",
                html: true,
                buttons: {
                    confirm: {
                        text: "CÓ",
                        value: true,
                        visible: true,
                        className: "btn btn-primary",
                        closeModal: true
                    },
                    cancel: {
                        text: "KHÔNG",
                        value: false,
                        visible: true,
                        className: "btn btn-danger",
                        closeModal: true,
                    }
                },
            }).then((value) => {
                if (value) {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("JIsPaymentCODMultiple", "Payment")',
                        dataType: 'json',
                        loading: true,
                        data: {
                            arr: arr
                        },
                        success: function (res) {
                            if (res.Code == "00") {
                                swal({
                                    title: "Thông báo",
                                    text: res.Message,
                                    button: false,
                                    timer: 1500
                                }).then(function () {
                                    setTimeout(function () { $('#btnSearch').click(); }, 1200);
                                });
                            } else {
                                swal({
                                    title: 'Thông báo',
                                    text: res.Message,
                                    buttons: {
                                        confirm: {
                                            text: "XEM CHI TIẾT",
                                            value: true,
                                            visible: true,
                                            className: "btn btn-primary",
                                            closeModal: true
                                        },
                                        cancel: {
                                            text: "KHÔNG",
                                            value: false,
                                            visible: true,
                                            className: "btn btn-danger",
                                            closeModal: true,
                                        }
                                    },
                                }).then((value) => {
                                    if (value) {
                                        $.post('@Url.Action("ShowListErrorMultipleSelect", "Handle")', {
                                            Error: res.Data,
                                            Controller: "PaymentCOD"
                                        }, function (data) {
                                            $('#modal-ViewModal-html').html(data);
                                            $('#ViewModal').modal('show');
                                        });
                                    } else {
                                        window.location.reload();
                                    }
                                });
                            }
                        },
                        error: function (xhr, status, error) {
                            var err = eval("(" + xhr.responseText + ")");
                            swal({
                                title: 'Lỗi',
                                text: err.Message,
                                button: {
                                    text: "ĐÓNG"
                                }
                            });
                            return;
                        }
                    });
                }
            });
        });
    });
    function Detail(OrderID, ShopID) {
        $.post('@Url.Action("OrderDetailView", "Order")', { OrderID: OrderID, ShopID: ShopID} ,function (data) {
            $('#modal-common-container').html(data);
            $('#modal-common').modal('show');
        });
    }
    function btnIsPayment(ID) {
        swal({
            title: 'Thông báo',
            text: "Bạn chắc chắn đồng ý với thao tác này?",
            html: true,
            buttons: {
                confirm: {
                    text: "Có",
                    value: true,
                    visible: true,
                    className: "btn btn-primary",
                    closeModal: true
                },
                cancel: {
                    text: "Không",
                    value: false,
                    visible: true,
                    className: "btn btn-danger",
                    closeModal: true,
                }
            },
        }).then((value) => {
            if (value) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("JIsPaymentCOD", "Payment")',
                    dataType: 'json',
                    loading: true,
                    data: {
                        ID: ID
                    },
                    success: function (res) {
                        if (res.Code == "00") {
                            swal({
                                title: "Thông báo",
                                text: res.Message,
                                button: false,
                                timer: 1500
                            }).then(function () {
                                setTimeout(function () { $('#btnSearch').click(); }, 1200);
                            });
                        }
                        else {
                            swal({
                                title: "Thông báo",
                                text: res.Message,
                                button: {
                                    text: "ĐÓNG"
                                }
                            });
                        }
                    }
                });
            }
        });
    };

    function btnDetailShippingCode(ShippingCode, ShopID) {
        var param = String.format("ShippingCode={0}", btoa(ShippingCode));
        var link = document.createElement('a');
        link.target = "_blank";
        link.href = '@XHelper.Ems247Url@("tra-cuu-buu-gui?")' + param;
        link.click();
    }
</script>

