@{
    ViewBag.Title = "PaymentCOD";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="template-demo">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-custom">
                        <li class="breadcrumb-item"><a href="@Url.Action("PaymentCOD","Payment")">Quản lý thanh toán tiền COD</a></li>
                        <li class="breadcrumb-item active" aria-current="page"><span></span></li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-lg-3 mb-2">
                    <label>Mã PayPost/CRM</label>
                    <input class="form-control" id="CustomerPPCRM" name="CustomerPPCRM" placeholder="Mã PayPost/CRM" type="text">
                </div>
                <div class="col-lg-3 mb-2">
                    <label>Mã khách hàng</label>
                    <input class="form-control" id="CustomerCode" name="CustomerCode" placeholder="Mã khách hàng" type="text">
                </div>
                <div class="col-lg-3 mb-2">
                    <label>Trạng thái đối soát</label>
                    <select class="select2 form-control" id="FreightReconciliationStatus">
                        @foreach (var item in ViewBag.ReconciliationStatus)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col-lg-3 mb-2">
                    <label>Trạng thái thanh toán</label>
                    <select class="select2 form-control" id="PaymentStatus">
                        <option value="">Tất cả</option>
                        @foreach (var item in ViewBag.PaymentStatus)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                </div>
                <div class="col-lg-3 mb-2">
                    <label for="">Ngày đối soát</label>
                    <input class="form-control" id="ApprovalDate" name="ApprovalDate" placeholder="dd / mm / yyyy" type="datetime">
                </div>
                <div class="col-lg-3 mb-2">
                    <label for="">Mã đơn hàng</label>
                    <input class="form-control" id="OrderCode" name="OrderCode" placeholder="Mã đơn hàng" type="text">
                </div>
                <div class="col-lg-3 mb-2">
                    <label for="">Mã bưu gửi</label>
                    <input class="form-control" id="EmsBarCode" name="EmsBarCode" placeholder="Mã bưu gửi" type="text">
                </div>
                <div class="col-lg-3 mb-2">
                    <label>&nbsp;</label>
                    <button id="btnSearch" class="btn btn-sm btn-secondary form-control">
                        <i class="fa fa-search"></i> TÌM KIẾM
                    </button>
                </div>
                <div class="col-lg-3 mb-2 mb-2">
                    <label>&nbsp;</label>
                    <button type="button" id="btnExportExcel" class="btn btn-sm btn-dribbble form-control">
                        <i class="fa fa-file-excel-o mr-2"></i>&nbsp; EXPORT EXCEL
                    </button>
                </div>
            </div>
            <p>&nbsp;</p>
            <div class="form-inline">
                <button type="button" id="btnAcceptIsPayment" class="btn btn-sm btn-primary btn-sm mb-2">
                    <i class="fa fa-paypal" aria-hidden="true"></i>&nbsp;&nbsp;Xác nhận thanh toán
                </button>
            </div>
            <hr />
            <div id="tbl-data" class="table-responsive">
                @{Html.RenderAction("GetDataPaymentCOD", "Payment");}
            </div>
        </div>
    </div>
</div>
@section scripts{
    <script>
        $(document).ready(function () {
            CreateDatePicker("#ApprovalDate");
        });

        $('#btnSearch').on('click', function () {
            var errMsg = '', isError = false;
            var agrs = {
                CustomerPPCRM: $('#CustomerPPCRM').val().trim(),
                CustomerCode: $('#CustomerCode').val().trim(),
                Status: $('#FreightReconciliationStatus').val(),
                PaymentStatus: $('#PaymentStatus').val(),
                ApprovalDate: $('#ApprovalDate').val(),
                OrderCode: $('#OrderCode').val().trim(),
                EmsBarCode: $('#EmsBarCode').val().trim(),
            };
            if (agrs.CustomerPPCRM == "") {
                if (agrs.CustomerCode == "") {
                    errMsg = 'Vui nhập mã PayPost/CRM hoặc mã Khách Hàng';
                    isError = true;
                }
            }
            if (isError) {
                swal({
                    title: 'Thông báo',
                    text: errMsg,
                    icon: 'error',
                    button: {
                        text: "Đóng",
                        value: true,
                        visible: true,
                        className: "btn btn-primary"
                    }

                })
                return;
            }

            $.get('@Url.Action("GetDataPaymentCOD", "Payment")', agrs, function (htmlString) {
                $('#tbl-data').html(htmlString);
            });
        });

        $("#btnExportExcel").on("click", function () {
            var errMsg = '', isError = false;
            var agrs = {
                CustomerPPCRM: $('#CustomerPPCRM').val().trim(),
                CustomerCode: $('#CustomerCode').val().trim(),
                Status: $('#FreightReconciliationStatus').val(),
                PaymentStatus: $('#PaymentStatus').val(),
                ApprovalDate: $('#ApprovalDate').val(),
                OrderCode: $('#OrderCode').val().trim(),
                EmsBarCode: $('#EmsBarCode').val().trim(),
            };
            if (agrs.CustomerPPCRM == "") {
                if (agrs.CustomerCode == "") {
                    errMsg = 'Vui nhập mã PayPost/CRM hoặc mã Khách Hàng';
                    isError = true;
                }
            }
            if (isError) {
                swal({
                    title: 'Thông báo',
                    text: errMsg,
                    icon: 'error',
                    button: {
                        text: "Đóng",
                        value: true,
                        visible: true,
                        className: "btn btn-primary"
                    }

                })
                return;
            }
            window.location.href = "@Url.Action("ExportExcelDataPaymentCOD", "Payment")?CustomerPPCRM=" + agrs.CustomerPPCRM + "&CustomerCode=" + agrs.CustomerCode + "&Status=" + agrs.Status + "&ApprovalDate=" + agrs.ApprovalDate + "&OrderCode=" + agrs.OrderCode + "&EmsBarCode=" + agrs.EmsBarCode + "&PaymentStatus=" + agrs.PaymentStatus;
        });
    </script>
}
