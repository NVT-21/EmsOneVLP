
<div class="modal-dialog modal-700" role="document">
    <div class="modal-content">
        <div class="modal-header">
            <h4 class="modal-title">Đổi mật khẩu</h4>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body" id="ClearModal">
            <div class="row">
                <div class="col-xl-12 col-lg-12 col-md-12 mb-2">
                    <label for="">Mật khẩu cũ <span class="text-danger">(*)</span></label>
                    <div class="input-group">
                        <input type="password" class="form-control border-right-0" id="OldPassword" placeholder="Vui lòng nhập Mật khẩu cũ" maxlength="12" autocomplete="off"/>
                        <div class="input-group-append">
                            <button type="button" class="btn btn-sm form-control" style="color: gray; border-left: none;" id="btnDisplayOrHiddenOldPassword">
                                <div id="iDisplayOrHiddenOldPassword">
                                    <i class="fa fa-eye"></i>
                                </div>
                            </button>
                        </div>
                    </div>
                    <span class="text-danger" id="errOldPassword"></span>
                </div>
                <div class="col-xl-12 col-lg-12 col-md-12 mb-2">
                    <label for="">Mật khẩu mới <span class="text-danger">(*)</span></label>
                    <div class="input-group">
                        <input type="password" class="form-control border-right-0" id="NewPassword" placeholder="Vui lòng nhập Mật khẩu mới" maxlength="12" autocomplete="off">
                        <div class="input-group-append">
                            <button type="button" class="btn btn-sm form-control" style="color: gray; border-left: none;" id="btnDisplayOrHiddenNewPassword">
                                <div id="iDisplayOrHiddenNewPassword">
                                    <i class="fa fa-eye"></i>
                                </div>
                            </button>
                        </div>
                    </div>
                    <span class="text-danger" id="errNewPassword"></span>
                </div>
                <div class="col-xl-12 col-lg-12 col-md-12 mb-2">
                    <label for="">Nhập lại mật khẩu mới <span class="text-danger">(*)</span></label>
                    <div class="input-group">
                        <input type="password" class="form-control border-right-0" id="ConfirmPassword" placeholder="Vui lòng nhập lại Mật khẩu mới" maxlength="12" autocomplete="off"/>
                        <div class="input-group-append">
                            <button type="button" class="btn btn-sm form-control" style="color: gray; border-left: none;" id="btnDisplayOrHiddenConfirmPassword">
                                <div id="iDisplayOrHiddenConfirmPassword">
                                    <i class="fa fa-eye"></i>
                                </div>
                            </button>
                        </div>
                    </div>
                    <span class="text-danger" id="errConfirmPassword"></span>
                </div>
            </div>
        </div>
        <div class="modal-footer" style="display: block;">
            <div class="row">
                <div class="col-xl-12 col-lg-12 col-md-12 d-flex justify-content-between">
                    <button type="button" class="btn btn-sm btn-danger" data-dismiss="modal" aria-label="Close">HỦY BỎ</button>
                    <button type="button" class="btn btn-sm btn-primary" id="btnSubmit">XÁC NHẬN</button>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    CheckChangeValue("OldPassword", "Vui lòng nhập Mật khẩu cũ", "Password", "Y");
    CheckChangeValue("NewPassword", "Vui lòng nhập Mật khẩu mới", "Password", "Y");
    CheckChangeValue("ConfirmPassword", "Vui lòng nhập lại Mật khẩu mới", "Password", "Y");

    $("#btnDisplayOrHiddenOldPassword").on("click", function () {
        var TypeInput = document.getElementById("OldPassword").type;
        if (TypeInput == "password") {
            $("#OldPassword").attr("type", "text");
            $("#iDisplayOrHiddenOldPassword").html('<i class="fa fa-eye-slash"></i>');
        } else {
            $("#OldPassword").attr("type", "password");
            $("#iDisplayOrHiddenOldPassword").html('<i class="fa fa-eye"></i>');
        }
    });

    $("#btnDisplayOrHiddenNewPassword").on("click", function () {
        var TypeInput = document.getElementById("NewPassword").type;
        if (TypeInput == "password") {
            $("#NewPassword").attr("type", "text");
            $("#iDisplayOrHiddenNewPassword").html('<i class="fa fa-eye-slash"></i>');
        } else {
            $("#NewPassword").attr("type", "password");
            $("#iDisplayOrHiddenNewPassword").html('<i class="fa fa-eye"></i>');
        }
    });

    $("#btnDisplayOrHiddenConfirmPassword").on("click", function () {
        var TypeInput = document.getElementById("ConfirmPassword").type;
        if (TypeInput == "password") {
            $("#ConfirmPassword").attr("type", "text");
            $("#iDisplayOrHiddenConfirmPassword").html('<i class="fa fa-eye-slash"></i>');
        } else {
            $("#ConfirmPassword").attr("type", "password");
            $("#iDisplayOrHiddenConfirmPassword").html('<i class="fa fa-eye"></i>');
        }
    });

    $('#btnSubmit').on('click', function () {
        var errMessagePassword = "Mật khẩu phải có độ dài từ 6 đến 12 ký tự, bao gồm ký tự thường, ký tự in hoa, số và ký tự đặc biệt !#@@$%^&";
        var isError = false;
        var data = {
            OldPassword: $('#OldPassword').val().trim(),
            NewPassword: $('#NewPassword').val().trim(),
            ConfirmPassword: $('#ConfirmPassword').val().trim()
        };

        isError = CheckNullAndRegexValue(data.OldPassword, "Password", "OldPassword", "Vui lòng nhập Mật khẩu cũ.", errMessagePassword, isError);
        isError = CheckNullAndRegexValue(data.NewPassword, "Password", "NewPassword", "Vui lòng nhập Mật khẩu mới.", errMessagePassword, isError);
        isError = CheckNullAndRegexValue(data.ConfirmPassword, "Password", "ConfirmPassword", "Vui lòng nhập lại Mật khẩu mới.", errMessagePassword, isError);

        if (isError == false) {
            if (data.NewPassword != data.ConfirmPassword) {
                $("#errConfirmPassword").text("Xác nhận mật khẩu mới không trùng khớp.");
                $("#ConfirmPassword").focus();
                isError = true;
            }
        }

        if (isError == true) {
            return;
        }

        swal({
            title: 'Thông báo',
            text: "Bạn chắc chắn muốn đổi mật khẩu?",
            icon: 'warning',
            buttons: {
                confirm: {
                    text: "Có",
                    value: true,
                    visible: true,
                    className: "btn btn-primary",
                    closeModal: true
                },
                cancel: {
                    text: "Không",
                    value: false,
                    visible: true,
                    className: "btn btn-danger",
                    closeModal: true,
                }
            },
        }).then((value) => {
            if (value) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("JChangePassword", "User")',
                    data: data,
                    dataType: 'json',
                    success: function (res) {
                        if (res.Code == "00") {
                            CreateCustomSwal("success", res.Message);
                        } else {
                            CreateCustomSwal("error", res.Message);
                        }
                    },
                    error: function (xhr, status, error) {
                        var err = eval("(" + xhr.responseText + ")");
                        swal({
                            title: 'Lỗi',
                            text: err.Message,
                            icon: 'error',
                            button: {
                                text: "Đóng",
                                value: true,
                                visible: true,
                                className: "btn btn-primary"
                            }
                        });
                        return;
                    }
                });
            }
        });
    });
</script>