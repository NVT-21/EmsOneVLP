@model EMS.MVC.Backend.Models.EditFreightChargesViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="template-demo">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-custom">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index","Transport")">Quản lý cước vận chuyển</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index","Transport")">Cấu hình</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("FreightChargesView", "TransportMainService")">Danh sách bảng cước chính</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@Model.TransportPostageCode</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="mb-4">
                <ul class="nav nav-pills nav-pills-primary" id="pills-tab" role="tablist" style="border-bottom: none; padding-bottom:0; cursor: pointer;">
                    <li class="nav-item">
                        <a class="nav-link active" data-toggle="pill" role="tab" aria-selected="true" id="step1" onclick="GoToStep('step1')">
                            <b>1. Thông tin cơ bản</b>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-toggle="pill" role="tab" aria-selected="false" id="step2" onclick="GoToStep('step2')">
                            <b>2. Khai báo cước chính</b>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-toggle="pill" role="tab" aria-selected="false" id="step3" onclick="GoToStep('step3')">
                            <b>3. Khai báo phụ phí</b>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-toggle="pill" role="tab" aria-selected="false" id="step4" onclick="GoToStep('step4')">
                            <b>4. Lịch sử</b>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="card mt-3">
                <div class="card-body pt-10px">
                    <div id="Content">
                        @{
                            Html.RenderAction("EditBasicInfoTabView", "TransportMainService", new { TransportPostageID = Model.TransportPostageID });
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        function GoToStep(step) {
            var url = "";
            var data = {
                TransportPostageID: @Model.TransportPostageID,
                TransportPostageCode: '@Model.TransportPostageCode'
            }
            switch (step) {
                case "step1":
                    url = '@Url.Action("EditBasicInfoTabView", "TransportMainService")';
                    break;
                case "step2":
                    url = '@Url.Action("EditMainFeeTabView", "TransportMainService")';
                    break;
                case "step3":
                    url = '@Url.Action("EditSurchargeTabView", "TransportMainService")';
                    break;
                case "step4":
                     url = '@Url.Action("EditHistoryTabView", "TransportMainService")';
                    break;
                default:
                    url = '@Url.Action("PageNotFound", "Error")';
                    break;
            }

            $.post(url, data, function (htmlString) {
                $('#Content').html(htmlString);
            });
        }

        function btnConfirm() {
            swal({
                title: 'Thông báo',
                text: "Bạn chắc chắn muốn xác nhận?",
                buttons: {
                    confirm: {
                        text: "CÓ",
                        value: true,
                        visible: true,
                        className: "btn btn-primary",
                        closeModal: true
                    },
                    cancel: {
                        text: "KHÔNG",
                        value: false,
                        visible: true,
                        className: "btn btn-danger",
                        closeModal: true,
                    }
                },
            }).then((value) => {
                if (value) {
                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("JConfirm", "TransportMainService")',
                        dataType: 'json',
                        loading: true,
                        data: {
                            TransportPostageID: @Model.TransportPostageID,
                        },
                        success: function (res) {
                            if (res.Code == "00") {
                                CreateCustomSwal("success", res.Message, '@Url.Action("FreightChargesView", "TransportMainService")')
                            } else
                            if (res.Code == "03") {
                                swal({
                                    title: 'Thông báo',
                                    text: res.Message + "\n\n Đến nơi khai báo loại phạm vi?",
                                    buttons: {
                                        confirm: {
                                            text: "CÓ",
                                            value: true,
                                            visible: true,
                                            className: "btn btn-primary",
                                            closeModal: true
                                        },
                                        cancel: {
                                            text: "KHÔNG",
                                            value: false,
                                            visible: true,
                                            className: "btn btn-danger",
                                            closeModal: true,
                                        }
                                    },
                                }).then((value) => {
                                    if (value) {
                                        $('#step2').click();
                                    };
                                });
                            } else
                            if (res.Code == "04") {
                                swal({
                                    title: 'Thông báo',
                                    text: res.Message + "\n\n Đến nơi cấu hình cước dịch vụ chính?",
                                    buttons: {
                                        confirm: {
                                            text: "CÓ",
                                            value: true,
                                            visible: true,
                                            className: "btn btn-primary",
                                            closeModal: true
                                        },
                                        cancel: {
                                            text: "KHÔNG",
                                            value: false,
                                            visible: true,
                                            className: "btn btn-danger",
                                            closeModal: true,
                                        }
                                    },
                                }).then((value) => {
                                    if (value) {
                                        window.location.href = '@Url.Action("ConfigMainFeeView", "TransportMainService")?TransportPostageID=' + @Model.TransportPostageID;
                                    };
                                });
                            } else
                            if (res.Code == "05") {
                                swal({
                                    title: 'Thông báo',
                                    text: res.Message + "\n\n Đến nơi chỉnh sửa?",
                                    buttons: {
                                        confirm: {
                                            text: "CÓ",
                                            value: true,
                                            visible: true,
                                            className: "btn btn-primary",
                                            closeModal: true
                                        },
                                        cancel: {
                                            text: "KHÔNG",
                                            value: false,
                                            visible: true,
                                            className: "btn btn-danger",
                                            closeModal: true,
                                        }
                                    },
                                }).then((value) => {
                                    if (value) {
                                        $('#step1').click();
                                    };
                                });
                            } else {
                                CreateCustomSwal("error", res.Message);
                            }
                        },
                        error: function (xhr, status, error) {
                            var err = eval("(" + xhr.responseText + ")");
                            swal({
                                title: 'Lỗi',
                                text: err.Message,
                                button: {
                                    text: "ĐÓNG",
                                    value: true,
                                    visible: true,
                                    className: "btn btn-primary"
                                }
                            });
                            return;
                        }
                    });
                }
            });
        };
    </script>
}

