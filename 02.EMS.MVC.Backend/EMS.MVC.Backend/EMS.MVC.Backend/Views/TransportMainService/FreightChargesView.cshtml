@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="template-demo">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-custom">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index","Transport")">Quản lý cước vận chuyển</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index","Transport")">Cấu hình</a></li>
                        <li class="breadcrumb-item active" aria-current="page"><span>Danh sách bảng cước chính</span></li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-12">
                    <button class="btn btn-sm btn-primary mb-2 pull-right text-left w-auto" onclick="window.location.href = '@Url.Action("AddFreightChargesView", "TransportMainService")'">Tạo mới</button>
                </div>
                <div id="tbl-data" class="table-responsive">
                    @{ Html.RenderAction("SearchListFreightChargesView", "TransportMainService"); }
                </div>
            </div>
        </div>
    </div>
