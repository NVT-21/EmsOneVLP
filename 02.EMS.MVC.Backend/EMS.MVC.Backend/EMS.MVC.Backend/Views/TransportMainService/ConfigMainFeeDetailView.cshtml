@model List<EMS.MVC.Backend.Models.ConfigMainFeeDetailViewModel>

@{
    int temp = Model.Count - 1;
}

@if (ViewBag.TransportPostageRange == 1)
{
    <table id="Datatable" class="table table-bordered">
        <thead class="border text-center" style="background-color:aliceblue">
            <tr>
                <th class="border text-left" style="min-width:300px;">Nấc khối lượng (gram)<i class="fa fa-info-circle" title="Sẽ được tính từ khối lượng cao nhất đã cấu hình trước đến khối lượng này"></i></th>
                <th class="border text-right" style="min-width:150px;">Cước nội tỉnh (VNĐ)</th>
                <th class="border text-right" style="min-width:150px;">Cước liên tỉnh (VNĐ)</th>
                <th style="min-width:150px;"></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <input type="text" class="form-control" data-inputmask="'alias': 'PositiveNumber'" id="Weight" value="0" placeholder="Nhập khối lượng">
                    <label class="error-message pt-1" id="errWeight"></label>
                </td>
                <td>
                    <input type="text" class="form-control" data-inputmask="'alias': 'PositiveNumber'" id="LocalFee" value="0" placeholder="Nhập cước nội tỉnh">
                    <label class="error-message pt-1" id="errLocalFee"></label>
                </td>
                <td>
                    <input type="text" class="form-control" data-inputmask="'alias': 'PositiveNumber'" id="IntercityFee1" value="0" placeholder="Nhập cước liên tỉnh">
                    <label class="error-message pt-1" id="errIntercityFee1"></label>
                </td>
                <td class="text-center vertical-top">
                    <button class="btn btn-sm btn-primary w-auto float-left" id="Add_Detail" onclick="btnAdd()">Thêm</button>
                </td>
            </tr>
            @for (var i = 0; i < Model.Count - 1; i++)
            {
                <tr>
                    <td class="text-left">
                        <p>@Model[i].TransportPostageDetailName</p>
                    </td>
                    <td class="text-right vertical-top">
                        <input type="text" class="form-control" data-inputmask="'alias': 'PositiveNumber'" id="LocalFee_@Model[i].TransportPostageDetailID" value="@Model[i].LocalFee" disabled placeholder="Nhập cước nội tỉnh">
                        <label class="error-message pt-1" id="errLocalFee_@Model[i].TransportPostageDetailID"></label>
                    </td>
                    <td class="text-right vertical-top">
                        <input type="text" class="form-control" data-inputmask="'alias': 'PositiveNumber'" id="IntercityFee1_@Model[i].TransportPostageDetailID" value="@Model[i].IntercityFee1" disabled placeholder="Nhập giá">
                        <label class="error-message pt-1" id="errIntercityFee1_@Model[i].TransportPostageDetailID"></label>
                    </td>
                    <td class="form-group vertical-top" style="width:200px;">
                        <button class="btn btn-sm btn-warning float-left mr-2" name="btnEditDetail" onclick="btnEdit('@Model[i].TransportPostageDetailID','@ViewBag.TransportPostageRange','N')">Sửa</button>
                        <button class="btn btn-sm btn-danger" name="btnRemoveDetail" onclick="btnDelete('@Model[i].TransportPostageDetailID')">Xoá</button>

                        <button class="btn btn-sm btn-danger float-left mr-2 mb-2" style="display: none;" id="CancelEdit_@Model[i].TransportPostageDetailID" onclick="btnCancel()">Huỷ</button>
                        <button class="btn btn-sm btn-primary" style="display:none;" id="EditConfirmation_@Model[i].TransportPostageDetailID" onclick="btnConfirm('@Model[i].TransportPostageDetailID', '@ViewBag.TransportPostageRange','N')">Xác nhận</button>
                    </td>
                </tr>
            }
            <tr>
                <td class="text-left vertical-top">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="form-control input-group-text">Mỗi nấc</span>
                        </div>
                        <input type="text" class="form-control" data-inputmask="'alias': 'PositiveNumber'" id="StepWeight" value="@Model[temp].Weight" disabled placeholder="Nhập khối lượng">
                        <div class="input-group-append">
                            <span class="form-control input-group-text">tiếp theo</span>
                        </div>
                    </div>
                </td>
                <td class="text-right vertical-top">
                    <input type="text" class="form-control" data-inputmask="'alias': 'PositiveNumber'" id="LocalFee_@Model[temp].TransportPostageDetailID" value="@Model[temp].LocalFee" disabled placeholder="Nhập cước nội tỉnh">
                    <label class="error-message pt-1" id="errLocalFee_@Model[temp].TransportPostageDetailID"></label>
                </td>
                <td class="text-right vertical-top">
                    <input type="text" class="form-control" data-inputmask="'alias': 'PositiveNumber'" id="IntercityFee1_@Model[temp].TransportPostageDetailID" value="@Model[temp].IntercityFee1" disabled placeholder="Nhập giá">
                    <label class="error-message pt-1" id="errIntercityFee1_@Model[temp].TransportPostageDetailID"></label>
                </td>
                <td class="form-group vertical-top" style="width:200px;">
                    <button class="btn btn-sm btn-warning float-left mr-2" name="btnEditDetail" onclick="btnEdit('@Model[temp].TransportPostageDetailID','@ViewBag.TransportPostageRange','Y')">Sửa</button>
                    <button class="btn btn-sm btn-danger float-left mr-2 mb-2" style="display: none;" id="CancelEdit_@Model[temp].TransportPostageDetailID" onclick="btnCancel()">Huỷ</button>
                    <button class="btn btn-sm btn-primary" style="display:none;" id="EditConfirmation_@Model[temp].TransportPostageDetailID" onclick="btnConfirm('@Model[temp].TransportPostageDetailID','@ViewBag.TransportPostageRange','Y')">Xác nhận</button>
                </td>
            </tr>
        </tbody>
    </table>
}
