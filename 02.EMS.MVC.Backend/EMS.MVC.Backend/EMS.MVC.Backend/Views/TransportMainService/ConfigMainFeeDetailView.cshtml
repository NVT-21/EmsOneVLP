<script>
    $(document).ready(function () {
        $('select.select2').select2(AttributeSelect2);
        $(":input").inputmask();
        $('#Weight').focus();
    });

    CheckChangeValue("Weight", "Vui lòng nhập Khối lượng", "Number", "Y");

    //ENTER
    $('#Weight, #LocalFee, #IntercityFee1, #IntercityFee2, #IntercityFee3, #IntercityFee4').keypress(function (e) {
        if (e.keyCode === 13) {
            $('#Add_Detail').click();
        }
    });

    function btnAdd() {
        var isError = false;
        var data = {
            TransportPostageID: @ViewBag.TransportPostageID,
            TransportPostageRange: @ViewBag.TransportPostageRange,
            Weight: NumberReplace($('#Weight').val()),
        };

        if (data.TransportPostageRange == 1 || data.TransportPostageRange == 2 || data.TransportPostageRange == 3 || data.TransportPostageRange == 5 || data.TransportPostageRange == 6) {
            data.LocalFee = NumberReplace($('#LocalFee').val());
        }

        if (data.TransportPostageRange == 1)
        {
            data.IntercityFee1 = NumberReplace($('#IntercityFee1').val());
            data.Key = "M1";
        }
        else if (data.TransportPostageRange == 2)
        {
            data.IntercityFee1 = NumberReplace($('#IntercityFee1').val());
            data.IntercityFee2 = NumberReplace($('#IntercityFee2').val());
            data.IntercityFee3 = NumberReplace($('#IntercityFee3').val());
            data.IntercityFee4 = NumberReplace($('#IntercityFee4').val());
            data.Key = "M2";
        }
        else if (data.TransportPostageRange == 3)
        {
            data.IntercityFee1 = NumberReplace($('#IntercityFee1').val());
            data.IntercityFee2 = NumberReplace($('#IntercityFee2').val());
            data.Key = "M3";
        }
        else if (data.TransportPostageRange == 4)
        {
            data.IntercityFee1 = NumberReplace($('#IntercityFee1').val());
            data.IntercityFee2 = NumberReplace($('#IntercityFee2').val());
            data.IntercityFee3 = NumberReplace($('#IntercityFee3').val());
            data.IntercityFee4 = NumberReplace($('#IntercityFee4').val());
            data.Key = "M4";
        }
        else if (data.TransportPostageRange == 5) {
            data.IntercityFee1 = NumberReplace($('#IntercityFee1').val());
            data.IntercityFee2 = NumberReplace($('#IntercityFee2').val());
            data.IntercityFee3 = NumberReplace($('#IntercityFee3').val());
            data.IntercityFee4 = NumberReplace($('#IntercityFee4').val());
            data.Key = "M5";
        } else if (data.TransportPostageRange == 6) {
            data.IntercityFee1 = NumberReplace($('#IntercityFee1').val());
            data.IntercityFee2 = NumberReplace($('#IntercityFee2').val());
            data.IntercityFee3 = NumberReplace($('#IntercityFee3').val());
            data.Key = "M6";
        }
        else
        {
            CreateCustomSwal("error", "Không xác định được loại phạm vi tính cước. Vui lòng thử lại hoăc liên hệ quản trị.");
            return;
        }

        isError = CheckNullAndRegexValue(parseInt(data.Weight), "Number", "Weight", "Vui lòng nhập Khối lượng", "Chỉ được nhập số", isError);

        if (isError == true) {
            return;
        }

        $.ajax({
            type: 'POST',
            url: '@Url.Action("JAddConfigMainFeeDetailView", "TransportMainService")',
            dataType: 'json',
            loading: true,
            data: data,
            success: function (res) {
                if (res.Code == "00") {
                    $.post('@Url.Action("ConfigMainFeeDetailView", "TransportMainService")', data, function (data) {
                        $('#Data').html(data);
                    });
                } else {
                    CreateCustomSwal("error", res.Message);
                }
            },
            error: function (xhr, status, error) {
                var err = eval("(" + xhr.responseText + ")");
                swal({
                    title: 'Lỗi',
                    text: err.Message,
                    button: {
                        text: "ĐÓNG",
                        value: true,
                        visible: true,
                        className: "btn btn-primary"
                    }
                });
                return;
            }
        });
    }

