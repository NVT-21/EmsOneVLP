    function btnDelete(DetailID) {
        var data = {
            TransportPostageID: @ViewBag.TransportPostageID,
            TransportPostageRange: @ViewBag.TransportPostageRange,
            TransportPostageDetailID: DetailID
        };

        swal({
            title: 'Thông báo',
            text: "Bạn chắc chắn muốn xoá bỏ?",
            buttons: {
                confirm: {
                    text: "CÓ",
                    value: true,
                    visible: true,
                    className: "btn btn-primary",
                    closeModal: true
                },
                cancel: {
                    text: "KHÔNG",
                    value: false,
                    visible: true,
                    className: "btn btn-danger",
                    closeModal: true,
                }
            },
        }).then((value) => {
            if (value) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("JRemoveConfigMainFeeDetailView", "TransportMainService")',
                    dataType: 'json',
                    loading: true,
                    data: {
                        TransportPostageDetailID: data.TransportPostageDetailID
                    },
                    success: function (res) {
                        if (res.Code == "00") {
                            swal({
                                title: "Thông báo",
                                text: res.Message,
                                button: false,
                                timer: 1500
                            }).then(function () {
                                $.post('@Url.Action("ConfigMainFeeDetailView", "TransportMainService")', data, function (data) {
                                    $('#Data').html(data);
                                });
                            });
                        } else {
                            CreateCustomSwal("error", res.Message);
                        }
                    },
                    error: function (xhr, status, error) {
                        var err = eval("(" + xhr.responseText + ")");
                        swal({
                            title: 'Lỗi',
                            text: err.Message,
                            button: {
