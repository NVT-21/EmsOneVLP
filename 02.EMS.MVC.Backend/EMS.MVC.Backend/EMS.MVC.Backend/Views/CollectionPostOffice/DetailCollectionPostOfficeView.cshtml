@model EMS.MVC.Backend.Models.DetailCollectionPostOfficeViewModel
@Html.HiddenFor(m => m.ID)
@Html.HiddenFor(m => m.ParentID)
@Html.HiddenFor(m => m.RegionName)

<div class="card" style="min-height: 591px;">
    <div class="card-body">
        <div class="row justify-content-between">
            @if (Model.ParentID == 0)
            {
                <h3 class="text-left mb-2">@Model.CollectionPostOfficeName</h3>
                <button type="button" class="btn btn-sm btn-primary" id="btnAddCollectionPostOffice">THÊM BƯU CỤC</button>
            }
            else
            {
                <h3 class="text-left mb-2">@Model.CollectionPostOfficeCode - @Model.CollectionPostOfficeName</h3>
            }
        </div>
        @if (Model.ParentID == 0)
        {
            <div class="row mb-2">
                <div class="col-xl-4 col-lg-12 col-md-12 mb-2">
                    <label>Tên khu vực <span class="text-danger">(*)</span></label>
                    @Html.EditorFor(m => m.CollectionPostOfficeName, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Tên khu vực", @maxlength = "150" } })
                    <span class="text-danger" id="errCollectionPostOfficeName"></span>
                </div>
                <div class="col-xl-4 col-lg-12 col-md-12 mb-2">
                    <label>Trạng thái hoạt động</label>
                    @Html.DropDownListFor(m => m.IsLock.Code, new SelectList(Model.ListIsLock, "Value", "Text", "N"), new { @class = "select2" })
                    <span class="text-danger" id="errIsLock_Code"></span>
                </div>
            </div>
        }
        else
        {
            <div class="row mb-2">
                <div class="col-xl-2 col-lg-12 col-md-12 mb-2">
                    <label>Mã bưu cục</label>
                    @Html.EditorFor(m => m.CollectionPostOfficeCode, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Mã bưu cục", @maxlength = "8", @disabled = "true" } })
                    <span class="text-danger" id="errCollectionPostOfficeCode"></span>
                </div>
                <div class="col-xl-4 col-lg-12 col-md-12 mb-2">
                    <label>Tên bưu cục <span class="text-danger">(*)</span></label>
                    @Html.EditorFor(m => m.CollectionPostOfficeName, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Tên bưu cục", @maxlength = "150" } })
                    <span class="text-danger" id="errCollectionPostOfficeName"></span>
                </div>
                <div class="col-xl-3 col-lg-12 col-md-12 mb-2">
                    <label>Loại bưu cục</label>
                    @Html.DropDownListFor(m => m.CollectionPostOfficeType.Code, new SelectList(Model.ListCollectionPostOfficeType, "Value", "Text"), new { @class = "select2" })
                    <span class="text-danger" id="errCollectionPostOfficeType_Code"></span>
                </div>
                <div class="col-xl-3 col-lg-12 col-md-12 mb-2">
                    <label>Trạng thái hoạt động</label>
                    @Html.DropDownListFor(m => m.IsLock.Code, new SelectList(Model.ListIsLock, "Value", "Text", "N"), new { @class = "select2" })
                    <span class="text-danger" id="errIsLock_Code"></span>
                </div>
                <div class="col-xl-12 col-lg-12 col-md-12 mb-2">
                    <label>Địa chỉ <span class="text-danger">(*)</span></label>
                    @Html.EditorFor(m => m.Street, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Địa chỉ", @maxlength = "400", @autocomplete = "off" } })
                    <span class="text-danger" id="errStreet"></span>
                </div>
                <div class="col-xl-4 col-lg-12 col-md-12 mb-2">
                    <label>Tỉnh/ Thành phố <span class="text-danger">(*)</span></label>
                    @Html.DropDownListFor(m => m.ProvinceID, new SelectList(Model.ListProvince, "ID", "Name"), "--- Tỉnh/ Thành phố ---", new { @class = "select2", @onchange = "LoadListWardV2('ProvinceID', 'WardID')" })
                    <span class="text-danger" id="errProvinceID"></span>
                </div>
                @*<div class="col-xl-4 col-lg-12 col-md-12 mb-2">
                    <label>Quận/ Huyện <span class="text-danger">(*)</span></label>
                    @Html.DropDownListFor(m => m.DistrictID, new SelectList(Model.ListDistrict, "ID", "Name"), "--- Quận/ Huyện ---", new { @class = "select2", @onchange = "LoadListWard('DistrictID', 'WardID')" })
                    <span class="text-danger" id="errDistrictID"></span>
                </div>*@
                <div class="col-xl-4 col-lg-12 col-md-12 mb-2">
                    <label>Phường/ Xã <span class="text-danger">(*)</span></label>
                    @Html.DropDownListFor(m => m.WardID, new SelectList(Model.ListWard, "ID", "Name"), "--- Phường/ Xã ---", new { @class = "select2" })
                    <span class="text-danger" id="errWardID"></span>
                </div>
                <div class="col-xl-3 col-lg-4 col-md-12 mb-2">
                    <label>Email</label>
                    @Html.EditorFor(m => m.Email, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Địa chỉ email", @maxlength = "100" } })
                    <span class="text-danger" id="errEmail"></span>
                </div>
                <div class="col-xl-3 col-lg-4 col-md-12 mb-2">
                    <label>UserCMS <span class="text-danger">(*)</span></label>
                    @Html.EditorFor(m => m.UserCMS, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "User CMS", @maxlength = "100" } })
                    <span class="text-danger" id="errUserCMS"></span>
                </div>
            </div>
        }
        <div class="row">
            <div class="col-xl-12 col-lg-12 col-md-12 mb-2">
                <button type="button" class="btn btn-sm btn-primary" id="btnEditCollectionPostOffice">CẬP NHẬT</button>
            </div>
        </div>
    </div>
</div>


<script>
    var RegionName = $("#RegionName").val().toLowerCase();

    $(document).ready(function () {
        $('select.select2').select2(AttributeSelect2);
    });

    CheckChangeValue("CollectionPostOfficeName", "Vui lòng nhập Tên " + RegionName, "", "Y");
    CheckChangeValue("ProvinceID", "Vui lòng chọn Tỉnh/ Thành phố", "", "Y");
    //CheckChangeValue("DistrictID", "Vui lòng chọn Quận/ Huyện", "", "Y");
    CheckChangeValue("WardID", "Vui lòng chọn Phường/ Xã", "", "Y");
    CheckChangeValue("Street", "Vui lòng nhập Địa chỉ", "", "Y");
    CheckChangeValue("Email", "", "Email", "N");
    CheckChangeValue("UserCMS", "Vui lòng nhập User CMS", "", "Y");
    VNPMapsAutocomplete('Street', 'ProvinceID', 'DistrictID', 'WardID');

    $("#btnAddCollectionPostOffice").on("click", function () {
        $.get('@Url.Action("AddCollectionPostOfficeView", "CollectionPostOffice")', {
            ParentID: $("#ID").val(),
        }, function (data) {
            $('#modal-common-container').html(data);
            $('#modal-common').modal('show');
        });
    });

    $("#btnEditCollectionPostOffice").on("click", function () {
        var isError = false;
        var data = {
            ID: $("#ID").val(),
            ParentID: $("#ParentID").val(),
            CollectionPostOfficeName: $("#CollectionPostOfficeName").val().trim(),
            IsLock: {
                Code: $("#IsLock_Code").val(),
            },
            CollectionPostOfficeType: {
                Code: "1"
            }
        }
        if (data.ParentID > 0) {
            data.CollectionPostOfficeType = {
                Code: $("#CollectionPostOfficeType_Code").val()
            };
            data.ProvinceID = $("#ProvinceID").val();
            //data.DistrictID = $("#DistrictID").val();
            data.WardID = $("#WardID").val();
            data.Street = $("#Street").val().trim();
            data.Email = $("#Email").val().trim();
            data.UserCMS = $("#UserCMS").val().trim();

            isError = CheckNullValue(data.ProvinceID, "ProvinceID", "Vui lòng chọn Tỉnh/ Thành phố", isError);
            //isError = CheckNullValue(data.DistrictID, "DistrictID", "Vui lòng chọn Quận/ Huyện", isError);
            isError = CheckNullValue(data.WardID, "WardID", "Vui lòng chọn Phường/ Xã", isError);
            isError = CheckNullValue(data.Street, "Street", "Vui lòng nhập Địa chỉ", isError);
            isError = CheckRegexValue(data.Email, "Email", "Email", "Địa chỉ Email không hợp lệ", isError);
            isError = CheckNullValue(data.UserCMS, "UserCMS", "Vui lòng nhập User CMS", isError);
        }

        isError = CheckNullValue(data.CollectionPostOfficeName, "CollectionPostOfficeName", "Vui lòng nhập tên " + RegionName, isError);

        if (isError == true) {
            return;
        }

        swal({
            title: 'Thông báo',
            text: "Bạn chắc chắn muốn cập nhật thông tin?",
            icon: 'warning',
            buttons: {
                confirm: {
                    text: "Có",
                    value: true,
                    visible: true,
                    className: "btn btn-primary",
                    closeModal: true
                },
                cancel: {
                    text: "Không",
                    value: false,
                    visible: true,
                    className: "btn btn-danger",
                    closeModal: true,
                }
            },
        }).then((value) => {
            if (value) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("JEditCollectionPostOffice", "CollectionPostOffice")',
                    data: data,
                    dataType: 'json',
                    success: function (res) {
                       if (res.Code == "00") {
                            swal({
                                title: "Thông báo",
                                text: res.Message,
                                button: false,
                                timer: 1500
                            }).then(function () {
                                var CurrentCollectionPostOfficeName = '@Model.CollectionPostOfficeName';
                                if (data.CollectionPostOfficeName != CurrentCollectionPostOfficeName) {
                                    $('#TreeView').jstree(true).refresh();
                                }
                            });
                        } else {
                            swal({
                                title: "Thông báo",
                                text: res.Message,
                                button: {
                                    text: "ĐÓNG"
                                }
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        var err = eval("(" + xhr.responseText + ")");
                        swal({
                            title: 'Lỗi',
                            text: err.Message,
                            icon: 'error',
                            button: {
                                text: "Đóng",
                                value: true,
                                visible: true,
                                className: "btn btn-primary"
                            }
                        });
                        return;
                    }
                });
            }
        });
    });
</script>