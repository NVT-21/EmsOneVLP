@model EMS.MVC.Backend.Models.AddCollectionPostOfficeViewModel

@Html.HiddenFor(m => m.ParentID, new { @id = "M_ParentID" })
@Html.HiddenFor(m => m.RegionName, new { @id = "M_RegionName" })
<div class="modal-dialog modal-xl" role="document">
    <div class="modal-content">
        <div class="modal-header">
            <h4 class="modal-title">Thêm mới @Model.RegionName</h4>
            <button type="button" id="CloseModal" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body" id="ClearModal">
            <div class="row">
                @if (Model.ParentID == 0)
                {
                    <div class="col-xl-4 col-lg-6 col-md-12 mb-2">
                        <label>Tên khu vực <span class="text-danger">(*)</span></label>
                        @Html.EditorFor(m => m.CollectionPostOfficeName, new { htmlAttributes = new { @type = "text", @class = "form-control", @id = "M_CollectionPostOfficeName", @placeholder = "Tên khu vực", @maxlength = "150" } })
                        <span class="text-danger" id="errM_CollectionPostOfficeName"></span>
                    </div>
                    <div class="col-xl-4 col-lg-6 col-md-12 mb-2">
                        <label>Trạng thái hoạt động</label>
                        @Html.DropDownListFor(m => m.IsLock, new SelectList(Model.ListIsLock, "Value", "Text", "N"), new { @class = "select2", @id = "M_IsLock" })
                        <span class="text-danger" id="errM_IsLock"></span>
                    </div>
                }
                else
                {
                    <div class="col-xl-3 col-lg-4 col-md-12 mb-2">
                        <label>Mã bưu cục <span class="text-danger">(*)</span></label>
                        @Html.EditorFor(m => m.CollectionPostOfficeCode, new { htmlAttributes = new { @type = "text", @class = "form-control", @id = "M_CollectionPostOfficeCode", @placeholder = "Mã bưu cục", @maxlength = "8" } })
                        <span class="text-danger" id="errM_CollectionPostOfficeCode"></span>
                    </div>
                    <div class="col-xl-3 col-lg-4 col-md-12 mb-2">
                        <label>Tên bưu cục <span class="text-danger">(*)</span></label>
                        @Html.EditorFor(m => m.CollectionPostOfficeName, new { htmlAttributes = new { @type = "text", @class = "form-control", @id = "M_CollectionPostOfficeName", @placeholder = "Tên bưu cục", @maxlength = "150" } })
                        <span class="text-danger" id="errM_CollectionPostOfficeName"></span>
                    </div>
                    <div class="col-xl-3 col-lg-4 col-md-12 mb-2">
                        <label>Loại bưu cục</label>
                        @Html.DropDownListFor(m => m.CollectionPostOfficeType, new SelectList(Model.ListCollectionPostOfficeType, "Value", "Text"), new { @class = "select2", @id = "M_CollectionPostOfficeType" })
                        <span class="text-danger" id="errM_CollectionPostOfficeType"></span>
                    </div>
                    <div class="col-xl-3 col-lg-4 col-md-12 mb-2">
                        <label>Trạng thái hoạt động</label>
                        @Html.DropDownListFor(m => m.IsLock, new SelectList(Model.ListIsLock, "Value", "Text", "N"), new { @class = "select2", @id = "M_IsLock" })
                        <span class="text-danger" id="errM_IsLock"></span>
                    </div>
                    <div class="col-xl-12 col-lg-4 col-md-12 mb-2">
                        <label>Địa chỉ <span class="text-danger">(*)</span></label>
                        @Html.EditorFor(m => m.Street, new { htmlAttributes = new { @type = "text", @class = "form-control", @id = "M_Street", @placeholder = "Địa chỉ", @maxlength = "400", @autocomplete = "off" } })
                        <span class="text-danger" id="errM_Street"></span>
                    </div>
                    <div class="col-xl-4 col-lg-4 col-md-12 mb-2">
                        <label>Tỉnh/ Thành phố <span class="text-danger">(*)</span></label>
                        @Html.DropDownListFor(m => m.ProvinceID, new SelectList(Model.ListProvince, "ID", "Name"), "--- Tỉnh/ Thành phố ---", new { @class = "select2", @id = "M_ProvinceID", @onchange = "LoadListWardV2('M_ProvinceID', 'M_WardID')" })
                        <span class="text-danger" id="errM_ProvinceID"></span>
                    </div>
                    @*<div class="col-xl-4 col-lg-4 col-md-12 mb-2">
                        <label>Quận/ Huyện <span class="text-danger">(*)</span></label>
                        @Html.DropDownListFor(m => m.DistrictID, new SelectList(Model.ListDistrict, "ID", "Name"), "--- Quận/ Huyện ---", new { @class = "select2", @id = "M_DistrictID", @onchange = "LoadListWard('M_DistrictID', 'M_WardID')" })
                        <span class="text-danger" id="errM_DistrictID"></span>
                    </div>*@
                    <div class="col-xl-4 col-lg-4 col-md-12 mb-2">
                        <label>Phường/ Xã <span class="text-danger">(*)</span></label>
                        @Html.DropDownListFor(m => m.WardID, new SelectList(Model.ListWard, "ID", "Name"), "--- Phường/ Xã ---", new { @class = "select2", @id = "M_WardID" })
                        <span class="text-danger" id="errM_WardID"></span>
                    </div>
                    <div class="col-xl-3 col-lg-4 col-md-12 mb-2">
                        <label>Email</label>
                        @Html.EditorFor(m => m.Email, new { htmlAttributes = new { @type = "text", @class = "form-control", @id = "M_Email", @placeholder = "Địa chỉ email", @maxlength = "100" } })
                        <span class="text-danger" id="errM_Email"></span>
                    </div>
                    <div class="col-xl-3 col-lg-4 col-md-12 mb-2">
                        <label>UserCMS <span class="text-danger">(*)</span></label>
                        @Html.EditorFor(m => m.UserCMS, new { htmlAttributes = new { @type = "text", @class = "form-control", @id = "M_UserCMS", @placeholder = "User CMS", @maxlength = "100" } })
                        <span class="text-danger" id="errM_UserCMS"></span>
                    </div>
                }
            </div>
        </div>
        <div class="modal-footer">
            <div class="col-lg-12 col-md-12">
                <div class="row justify-content-between">
                    <button type="button" class="btn btn-sm btn-danger" data-dismiss="modal" aria-label="Close">HUỶ BỎ</button>
                    <button type="button" class="btn btn-sm btn-primary" id="btnM_AddCollectionPostOffice">XÁC NHẬN</button>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $('select.select2').select2(AttributeSelect2);
    });

    var M_RegionName = $("#M_RegionName").val();
    OnlyNumber("#M_CollectionPostOfficeCode");
    CheckChangeValue("M_CollectionPostOfficeCode", "Vui lòng nhập Mã bưu cục", "", "Y");
    CheckChangeValue("M_CollectionPostOfficeName", "Vui lòng nhập Tên " + M_RegionName, "", "Y");
    CheckChangeValue("M_ProvinceID", "Vui lòng chọn Tỉnh/ Thành phố", "", "Y");
    //CheckChangeValue("M_DistrictID", "Vui lòng chọn Quận/ Huyện", "", "Y");
    CheckChangeValue("M_WardID", "Vui lòng chọn Phường/ Xã", "", "Y");
    CheckChangeValue("M_Street", "Vui lòng nhập Địa chỉ", "", "Y");
    CheckChangeValue("M_Email", "", "Email", "N");
    CheckChangeValue("M_UserCMS", "Vui lòng nhập User CMS", "", "Y");
    //VNPMapsAutocomplete('M_Street', 'M_ProvinceID', 'M_DistrictID', 'M_WardID');

    $("#btnM_AddCollectionPostOffice").on("click", function () {
        var isError = false;
        var data = {
            ParentID: $("#M_ParentID").val(),
            CollectionPostOfficeName: $("#M_CollectionPostOfficeName").val().trim(),
            IsLock: $("#M_IsLock").val(),
        }
        if (data.ParentID > 0) {
            data.CollectionPostOfficeCode = $("#M_CollectionPostOfficeCode").val().trim();
            data.CollectionPostOfficeType = $("#M_CollectionPostOfficeType").val();
            data.ProvinceID = $("#M_ProvinceID").val();
            //data.DistrictID = $("#M_DistrictID").val();
            data.WardID = $("#M_WardID").val();
            data.Street = $("#M_Street").val().trim();
            data.Email = $("#M_Email").val().trim();
            data.UserCMS = $("#M_UserCMS").val().trim();

            isError = CheckNullValue(data.CollectionPostOfficeCode, "M_CollectionPostOfficeCode", "Vui lòng nhập Mã bưu cục", isError);
            isError = CheckNullValue(data.ProvinceID, "M_ProvinceID", "Vui lòng chọn Tỉnh/ Thành phố", isError);
            //isError = CheckNullValue(data.DistrictID, "M_DistrictID", "Vui lòng chọn Quận/ Huyện", isError);
            isError = CheckNullValue(data.WardID, "M_WardID", "Vui lòng chọn Phường/ Xã", isError);
            isError = CheckNullValue(data.Street, "M_Street", "Vui lòng nhập Địa chỉ", isError);
            isError = CheckRegexValue(data.Email, "Email", "M_Email", "Địa chỉ Email không hợp lệ", isError);
            isError = CheckNullValue(data.UserCMS, "M_UserCMS", "Vui lòng nhập User CMS", isError);
        }

        isError = CheckNullValue(data.CollectionPostOfficeName, "M_CollectionPostOfficeName", "Vui lòng nhập Tên " + M_RegionName, isError);
       
        if (isError == true) {
            return;
        }

        $.ajax({
            type: 'POST',
            url: '@Url.Action("JAddCollectionPostOffice", "CollectionPostOffice")',
            data: data,
            dataType: 'json',
            success: function (res) {
                if (res.Code == "00") {
                    CreateCustomSwal("success", res.Message);
                } else {
                    CreateCustomSwal("error", res.Message);
                }
            },
            error: function (xhr, status, error) {
                var err = eval("(" + xhr.responseText + ")");
                swal({
                    title: 'Lỗi',
                    text: err.Message,
                    icon: 'error',
                    button: {
                        text: "Đóng",
                        value: true,
                        visible: true,
                        className: "btn btn-primary"
                    }
                });
                return;
            }
        });
    });
</script>