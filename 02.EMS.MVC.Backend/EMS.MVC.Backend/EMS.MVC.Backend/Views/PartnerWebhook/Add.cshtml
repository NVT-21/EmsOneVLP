<div class="modal-dialog modal-md" role="document">
    <div class="modal-content">
        <div class="modal-header">
            <h4 class="modal-title">Thêm mới thông tin đối tác Webhook</h4>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body" id="ClearModal">
            <div class="row">
                <div class="col-xl-12 col-lg-12 col-md-12 mb-2">
                    <label>Mã PP/CRM <span style="color: red">(*)</span></label>
                    <input type="text" class="form-control" id="PartnerCode" placeholder="Mã PP/CRM">
                    <span class="text-danger" id="errPartnerCode"></span>
                </div>
                <div class="col-xl-12 col-lg-12 col-md-12 mb-2">
                    <label>Tên đối tác <span style="color: red">(*)</span></label>
                    <input type="text" class="form-control" id="PartnerName" placeholder="Tên đối tác" maxlength="100">
                    <span class="text-danger" id="errPartnerName"></span>
                </div>
                <div class="col-xl-12 col-lg-12 col-md-12 mb-2">
                    <label>Link Webhook <span style="color: red">(*)</span></label>
                    <input type="text" class="form-control" id="PartnerUrl" placeholder="Link Webhook">
                    <span class="text-danger" id="errPartnerUrl"></span>
                </div>
                <div class="col-xl-12 col-lg-12 col-md-12 mb-2">
                    <label>API Key</label>
                    <input type="text" class="form-control" id="PartnerKey" placeholder="API Key" maxlength="100">
                    <span class="text-danger" id="errPartnerKey"></span>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <div class="col-lg-12 col-md-12">
                <div class="row justify-content-between">
                    <button type="button" class="btn btn-sm btn-danger" data-dismiss="modal" aria-label="Close">HUỶ BỎ</button>
                    <button type="button" class="btn btn-sm btn-primary" id="btn-submit">THÊM MỚI</button>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $("input[id=PartnerCode_tag]").keyup(function () {
            var value = $(this).val();
            $(this).val(value.toUpperCase());
        });

        $("input[id=PartnerCode_tag]").bind("paste", function (e) {
            var source = "";

            if (window.clipboardData !== undefined) {
                source = window.clipboardData;
            } else {
                source = e.originalEvent.clipboardData;
            }

            var data = source.getData("Text");

            var replaceSpace = data.split(/\s+/);

            $.each(replaceSpace, function (idx, value) {
                if (value.trim()) {
                    $('#PartnerCode').tagsinput('add', value.toUpperCase());
                }
            });

            e.preventDefault();
        });
    });

    CheckChangeValue("PartnerName", "Vui lòng nhập tên đối tác.", "Vietnamese", "Y");
    CheckChangeValue("PartnerUrl", "Vui lòng nhập link Webhook.", "", "Y");

    $('#PartnerCode').tagsinput({
        maxChars: 20,
        trimValue: true,
        confirmKeys: [13, 32], //13 - enter, 32 - space, 44 - comma
    });

    $('#PartnerCode').on('beforeItemAdd', function (event) {
        var CrmOrPaypostcode = event.item;
        var isError = CheckRegexValue(CrmOrPaypostcode, "Code", "PartnerCode", "Giá trị hợp lệ chỉ bao gồm chữ cái (a-zA-Z), số (0-9) và dấu -", false);
        if (isError == true) {
            event.cancel = true;
        }
    });

    $(".bootstrap-tagsinput input").attr("id", "PartnerCode_tag");

