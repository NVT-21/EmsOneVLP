    //    }
    //    else if (isCheckNull) {
    //        $(errWhere).text('Trường này không được để trống.');
    //        return true;
    //    }
    //    return isError;
    //}
    $('#btn-submit').on('click', function () {
        var isError = false;
        var data = {
            PartnerCode: $('#PartnerCode').val(),
            PartnerName: $('#PartnerName').val().trim(),
            PartnerUrl: $('#PartnerUrl').val().trim(),
            PartnerKey: $('#PartnerKey').val().trim()
        };

        isError = CheckNullAndRegexValue(data.PartnerCode, "ChildCustomerCode", "PartnerCode", "Vui lòng nhập mã PP/CRM", "Giá trị hợp lệ chỉ bao gồm chữ cái (a-z), số (0-9) và dấu -", isError);
        isError = CheckNullAndRegexValue(data.PartnerName, "Vietnamese", "PartnerName", "Vui lòng nhập tên đối tác.", "Giá trị hợp lệ không bao gồm ký tự đặc biệt.", isError);
        isError = CheckNullValue(data.PartnerUrl, "PartnerUrl", "Vui lòng nhập link Webhook", isError);

        if (isError == true) {
            return;
        }

        $.ajax({
            type: 'POST',
            url: '@Url.Action("JAdd", "PartnerWebhook")',
            data: data,
            dataType: 'json',
            success: function (res) {
                if (res.Code == "00") {
                    CreateCustomSwal("success", res.Message);
                } else {
                    CreateCustomSwal("error", res.Message);
                }
            },
            error: function (xhr, status, error) {
                var err = eval("(" + xhr.responseText + ")");
                swal({
                    title: 'Lỗi',
                    text: err.Message,
                    icon: 'error',
                    button: {
                        text: "Đóng",
                        value: true,
                        visible: true,
                        className: "btn btn-primary"
                    }
                });
                return;
            }
        });
    });
</script>