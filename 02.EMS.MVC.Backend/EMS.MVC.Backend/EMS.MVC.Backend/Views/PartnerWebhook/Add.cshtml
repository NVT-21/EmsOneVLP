    //        if (!value.match(/^[a-zA-Z0-9-,]+$/i)) {
    //            $(errWhere).text("Chỉ được phép nhập chữ cái (a-z), số (0-9), dấu phẩy và dấu -");
    //            return true;
    //        }
    //        else {
    //            $(errWhere).text('');
    //            return isError;
