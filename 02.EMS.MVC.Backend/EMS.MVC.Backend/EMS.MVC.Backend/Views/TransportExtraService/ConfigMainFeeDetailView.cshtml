                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <input type="text" class="form-control" data-inputmask="'alias': 'PositiveNumber'" id="Weight" value="0" placeholder="Nhập số tiền">
                        <label class="error-message pt-1" id="errWeight"></label>
                    </td>
                    <td>
                        <input type="text" class="form-control" data-inputmask="'alias': 'PositiveNumber'" id="LocalFee" value="0" placeholder="Nhập cước phí">
