else
{
    <p>Không lấy được dữ liệu bảng cước. Vui lòng thử lại hoặc liên hệ quản trị.</p>
}

<script>
    $(document).ready(function () {
        $('select.select2').select2(AttributeSelect2);
        $(":input").inputmask();
        $('#Weight').focus();
    });

    CheckChangeValue("Weight", "Vui lòng nhập Khối lượng", "Number", "Y");

    function btnAdd() {
        var isError = false;
        var data = {
            TransportPostageID:  @ViewBag.TransportPostageID,
            ChargingConditionsID: @ViewBag.ChargingConditionsID,
            Weight: NumberReplace($('#Weight').val()),
            LocalFee: NumberReplace($('#LocalFee').val()),
        };

        if (data.ChargingConditionsID == 4) {
            data.Key = "E4";
        }
        else if (data.ChargingConditionsID == 5) {
            data.IntercityFee1 = NumberReplace($('#IntercityFee1').val());
            data.IntercityFee2 = NumberReplace($('#IntercityFee2').val());
            data.Key = "E5";
        }
        else if (data.ChargingConditionsID == 6){
            data.IntercityFee1 = NumberReplace($('#IntercityFee1').val());
            data.IntercityFee2 = NumberReplace($('#IntercityFee2').val());
            data.Key = "E6";
        }
        else {
            CreateCustomSwal("error", "Không xác định được loại phạm vi tính cước. Vui lòng thử lại hoăc liên hệ quản trị.");
            return;
        }


        isError = CheckNullAndRegexValue(parseInt(data.Weight), "Number", "Weight", "Vui lòng nhập Khối lượng", "Chỉ được nhập số", isError);

        if (isError == true) {
            return;
        }

        $.ajax({
            type: 'POST',
            url: '@Url.Action("JAddConfigMainFeeDetailView", "TransportExtraService")',
            dataType: 'json',
            loading: true,
            data: data,
            success: function (res) {
                if (res.Code == "00") {
                    $.post('@Url.Action("ConfigMainFeeDetailView", "TransportExtraService")', data, function (data) {
                        $('#Data').html(data);
                    });
                } else {
                    CreateCustomSwal("error", res.Message);
                }
            },
            error: function (xhr, status, error) {
                var err = eval("(" + xhr.responseText + ")");
                swal({
                    title: 'Lỗi',
                    text: err.Message,
                    button: {
                        text: "ĐÓNG",
                        value: true,
                        visible: true,
                        className: "btn btn-primary"
                    }
                });
                return;
            }
        });
    };

    function btnConfirm(TransportPostageDetailID, ChargingConditionsID, IsStep) {
        var isError = false;
        var data = {
            TransportPostageID:  @ViewBag.TransportPostageID,
            ChargingConditionsID: @ViewBag.ChargingConditionsID,
            TransportPostageDetailID: TransportPostageDetailID,
            Weight: IsStep == "Y" ? NumberReplace($('#StepWeight').val()) : 0,
            LocalFee: NumberReplace($('#LocalFee_' + TransportPostageDetailID).val()),
        };

        if (data.ChargingConditionsID == 5 || data.ChargingConditionsID == 6) {
            data.IntercityFee1 = NumberReplace($('#IntercityFee1_' + TransportPostageDetailID).val());
            data.IntercityFee2 = NumberReplace($('#IntercityFee2_' + TransportPostageDetailID).val());
        }

        if (isError == true) {
            return;
        }

        swal({
            title: 'Thông báo',
            text: "Bạn chắc chắn muốn chỉnh sửa?",
            buttons: {
                confirm: {
                    text: "CÓ",
                    value: true,
                    visible: true,
                    className: "btn btn-primary",
                    closeModal: true
                },
                cancel: {
                    text: "KHÔNG",
                    value: false,
                    visible: true,
                    className: "btn btn-danger",
                    closeModal: true,
                }
            },
        }).then((value) => {
            if (value) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("JEditConfigMainFeeDetailView", "TransportExtraService")',
                    dataType: 'json',
                    loading: true,
                    data: data,
                    success: function (res) {
                        if (res.Code == "00") {
                            $.post('@Url.Action("ConfigMainFeeDetailView", "TransportExtraService")', data, function (data) {
                                $('#Data').html(data);
                            });
                        } else {
                            CreateCustomSwal("error", res.Message);
                        }
                    },
                    error: function (xhr, status, error) {
                        var err = eval("(" + xhr.responseText + ")");
                        swal({
                            title: 'Lỗi',
                            text: err.Message,
                            button: {
                                text: "ĐÓNG",
                                value: true,
                                visible: true,
                                className: "btn btn-primary"
                            }
                        });
                        return;
                    }
                });
            };
        });
    }

    function btnCancel() {
        var data = {
            TransportPostageID:  @ViewBag.TransportPostageID,
            ChargingConditionsID: @ViewBag.ChargingConditionsID,
        };

        $.post('@Url.Action("ConfigMainFeeDetailView", "TransportExtraService")', data, function (data) {
            $('#Data').html(data);
        });
    }

    function btnEdit(DetailID, ChargingConditionsID, IsStep) {
        //Vô hiệu hoá thêm sản phẩm
        if (ChargingConditionsID == 4) {
            $('#Weight').val('0');
            $('#LocalFee').val('0');
            $('#Weight').prop('disabled', true);
            $('#LocalFee').prop('disabled', true);
            $('#Add_Detail').prop('disabled', true);
            if (IsStep == 'Y') {
                $('#StepWeight').prop('disabled', false);
            }
            $('#LocalFee_' + DetailID).prop('disabled', false);
        }
        else if (ChargingConditionsID == 5) {
            $('#Weight').val('0');
            $('#LocalFee').val('0');
            $('#IntercityFee1').val('0');
            $('#IntercityFee2').val('0');
            $('#Weight').prop('disabled', true);
            $('#LocalFee').prop('disabled', true);
            $('#IntercityFee1').prop('disabled', true);
            $('#IntercityFee2').prop('disabled', true);
            $('#Add_Detail').prop('disabled', true);
            if (IsStep == 'Y') {
                $('#StepWeight').prop('disabled', false);
            }
            $('#LocalFee_' + DetailID).prop('disabled', false);
            $('#IntercityFee1_' + DetailID).prop('disabled', false);
            $('#IntercityFee2_' + DetailID).prop('disabled', false);
        }
        else if (ChargingConditionsID == 6) {
            $('#Weight').val('0');
            $('#LocalFee').val('0');
            $('#IntercityFee1').val('0');
            $('#IntercityFee2').val('0');
            $('#Weight').prop('disabled', true);
            $('#LocalFee').prop('disabled', true);
            $('#IntercityFee1').prop('disabled', true);
            $('#IntercityFee2').prop('disabled', true);
            $('#Add_Detail').prop('disabled', true);
            if (IsStep == 'Y') {
                $('#StepWeight').prop('disabled', false);
            }
            $('#LocalFee_' + DetailID).prop('disabled', false);
            $('#IntercityFee1_' + DetailID).prop('disabled', false);
            $('#IntercityFee2_' + DetailID).prop('disabled', false);
        }
        else {
            CreateCustomSwal("error", "Không xác định được loại phạm vi tính cước. Vui lòng thử lại hoăc liên hệ quản trị.");
            return;
        }

        ////hiện button xác nhận - huỷ
        $('#EditConfirmation_' + DetailID).css('display', 'block');
        $('#CancelEdit_' + DetailID).css('display', 'block');

        //ẩn các button thêm - sửa - xoá
        $('button[name="btnEditDetail"]').css('display', 'none');
        $('button[name="btnRemoveDetail"]').css('display', 'none');
    }

    function btnDelete(DetailID) {
        var data = {
            TransportPostageID:  @ViewBag.TransportPostageID,
            ChargingConditionsID: @ViewBag.ChargingConditionsID,
            TransportPostageDetailID: DetailID
        };

        swal({
            title: 'Thông báo',
            text: "Bạn chắc chắn muốn xoá bỏ?",
            buttons: {
                confirm: {
                    text: "CÓ",
                    value: true,
                    visible: true,
                    className: "btn btn-primary",
                    closeModal: true
                },
                cancel: {
                    text: "KHÔNG",
                    value: false,
                    visible: true,
                    className: "btn btn-danger",
                    closeModal: true,
                }
            },
        }).then((value) => {
            if (value) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("JRemoveConfigMainFeeDetailView", "TransportExtraService")',
                    dataType: 'json',
                    loading: true,
                    data: {
                        TransportPostageDetailID: data.TransportPostageDetailID
                    },
                    success: function (res) {
                        if (res.Code == "00") {
                            swal({
                                title: "Thông báo",
                                text: res.Message,
                                button: false,
                                timer: 1500
                            }).then(function () {
                                $.post('@Url.Action("ConfigMainFeeDetailView", "TransportExtraService")', data, function (data) {
                                    $('#Data').html(data);
                                });
                            });
                        } else {
                            CreateCustomSwal("error", res.Message);
                        }
                    },
                    error: function (xhr, status, error) {
                        var err = eval("(" + xhr.responseText + ")");
                        swal({
                            title: 'Lỗi',
                            text: err.Message,
                            button: {
                                text: "ĐÓNG",
                                value: true,
                                visible: true,
                                className: "btn btn-primary"
                            }
                        });
                        return;
                    }
                });
            }
        });
    }
</script>