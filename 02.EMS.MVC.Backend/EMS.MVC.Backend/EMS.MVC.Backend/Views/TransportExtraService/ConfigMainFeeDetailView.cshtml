@model List<EMS.MVC.Backend.Models.ConfigMainFeeDetailViewModel>

@{
    int temp = Model.Count - 1;
}

@if (Model.Count > 0)
{
    if (ViewBag.ChargingConditionsID == 4)//Cước chính
    {
        <table id="Datatable" class="table table-bordered">
            <thead class="border text-center" style="background-color:aliceblue">
                <tr>
                    <th class="border text-left">Nấc tiền (VNĐ)<i class="fa fa-info-circle" title="Sẽ được tính từ số tiền cao nhất đã cấu hình trước đến số tiền này"></i></th>
                    <th class="border text-right">Cước phí (VNĐ)</th>
