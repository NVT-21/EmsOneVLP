                        </td>
                        <td class="form-group vertical-top" style="width:200px;">
                            <button class="btn btn-sm btn-warning float-left mr-2" name="btnEditDetail" onclick="btnEdit('@Model[i].TransportPostageDetailID','4','N')">Sửa</button>
