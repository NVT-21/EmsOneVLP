@model List<EMS.MVC.Backend.Models.PeriodListViewModel>

<table id="ListDataTableSearch" class="table table-bordered table-hover text-center">
    <thead>
        <tr class="table-info text-center">
            <th class="align-middle"> Giá trị </th>
            <th class="align-middle"> Thao tác </th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>
                <select class="select2" id="Value_@ViewBag.Type">
                    <option value="">--- Chọn ---</option>
                    @if (ViewBag.PeriodType == 1)
                    {
                        foreach (var item in ViewBag.Week)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                    else
                    {
                        foreach (var item in ViewBag.AllDays)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    }
                </select>
                <br />
                <span class="text-danger mt-1" id="errValue_@ViewBag.Type"></span>
            </td>
            <td>
                <button class="btn btn-sm btn-primary" onclick="btnAdd('@ViewBag.Type')">THÊM</button>
            </td>
        </tr>
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td class="text-left">@item.Text</td>
                    <td>
                        <button onclick="Remove(@item.ID, '@ViewBag.Type')" class="btn btn-sm btn-danger">XÓA</button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<script>
    $(document).ready(function () {
        $('select.select2').select2(AttributeSelect2);
    });
</script>
