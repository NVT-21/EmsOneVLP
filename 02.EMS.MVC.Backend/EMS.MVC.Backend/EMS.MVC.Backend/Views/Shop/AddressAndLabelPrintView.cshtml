<script>
    $(document).ready(function () {
        //$("#ShowStoreName").text($("#StoreNameTemp").val());
        $("#tree").jstree({
            "core": {
                //"animation": 0,
                //"check_callback": true,
                //'force_text': true,
                "themes": {
                    "icons": false
                },
                "data": {
                    "url": function (node) {
                        var url = "";
                        if (node.id === "#") {
                            url = "@Url.Action("PickUpAddressTreeView", "Handle")?ShopID=" + @Model.ShopID;
                        } else {
                            url = "@Url.Action("LabelPrintTreeView", "Handle")?PickUpAddressID=" + node.id;
                        }
                        return url;
                    },
                    "data": function (node) {
                        return { 'id': node.id };
                    },
                    "dataType": "json"
                }
            },
            //"plugins": ["contextmenu"],
            //'contextmenu': {
            //    'select_node': false,
            //    'items': reportMenu
            //}
        }).on("loaded.jstree", function (event, data) {
            @*$(this).jstree("open_all");
            $('#tree').jstree(true).select_node(@Model.PickUpID);*@
        }).on("select_node.jstree", function (e, data) {
            var Parent = data.node.parent;
            if (Parent == "#") {
                ShowInfoPickUpAddress(data.node.id, @Model.ShopID);
                data.instance.open_node(data.node); // click vào là open node luôn
            } else {
                ShowInfoLabelPrint(data.node.li_attr.id, @Model.ShopID);
            }
        });
    });

