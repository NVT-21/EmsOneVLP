    $("#DivAddPickUpAddress").on("click", function () {
        AddPickUpAddressView(@Model.ShopID, @Model.CollectionPostOfficeID);
    });

    function ShowInfoPickUpAddress(PickUpAddressID, ShopID) {
        $.post('@Url.Action("ShowInfoPickUpAddress", "Shop")', {
            ShopID: ShopID,
            PickUpAddressID: PickUpAddressID
        }, function (htmlString) {
            $("#ShowInfoAddressOrLabelPrint").html(htmlString);
        });
    }

    function AddPickUpAddressView(ShopID, CollectionPostOfficeID) {
        $.post('@Url.Action("AddPickUpAddressView", "Shop")', {
            ShopID: ShopID,
            CollectionPostOfficeID: CollectionPostOfficeID
        }, function (htmlString) {
            $('#modal-common-container').html(htmlString);
            $('#modal-common').modal('show');
        });
    }

    function RemovePickUpAddress(PickUpAddressID, ShopID) {
        swal({
            title: 'Thông báo',
            text: "Xóa địa chỉ lấy hàng sẽ xóa luôn mẫu in. Bạn có chắc chắn muốn xóa?",
            icon: 'warning',
            buttons: {
                confirm: {
                    text: "Có",
                    value: true,
                    visible: true,
                    className: "btn btn-primary",
                    closeModal: true
                },
                cancel: {
                    text: "Không",
                    value: false,
                    visible: true,
                    className: "btn btn-danger",
                    closeModal: true,
                }
            },
        }).then((value) => {
            if (value) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("JRemovePickUpAddress", "Shop")',
                    data: {
                        PickUpAddressID: PickUpAddressID,
                        ShopID: ShopID
                    },
                    dataType: 'json',
                    success: function (res) {
                        if (res.Code == "00") {
                            swal({
                                icon: "success",
                                title: "Thông báo",
                                text: res.Message,
                                button: false,
                                timer: 2000
                            }).then(function () {
                                $('#tree').jstree(true).refresh();
                                $("#ShowInfoAddressOrLabelPrint").html("");
                            });
                        } else {
                            swal({
                                icon: "error",
                                title: "Thông báo",
                                text: res.Message,
                                button: {
                                    text: "Đóng"
                                }
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        var err = eval("(" + xhr.responseText + ")");
                        swal({
                            title: 'Lỗi',
                            text: err.Message,
                            icon: 'error',
                            button: {
                                text: "Đóng",
                                value: true,
                                visible: true,
                                className: "btn btn-primary"
                            }
                        });
                        return;
                    }
                });
            }
        });
    }

    function ShowInfoLabelPrint(LabelPrintID, ShopID){
        $.post('@Url.Action("ShowInfoLabelPrint", "Shop")', {
            ShopID: ShopID,
            LabelPrintID: LabelPrintID
        }, function (htmlString) {
            $("#ShowInfoAddressOrLabelPrint").html(htmlString);
        });
    }

    function AddLabelPrintView(PickUpAddressID, ShopID){
        $.post('@Url.Action("AddLabelPrintView", "Shop")', { PickUpAddressID: PickUpAddressID, ShopID: ShopID }, function (htmlString) {
            $('#modal-common-container').html(htmlString);
            $('#modal-common').modal('show');
        });
    }

    function RemoveLabelPrint(LabelPrintID, ShopID) {
        swal({
