@model EMS.MVC.Backend.Models.DetailOrderBatchViewModel
@using Newtonsoft.Json
<div class="modal-dialog modal-xl" role="document">
    <div class="modal-content">
        <div class="modal-header">
            <h4 class="modal-title" style="word-break: break-all;">Chi tiết đơn hàng lô - @Model.BatchCode</h4>
            <button type="button" id="CloseModal" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body">
            <div class="row">
                <div class="col-xl-6 col-lg-6 col-md-6">
                    <h5 class="text-primary">Thông tin chung</h5>
                    <div class="col-xl-12 col-lg-12 col-md-12">
                        <label class="text-muted">Kho:</label>
                        <label class="font-weight-bold">@Html.DisplayFor(m => m.WareHouseName)</label>
                    </div>
                    <div class="col-xl-12 col-lg-12 col-md-12">
                        <label class="text-muted">Hình thức thu gom:</label>
                        <label class="font-weight-bold">@Html.DisplayFor(m => m.CollectionType.Name)</label>
                    </div>
                    <div class="col-xl-12 col-lg-12 col-md-12">
                        <label class="text-muted">Người trả cước:</label>
                        <label class="font-weight-bold">@Html.DisplayFor(m => m.TransportPayer.Name)</label>
                    </div>
                    <div class="col-xl-12 col-lg-12 col-md-12">
                        <label class="text-muted">Dịch vụ chính:</label>
                        <label class="font-weight-bold">@Html.DisplayFor(m => m.MainTransportServiceID.Name)</label>
                    </div>
                    <div class="col-xl-12 col-lg-12 col-md-12">
                        <label class="text-muted">Dịch vụ cộng thêm:</label>
                        <label class="font-weight-bold">
                            @{
                                if (!string.IsNullOrEmpty(Model.ExtraTransportServiceID.Name))
                                {
                                    var SplitExtraTransportServiceName = Model.ExtraTransportServiceID.Name.Split(',');
                                    for (var i = 0; i < SplitExtraTransportServiceName.Length; i++)
                                    {
                                        Write(SplitExtraTransportServiceName[i]);
                                        if (Model.ExtraTransportServiceID.Code.Split(',')[i].Trim() == "108")
                                        {
                                            Write(" (Tiền COD: " + Model.ProvisionalTotalCOD.ToString("N0") + ")");
                                        }
                                        <br />
                                    }
                                }
                            }
                        </label>
                    </div>
                    <div class="col-xl-12 col-lg-12 col-md-12">
                        <label class="text-muted">Tiền COD thực tế: </label>
                        <label class="font-weight-bold">@Model.ActualTotalCOD.ToString("N0")</label>
                    </div>
                    <div class="col-xl-12 col-lg-12 col-md-12">
                        <label class="text-muted">Ghi chú:</label>
                        <label class="font-weight-bold">@Html.DisplayFor(m => m.Note)</label>
                    </div>
                    <div class="col-xl-12 col-lg-12 col-md-12">
                        <label class="text-muted">Kênh bán hàng:</label>
                        <label class="font-weight-bold">@Html.DisplayFor(m => m.Channel.Name)</label>
                    </div>
                    <div class="col-xl-12 col-lg-12 col-md-12">
                        <label class="text-muted">Nơi tạo:</label>
                        <label class="font-weight-bold">@Html.DisplayFor(m => m.PlaceOfCreation)</label>
                    </div>
                </div>

                <div class="col-xl-6 col-lg-6 col-md-6">
                    <div class="row">
                        <div class="col-xl-12 col-lg-12 col-md-12">
                            <h5 class="text-primary">Thông tin người mua</h5>
                            <div class="row">
                                <div class="col-xl-12 col-lg-12 col-md-12">
                                    <label class="text-muted">Họ tên:</label>
                                    <label class="font-weight-bold">@Html.DisplayFor(m => m.BuyerInfo.FullName)</label>
                                </div>
                                <div class="col-xl-12 col-lg-12 col-md-12">
                                    <label class="text-muted">Số điện thoại:</label>
                                    <label class="font-weight-bold">@Html.DisplayFor(m => m.BuyerInfo.MobileNumber)</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-xl-12 col-lg-12 col-md-12">
                            <h5 class="text-primary">Thông tin người nhận</h5>
                            <div class="row">
                                <div class="col-xl-12 col-lg-12 col-md-12">
                                    <label class="text-muted">Họ tên:</label>
                                    <label class="font-weight-bold">@Html.DisplayFor(m => m.ReceiverInfo.FullName)</label>
                                </div>
                                <div class="col-xl-12 col-lg-12 col-md-12">
                                    <label class="text-muted">Số điện thoại:</label>
                                    <label class="font-weight-bold">@Html.DisplayFor(m => m.ReceiverInfo.MobileNumber)</label>
                                </div>
                                <div class="col-xl-12 col-lg-12 col-md-12">
                                    <label class="text-muted">Địa chỉ:</label>
                                    <label class="font-weight-bold">@Html.DisplayFor(m => m.ReceiverInfo.FullAddress)</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <hr />

                @foreach (var ItemOrderInfo in Model.ListOrderInfo)
                {
                    <div class="col-xl-12 col-lg-12 col-md-12">
                        <div class="row">
                            <div class="col-xl-12 col-lg-12 col-md-12">
                                <h5 class="text-primary">Thông tin đơn hàng - @ItemOrderInfo.OrderCode</h5>
                                <div class="row">
                                    @if (ItemOrderInfo.ListProductInfo.Count > 0)
                                    {
                                        <div class="col-xl-12 col-lg-12 col-md-12 mb-2">
                                            <h5 class="text-primary">Sản phẩm</h5>
                                            <div class="table-responsive">
                                                <table class="table table-bordered" style="width: 100%;">
                                                    <thead>
                                                        <tr>
                                                            <th>Sản phẩm</th>
                                                            <th>Tên biến thể</th>
                                                            <th>Số lượng</th>
                                                            <th>Giá tiền</th>
                                                            <th>Giảm giá</th>
                                                            <th>Thành tiền</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var ItemProductInfo in ItemOrderInfo.ListProductInfo)
                                                        {
                                                            <tr>
                                                                <td>@ItemProductInfo.VariantSKU - @ItemProductInfo.ProductName</td>
                                                                <td>@ItemProductInfo.VariantName</td>
                                                                <td>@ItemProductInfo.NumberOfProduct</td>
                                                                <td>@ItemProductInfo.Price.ToString("N0") đ</td>
                                                                <td>0 đ</td>
                                                                <td>@ItemProductInfo.TotalPrice.ToString("N0") đ</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    }

                                    <div class="col-xl-6 col-lg-6 col-md-6">
                                        <h5 class="text-primary">Thanh toán</h5>
                                        <div class="row">
                                            <div class="col-xl-12 col-lg-12 col-md-12">
                                                <label class="text-muted">Ghi chú đơn hàng:</label>
                                                <label class="font-weight-bold text-break">@ItemOrderInfo.Message</label>
                                            </div>
                                            <div class="col-xl-12 col-lg-12 col-md-12">
                                                <label class="text-muted">Số lượng sản phẩm:</label>
                                                <label class="font-weight-bold">@ItemOrderInfo.TotalProductQuantity.ToString("N0")</label>
                                            </div>
                                            <div class="col-xl-12 col-lg-12 col-md-12">
                                                <label class="text-muted">Tổng tiền hàng:</label>
                                                <label class="font-weight-bold">@ItemOrderInfo.TotalAmount.ToString("N0") đ</label>
                                            </div>
                                            <div class="col-xl-12 col-lg-12 col-md-12">
                                                <label class="text-muted">Giảm giá:</label>
                                                <label class="font-weight-bold">@ItemOrderInfo.TotalDiscount.ToString("N0") đ</label>
                                            </div>
                                            @if (ItemOrderInfo.TotalPHU > 0)
                                            {
                                                <div class="col-xl-12 col-lg-12 col-md-12">
                                                    <label class="text-2">Tiền thu phí hủy đơn (PHU):</label>
                                                    <label class="font-w600">@ItemOrderInfo.TotalPHU.ToString("N0") đ</label>
                                                </div>
                                            }
                                            <div class="col-xl-12 col-lg-12 col-md-12">
                                                <label class="text-muted">Phí vận chuyển tạm tính: </label>
                                                <label class="font-weight-bold">@ItemOrderInfo.ProvisionalTransportFee.ToString("N0") đ</label>
                                            </div>
                                            <div class="col-xl-12 col-lg-12 col-md-12">
                                                <label class="text-muted">Phí vận chuyển thực tế: </label>
                                                <label class="font-weight-bold">@ItemOrderInfo.ActualTransportFee.ToString("N0") đ</label>
                                            </div>
                                            <div class="col-xl-12 col-lg-12 col-md-12">
                                                <label class="text-muted">Tổng giá trị đơn hàng:</label>
                                                <label class="font-weight-bold">@ItemOrderInfo.TotalOrderValue.ToString("N0") đ</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-xl-6 col-lg-6 col-md-6">
                                        <h5 class="text-primary">Thông tin vận chuyển</h5>
                                        <div class="row">
                                            <div class="col-xl-12 col-lg-12 col-md-12">
                                                <label class="text-muted">Mã đơn hàng: </label>
                                                <label class="font-weight-bold text-break">@ItemOrderInfo.OrderCode</label>
                                            </div>
                                            <div class="col-xl-12 col-lg-12 col-md-12">
                                                <label class="text-muted">Tên đơn hàng: </label>
                                                <label class="font-weight-bold">@ItemOrderInfo.OrderName</label>
                                            </div>
                                            <div class="col-xl-12 col-lg-12 col-md-12">
                                                <label class="text-muted">Mã bưu gửi:</label>
                                                <label class="font-weight-bold">@ItemOrderInfo.ShippingCode</label>
                                            </div>
                                            <div class="col-xl-12 col-lg-12 col-md-12">
                                                <label class="text-muted">Khối lượng tạm tính: </label>
                                                <label class="font-weight-bold">@ItemOrderInfo.ProvisionalTransportWeight.ToString("N0") gr</label>
                                            </div>
                                            <div class="col-xl-12 col-lg-12 col-md-12">
                                                <label class="text-muted">Khối lượng thực tế: </label>
                                                <label class="font-weight-bold">@ItemOrderInfo.ActualTransportWeight.ToString("N0") gr</label>
                                            </div>
                                            <div class="col-xl-12 col-lg-12 col-md-12">
                                                <label class="text-muted">Khối lượng quy đổi: </label>
                                                <label class="font-weight-bold">@ItemOrderInfo.ExchangeTransportWeight.ToString("N0") gr</label>
                                            </div>
                                            <div class="col-xl-12 col-lg-12 col-md-12">
                                                <label class="text-muted">Số lượng: </label>
                                                <label class="font-weight-bold">@ItemOrderInfo.OrderQuantity.ToString("N0")</label>
                                            </div>
                                            <div class="col-xl-12 col-lg-12 col-md-12">
                                                <label class="text-muted">Giá trị đơn hàng: </label>
                                                <label class="font-weight-bold">@ItemOrderInfo.OrderValue.ToString("N0") đ</label>
                                            </div>
                                            <div class="col-xl-12 col-lg-12 col-md-12">
                                                <label class="text-muted">Kích thước (dài x rộng x cao): </label>
                                                <label class="font-weight-bold">@ItemOrderInfo.Length.ToString() x @ItemOrderInfo.Width.ToString() x @ItemOrderInfo.Height.ToString()</label>
                                            </div>
                                            <div class="col-xl-12 col-lg-12 col-md-12">
                                                <label class="text-muted">Bưu cục phục vụ: </label>
                                                <label class="font-weight-bold">@ItemOrderInfo.AcceptancePosCode</label>
                                            </div>
                                        </div>
                                    </div>

                                    @if (ItemOrderInfo.ListRequestSupportInfo.Count > 0)
                                    {
                                        <div class="col-xl-12 col-lg-12 col-md-12">
                                            <h5 class="text-primary">Yêu cầu sửa thông tin đơn hàng </h5>
                                            <div class="table-responsive">
                                                <table class="table table-bordered" style="width: 100%;">
                                                    <thead>
                                                        <tr>
                                                            <th>Loại yêu cầu</th>
                                                            <th style="max-width: 300px; white-space: inherit; line-height: 20px;">Thông tin cũ</th>
                                                            <th style="max-width: 300px; white-space: inherit; line-height: 20px;">Thông tin mới</th>
                                                            <th>Ngày tạo</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var ItemRequestSupportInfo in ItemOrderInfo.ListRequestSupportInfo)
                                                        {
                                                            <tr>
                                                                <td>@ItemRequestSupportInfo.RequestSupportType.Name</td>
                                                                @if (ItemRequestSupportInfo.RequestSupportType.ID == 7)
                                                                {
                                                                    <td style="max-width: 300px; white-space: inherit; line-height: 20px;">@Convert.ToInt64(ItemRequestSupportInfo.OldUpdateInformation).ToString("N0")</td>
                                                                    <td style="max-width: 300px; white-space: inherit; line-height: 20px;">@Convert.ToInt64(ItemRequestSupportInfo.NewUpdateInformation).ToString("N0")</td>
                                                                }
                                                                else
                                                                {
                                                                    <td style="max-width: 300px; white-space: inherit; line-height: 20px;">@ItemRequestSupportInfo.OldUpdateInformation</td>
                                                                    <td style="max-width: 300px; white-space: inherit; line-height: 20px;">@ItemRequestSupportInfo.NewUpdateInformation</td>
                                                                }
                                                                <td>@ItemRequestSupportInfo.CreatedDate</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    }

                                    <div class="col-xl-12 col-lg-12 col-md-12">
                                        <p class="font-weight-bold mb-0">
                                            Trạng thái đơn hàng: @ItemOrderInfo.OrderStatus.Name
                                            @if (ItemOrderInfo.OrderStatus.Code == "C")
                                            {
                                                <div class="row">
                                                    <div class="col-xl-12 col-lg-12 col-md-12">
                                                        <label class="text-muted">Lý do: </label>
                                                        <label class="font-weight-bold">@ItemOrderInfo.ReasonCancel</label>
                                                    </div>
                                                    <div class="col-xl-12 col-lg-12 col-md-12">
                                                        <label class="text-muted">Người cập nhật: </label>
                                                        <label class="font-weight-bold">@ItemOrderInfo.UpdatedName</label>
                                                    </div>
                                                    <div class="col-xl-12 col-lg-12 col-md-12">
                                                        <label class="text-muted">Thời gian: </label>
                                                        <label class="font-weight-bold">@ItemOrderInfo.UpdatedDate</label>
                                                    </div>
                                                </div>
                                            }
                                        </p>
                                    </div>

