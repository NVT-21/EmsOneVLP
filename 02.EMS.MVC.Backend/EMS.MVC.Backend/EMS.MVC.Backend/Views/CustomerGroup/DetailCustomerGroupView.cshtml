@model EMS.MVC.Backend.Models.DetailCustomerGroupViewModel
@Html.HiddenFor(m => m.Id)

<div class="card" style="min-height: 591px;">
    <div class="card-body">
        <div class="row">
            <div class="col-xl-6 col-lg-6 col-md-12 mb-2">
                <label>Tên nhóm khách hàng <span class="text-danger">(*)</span></label>
                @Html.EditorFor(m => m.Name, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Tên nhóm khách hàng", @maxlength = "250" } })
                <span class="text-danger" id="errName"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-xl-6 col-lg-6 col-md-6 mb-2">
                <label>Mã CRM <span class="text-danger">(*)</span></label>
                @Html.EditorFor(m => m.CRMCode, new { htmlAttributes = new { @type = "text", @class = "form-control", @placeholder = "Mã khách hàng", @maxlength = "250" } })
                <span class="text-danger" id="errCRMCode"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-xl-12 col-lg-12 col-md-12 mb-2">
                <button type="button" class="btn btn-sm btn-primary" id="btnEditCustomerGroup">CẬP NHẬT</button>
            </div>
        </div>
    </div>
</div>


<script>
    CheckChangeValue("Name", "Vui lòng nhập tên nhóm khách hàng", "", "Y");
    CheckChangeValue("CRMCode", "Vui lòng nhập mã CRM", "", "Y");

    $(document).ready(function () {
        $("input[id=CRMCode_tag]").keyup(function () {
            var value = $(this).val();
            $(this).val(value.toUpperCase());
        });

        $("input[id=CRMCode_tag]").bind("paste", function (e) {
            var source = "";

            if (window.clipboardData !== undefined) {
                source = window.clipboardData;
            } else {
                source = e.originalEvent.clipboardData;
            }

            var data = source.getData("Text");

            var replaceSpace = data.split(/\s+/);

            $.each(replaceSpace, function (idx, value) {
                if (value.trim()) {
                    $('#CRMCode').tagsinput('add', value.toUpperCase());
                }
            });

            e.preventDefault();
        });
    });

    $('#CRMCode').tagsinput({
        maxChars: 20,
        trimValue: true,
        confirmKeys: [13, 32], //13 - enter, 32 - space, 44 - comma
    });

    $('#CRMCode').on('beforeItemAdd', function (event) {
        var CrmOrPaypostcode = event.item;
        var isError = CheckRegexValue(CrmOrPaypostcode, "Code", "CRMCode", "Giá trị hợp lệ chỉ bao gồm chữ cái (a-zA-Z), số (0-9) và dấu -", false);
        if (isError == true) {
            event.cancel = true;
        }
    });

    $(".bootstrap-tagsinput input").attr("id", "CRMCode_tag");

    $("#btnEditCustomerGroup").on("click", function () {
        var isError = false;

        var data = {
            Id: $("#Id").val(),
            Name: $("#Name").val().trim(),
            CRMCode: $("#CRMCode").val().trim(),
        }

        isError = CheckNullValue(data.Name, "Name", "Vui lòng nhập tên nhóm khách hàng", isError);
        isError = CheckNullValue(data.CRMCode, "CRMCode", "Vui lòng nhập mã CRM", isError);

        if (isError == true) {
            return;
        }

        swal({
            title: 'Thông báo',
            text: "Bạn chắc chắn muốn cập nhật thông tin?",
            icon: 'warning',
            buttons: {
                confirm: {
                    text: "Có",
                    value: true,
                    visible: true,
                    className: "btn btn-primary",
                    closeModal: true
                },
                cancel: {
                    text: "Không",
                    value: false,
                    visible: true,
                    className: "btn btn-danger",
                    closeModal: true,
                }
            },
        }).then((value) => {
            if (value) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("JEditCustomerGroup", "CustomerGroup")',
                    data: data,
                    dataType: 'json',
                    success: function (res) {
                       if (res.Code == "00") {
                           swal({
                               icon: "success",
                                title: "Thông báo",
                                text: res.Message,
                                button: false,
                                timer: 1500
                            }).then(function () {
                                var CurrentCustomerGroupName = '@Model.Name';
                                if (data.Name != CurrentCustomerGroupName) {
                                    $('#TreeView').jstree(true).refresh();
                                }
                            });
                        } else {
                           swal({
                                icon: "error",
                                title: "Thông báo",
                                text: res.Message,
                                button: {
                                    text: "ĐÓNG"
                                }
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        var err = eval("(" + xhr.responseText + ")");
                        swal({
                            title: 'Lỗi',
                            text: err.Message,
                            icon: 'error',
                            button: {
                                text: "Đóng",
                                value: true,
                                visible: true,
                                className: "btn btn-primary"
                            }
                        });
                        return;
                    }
                });
            }
        });
    });
</script>