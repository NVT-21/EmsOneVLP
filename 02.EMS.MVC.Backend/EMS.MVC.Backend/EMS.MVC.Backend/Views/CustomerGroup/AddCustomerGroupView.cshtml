@model EMS.MVC.Backend.Models.AddCustomerGroupViewModel

<div class="modal-dialog modal-md" role="document">
    <div class="modal-content">
        <div class="modal-header">
            <h4 class="modal-title">Thêm mới nhóm khách hàng</h4>
            <button type="button" id="CloseModal" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body" id="ClearModal">
            <div class="row">
                <div class="col-xl-12 col-lg-12 col-md-12 mb-2">
                    <label>Tên nhóm khách hàng <span class="text-danger">(*)</span></label>
                    @Html.EditorFor(m => m.Name, new { htmlAttributes = new { @type = "text", @class = "form-control", @id = "A_Name", @placeholder = "Tên nhóm khách hàng", @maxlength = "250" } })
                    <span class="text-danger" id="errA_Name"></span>
                </div>
                <div class="col-xl-12 col-lg-12 col-md-12 mb-2">
                    <label>Mã CRM <span class="text-danger">(*)</span></label>
                    @Html.EditorFor(m => m.CRMCode, new { htmlAttributes = new { @type = "text", @class = "form-control", @id = "A_CRMCode", @placeholder = "Mã khách hàng", @maxlength = "250" } })
                    <span class="text-danger" id="errA_CRMCode"></span>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <div class="col-lg-12 col-md-12">
                <div class="row justify-content-between">
                    <button type="button" class="btn btn-sm btn-danger" data-dismiss="modal" aria-label="Close">HUỶ BỎ</button>
                    <button type="button" class="btn btn-sm btn-primary" id="btnM_AddCustomerGroup">XÁC NHẬN</button>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    CheckChangeValue("A_Name", "Vui lòng nhập tên nhóm khách hàng", "", "Y");
    CheckChangeValue("A_CRMCode", "Vui lòng nhập mã CRM", "", "Y");

    $(document).ready(function () {
        $("input[id=A_CRMCode_tag]").keyup(function () {
            var value = $(this).val();
            $(this).val(value.toUpperCase());
        });

        $("input[id=A_CRMCode_tag]").bind("paste", function (e) {
            var source = "";

            if (window.clipboardData !== undefined) {
                source = window.clipboardData;
            } else {
                source = e.originalEvent.clipboardData;
            }

            var data = source.getData("Text");

            var replaceSpace = data.split(/\s+/);

            $.each(replaceSpace, function (idx, value) {
                if (value.trim()) {
                    $('#A_CRMCode').tagsinput('add', value.toUpperCase());
                }
            });

            e.preventDefault();
        });
    });

    $('#A_CRMCode').tagsinput({
        maxChars: 20,
        trimValue: true,
        confirmKeys: [13, 32], //13 - enter, 32 - space, 44 - comma
    });

    $('#A_CRMCode').on('beforeItemAdd', function (event) {
        var CrmOrPaypostcode = event.item;
        var isError = CheckRegexValue(CrmOrPaypostcode, "Code", "A_CRMCode", "Giá trị hợp lệ chỉ bao gồm chữ cái (a-zA-Z), số (0-9) và dấu -", false);
        if (isError == true) {
            event.cancel = true;
        }
    });

    $(".bootstrap-tagsinput input").attr("id", "A_CRMCode_tag");

    $("#btnM_AddCustomerGroup").on("click", function () {
        var isError = false;

        var data = {
            Name: $("#A_Name").val(),
            CRMCode: $("#A_CRMCode").val().trim(),
        }

        isError = CheckNullValue(data.Name, "A_Name", "Vui lòng nhập tên nhóm khách hàng", isError);
        isError = CheckNullValue(data.CRMCode, "A_CRMCode", "Vui lòng nhập mã CRM", isError);

        if (isError == true) {
            return;
        }

        $.ajax({
            type: 'POST',
            url: '@Url.Action("JAddCustomerGroup", "CustomerGroup")',
            data: data,
            dataType: 'json',
            success: function (res) {
                if (res.Code == "00") {
                    CreateCustomSwal("success", res.Message);
                } else {
                    CreateCustomSwal("error", res.Message);
                }
            },
            error: function (xhr, status, error) {
                var err = eval("(" + xhr.responseText + ")");
                swal({
                    title: 'Lỗi',
                    text: err.Message,
                    icon: 'error',
                    button: {
                        text: "Đóng",
                        value: true,
                        visible: true,
                        className: "btn btn-primary"
                    }
                });
                return;
            }
        });
    });
</script>