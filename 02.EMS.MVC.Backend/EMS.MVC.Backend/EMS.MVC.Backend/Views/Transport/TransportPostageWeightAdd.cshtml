@model EMS.MVC.Backend.Models.TransportPostageCommonModel
@{
    ViewBag.Title = "TransportPostageWeightAdd";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="template-demo">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-custom">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index","Transport")">Quản lý cước vận chuyển</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index","Transport")">Cấu hình</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("FreightChargesView", "TransportMainService")">Danh sách bảng cước</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("TransportPostageMainFee", "Transport", new { PostageID = Model.PostageID })">@Model.PostageName</a></li>
                        <li class="breadcrumb-item active" aria-current="page"><span>Khai báo cước chính - Khối lượng</span></li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>
<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="col-12 mb-4">
                @if (Model.GroupID == 2) //Cước chính - Khối lượng
                {
                    <table class="table table-bordered">
                        <thead style="background-color: #d5e9ff;">
                            <tr class="text-center align-middle">
                                <th colspan="2">
                                    Khối lượng (gram)
                                </th>
                                <th rowspan="2" style="vertical-align: middle!important;">Mức giá</th>
                                <th rowspan="2"><button type="button" class="btn btn-sm btn-primary form-control-sm" id="AddItemPostageWeight" onclick="AddItemPostageWeight(this)"><i class="fa fa-plus m-0"></i></button></th>
                            </tr>
                            <tr class="text-center">
                                <th>Từ</th>
                                <th>Đến</th>
                            </tr>
                        </thead>
                        <tbody id="Weight">
                            <tr>
                                <td class="vertical-top">
                                    <input class="form-control form-control-sm w-100 mb-1" type="text" name="FromWeight" disabled value="0" onkeypress="" placeholder="Nhập khối lượng" data-inputmask="'alias': 'currency'" />
                                    <span class="error-message" name="errFromWeight"></span>
                                </td>
                                <td class="vertical-top">
                                    <input class="form-control form-control-sm w-100 mb-1" type="text" name="ToWeight" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập khối lượng" data-inputmask="'alias': 'currency'" />
                                    <span class="error-message" name="errToWeight"></span>
                                </td>
                                <td class="vertical-top">
                                    <input class="form-control form-control-sm w-100 mb-1" type="text" name="Value" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập mức giá" data-inputmask="'alias': 'currency'" />
                                    <span class="error-message" name="errValue"></span>
                                </td>
                                <td class="text-center vertical-top"><button type="button" class="btn btn-sm btn-warning form-control-sm" tabindex="-1" onclick=""><i class="fa fa-minus"></i></button></td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3">
                                    <div class="input-group input-group-sm">
                                        <div class="input-group input-group-prepend">
                                            <span class="input-group-text text-black-important">Mỗi </span>
                                        </div>
                                        <input class="form-control" name="NextWeight" style="width: 100px;" type="text" placeholder="Nhập khối lượng" data-inputmask="'alias': 'currency'" />
                                        <div class="input-group-prepend input-group-append">
                                            <span class="input-group-text text-black-important"> tiếp theo giá </span>
                                        </div>
                                        <input style="width: 100px;" class="form-control" name="NextValue" type="text" placeholder="Nhập mức giá" data-inputmask="'alias': 'currency'" />
                                    </div>
                                    <span class="error-message" name="errNextWeight"></span>
                                    <span class="error-message" name="errNextValue"></span>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                }
                else if (Model.GroupID == 5)
                {
                    <table class="table table-bordered" id="tbl_Weight">
                        <thead style="background-color: #d5e9ff;">
                            <tr class="text-center align-middle">
                                <th colspan="2">
                                    Khối lượng (gram)
                                </th>
                                <th rowspan="2" style="vertical-align: middle!important;">Mức giá</th>
                                <th rowspan="2"><button type="button" class="btn btn-sm btn-primary form-control-sm" onclick="AddItemPostageExtraServiceWeight(this);"><i class="fa fa-plus m-0"></i></button></th>
                            </tr>
                            <tr class="text-center">
                                <th>Từ</th>
                                <th>Đến</th>
                            </tr>
                        </thead>
                        <tbody id="Weight">
                            <tr>
                                <td class="col-3 vertical-top">
                                    <input class="form-control form-control-sm w-100 mb-1" onkeypress="RemoveErrorMessage(this)" name="FromWeight" type="text" value="0" disabled placeholder="Nhập khối lượng" data-inputmask="'alias': 'currency'" />
                                    <span class="error-message" name="errFromWeight"></span>
                                </td>
                                <td class="col-3 vertical-top">
                                    <input class="form-control form-control-sm w-100 mb-1" onkeypress="RemoveErrorMessage(this)" name="ToWeight" type="text" placeholder="Nhập khối lượng" data-inputmask="'alias': 'currency'" />
                                    <span class="error-message" name="errToWeight"></span>
                                </td>
                                <td class="col-6 vertical-top">
                                    <div class="row">
                                        <div class="col-md-6">
                                            @*<label>Đơn vị tính</label>*@
                                            <select class="form-control form-control-sm mb-1" name="Unit" onchange="CheckUnit(this)">
                                                <option value="1" selected>Việt nam đồng (VNĐ)</option>
                                                <option value="2">Phần trăm (%)</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6">
                                            @*<label>Giá trị</label>*@
                                            <input class="form-control form-control-sm mb-1" type="text" name="Value" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập giá trị" data-inputmask="'alias': 'currency'" />
                                            <span class="error-message" name="errValue"></span>
                                        </div>
                                        <div class="col-md-6 mt-3 SurchargePercent d_none Percent">
                                            @*<label>Số tiền tối thiểu</label>*@
                                            <input class="form-control form-control-sm" name="MinValue" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập số tiền tối thiểu" data-inputmask="'alias': 'currency'" />
                                            <span class="error-message" name="errMinValue"></span>
                                        </div>
                                        <div class="col-md-6 mt-3 SurchargePercent d_none Percent">
                                            @*<label>Số tiền tối đa</label>*@
                                            <input class="form-control form-control-sm" name="MaxValue" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập số tiền tối đa" data-inputmask="'alias': 'currency'" />
                                            <span class="error-message" name="errMaxValue"></span>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center vertical-top"><button type="button" class="btn btn-sm btn-warning form-control-sm" onclick="RemoveItemPostageWeight(this)"><i class="fa fa-minus"></i></button></td>
                            </tr>
                        </tbody>
                        <tfoot id="NextWeight">
                            <tr>
                                <td colspan="3">
                                    <div class="input-group input-group-sm">
                                        <div class="input-group input-group-prepend">
                                            <span class="input-group-text text-black-important">Mỗi </span>
                                        </div>
                                        <input class="form-control" style="width: 100px;" type="text" name="NextWeight" placeholder="Nhập khối lượng" data-inputmask="'alias': 'currency'" />
                                        <div class="input-group-prepend input-group-append">
                                            <span class="input-group-text text-black-important"> tiếp theo giá </span>
                                        </div>
                                        <input style="width: 100px;" class="form-control" type="text" name="NextValue" placeholder="Nhập mức giá" data-inputmask="'alias': 'currency'" />
                                    </div>
                                    <span class="error-message" name="errNextWeight"></span>
                                    <span class="error-message" name="errNextValue"></span>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                    @*<table class="table table-bordered">
                <thead style="background-color: #d5e9ff;">
                    <tr class="text-center align-middle">
                        <th colspan="2">
                            Khối lượng (gram)
                        </th>
                        <th rowspan="2" style="vertical-align: middle!important;">Mức giá</th>
                        <th rowspan="2"><button type="button" class="btn btn-sm btn-primary form-control-sm" onclick=""><i class="fa fa-plus m-0"></i></button></th>
                    </tr>
                    <tr class="text-center">
                        <th>Từ</th>
                        <th>Đến</th>
                    </tr>
                </thead>
                <tbody class="BodyExtraServiceWeight">
                    <tr>
                        <td class="col-3 vertical-top"><input class="form-control form-control-sm w-100" type="text" placeholder="Nhập khối lượng" data-inputmask="'alias': 'currency'" /></td>
                        <td class="col-3 vertical-top"><input class="form-control form-control-sm w-100" type="text" placeholder="Nhập khối lượng" data-inputmask="'alias': 'currency'" /></td>
                        <td class="col-6 vertical-top">
                            <div class="row">
                                <div class="col-md-6">
                                    <select class="form-control form-control-sm" onchange="CheckUnit(this)">
                                        <option value="1" selected>Việt nam đồng (VNĐ)</option>
                                        <option value="2">Phần trăm (%)</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <input class="form-control form-control-sm" type="text" name="Value" placeholder="Nhập giá trị" data-inputmask="'alias': 'currency'" />
                                </div>
                                <div class="col-md-6 mt-3 SurchargePercent d_none Percent">
                                    <input class="form-control form-control-sm" name="Min" placeholder="Nhập số tiền tối thiểu" data-inputmask="'alias': 'currency'" />
                                </div>
                                <div class="col-md-6 mt-3 SurchargePercent d_none Percent">
                                    <input class="form-control form-control-sm" name="Max" placeholder="Nhập số tiền tối đa" data-inputmask="'alias': 'currency'" />
                                </div>
                            </div>
                        </td>
                        <td class="text-center vertical-top"><button type="button" class="btn btn-sm btn-warning form-control-sm" onclick=""><i class="fa fa-minus"></i></button></td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3">
                            <div class="input-group input-group-sm">
                                <div class="input-group input-group-prepend">
                                    <span class="input-group-text text-black-important">Mỗi </span>
                                </div>
                                <input class="form-control" style="width: 100px;" type="text" placeholder="Nhập khối lượng" data-inputmask="'alias': 'currency'" />
                                <div class="input-group-prepend input-group-append">
                                    <span class="input-group-text text-black-important"> tiếp theo giá </span>
                                </div>
                                <input style="width: 100px;" class="form-control" type="text" placeholder="Nhập mức giá" data-inputmask="'alias': 'currency'" />
                            </div>
                        </td>
                    </tr>
                </tfoot>
            </table>*@
                }
                <button class="btn btn-sm btn-primary mt-3 pull-right" id="Submit">Tạo</button>
            </div>
        </div>
    </div>
</div>
<script>
    let model = @Html.Raw(Json.Encode(Model));

    function AddItemPostageExtraServiceWeight(This) {
        debugger;
        let strHtml = '', isError = false;
        let list = $(This).parents('table#tbl_Weight').find('#Weight').find('tr');
        if (list.length == 0) {
            strHtml = '<tr>' +
                '<td class="col-3 vertical-top"><input class="form-control form-control-sm w-100" name="FromWeight" onkeypress="RemoveErrorMessage(this)" value="0" disabled type="text" placeholder="Nhập khối lượng" data-inputmask="' + "'alias': 'currency'" + '"/>' +
                '<span class="error-message" name="errFromWeight"></span></td>' +
                '<td class="col-3 vertical-top"><input class="form-control form-control-sm w-100 mb-1" name="ToWeight" onkeypress="RemoveErrorMessage(this)" type="text" placeholder="Nhập khối lượng" data-inputmask="' + "'alias': 'currency'" + '"/>' +
                '<span class="error-message" name="errToWeight"></span></td>' +
                '<td class="col-6 vertical-top">' +
                '<div class="row">' +
                '<div class="col-md-6">' +
                '<select class="form-control form-control-sm" name="Unit" onchange="CheckUnit(this)">' +
                '<option value="1" selected>Việt nam đồng (VNĐ)</option>' +
                '<option value="2">Phần trăm (%)</option>' +
                '</select>' +
                '</div>' +
                '<div class="col-md-6">' +
                '<input class="form-control form-control-sm mb-1" type="text" name="Value" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập giá trị" data-inputmask="' + "'alias': 'currency'" + '"/>' +
                '<span class="error-message" name="errValue"></span>' +
                '</div>' +
                '<div class="col-md-6 mt-3 mb-1 SurchargePercent d_none Percent">' +
                '<input class="form-control form-control-sm" name="MinValue" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập số tiền tối thiểu" data-inputmask="' + "'alias': 'currency'" + '"/>' +
                '<span class="error-message" name="errMinValue"></span>' +
                '</div>' +
                '<div class="col-md-6 mt-3 mb-1 SurchargePercent d_none Percent">' +
                '<input class="form-control form-control-sm" name="MaxValue" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập số tiền tối đa" data-inputmask="' + "'alias': 'currency'" + '"/>' +
                '<span class="error-message" name="errMaxValue"></span>' +
                '</div>' +
                '</div>' +
                '</td>' +
                '<td class="text-center vertical-top"><button type="button" class="btn btn-sm btn-warning form-control-sm" onclick="RemoveItemPostageWeight(this)"><i class="fa fa-minus"></i></button></td>' +
                '</tr>';
        }
        else {
            let FromWeight = $(list[list.length - 1]).find('[name=FromWeight]').val().replaceAll(',', '');
            let ToWeight = $(list[list.length - 1]).find('[name=ToWeight]').val().replaceAll(',', '');
            let Value = $(list[list.length - 1]).find('[name=Value]').val().trim();
            let Unit = $(list[list.length - 1]).find('[name=Unit]').val();
            if (FromWeight == "") {
                $(list[list.length - 1]).find('[name=errFromWeight]').text('Trường này không được để trống.');
                isError = true;
            }
            if (ToWeight == "") {
                $(list[list.length - 1]).find('[name=errToWeight]').text('Trường này không được để trống.');
                isError = true;
            }
            if (FromWeight != "" && ToWeight != "") {
                if (Number(FromWeight) >= Number(ToWeight)) {
                    $(list[list.length - 1]).find('[name=errToWeight]').text('Giá trị đến phải lớn hơn giá trị từ.');
                    isError = true;
                }
            }

            if (Value == "") {
                $(list[list.length - 1]).find('[name=errValue]').text('Trường này không được để trống.');
                isError = true;
            }
            if (isError) {
                return;
            }

            let FromWeightNext = Number(ToWeight) + 1;
            strHtml = '<tr>' +
                '<td class="col-3 vertical-top"><input class="form-control form-control-sm w-100 mb-1" onkeypress="RemoveErrorMessage(this)" value="' + FromWeightNext + '" disabled name="FromWeight" type="text" placeholder="Nhập khối lượng" data-inputmask="' + "'alias': 'currency'" + '"/>' +
                '<span class="error-message" name="errFromWeight"></span></td>' +
                '<td class="col-3 vertical-top"><input class="form-control form-control-sm w-100 mb-1" onkeypress="RemoveErrorMessage(this)" name="ToWeight" type="text" placeholder="Nhập khối lượng" data-inputmask="' + "'alias': 'currency'" + '"/>' +
                '<span class="error-message" name="errToWeight"></span></td>' +
                '<td class="col-6 vertical-top">' +
                '<div class="row">' +
                '<div class="col-md-6">' +
                '<select class="form-control form-control-sm" name="Unit" onchange="CheckUnit(this)">' +
                '<option value="1" selected>Việt nam đồng (VNĐ)</option>' +
                '<option value="2">Phần trăm (%)</option>' +
                '</select>' +
                '</div>' +
                '<div class="col-md-6">' +
                '<input class="form-control form-control-sm mb-1" type="text" name="Value" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập giá trị" data-inputmask="' + "'alias': 'currency'" + '"/>' +
                '<span class="error-message" name="errValue"></span>' +
                '</div>' +
                '<div class="col-md-6 mt-3 mb-1 SurchargePercent d_none Percent">' +
                '<input class="form-control form-control-sm" name="MinValue" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập số tiền tối thiểu" data-inputmask="' + "'alias': 'currency'" + '"/>' +
                '<span class="error-message" name="errMinValue"></span>' +
                '</div>' +
                '<div class="col-md-6 mt-3 mb-1 SurchargePercent d_none Percent">' +
                '<input class="form-control form-control-sm" name="MaxValue" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập số tiền tối đa" data-inputmask="' + "'alias': 'currency'" + '"/>' +
                '<span class="error-message" name="errMaxValue"></span>' +
                '</div>' +
                '</div>' +
                '</td>' +
                '<td class="text-center vertical-top"><button type="button" class="btn btn-sm btn-warning form-control-sm" onclick="RemoveItemPostageWeight(this)"><i class="fa fa-minus"></i></button></td>' +
                '</tr>';
        }
        $(This).parents('table').find('tbody#Weight').append(strHtml);

        var ROOT = window.location.origin;
        loadjs(ROOT + '/Assets/js/inputmask.js');
    }

    $('#Submit').on('click', function () {
        let arrWeight = [], isError = false;
        let listWeight = $('#Weight').find('tr');
        let MaxTemp = 0;
        for (let j = 0; j < listWeight.length; j++) {
            let objWeight = {};
            let itemWeight = listWeight[j];
            objWeight.PostageID = model.PostageID;
            objWeight.GroupID = model.GroupID;
            objWeight.FromWeight = $(itemWeight).find('[name=FromWeight]').val().replaceAll(',', '');
            objWeight.ToWeight = $(itemWeight).find('[name=ToWeight]').val().replaceAll(',', '');
            objWeight.Value = $(itemWeight).find('[name=Value]').val().replaceAll(',', '');
            if (model.GroupID == 5) {
                objWeight.Unit = $(itemWeight).find('[name=Unit]').val();
                objWeight.MinValue = $(itemWeight).find('[name=MinValue]').val().replaceAll(',', '');
                objWeight.Value = $(itemWeight).find('[name=Value]').val().replaceAll(',', '');
            }
            if (objWeight.FromWeight == "") {
                $(itemWeight).find('[name=errFromWeight]').text('Trường này không được để trống.');
                isError = true;
            }
            if (objWeight.ToWeight == "") {
                $(itemWeight).find('[name=errToWeight]').text('Trường này không được để trống.');
                isError = true;
            }
            else {
                if (objWeight.ToWeight < MaxTemp) {
                    $(itemWeight).find('[name=errToWeight]').text('Giá trị không hợp lệ. Vui lòng kiểm tra lại.');
                    isError = true;
                }
                else {
                    MaxTemp = objWeight.ToWeight;
                }
            }
            if (objWeight.Value == "") {
                $(itemWeight).find('[name=errValue]').text('Trường này không được để trống.');
                isError = true;
            }
            if (isError) {
                return;
            }
            arrWeight.push(objWeight);
        }
        let objWeight = {};
        objWeight.FromWeight = $('[name=NextWeight]').val().replaceAll(',', '');
        objWeight.Value = $('[name=NextValue]').val().replaceAll(',', '');
        if (objWeight.FromWeight != "" && objWeight.Value == "" || objWeight.FromWeight == "" && objWeight.Value != "") {
            $('#MainFee_Weight').find('[name=errNextWeight]').text('Khối lượng không được để trống.');
            $('#MainFee_Weight').find('[name=errNextValue]').text('Mức giá không được để trống.');
        }
        if (objWeight.FromWeight != "" && objWeight.Value != "") {
            arrWeight.push(objWeight);
        }
        debugger;
        if (isError) {
            return;
        }
        $.ajax({
            type: 'POST',
            url: '@Url.Action("JTransportPostageWeightAdd", "Transport")',
            dataType: 'json',
            loading: true,
            data: { data: arrWeight },
            success: function (res) {
                if (res.Code == "00") {
                    swal({
                        icon: "success",
                        title: "Thông báo",
                        text: res.Message,
                        timer: 1500,
                        button: false
                    }).then(function () {
                        if (model.GroupID == 2) {
                            window.location.href = '@Url.Action("TransportPostageMainFee", "Transport", new { PostageID = Model.PostageID } )';
                        }
                        else if (model.GroupID == 5) {
                            window.location.href = '@Url.Action("TransportPostageExtraService", "Transport", new { PostageID = Model.PostageID } )';
                        }
                    });
                } else {
                    swal({
                        icon: "error",
                        title: "Thông báo",
                        text: res.Message,
                        button: {
                            text: "Đóng"
                        }
                    });
                }
            },
            error: function (xhr, status, error) {
                var err = eval("(" + xhr.responseText + ")");
                swal({
                    icon: 'error',
                    title: 'Lỗi',
                    text: err.Message,
                    button: {
                        text: "Đóng",
                        value: true,
                        visible: true,
                        className: "btn btn-primary"
                    }
                });
                return;
            }
        });


    });
</script>
<script>
    $(document).ready(function () {
        $(document).keypress(function (e) {
            if (e.keyCode == 13)
                $('#AddItemPostageWeight').click();
        });
    });
</script>