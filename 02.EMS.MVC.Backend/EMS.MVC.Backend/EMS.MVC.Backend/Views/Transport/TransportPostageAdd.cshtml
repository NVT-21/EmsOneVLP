    //---------------Submit------------------>
    $('#btn-Submit').on('click', function () {
        let ulError = document.getElementById("error-msg"), isError = false;
        ulError.innerHTML = '';

        // Ngày kết thúc
        let EndDate = "";
        let cbEndDate = getCheckboxValue("cbEndDate");
        if (cbEndDate == "Y") {
            EndDate = $('#EndDate').val();
            isError = checkNull(EndDate, '#errEndDate', isError);
        }


        let agrs = {
            //Tab 1 --- BasicInfo
            Code: $('#Code').val(),
            Name: $('#Name').val(),
            StartDate: $('#StartDate').val(),
            EndDate: EndDate,
            MainServiceID: $('#MainServiceID').val(),
            Area: 1, // 1 là Trong nước
            RegionGroupID: $('#RegionGroupID').val(),
            SubjectsOfApplication: $('#SubjectsOfApplication').val(),
            //Tab 2 --- MainFee
            MainFeeVAT: getCheckboxValue("MainFee_VAT"),
            MainFeeWeight: getCheckboxValue("cbMainFee_Weight"),
            //Tab 3 --- Surcharge
            SurchargeVAT: getCheckboxValue("Surcharge_VAT"),
            Fuel: getCheckboxValue("cbFuel"),
            RemoteArea: getCheckboxValue("cbRemoteArea"),
            IslandsArea: getCheckboxValue("cbIslandsArea"),
            MainFeeRangeView: getCheckboxValue("cbMainFee_RangeView"),
            //Tab 4 --- ExtraService
            ExtraServiceID: $('#ExtraServiceID').val(),
            ExtraServiceVAT: getCheckboxValue("ExtraService_VAT"),
            ExtraServicePostage: getCheckboxValue("cbExtraService_Postage"),
            ExtraServiceQuantity: getCheckboxValue("cbExtraService_Quantity"),
            ExtraServiceHeavyGoods: getCheckboxValue("cbExtraService_HeavyGoods"),
            ExtraServiceLightGoods: getCheckboxValue("cbExtraService_LightGoods"),
            ExtraServiceRange: getCheckboxValue("cbExtraService_Range"),
            ExtraServiceWeight: getCheckboxValue("cbExtraService_Weight"),
            ExtraServiceDeclaredValue: getCheckboxValue("cbExtraService_DeclaredValue"),
            ExtraServiceMainFee: getCheckboxValue("cbExtraService_MainFee"),
            ExtraServiceSurcharge: getCheckboxValue("cbExtraService_Surcharge")
        };

        //checkNull
        isError = checkNull(agrs.Code, '#errCode', isError);
        isError = checkNull(agrs.Name, '#errName', isError);
        isError = checkNull(agrs.StartDate, '#errStartDate', isError);
        isError = checkNull(agrs.MainServiceID, '#errMainServiceID', isError);
        isError = checkNull(agrs.RegionGroupID, '#errRegionGroupID', isError);
        isError = checkNull(agrs.SubjectsOfApplication, '#errSubjectsOfApplication', isError);

        //Thông tin cơ bản - Áp dụng cho
        if (agrs.SubjectsOfApplication == 3) //Khách hàng
        {
            agrs.ApplicationObjectValue = $('#ApplyToShops').val();
            isError = checkNull(agrs.ApplicationObjectValue, '.errApplicationObjectValue', isError);
        }
        else if (agrs.SubjectsOfApplication == 4)//Nơi xuất phát
        {
            agrs.ApplicationObjectValue = $('#ApplyToProvinces').val();
            isError = checkNull(agrs.ApplicationObjectValue, '.errApplicationObjectValue', isError);
        }

        //Khai báo cước chính - Căn cứ tính cước
        let cbMainFee_RangeView = getCheckboxValue("cbMainFee_RangeView"); // Phạm vi

        if (agrs.MainFeeWeight == "Y" && cbMainFee_RangeView == "Y") //Khối lượng + Phạm vi
        {
            let cbMainFee_Range = getCheckboxValue("cbMainFee_Range");
            if (cbMainFee_Range == "N") //Nội tỉnh
            {
                agrs.MainFeeRange = 1;
                let MainFeeWeightValue = {};
                let MainFee_Weight = $('#MainFee_Weight').find('tbody').find('tr')
                MainFee_Weight

            }
            else if (cbMainFee_Range == "Y")//Liên Tỉnh
            {
                agrs.MainFeeRange = 2;
            }

            agrs.TwoWay = getCheckboxValue("TwoWay"); //Phạm vi - Hỗ trợ vận chuyển 2 chiều
            agrs.MainFeeRemoteArea = getCheckboxValue("cbRemoteAreaView"); //Phạm vi - Vùng xa
            agrs.MainFeeIslandsArea = getCheckboxValue("cbIslandsAreaView"); //Phạm vi - Vùng hải đảo
        }




        //Tên bảng cước
        let Name = $('#Name').val();
        isError = funcRequired('Name', isError);

        //Ngày bắt đầu
        let StartDate = $('#StartDate').val();
        isError = funcRequired('StartDate', isError);

        //Ngày kết thúc
        var checkedEndDate = document.getElementById("cbEndDate").checked;
        if (checkedEndDate) {
            let EndDate = $('#EndDate').val();
            isError = funcRequired('EndDate', isError);
            if (EndDate != "") {
                if (convertDate(StartDate) > convertDate(EndDate)) {
                    $('#errEndDate').text('Thời gian không hợp lệ');
                    isError = true;
                }
            }
        }

        console.log('log', isError);
        if (isError) {
            return;
        };

        swal({
            title: 'Xác nhận hành động',
            text: "Bạn chắc chắn muốn thêm chương trình khuyến mãi này?",
            icon: 'warning',
            buttons: {
                confirm: {
                    text: "Có",
                    value: true,
                    visible: true,
                    className: "btn btn-primary",
                    closeModal: true
                },
                cancel: {
                    text: "Không",
                    value: false,
                    visible: true,
                    className: "btn btn-danger",
                    closeModal: true,
                }
            },
        }).then((value) => {
            if (value) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("JAddPromotion", "Promotions")',
                    dataType: 'json',
                    loading: true,
                    data: agrs,
                    success: function (res) {
                        if (res.Code == "00") {
                            swal({
                                title: "Thông báo",
                                icon: "success",
                                text: res.Message,
                                button: false,
                                timer: 1500
                            });
                            setTimeout(function () { window.location.href = "@Url.Action("Index", "Promotions")" }, 1200);
                        } else {
                            swal({
                                icon: "error",
                                title: "Thông báo",
                                text: res.Message,
                                button: {
                                    text: "Đóng"
                                }
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        var err = eval("(" + xhr.responseText + ")");
                        swal({
                            icon: 'error',
                            title: 'Lỗi',
                            text: err.Message,
                            button: {
                                text: "Đóng",
                                value: true,
                                visible: true,
                                className: "btn btn-primary"
                            }
                        });
                        return;
                    }
                });
            }
        });
    });
</script>