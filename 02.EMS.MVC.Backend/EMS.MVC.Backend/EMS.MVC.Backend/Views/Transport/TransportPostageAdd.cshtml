    });

    $('#cbMainFee_Weight, .cbMainFee_Range, #cbMainFee_RangeView').on('change', function () {
        var CheckedW = document.getElementById("cbMainFee_Weight").checked;
        var CheckedR = document.getElementById("cbMainFee_Range").checked;
        var CheckedRangeView = document.getElementById("cbMainFee_RangeView").checked;

        if (CheckedW && CheckedR && CheckedRangeView) {
            $('#MainFee_Weight').hide();
            $('#MainFee_Range').hide();
            $('#MainFee_Range_Weight').show();
        }
        else if (CheckedW) {
            $('#MainFee_Range_Weight').hide();
            $('#MainFee_Weight').show();
        }
        else if (CheckedR && CheckedRangeView) {
            $('#MainFee_Range_Weight').hide();
            $('#MainFee_Range').show();
        }
        else {
            $('#MainFee_Weight').hide();
            $('#MainFee_Range').hide();
            $('#MainFee_Range_Weight').hide();
        }
    });
    //-------------->

    //TAB-4 Căn cứ tính cước
    $('#ExtraService_AddRange').on('click', function () {
        $.get('@Url.Action("TransportPostageExtraServiceRange", "Transport")', function (htmlString) {
            $('#ExtraService_Range_Body').append(htmlString);
        })
    });

    $('#ExtraService_AddRangeWeight').on('click', function () {
        $.get('@Url.Action("TransportPostageExtraServiceRangeWeight", "Transport")', function (htmlString) {
            $('#ExtraService_Range_Weight_Body').append(htmlString);
