    $('#cbExtraService_Weight, #cbExtraService_Range').on('change', function () {
        var CheckedWeight = document.getElementById("cbExtraService_Weight").checked;
        var CheckedRange = document.getElementById("cbExtraService_Range").checked;
        if (CheckedWeight && CheckedRange) {
            $('#ExtraService_Weight').hide();
            $('#ExtraService_Range').hide();
            $('#ExtraService_Range_Weight').show();
        }
        else if (CheckedWeight) {
            $('#ExtraService_Range_Weight').hide();
            $('#ExtraService_Weight').show();
        }
        else if (CheckedRange) {
            $('#ExtraService_Range_Weight').hide();
            $('#ExtraService_Range').show();
        }
        else {
            $('#ExtraService_Weight').hide();
            $('#ExtraService_Range').hide();
            $('#ExtraService_Range_Weight').hide();
        }
    });
