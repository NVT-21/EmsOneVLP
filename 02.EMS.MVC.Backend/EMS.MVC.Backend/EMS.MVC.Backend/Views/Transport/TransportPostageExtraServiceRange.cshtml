@{
    Layout = null;
}
<div class="card mt-3">
    <div class="card-body pt-10px">
        <div class="col-12">
            <span class="">Khai báo cước theo phạm vi <span class="text-danger">(*)</span> </span>
            <button class="btn btn-sm btn-danger pull-right mb-2" onclick="RemoveRange(this);" style="margin-top:-4px;">Xoá</button>
        </div>
        <div class="col-12">
            <table class="table table-bordered">
                <thead>
                    <tr class="text-center">
                        <th class="align-middle w-auto" style="background-color: #d5e9ff;"> Từ</th>
                        <th class="col-5">
                            <div class="row">
                                <div class="col-12 mb-3">
                                    <select class="form-control" onchange="CheckFromRangeType(this)">
                                        <option value="1" selected>Vùng</option>
                                        <option value="2">Tỉnh/Thành Phố</option>
                                    </select>
                                </div>
                                <div class="col-12 FromRegion">
                                    <select class="form-control selectpicker w-100" name="FromRegion" data-live-search="true" data-dropup-auto="false" data-size="8">
                                        <option value="" selected>Chọn vùng</option>
                                        @foreach (var item in ViewBag.RegionList)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12 FromProvince" style="display:none;">
                                    <select class="form-control selectpicker w-100" name="FromProvince" data-live-search="true" data-dropup-auto="false" data-size="8">
                                        <option value="" selected>Chọn Tỉnh/Thành phố</option>
                                        @foreach (var item in ViewBag.ProvincesList)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </th>
                        <th class="align-middle w-auto" style="background-color: #d5e9ff;"> Đến</th>
                        <th class="col-5">
                            <div class="row">
                                <div class="col-12 mb-3">
                                    <select class="form-control" onchange="CheckToRangeType(this)">
                                        <option value="1" selected>Vùng</option>
                                        <option value="2">Tỉnh/Thành Phố</option>
                                    </select>
                                </div>
                                <div class="col-12 ToRegion">
                                    <select class="form-control selectpicker w-100" name="ToRegion" data-live-search="true" data-dropup-auto="false" data-size="8">
                                        <option value="" selected>Chọn vùng</option>
                                        @foreach (var item in ViewBag.RegionList)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12 ToProvince" style="display:none;">
                                    <select class="form-control selectpicker w-100" name="ToProvince" data-live-search="true" data-dropup-auto="false" data-size="8">
                                        <option value="" selected>Chọn Tỉnh/Thành phố</option>
                                        @foreach (var item in ViewBag.ProvincesList)
                                        {
                                            <option value="@item.Value">@item.Text</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </th>
                    </tr>
                </thead>
                <tbody class="pt-3">
                    <tr>
                        <td colspan="4">
                            <div class="row p-2">
                                <div class="col-md-6 mb-3">
                                    <label>Đơn vị tính</label>
                                    <select class="form-control" onchange="CheckUnit(this)">
                                        <option value="1" selected>Việt nam đồng (VNĐ)</option>
                                        <option value="2">Phần trăm (%)</option>
                                    </select>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label>Giá trị</label>
                                    <input class="form-control" type="text" name="Value" placeholder="Nhập giá trị" data-inputmask="'alias': 'currency'" />
                                </div>
                                <div class="col-md-6 mb-3 SurchargePercent d_none Percent">
                                    <label>Số tiền tối thiểu</label>
                                    <input class="form-control" name="Min" placeholder="Nhập số tiền" data-inputmask="'alias': 'currency'" />
                                </div>
                                <div class="col-md-6 mb-3 SurchargePercent d_none Percent">
                                    <label>Số tiền tối đa</label>
                                    <input class="form-control" name="Max" placeholder="Nhập số tiền" data-inputmask="'alias': 'currency'" />
                                </div>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $('select.selectpicker').selectpicker();
    });
</script>