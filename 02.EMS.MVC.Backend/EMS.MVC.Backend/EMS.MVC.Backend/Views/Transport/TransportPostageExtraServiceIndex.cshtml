@{
    ViewBag.Title = "TransportPostageExtraServiceIndex";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="template-demo">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-custom">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index","Transport")">Quản lý cước vận chuyển</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index","Transport")">Cấu hình</a></li>
                        <li class="breadcrumb-item active" aria-current="page"><span>Danh sách bảng cước DV cộng thêm</span></li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="col-12">
                <button class="btn btn-sm btn-primary mb-2 pull-right text-left w-auto" onclick="window.location.href = '@Url.Action("TransportPostageExtraServiceAdd", "Transport")'"> Tạo mới</button>
            </div>
            <div id="tbl-data" class="table-responsive">
                @{ Html.RenderAction("TransportPostageExtraServiceList", "Transport"); }
            </div>
        </div>
    </div>
</div>
<script>
    //Tạm dừng
    function Lock(PostageID) {
        swal({
            title: 'Thông báo',
            text: "Bạn chắc chắn muốn tạm dừng gói cước này?",
            icon: 'warning',
            buttons: {
                confirm: {
                    text: "Có",
                    value: true,
                    visible: true,
                    className: "btn btn-primary",
                    closeModal: true
                },
                cancel: {
                    text: "Không",
                    value: false,
                    visible: true,
                    className: "btn btn-danger",
                    closeModal: true,
                }
            },
        }).then((value) => {
            if (value) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("JTransportPostageLock", "Transport")',
                    data: {
                        PostageID: PostageID
                    },
                    dataType: 'json',
                    success: function (res) {
                        if (res.Code == "00") {
                            swal({
                                icon: "success",
                                title: "Thông báo",
                                text: res.Message,
                                html: true,
                                button: false
                            });
                            setTimeout(function () {
                                location.reload();
                            }, 1200);
                        } else {
                            swal({
                                icon: "error",
                                title: "Thông báo",
                                text: res.Message,
                                button: {
                                    text: "Đóng"
                                }
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        var err = eval("(" + xhr.responseText + ")");
                        swal({
                            title: 'Error',
                            text: err.Message,
                            icon: 'error',
                            button: {
                                text: "Close",
                                value: true,
                                visible: true,
                                className: "btn btn-primary"
                            }
                        });
                        return;
                    }
                });
            }
        });
    }
    //Mở
    function Unlock(PostageID) {
        swal({
            title: 'Thông báo',
            text: "Bạn chắc chắn muốn mở gói cước này?",
            icon: 'warning',
            buttons: {
                confirm: {
                    text: "Có",
                    value: true,
                    visible: true,
                    className: "btn btn-primary",
                    closeModal: true
                },
                cancel: {
                    text: "Không",
                    value: false,
                    visible: true,
                    className: "btn btn-danger",
                    closeModal: true,
                }
            },
        }).then((value) => {
            debugger;
            if (value) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("JTransportPostageUnlock", "Transport")',
                    data: {
                        PostageID: PostageID
                    },
                    dataType: 'json',
                    success: function (res) {
                        if (res.Code == "00") {
                            swal({
                                icon: "success",
                                title: "Thông báo",
                                text: res.Message,
                                html: true,
                                button: false
                            });
                            setTimeout(function () {
                                location.reload();
                            }, 1200);
                        } else {
                            swal({
                                icon: "error",
                                title: "Thông báo",
                                text: res.Message,
                                button: {
                                    text: "Đóng"
                                }
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        var err = eval("(" + xhr.responseText + ")");
                        swal({
                            title: 'Error',
                            text: err.Message,
                            icon: 'error',
                            button: {
                                text: "Close",
                                value: true,
                                visible: true,
                                className: "btn btn-primary"
                            }
                        });
                        return;
                    }
                });
            }
        });
    }
</script>

