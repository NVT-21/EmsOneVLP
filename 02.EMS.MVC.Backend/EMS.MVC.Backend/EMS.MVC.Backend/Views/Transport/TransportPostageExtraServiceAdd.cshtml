@model EMS.MVC.Backend.Models.TransportPostageExtraServiceAddViewModel
@{
    ViewBag.Title = "TransportPostageExtraServiceAdd";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    /*td {
        padding: 5px 5px 5px 5px !important;
    }

    th {
        padding: 10px 10px !important;
        font-weight: 500 !important;
    }*/

    .datepicker-days .table-condensed {
        margin-bottom: 20px;
    }

    .filter-option-inner-inner {
        color: black !important;
    }
    .btn {
        text-transform: none;
    }
</style>
<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="template-demo">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-custom">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Transport")">Quản lý cước vận chuyển</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Transport")">Cấu hình</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("TransportPostageExtraServiceIndex", "Transport")">Danh sách bảng cước DV cộng thêm</a></li>
                        <li class="breadcrumb-item active" aria-current="page"><span>Tạo mới bảng cước</span></li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div id="Content">
                <div class="card">
                    <div class="card-body">
                        <div class="form-group row">
                            <div class="col-6 mb-3">
                                <label for="">Dịch vụ cộng thêm <span class="text-danger"></span></label>
                                <select class="form-control selectpicker w-100" data-live-search="true" data-dropup-auto="false" data-size="8" data-selected-text-format="count" data-actions-box="true" multiple id="ExtraServiceIDs" onchange="checkNull(this.value,'#errExtraServiceIDs','')">
                                    @foreach (var item in Model.ExtraServiceList)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                                <span class="error-message" id="errExtraServiceIDs"></span>
                            </div>
                            <div class="col-lg-6 mb-3">
                                <label>&nbsp;</label>
                                <div class="form-check">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input" checked id="VAT">
                                        Cước đã bao gồm VAT
                                        <i class="input-helper"></i>
                                    </label>
                                </div>
                            </div>
                            <div class="col-lg-6 mb-3">
                                <label for="PricesOriginal">Ngày bắt đầu <span class="text-danger">(*)</span> </label>
                                <input type="text" class="form-control" size="16" id="StartDate" placeholder="Ngày/ Tháng/ Năm Giờ:Phút" autocomplete="off">
                                <span class="error-message" id="errStartDate"></span>
                            </div>
                            <div class="col-lg-6 mb-3">
                                <div class="form-check mt-0">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input" id="cbEndDate">
                                        Ngày kết thúc
                                        <i class="input-helper"></i>
                                    </label>
                                </div>
                                <input type="text" class="form-control" id="EndDate" placeholder="Ngày/ Tháng/ Năm Giờ:Phút" autocomplete="off" disabled>
                                <span class="error-message" id="errEndDate"></span>
                            </div>
                            <div class="col-6 mb-3">
                                <label for="">Căn cứ tính cước <span class="text-danger"></span></label>
                                <select class="form-control" id="ChargingConditionsID">
                                    <option value="" selected>--- Chọn ---</option>
                                    @foreach (var item in Model.ListChargingConditions)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                            </div>
                            @* Dùng cho bưu gửi, số lượng*@
                            <div class="col-md-6 mb-3 d_none" id="VNDView">
                                <label>Mức cước (VNĐ)</label>
                                <input class="form-control" id="Value" placeholder="Nhập giá trị" data-inputmask="'alias': 'currency'" onchange="checkNull(this.value,'#errValue','')" />
                                <span class="error-message" id="errValue"></span>
                            </div>
                            @* Dùng cho giá trị*@
                            <div class="col-md-6 mb-3 d_none" id="PercentView">
                                <label>Mức cước (%)</label>
                                <input class="form-control" id="PercentValue" placeholder="Nhập giá trị" data-inputmask="'alias': 'percentage'" onchange="checkNull(this.value,'#errPercentValue','')" />
                                <span class="error-message" id="errPercentValue"></span>
                            </div>
                            <div class="col-md-6 mb-3 d_none" id="MinValuaView">
                                <label>Giá trị tối thiểu</label>
                                <input class="form-control" id="MinValue" placeholder="Nhập giá trị" data-inputmask="'alias': 'currency'" onchange="checkNull(this.value,'#errMinValue','')" />
                                <span class="error-message" id="errMinValue"></span>
                            </div>
                            <div class="col-6 mb-3 d_none" id="ServicesUsedView">
                                <label for="">Các dịch vụ chính được áp dụng <span class="text-danger"></span></label>
                                <select class="form-control selectpicker w-100" data-live-search="true" data-dropup-auto="false" data-size="8" data-selected-text-format="count" data-actions-box="true" multiple id="ServicesUsed">
                                    @foreach (var item in Model.MainServiceList)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 pt-3 pb-3">
                    <button class="btn btn-sm btn-primary pull-right w-auto" id="Submit">Tạo mới</button>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    var model = @Html.Raw(Json.Encode(Model));
    $(document).ready(function () {
        jQuery.datetimepicker.setLocale('vi');
        $('#StartDate, #EndDate').datetimepicker({
            format: 'd/m/Y H:i',
            lang: "vi",
            autoclose: true, minDate: new Date(), startDate: new Date('@DateTime.Now.Year', '@(DateTime.Now.Month - 1)', '@DateTime.Now.Day', @DateTime.Now.Hour, @DateTime.Now.Minute, 0, 0),
            step: 10,
            validateOnBlur: true
        });

        $('#ExtraServiceIDs').selectpicker();
    });

    //Kiểm tra thời gian sử dụng
    $('#StartDate, #EndDate, #cbEndDate').on('change', function () {
        var CheckEndDate = document.getElementById("cbEndDate").checked;
        if (CheckEndDate) {
            $('#EndDate').prop("disabled", false);
        }
        else {
            $('#EndDate').val("");
            $('#EndDate').prop("disabled", true);
        }

        let strStartDate = $('#StartDate').val();
        let strEndDate = $('#EndDate').val();
        if (strStartDate != "") {
            $('#errStartDate').text('');
        }
        $('#errEndDate').text('');
        if (strEndDate == "" && CheckEndDate) {
            $('#errEndDate').text('Trường này không được để trống.');
        }
        if (CheckEndDate && strStartDate != "" && strEndDate != "") {
            var StartDate = convertDateTime(strStartDate);
            var EndDate = convertDateTime(strEndDate);
            if (StartDate > EndDate) {
                if (this.id == "StartDate") {
                    $("#EndDate").datetimepicker({ value: StartDate });
                }
                else {
                    $("#StartDate").datetimepicker({ value: EndDate });
                }
            }
            else {
                $('#errEndDate').text('');
            }
        }
        else if (CheckEndDate && StartDate != "" && EndDate == "") {
            $('#EndDate').val(StartDate);
        }
    });

    $('#ChargingConditionsID').on('change', function () {
        var val = $('#ChargingConditionsID').val();
        debugger;
        if (val == 1)//Bưu gửi
        {
            $('#VNDView').css('display', 'block');
            $('#PercentView').css('display', 'none');
            $('#MinValuaView').css('display', 'none');
            $('#ServicesUsedView').css('display', 'none');
        }
        else if (val == 2)//Số lượng
        {
            $('#VNDView').css('display', 'block');
            $('#PercentView').css('display', 'none');
            $('#MinValuaView').css('display', 'block');
            $('#ServicesUsedView').css('display', 'none');
        }
        else if (val == 3)// Giá trị
        {
            $('#VNDView').css('display', 'none');
            $('#PercentView').css('display', 'block');
            $('#MinValuaView').css('display', 'block');
            $('#ServicesUsedView').css('display', 'none');
        }
        else if (val == 4)// Cước chính
        {
            $('#VNDView').css('display', 'none');
            $('#PercentView').css('display', 'none');
            $('#MinValuaView').css('display', 'none');
            $('#ServicesUsedView').css('display', 'block');
        }
        else
        {
            $('#VNDView').css('display', 'none');
            $('#PercentView').css('display', 'none');
            $('#MinValuaView').css('display', 'none');
            $('#ServicesUsedView').css('display', 'none');
        }
    });

    //Tạo bảng cước
    $('#Submit').on('click', function () {
        var isError = false;
        debugger;
        // Ngày kết thúc
        let EndDate = "";
        let cbEndDate = getCheckboxValue("cbEndDate");
        if (cbEndDate == "Y") {
            EndDate = $('#EndDate').val();
            isError = checkNull(EndDate, '#errEndDate', isError);
        }


        let agrs = {
            ExtraServiceIDs: $('#ExtraServiceIDs').val(),
            VAT: getCheckboxValue("VAT"),
            StartDate: $('#StartDate').val(),
            EndDate: EndDate,
            ChargingConditionsID: $('#ChargingConditionsID').val(),
        };

        //checkNull
        isError = checkNull(agrs.ExtraServiceIDs, '#errExtraServiceIDs', isError);
        isError = checkNull(agrs.StartDate, '#errStartDate', isError);
        /*isError = checkNull(agrs.ChargingConditionsID, '#errChargingConditionsID', isError);*/

        if (agrs.ChargingConditionsID == 1)//Bưu gửi
        {
            agrs.ChargingConditionsValue = $('#Value').val().replaceAll(',', '');
            if (agrs.ChargingConditionsValue == "") {
                $('#errValue').text('Trường này không được để trống.');
                isError = true;
            }
            else if (agrs.ChargingConditionsValue == 0) {
                $('#errValue').text('Giá trị phải lớn hơn 0.');
                isError = true;
            }
        }
        else if (agrs.ChargingConditionsID == 2)//Số lượng
        {
            agrs.ChargingConditionsValue = $('#Value').val().replaceAll(',', '');
            agrs.ChargingConditionsMinValue = $('#MinValue').val().replaceAll(',', '');
            if (agrs.ChargingConditionsValue == "") {
                $('#errValue').text('Trường này không được để trống.');
                isError = true;
            }
            else if (agrs.ChargingConditionsValue == 0) {
                $('#errValue').text('Giá trị phải lớn hơn 0.');
                isError = true;
            }
            if (agrs.ChargingConditionsMinValue == "") {
                $('#errMinValue').text('Trường này không được để trống.');
                isError = true;
            }
            else if (agrs.ChargingConditionsMinValue == 0) {
                $('#errMinValue').text('Giá trị phải lớn hơn 0.');
                isError = true;
            }
        }
        else if (agrs.ChargingConditionsID == 3)//Giá trị
        {
            agrs.ChargingConditionsValue = $('#PercentValue').val().replaceAll(',', '');
            agrs.ChargingConditionsMinValue = $('#MinValue').val().replaceAll(',', '');
            if (agrs.ChargingConditionsValue == "") {
                $('#errPercentValue').text('Trường này không được để trống.');
                isError = true;
            }
            else if (agrs.ChargingConditionsValue == 0) {
                $('#errValue').text('Giá trị phải lớn hơn 0.');
                isError = true;
            }
            if (agrs.ChargingConditionsMinValue == "") {
                $('#errMinValue').text('Trường này không được để trống.');
                isError = true;
            }
            else if (agrs.ChargingConditionsMinValue == 0) {
                $('#errMinValue').text('Giá trị phải lớn hơn 0.');
                isError = true;
            }
        }
        else if (agrs.ChargingConditionsID == 4)//Cước chính
        {
            agrs.ServicesUsed = $('#ServicesUsed').val().toString();
        }

        //Lỗi - trả về
        if (isError) {
            return;
        }
        swal({
            title: 'Thông báo',
            text: "Bạn chắc chắn muốn tạo bảng cước?",
            buttons: {
                confirm: {
                    text: "CÓ",
                    value: true,
                    visible: true,
                    className: "btn btn-primary",
                    closeModal: true
                },
                cancel: {
                    text: "KHÔNG",
                    value: false,
                    visible: true,
                    className: "btn btn-danger",
                    closeModal: true,
                }
            },
        }).then((value) => {
            if (value) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("JTransportPostageExtraServiceAdd", "Transport")',
                    dataType: 'json',
                    loading: true,
                    data: agrs,
                    success: function (res) {
                        if (res.Code == "00") {
                            swal({
                                title: "Thông báo",
                                text: res.Message,
                                button: false,
                                timer: 2500
                            }).then(function () {
                                window.location.href = '@Url.Action("TransportPostageExtraServiceIndex", "Transport")';
                            });
                        } else {
                            swal({
                                title: "Thông báo",
                                text: res.Message,
                                button: {
                                    text: "ĐÓNG"
                                }
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        var err = eval("(" + xhr.responseText + ")");
                        swal({
                            title: 'Lỗi',
                            text: err.Message,
                            button: {
                                text: "ĐÓNG",
                                value: true,
                                visible: true,
                                className: "btn btn-primary"
                            }
                        });
                        return;
                    }
                });
            }
        });
    });


</script>
