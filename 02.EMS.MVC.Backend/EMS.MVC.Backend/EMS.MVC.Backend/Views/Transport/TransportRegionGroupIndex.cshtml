@model List<EMS.MVC.Backend.Models.TransportRegionGroupViewModel>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="template-demo">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-custom">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index","Transport")">Quản lý cước vận chuyển</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index","Transport")">Cấu hình</a></li>
                        <li class="breadcrumb-item active" aria-current="page"><span>Nhóm vùng</span></li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="col-12">
            <button id="btnAdd" class="btn btn-sm btn-primary form-control pull-right text-left col-sm-4 col-md-3 col-lg-2 mt-3">
                <i class="fa fa-plus"></i> Thêm mới
            </button>
        </div>
        <div class="card-body">
            <table id="data-table" class="table table-bordered table-hover text-center">
                <thead>
                    <tr class="table-info text-center">
                        <th> Mã nhóm </th>
                        <th> Tên nhóm </th>
                        <th> Miêu tả </th>
                        <th> Người/thời gian tạo </th>
                        <th> Thao tác </th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count > 0)
                    {
                        var i = 1;
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Code</td>
                                <td>@item.Name</td>
                                <td>@item.Description</td>
                                <td>
                                    <p>@item.CreatedBy</p>
                                    <p>@item.CreatedDate</p>
                                </td>
                                <td>
                                    @*<button onclick="Edit(@item.ID)" title="Sửa" class="badge badge-outline-danger">
                                        <i class="fa fa-edit"></i>
                                    </button>*@
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">Không có dữ liệu</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    //Thêm
    $('#btnAdd').on('click', function () {
        var url = '@Url.Action("TransportRegionGroupAdd", "Transport", new { area = "" })';
        $.get(url, function (htmlString) {
            $('#modal-common-container').html(htmlString);
            $('#modal-common').modal('show');
        });
    });
</script>