@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="template-demo">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-custom">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index","Transport")">Quản lý cước vận chuyển</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index","Transport")">Cấu hình</a></li>
                        <li class="breadcrumb-item active" aria-current="page"><span>Dịch vụ</span></li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            @*<div class="col-12">
                <button id="btnAdd" class="btn btn-primary btn-sm pull-right text-left w-auto">
                    <i class="fa fa-plus"></i> Thêm mới
                </button>
            </div>*@
            <ul class="nav nav-tabs" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" id="MainService" data-toggle="tab" href="#MainService1" role="tab" aria-controls="MainService1" aria-selected="true" onclick="funcTabs('1')">Dịch vụ chính</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="ExtraService" data-toggle="tab" href="#ExtraService1" role="tab" aria-controls="ExtraService1" aria-selected="false" onclick="funcTabs('2')">Dịch vụ cộng thêm</a>
                </li>
            </ul>
            <div class="tab-content">
                <div class="tab-pane fade show active" id="Data" role="tabpanel" aria-labelledby="MainService">
                    @{Html.RenderAction("TransportServiceList", "Transport", new { ServiceGroupID = 1 });}
                </div>
                <!--<div class="tab-pane fade pt-3" id="ExtraService1" role="tabpanel" aria-labelledby="ExtraService">-->
                @*@{Html.RenderAction("TransportServiceList", "Transport", new { ServiceGroupID = 2 });}*@
                <!--</div>-->
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        OnlyNumber("#MobileNumber");
        OnChangeValidateRegex("#MobileNumber", "#errMobileNumber", "Số điện thoại không hợp lệ", "MobileNumber");
        $('#FromDate').datepicker({
            format: 'dd/mm/yyyy',
            language: "vi",
            autoclose: true,
            endDate: new Date('@DateTime.Now.Year', '@(DateTime.Now.Month - 1)', '@DateTime.Now.Day', 0, 0, 0, 0),
            orientation: "bottom auto"
        });
        $('#ToDate').datepicker({
            format: 'dd/mm/yyyy',
            language: "vi",
            autoclose: true,
            endDate: new Date('@DateTime.Now.Year', '@(DateTime.Now.Month - 1)', '@DateTime.Now.Day', 0, 0, 0, 0),
            orientation: "bottom auto"
        });
    });

    function funcTabs(value) {
        var url = '@Url.Action("TransportServiceList", "Transport")';
        $.get(url, { ServiceGroupID: value }, function (htmlString) {
            $('#Data').html(htmlString);
        });
    };

    //Thêm
    $('#btnAdd').on('click', function () {
        var url = '@Url.Action("TransportServiceAdd", "Transport", new { area = "" })';
        $.get(url, function (htmlString) {
            $('#modal-common-container').html(htmlString);
            $('#modal-common').modal('show');
        });
    });

    //Khóa
    function Lock(ServiceID, ServiceName) {
        swal({
            title: 'Thông báo',
            text: "Nếu khóa dịch vụ, bảng cước tương ứng với Dịch vụ " + ServiceName + " sẽ bị Tạm ngừng. Bạn có chắc chắn Khóa?",
            icon: 'warning',
            buttons: {
                confirm: {
                    text: "Có",
                    value: true,
                    visible: true,
                    className: "btn btn-primary",
                    closeModal: true
                },
                cancel: {
                    text: "Không",
                    value: false,
                    visible: true,
                    className: "btn btn-danger",
                    closeModal: true,
                }
            },
        }).then((value) => {
            if (value) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("JTransportServiceLock", "Transport")',
                    data: {
                        ServiceID: ServiceID
                    },
                    dataType: 'json',
                    success: function (res) {
                        if (res.Code == "00") {
                            swal({
                                icon: "success",
                                title: "Thông báo",
                                text: res.Message,
                                html: true,
                                button: false
                            });
                            setTimeout(function () {
                                location.reload();
                            }, 1200);
                        } else {
                            swal({
                                icon: "error",
                                title: "Thông báo",
                                text: res.Message,
                                button: {
                                    text: "Đóng"
                                }
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        var err = eval("(" + xhr.responseText + ")");
                        swal({
                            title: 'Error',
                            text: err.Message,
                            icon: 'error',
                            button: {
                                text: "Close",
                                value: true,
                                visible: true,
                                className: "btn btn-primary"
                            }
                        });
                        return;
                    }
                });
            }
        });
    }
    //Mở khóa
    function Unlock(ServiceID, ServiceName) {
        swal({
            title: 'Thông báo',
            text: "Bạn chắc chắn muốn mở khóa Dịch vụ " + ServiceName + "?",
            icon: 'warning',
            buttons: {
                confirm: {
                    text: "Có",
                    value: true,
                    visible: true,
                    className: "btn btn-primary",
                    closeModal: true
                },
                cancel: {
                    text: "Không",
                    value: false,
                    visible: true,
                    className: "btn btn-danger",
                    closeModal: true,
                }
            },
        }).then((value) => {
            debugger;
            if (value) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("JTransportServiceUnlock", "Transport")',
                    data: {
                        ServiceID: ServiceID
                    },
                    dataType: 'json',
                    success: function (res) {
                        if (res.Code == "00") {
                            swal({
                                icon: "success",
                                title: "Thông báo",
                                text: res.Message,
                                html: true,
                                button: false
                            });
                            setTimeout(function () {
                                location.reload();
                            }, 1200);
                        } else {
                            swal({
                                icon: "error",
                                title: "Thông báo",
                                text: res.Message,
                                button: {
                                    text: "Đóng"
                                }
                            });
                        }
                    },
                    error: function (xhr, status, error) {
                        var err = eval("(" + xhr.responseText + ")");
                        swal({
                            title: 'Error',
                            text: err.Message,
                            icon: 'error',
                            button: {
                                text: "Close",
                                value: true,
                                visible: true,
                                className: "btn btn-primary"
                            }
                        });
                        return;
                    }
                });
            }
        });
    }

</script>