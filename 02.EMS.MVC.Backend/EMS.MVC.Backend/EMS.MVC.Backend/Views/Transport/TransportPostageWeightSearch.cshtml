@model List<EMS.MVC.Backend.Models.TransportPostageWeightSearchModel>
@{
    ViewBag.Title = "TransportPostageWeightSearchView";
    Layout = null;
    var NextWeight = "";
    var NextValue = "";
}

@if (Model.Count > 0)
{
    <table class="table table-bordered">
        <thead style="background-color: #d5e9ff;">
            <tr class="text-center align-middle">
                <th colspan="2">
                    Khối lượng (gram)
                </th>
                <th rowspan="2" style="vertical-align: middle!important;">Mức giá</th>
                <th rowspan="2"><button type="button" class="btn btn-sm btn-warning form-control-sm">Sửa</button></th>
            </tr>
            <tr class="text-center">
                <th>Từ</th>
                <th>Đến</th>
            </tr>
        </thead>
        <tbody class="BodyMainFeeWeight">
            @{
                foreach (var item in Model)
                {
                    if (item.ToWeight == 0)
                    {
                        NextWeight = item.ToWeight.ToString();
                        NextValue = item.Value.ToString();
                    }
                    <tr>
                        <td class="text-right">
                            @item.FromWeight.ToString("N0")
                        </td>
                        <td class="text-right">
                            @item.ToWeight.ToString("N0")
                        </td>
                        <td class="text-right">
                            @item.Value.ToString("N0")
                        </td>
                        <td class="text-center vertical-top"></td>
                    </tr>
                }
            }
        </tbody>
        @if (NextWeight != "" && NextValue != "")
        {
            <tfoot>
                <tr>
                    <td colspan="3">
                        <div class="input-group input-group-sm">
                            <div class="input-group input-group-prepend">
                                <span class="input-group-text text-black-important">Mỗi </span>
                            </div>
                            <input class="form-control" name="NextWeight" style="width: 100px;" type="text" value="@NextWeight" placeholder="Nhập khối lượng" data-inputmask="'alias': 'currency'" />
                            <div class="input-group-prepend input-group-append">
                                <span class="input-group-text text-black-important"> tiếp theo giá </span>
                            </div>
                            <input style="width: 100px;" class="form-control" name="NextValue" type="text" value="@NextValue" placeholder="Nhập mức giá" data-inputmask="'alias': 'currency'" />
                        </div>
                        <span class="error-message" name="errNextWeight"></span>
                        <span class="error-message" name="errNextValue"></span>
                    </td>
                </tr>
            </tfoot>
        }
    </table>
}
else
{
    <a class="btn btn-sm btn-primary w-auto" href="@Url.Action("TransportPostageWeightAdd", "Transport", new { PostageID = ViewBag.Common.PostageID, GroupID = ViewBag.Common.GroupID, ParentID = ViewBag.Common.ParentID, PostageName = ViewBag.Common.PostageName })" ><i class="fa fa-plus-circle m-0"> Thêm mới</i></a>
}
