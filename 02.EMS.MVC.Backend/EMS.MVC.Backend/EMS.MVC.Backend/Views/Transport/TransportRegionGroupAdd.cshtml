@{
    ViewBag.Title = "";
    Layout = null;
}

<div class="modal-dialog modal-700" role="document">
    <div class="modal-content">
        <div class="modal-header">
            <h4 class="modal-title">Thêm nhóm vùng</h4>
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="modal-body">
            <div class="form-group">
                <label for="exampleInputUsername1">Mã nhóm vùng<span style="color: red"> (*)</span></label>
                <input type="text" class="form-control" id="Code" placeholder="Mã nhóm vùng" onchange="checkCode(this.value,'#errCode','')" oninput="this.value = this.value.toUpperCase()" onkeypress="RemoveErrorMessage(this)" autocomplete="off">
                <label class="error-message" id="errCode"></label>
            </div>
            <div class="form-group">
                <label for="Name">Tên nhóm vùng<span style="color: red"> (*)</span></label>
                <input type="text" class="form-control" id="Name" placeholder="Tên nhóm vùng" autocomplete="off">
                <label class="error-message" id="errName"></label>
            </div>
            <div class="form-group">
                <label for="Description">Miêu tả</label>
                <textarea class="form-control" rows="4" id="Description"></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <div class="col-12">
                <button type="button" class="btn btn-sm btn-primary pull-right" id="btn-submit">Xác nhận</button>
                <button type="button" class="btn btn-sm btn-danger pull-left" data-dismiss="modal" aria-label="Close">Huỷ bỏ</button>
            </div>
        </div>
    </div>
</div>

<script>
    //kiểm tra gàn buộc không được rỗng
    $('#Code, #Name').on('keyup', function () {
            var ID = $(this).attr('ID');
            funcRequired(ID);
    });

    $('#btn-submit').on('click', function () {
        let isError = false;
        let agrs = {
            Code: $('#Code').val(),
            Name: $('#Name').val().trim(),
            Description: $('#Description').val()
        };

        isError = funcRequired('Code', isError);
        isError = funcRequired('Name', isError);
        isError = checkCode(agrs.Code, '#errCode', isError);

        if (isError) {
            return;
        }

        $.ajax({
            type: 'POST',
            url: '@Url.Action("JTransportRegionGroupAdd", "Transport")',
            data: { data: agrs},
            dataType: 'json',
            success: function (res) {
                if (res.Code == "00") {
                    swal({
                        icon: "success",
                        title: "Thông báo",
                        text: res.Message,
                        html: true,
                        button: false
                    });
                    setTimeout(function () { location.reload(); }, 1200);
                } else {
                    swal({
                        icon: "error",
                        title: "Thông báo",
                        text: res.Message,
                        button: {
                            text: "Đóng"
                        }
                    });
                }
            },
            error: function (xhr, status, error) {
                var err = eval("(" + xhr.responseText + ")");
                swal({
                    title: 'Lỗi',
                    text: err.Message,
                    icon: 'error',
                    button: {
                        text: "Đóng",
                        value: true,
                        visible: true,
                        className: "btn btn-primary"
                    }
                });
                return;
            }
        });
    });
</script>
