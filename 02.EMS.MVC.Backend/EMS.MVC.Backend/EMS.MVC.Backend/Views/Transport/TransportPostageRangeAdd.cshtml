@model EMS.MVC.Backend.Models.TransportPostageCommonModel
@{
    ViewBag.Title = "TransportPostageRangeAdd";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="template-demo">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-custom">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index","Transport")">Quản lý cước vận chuyển</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Index","Transport")">Cấu hình</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("FreightChargesView", "TransportMainService")">Danh sách bảng cước</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("TransportPostageMainFee", "Transport", new { PostageID = Model.PostageID })">@Model.PostageName</a></li>
                        <li class="breadcrumb-item active" aria-current="page"><span>Thêm phạm vi tính cước</span></li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body row">
            <label class="car-title-border-bottom pl-3">Khai báo cước theo phạm vi</label>
            <div class="col-auto">
                <div class="form-check">
                    <label class="form-check-label w-auto">
                        <input type="checkbox" class="form-check-input" id="TwoWay">
                        Vận chuyển 2 chiều
                        <i class="input-helper"></i>
                    </label>
                </div>
            </div>
            <div class="col-lg-12 pt-2">
                <table class="table table-bordered">
                    <thead id="Range">
                        <tr class="text-center">
                            <th class="align-middle w-auto" style="background-color: #d5e9ff;"> Từ</th>
                            <th class="col-5">
                                <div class="row">
                                    <div class="col-12 mb-3">
                                        <select class="form-control" name="FromRange" onchange="CheckFromRangeType(this)">
                                            <option value="1" selected>Vùng</option>
                                            <option value="2">Tỉnh/Thành Phố</option>
                                        </select>
                                    </div>
                                    <div class="col-12 FromRegion">
                                        <select class="form-control selectpicker w-100" name="FromRegion" data-live-search="true" data-dropup-auto="false" data-size="8">
                                            <option value="" selected>Chọn vùng</option>
                                            @foreach (var item in Model.RegionList)
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12 FromProvince" style="display:none;">
                                        <select class="form-control selectpicker w-100" name="FromProvince" data-live-search="true" data-dropup-auto="false" data-size="8">
                                            <option value="" selected>Chọn Tỉnh/Thành phố</option>
                                            @foreach (var item in Model.ProvincesList)
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12 text-left pt-1">
                                        <span class="error-message font-weight-normal" id="errFromRangeValue"></span>
                                    </div>
                                </div>
                            </th>
                            <th class="align-middle w-auto" style="background-color: #d5e9ff;"> Đến</th>
                            <th class="col-5">
                                <div class="row">
                                    <div class="col-12 mb-3">
                                        <select class="form-control" name="ToRange" onchange="CheckToRangeType(this)">
                                            <option value="1" selected>Vùng</option>
                                            <option value="2">Tỉnh/Thành Phố</option>
                                        </select>
                                    </div>
                                    <div class="col-12 ToRegion">
                                        <select class="form-control selectpicker w-100" name="ToRegion" data-live-search="true" data-dropup-auto="false" data-size="8">
                                            <option value="" selected>Chọn vùng</option>
                                            @foreach (var item in Model.RegionList)
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12 ToProvince" style="display:none;">
                                        <select class="form-control selectpicker w-100" name="ToProvince" data-live-search="true" data-dropup-auto="false" data-size="8">
                                            <option value="" selected>Chọn Tỉnh/Thành phố</option>
                                            @foreach (var item in Model.ProvincesList)
                                            {
                                                <option value="@item.Value">@item.Text</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-12 text-left pt-1">
                                        <span class="error-message font-weight-normal" id="errToRangeValue"></span>
                                    </div>
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="pt-3">
                        <tr>
                            <td colspan="4">
                                <div class="row p-2">
                                    @if (Model.GroupID == 1)
                                    {
                                        <div class="form-group col-md-6 mb-3">
                                            <label>Giá trị</label>
                                            <input class="form-control" type="text" name="Value" id="RangeValue" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập giá trị" data-inputmask="'alias': 'currency'" />
                                            <label class="error-message" id="errRangeValue"></label>
                                        </div>
                                    }
                                    else if (Model.GroupID == 3)
                                    {
                                        <table class="table table-bordered">
                                            <thead style="background-color: #d5e9ff;">
                                                <tr class="text-center align-middle">
                                                    <th colspan="2">
                                                        Khối lượng (gram)
                                                    </th>
                                                    <th rowspan="2" style="vertical-align: middle!important;">Mức giá</th>
                                                    <th rowspan="2"><button type="button" class="btn btn-sm btn-primary form-control-sm" onclick="AddItemPostageWeight(this)"><i class="fa fa-plus m-0"></i></button></th>
                                                </tr>
                                                <tr class="text-center">
                                                    <th>Từ</th>
                                                    <th>Đến</th>
                                                </tr>
                                            </thead>
                                            <tbody id="Weight">
                                                <tr>
                                                    <td class="vertical-top">
                                                        <input class="form-control form-control-sm w-100 mb-1" type="text" name="FromWeight" disabled value="0" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập khối lượng" data-inputmask="'alias': 'currency'" />
                                                        <span class="error-message" name="errFromWeight"></span>
                                                    </td>
                                                    <td class="vertical-top">
                                                        <input class="form-control form-control-sm w-100 mb-1" type="text" name="ToWeight" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập khối lượng" data-inputmask="'alias': 'currency'" />
                                                        <span class="error-message" name="errToWeight"></span>
                                                    </td>
                                                    <td class="vertical-top">
                                                        <input class="form-control form-control-sm w-100 mb-1" type="text" name="Value" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập mức giá" data-inputmask="'alias': 'currency'" />
                                                        <span class="error-message" name="errValue"></span>
                                                    </td>
                                                    <td class="text-center vertical-top"><button type="button" class="btn btn-sm btn-warning form-control-sm" onclick="RemoveItemPostageWeight(this)"><i class="fa fa-minus"></i></button></td>
                                                </tr>
                                            </tbody>
                                            <tfoot id="NextWeight">
                                                <tr>
                                                    <td colspan="3">
                                                        <div class="input-group input-group-sm">
                                                            <div class="input-group input-group-prepend">
                                                                <span class="input-group-text text-black-important">Mỗi </span>
                                                            </div>
                                                            <input class="form-control" name="NextWeight" style="width: 100px;" type="text" placeholder="Nhập khối lượng" data-inputmask="'alias': 'currency'" />
                                                            <div class="input-group-prepend input-group-append">
                                                                <span class="input-group-text text-black-important"> tiếp theo giá </span>
                                                            </div>
                                                            <input style="width: 100px;" class="form-control" name="NextValue" type="text" placeholder="Nhập mức giá" data-inputmask="'alias': 'currency'" />
                                                        </div>
                                                        <span class="error-message" name="errNextWeight"></span>
                                                        <span class="error-message" name="errNextValue"></span>
                                                    </td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    }
                                    else if (Model.GroupID == 4)
                                    {
                                        <div class="col-md-6 mb-3">
                                            <label>Đơn vị tính</label>
                                            <select class="form-control" id="RangeUnit" onchange="CheckUnit(this)">
                                                <option value="1" selected>Việt nam đồng (VNĐ)</option>
                                                <option value="2">Phần trăm (%)</option>
                                            </select>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label>Giá trị</label>
                                            <input class="form-control" type="text" id="RangeValue" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập giá trị" data-inputmask="'alias': 'currency'" />
                                            <span class="error-message" name="errRangeValue"></span>
                                        </div>
                                        <div class="col-md-6 mb-3 SurchargePercent d_none Percent">
                                            <label>Số tiền tối thiểu</label>
                                            <input class="form-control" id="RangeMinValue" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập số tiền" data-inputmask="'alias': 'currency'" />
                                            <span class="error-message" name="errRangeMinValue"></span>
                                        </div>
                                        <div class="col-md-6 mb-3 SurchargePercent d_none Percent">
                                            <label>Số tiền tối đa</label>
                                            <input class="form-control" id="RangeMaxValue" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập số tiền" data-inputmask="'alias': 'currency'" />
                                            <span class="error-message" name="errRangeMaxValue"></span>
                                        </div>
                                    }
                                    else if (Model.GroupID == 6)
                                    {
                                        <table class="table table-bordered" id="tbl_Weight">
                                            <thead style="background-color: #d5e9ff;">
                                                <tr class="text-center align-middle">
                                                    <th colspan="2">
                                                        Khối lượng (gram)
                                                    </th>
                                                    <th rowspan="2" style="vertical-align: middle!important;">Mức giá</th>
                                                    <th rowspan="2"><button type="button" class="btn btn-sm btn-primary form-control-sm" onclick="AddItemPostageExtraServiceWeight(this);"><i class="fa fa-plus m-0"></i></button></th>
                                                </tr>
                                                <tr class="text-center">
                                                    <th>Từ</th>
                                                    <th>Đến</th>
                                                </tr>
                                            </thead>
                                            <tbody id="Weight">
                                                <tr>
                                                    <td class="col-3 vertical-top">
                                                        <input class="form-control form-control-sm w-100 mb-1" onkeypress="RemoveErrorMessage(this)" name="FromWeight" type="text" value="0" disabled placeholder="Nhập khối lượng" data-inputmask="'alias': 'currency'" />
                                                        <span class="error-message" name="errFromWeight"></span>
                                                    </td>
                                                    <td class="col-3 vertical-top">
                                                        <input class="form-control form-control-sm w-100 mb-1" onkeypress="RemoveErrorMessage(this)" name="ToWeight" type="text" placeholder="Nhập khối lượng" data-inputmask="'alias': 'currency'" />
                                                        <span class="error-message" name="errToWeight"></span>
                                                    </td>
                                                    <td class="col-6 vertical-top">
                                                        <div class="row">
                                                            <div class="col-md-6">
                                                                @*<label>Đơn vị tính</label>*@
                                                                <select class="form-control form-control-sm mb-1" name="Unit" onchange="CheckUnit(this)">
                                                                    <option value="1" selected>Việt nam đồng (VNĐ)</option>
                                                                    <option value="2">Phần trăm (%)</option>
                                                                </select>
                                                            </div>
                                                            <div class="col-md-6">
                                                                @*<label>Giá trị</label>*@
                                                                <input class="form-control form-control-sm mb-1" type="text" name="Value" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập giá trị" data-inputmask="'alias': 'currency'" />
                                                                <span class="error-message" name="errValue"></span>
                                                            </div>
                                                            <div class="col-md-6 mt-3 SurchargePercent d_none Percent">
                                                                @*<label>Số tiền tối thiểu</label>*@
                                                                <input class="form-control form-control-sm" name="MinValue" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập số tiền tối thiểu" data-inputmask="'alias': 'currency'" />
                                                                <span class="error-message" name="errMinValue"></span>
                                                            </div>
                                                            <div class="col-md-6 mt-3 SurchargePercent d_none Percent">
                                                                @*<label>Số tiền tối đa</label>*@
                                                                <input class="form-control form-control-sm" name="MaxValue" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập số tiền tối đa" data-inputmask="'alias': 'currency'" />
                                                                <span class="error-message" name="errMaxValue"></span>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="text-center vertical-top"><button type="button" class="btn btn-sm btn-warning form-control-sm" onclick="RemoveItemPostageWeight(this)"><i class="fa fa-minus"></i></button></td>
                                                </tr>
                                            </tbody>
                                            <tfoot id="NextWeight">
                                                <tr>
                                                    <td colspan="3">
                                                        <div class="input-group input-group-sm">
                                                            <div class="input-group input-group-prepend">
                                                                <span class="input-group-text text-black-important">Mỗi </span>
                                                            </div>
                                                            <input class="form-control" style="width: 100px;" type="text" name="NextWeight" placeholder="Nhập khối lượng" data-inputmask="'alias': 'currency'" />
                                                            <div class="input-group-prepend input-group-append">
                                                                <span class="input-group-text text-black-important"> tiếp theo giá </span>
                                                            </div>
                                                            <input style="width: 100px;" class="form-control" type="text" name="NextValue" placeholder="Nhập mức giá" data-inputmask="'alias': 'currency'" />
                                                        </div>
                                                        <span class="error-message" name="errNextWeight"></span>
                                                        <span class="error-message" name="errNextValue"></span>
                                                    </td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    }
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="col-lg-12 pt-2">
                @if (Model.GroupID == 1 || Model.GroupID == 4)
                {
                    <button type="button" class="btn btn-sm btn-primary pull-right" id="Add_Range_1_4">Thêm</button>
                }
                else if (Model.GroupID == 3 || Model.GroupID == 6)
                {
                    <button type="button" class="btn btn-sm btn-primary pull-right" id="Add_Range_3_6">Thêm</button>
                }
            </div>
        </div>
    </div>
</div>

<script>
    let model = @Html.Raw(Json.Encode(Model));
    $('[name=FromRegion], [name=FromProvince]').on('change', function () {
        debugger;
        $('#errFromRangeValue').text('');
    });
    $('[name=ToRegion], [name=ToProvince]').on('change', function () {
        $('#errToRangeValue').text('');
    });

    function AddItemPostageExtraServiceWeight(This) {
        debugger;
        let strHtml = '', isError = false;
        let list = $(This).parents('table#tbl_Weight').find('#Weight').find('tr');
        if (list.length == 0) {
            strHtml = '<tr>' +
                '<td class="col-3 vertical-top"><input class="form-control form-control-sm w-100" name="FromWeight" onkeypress="RemoveErrorMessage(this)" value="0" disabled type="text" placeholder="Nhập khối lượng" data-inputmask="' + "'alias': 'currency'" + '"/>' +
                '<span class="error-message" name="errFromWeight"></span></td>' +
                '<td class="col-3 vertical-top"><input class="form-control form-control-sm w-100 mb-1" name="ToWeight" onkeypress="RemoveErrorMessage(this)" type="text" placeholder="Nhập khối lượng" data-inputmask="' + "'alias': 'currency'" + '"/>' +
                '<span class="error-message" name="errToWeight"></span></td>' +
                '<td class="col-6 vertical-top">' +
                '<div class="row">' +
                '<div class="col-md-6">' +
                '<select class="form-control form-control-sm" name="Unit" onchange="CheckUnit(this)">' +
                '<option value="1" selected>Việt nam đồng (VNĐ)</option>' +
                '<option value="2">Phần trăm (%)</option>' +
                '</select>' +
                '</div>' +
                '<div class="col-md-6">' +
                '<input class="form-control form-control-sm mb-1" type="text" name="Value" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập giá trị" data-inputmask="' + "'alias': 'currency'" + '"/>' +
                '<span class="error-message" name="errValue"></span>' +
                '</div>' +
                '<div class="col-md-6 mt-3 mb-1 SurchargePercent d_none Percent">' +
                '<input class="form-control form-control-sm" name="MinValue" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập số tiền tối thiểu" data-inputmask="' + "'alias': 'currency'" + '"/>' +
                '<span class="error-message" name="errMinValue"></span>' +
                '</div>' +
                '<div class="col-md-6 mt-3 mb-1 SurchargePercent d_none Percent">' +
                '<input class="form-control form-control-sm" name="MaxValue" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập số tiền tối đa" data-inputmask="' + "'alias': 'currency'" + '"/>' +
                '<span class="error-message" name="errMaxValue"></span>' +
                '</div>' +
                '</div>' +
                '</td>' +
                '<td class="text-center vertical-top"><button type="button" class="btn btn-sm btn-warning form-control-sm" onclick="RemoveItemPostageWeight(this)"><i class="fa fa-minus"></i></button></td>' +
                '</tr>';
        }
        else {
            let FromWeight = $(list[list.length - 1]).find('[name=FromWeight]').val().replaceAll(',', '');
            let ToWeight = $(list[list.length - 1]).find('[name=ToWeight]').val().replaceAll(',', '');
            let Value = $(list[list.length - 1]).find('[name=Value]').val().trim();
            let Unit = $(list[list.length - 1]).find('[name=Unit]').val();
            if (FromWeight == "") {
                $(list[list.length - 1]).find('[name=errFromWeight]').text('Trường này không được để trống.');
                isError = true;
            }
            if (ToWeight == "") {
                $(list[list.length - 1]).find('[name=errToWeight]').text('Trường này không được để trống.');
                isError = true;
            }
            if (FromWeight != "" && ToWeight != "") {
                if (Number(FromWeight) >= Number(ToWeight)) {
                    $(list[list.length - 1]).find('[name=errToWeight]').text('Giá trị đến phải lớn hơn giá trị từ.');
                    isError = true;
                }
            }

            if (Value == "") {
                $(list[list.length - 1]).find('[name=errValue]').text('Trường này không được để trống.');
                isError = true;
            }
            if (isError) {
                return;
            }

            let FromWeightNext = Number(ToWeight) + 1;
            strHtml = '<tr>' +
                '<td class="col-3 vertical-top"><input class="form-control form-control-sm w-100 mb-1" onkeypress="RemoveErrorMessage(this)" value="' + FromWeightNext + '" disabled name="FromWeight" type="text" placeholder="Nhập khối lượng" data-inputmask="' + "'alias': 'currency'" + '"/>' +
                '<span class="error-message" name="errFromWeight"></span></td>' +
                '<td class="col-3 vertical-top"><input class="form-control form-control-sm w-100 mb-1" onkeypress="RemoveErrorMessage(this)" name="ToWeight" type="text" placeholder="Nhập khối lượng" data-inputmask="' + "'alias': 'currency'" + '"/>' +
                '<span class="error-message" name="errToWeight"></span></td>' +
                '<td class="col-6 vertical-top">' +
                '<div class="row">' +
                '<div class="col-md-6">' +
                '<select class="form-control form-control-sm" name="Unit" onchange="CheckUnit(this)">' +
                '<option value="1" selected>Việt nam đồng (VNĐ)</option>' +
                '<option value="2">Phần trăm (%)</option>' +
                '</select>' +
                '</div>' +
                '<div class="col-md-6">' +
                '<input class="form-control form-control-sm mb-1" type="text" name="Value" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập giá trị" data-inputmask="' + "'alias': 'currency'" + '"/>' +
                '<span class="error-message" name="errValue"></span>' +
                '</div>' +
                '<div class="col-md-6 mt-3 mb-1 SurchargePercent d_none Percent">' +
                '<input class="form-control form-control-sm" name="MinValue" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập số tiền tối thiểu" data-inputmask="' + "'alias': 'currency'" + '"/>' +
                '<span class="error-message" name="errMinValue"></span>' +
                '</div>' +
                '<div class="col-md-6 mt-3 mb-1 SurchargePercent d_none Percent">' +
                '<input class="form-control form-control-sm" name="MaxValue" onkeypress="RemoveErrorMessage(this)" placeholder="Nhập số tiền tối đa" data-inputmask="' + "'alias': 'currency'" + '"/>' +
                '<span class="error-message" name="errMaxValue"></span>' +
                '</div>' +
                '</div>' +
                '</td>' +
                '<td class="text-center vertical-top"><button type="button" class="btn btn-sm btn-warning form-control-sm" onclick="RemoveItemPostageWeight(this)"><i class="fa fa-minus"></i></button></td>' +
                '</tr>';
        }
        $(This).parents('table').find('tbody#Weight').append(strHtml);

        var ROOT = window.location.origin;
        loadjs(ROOT + '/Assets/js/inputmask.js');
    }

    $('#Add_Range_3_6').on('click', function () {
        let isError = false;
        let obj = {};
        let item = document.getElementById('Range');
        obj.PostageID = @Model.PostageID;
        obj.GroupID = model.GroupID;
        obj.TwoWay = getCheckboxValue("TwoWay");
        obj.FromRange = $(item).find('[name=FromRange]').val();
        debugger;
        if (obj.FromRange == 1)//Vùng
        {
            obj.FromRangeValue = $(item).find('[name=FromRegion]').val();
        }
        else//Tỉnh/TP
        {
            obj.FromRangeValue = $(item).find('[name=FromProvince]').val();
        }
        if (obj.FromRangeValue == "") {
            $(item).find('#errFromRangeValue').text('Giá trị từ không được để trống.');
            isError = true;
        }

        obj.ToRange = $(item).find('[name=ToRange]').val();
        if (obj.ToRange == 1)//Vùng
        {
            obj.ToRangeValue = $(item).find('[name=ToRegion]').val();
        }
        else//Tỉnh/TP
        {
            obj.ToRangeValue = $(item).find('[name=ToProvince]').val();
        }
        if (obj.ToRangeValue == "") {
            $(item).find('#errToRangeValue').text('Giá trị đến không được để trống.');
            isError = true;
        }
        debugger;
        let Weight = [];
        let listWeight = $('#Weight').find('tr');
        let MaxTemp = -1;
        for (let j = 0; j < listWeight.length; j++) {
            let objWeight = {};
            let itemWeight = listWeight[j];
            objWeight.FromWeight = $(itemWeight).find('[name=FromWeight]').val().replaceAll(',','');
            objWeight.ToWeight = $(itemWeight).find('[name=ToWeight]').val().replaceAll(',', '');
            objWeight.Value = $(itemWeight).find('[name=Value]').val().replaceAll(',', '');
            objWeight.Unit = $(itemWeight).find('[name=Unit]').val();

            //Giá trị từ: rỗng
            if (objWeight.FromWeight == "") {
                $(itemWeight).find('[name=errFromWeight]').text('Trường này không được để trống.');
                isError = true;
            }
            else {
                //Giá trị từ nhỏ hơn giá trị đến trước đó
                if (objWeight.FromWeight <= MaxTemp) {
                    $(itemWeight).find('[name=errFromWeight]').text('Giá trị không hợp lệ. Vui lòng kiểm tra lại.');
                    isError = true;
                }
            }
            //Giá trị đến: rỗng
            if (objWeight.ToWeight == "") {
                $(itemWeight).find('[name=errToWeight]').text('Trường này không được để trống.');
                isError = true;
            }
            else {
                //Lưu tạm giá trị đến
                MaxTemp = objWeight.ToWeight;
            }
            //Giá trị từ >= giá trị đến
            if (objWeight.FromWeight != "" && objWeight.ToWeight != "") {
                if (objWeight.FromWeight >= objWeight.ToWeight) {
                    $(itemWeight).find('[name=errToWeight]').text('Giá trị đến phải lớn hơn giá trị từ.');
                    isError = true;
                }
            }
            //Giá trị: rỗng
            if (objWeight.Value == "") {
                $(itemWeight).find('[name=errValue]').text('Trường này không được để trống.');
                isError = true;
            }

            if (objWeight.Unit == 2) {
                objWeight.MinValue = $(itemWeight).find('[name=MinValue]').val().replaceAll(',', '');
                objWeight.MaxValue = $(itemWeight).find('[name=MaxValue]').val().replaceAll(',', '');
                //if (objWeight.MinValue == "") {
                //    $(itemWeight).find('[name=errMinValue]').text('Trường này không được để trống.');
                //    isError = true;
                //}
                //if (objWeight.MinValue == "") {
                //    $(itemWeight).find('[name=errMinValue]').text('Trường này không được để trống.');
                //    isError = true;
                //}
            }

            if (isError) {
                return;
            }
            Weight.push(objWeight);
        }
        let objWeight = {};
            objWeight.FromWeight = $('#NextWeight').find('[name=NextWeight]').val().replaceAll(',', '');
            objWeight.Value = $('#NextWeight').find('[name=NextValue]').val().replaceAll(',', '');
        if (objWeight.FromWeight != "" && objWeight.Value == "" || objWeight.FromWeight == "" && objWeight.Value != "") {
            $(itemWeight).find('[name=errNextWeight]').text('Khối lượng không được để trống.');
            $(itemWeight).find('[name=errNextValue]').text('Mức giá không được để trống.');
        }
        if (objWeight.FromWeight != "" && objWeight.Value != "") {
            Weight.push(objWeight);
        }
        obj.Weight = Weight;

        //Lỗi - trả về
        if (isError) {
            return;
        }
        $.ajax({
                    type: 'POST',
            url: '@Url.Action("JTransportPostageRangeAdd", "Transport")',
            dataType: 'json',
            loading: true,
            data: obj,
            success: function (res) {
                if (res.Code == "00") {
                    swal({
                        icon: "success",
                        title: "Thông báo",
                        text: res.Message,
                        timer: 1500,
                        button: false
                    }).then(function () {
                        if (model.GroupID == 3) {
                            window.location.href = '@Url.Action("TransportPostageMainFee", "Transport", new { PostageID = Model.PostageID } )';
                        }
                        else if (model.GroupID == 6) {
                            window.location.href = '@Url.Action("TransportPostageExtraService", "Transport", new { PostageID = Model.PostageID } )';
                        }
                    });
                } else {
                    swal({
                        icon: "error",
                        title: "Thông báo",
                        text: res.Message,
                        button: {
                            text: "Đóng"
                        }
                    });
                }
            },
            error: function (xhr, status, error) {
                var err = eval("(" + xhr.responseText + ")");
                swal({
                    icon: 'error',
                    title: 'Lỗi',
                    text: err.Message,
                    button: {
                        text: "Đóng",
                        value: true,
                        visible: true,
                        className: "btn btn-primary"
                    }
                });
                return;
            }
        });
    });

