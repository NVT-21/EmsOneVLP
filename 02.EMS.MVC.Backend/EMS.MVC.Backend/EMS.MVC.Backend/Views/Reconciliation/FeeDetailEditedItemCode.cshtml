            isError = true;
        }

        var check_date = getDateDiff(agrs.FromDate, agrs.ToDate);
        if (check_date < 0) {
            errMsg = 'Ngày bắt đầu không được lớn hơn ngày kết thúc.';
            isError = true;
        }
        if (agrs.CustomerPPCRM == "") {
            if (check_date > 7) {
                errMsg = 'Vui lòng chọn thời gian lọc dữ liệu trong vòng 1 tuần.';
                isError = true;
            }
        } else {
            if (check_date > 31) {
                errMsg = 'Vui lòng chọn thời gian lọc dữ liệu trong vòng 1 tháng.';
                isError = true;
            }
        }

        if (isError) {
            swal({
                title: 'Thông báo',
                text: errMsg,
                icon: 'error',
                button: {
                    text: "Đóng",
                    value: true,
                    visible: true,
                    className: "btn btn-primary"
                }
            })
            return;
        }
        window.location.href = "@Url.Action("ExportExcelDataEditedItemCode", "Reconciliation")?PostOffice=" + agrs.PostOffice + "&FromDate=" + agrs.FromDate + "&ToDate=" + agrs.ToDate;
    });
    $("#btnExportPDF").on("click", function () {
        var errMsg = '', isError = false;
        var agrs = {
            FromDate: $('#FromDate').val(),
