            }
        } else {
            if (check_date > 31) {
                errMsg = 'Vui lòng chọn thời gian lọc dữ liệu trong vòng 1 tháng.';
                isError = true;
            }
        }

        if (isError) {
            swal({
                title: 'Thông báo',
                text: errMsg,
                icon: 'error',
                button: {
                    text: "Đóng",
                    value: true,
                    visible: true,
                    className: "btn btn-primary"
                }
            })
            return;
        }
        window.location.href = "@Url.Action("ExportPDFDataEditedItemCode", "Reconciliation")?PostOffice=" + agrs.PostOffice + "&FromDate=" + agrs.FromDate + "&ToDate=" + agrs.ToDate;
    });
</script>
