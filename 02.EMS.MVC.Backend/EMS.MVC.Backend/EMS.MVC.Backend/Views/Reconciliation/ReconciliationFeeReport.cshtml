@model EMS.MVC.Backend.Models.ReconciliationViewModel
@{
    ViewBag.Title = "ReconciliationFeeReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="template-demo">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb breadcrumb-custom">
                        <li class="breadcrumb-item"><a href="@Url.Action("ReconciliationFeeReport","Reconciliation")">Báo cáo đồng bộ</a></li>
                        <li class="breadcrumb-item active" aria-current="page"><span></span></li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
</div>
<div class="col-md-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-xl-3 col-lg-6 col-md-6 mb-2">
                    <label>&nbsp;</label>
                    <div class="input-group">
                        <div class="input-group-append">
                            <span class="input-group-text bg-secondary text-white border-secondary form-control form-control-sm">Từ</span>
                        </div>
                        <input type="text" class="form-control form-control-sm" id="FromDate" placeholder="Ngày/ Tháng/ Năm" value="@Model.FromDate" />
                        <div class="input-group-append">
                            <span class="input-group-text bg-secondary text-white border-secondary form-control form-control-sm">Đến</span>
                        </div>
                        <input type="text" class="form-control form-control-sm" id="ToDate" placeholder="Ngày/ Tháng/ Năm" value="@Model.ToDate">
                    </div>
                </div>
                <div class="col-lg-3 mb-2">
                    <label>Mã bưu cục</label>
                    @Html.EditorFor(model => model.PostOffice, new { htmlAttributes = new { @type = "text", @class = "form-control form-control-sm", @placeholder = "Mã bưu cục điều chỉnh" } })
                </div>
                <div class="col-lg-3 mb-2">
                    <label>Mã PayPost/CRM</label>
                    @Html.EditorFor(model => model.CustomerPPCRM, new { htmlAttributes = new { @type = "text", @class = "form-control form-control-sm", @placeholder = "Mã PayPost/CRM" } })
                </div>
                <div class="col-lg-3 mb-2">
                    <label>Loại bưu gửi</label>
                    <select class="select2 form-control" id="TypeItem">
                        <option value="" selected>Tất cả</option>
                        <option value="N">Phát hành mới</option>
                        <option value="R">Chuyển hoàn</option>
                    </select>
                </div>
                <div class="col-lg-3 mb-2">
                    <label>&nbsp;</label>
                    <button id="btnSearch" class="btn btn-sm btn-secondary form-control text-white">
                        <i class="fa fa-search"></i> TÌM KIẾM
                    </button>
                </div>
            </div>
            <hr />
            <div id="tbl-data" class="table-responsive">
                @*@{Html.RenderAction("DataReconciliationFeeReport", "Reconciliation", new { FromDate = Model.FromDate, ToDate = Model.ToDate });}*@
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        CreateDatePicker("#FromDate, #ToDate");
    });
    $('#btnSearch').on('click', function () {
        var errMsg = '', isError = false;
        var agrs = {
            FromDate: $('#FromDate').val(),
            ToDate: $('#ToDate').val(),
            CustomerPPCRM: $('#CustomerPPCRM').val().trim(),
            PostOffice: $('#PostOffice').val().trim(),
            TypeItem: $('#TypeItem').val()
        };
        if (agrs.FromDate == "") {
            errMsg = 'Vui lòng chọn Từ ngày';
            isError = true;
        }
        if (agrs.ToDate == "") {
            errMsg = 'Vui lòng chọn Đến ngày';
            isError = true;
        }

        var check_date = getDateDiff(agrs.FromDate, agrs.ToDate);
        if (check_date < 0) {
            errMsg = 'Ngày bắt đầu không được lớn hơn ngày kết thúc.';
            isError = true;
        }
        if (check_date > 31) {
            errMsg = 'Vui lòng chọn thời gian lọc dữ liệu trong vòng 1 tháng.';
            isError = true;
        }

        if (isError) {
            swal({
                title: 'Thông báo',
                text: errMsg,
                icon: 'error',
                button: {
                    text: "Đóng",
                    value: true,
                    visible: true,
                    className: "btn btn-primary"
                }

            })
            return;
        }

        $.get('@Url.Action("DataReconciliationFeeReport", "Reconciliation")', agrs, function (htmlString) {
            $('#tbl-data').html(htmlString);
        });
    });
</script>