@model EMS.MVC.Backend.Models.DebtNoticesViewModel
@{
    var stt = 1;
}
<style>
    .cell-Width{
        max-width: 100px;
    }
</style>
@if (Model != null)
{
    <p>&nbsp;</p>
    <h4 class="mt-2 ml-4 text-uppercase">Thông Tin Khách Hàng</h4>
    <hr />
    <div class="row mt-2 ml-2">
        <div class="col-lg-4 mb-2 text-content">
            <label class="text-lable"><b>Mã KH: </b>&nbsp;@Model.DataInfo.CustomerCode</label>
        </div>
        <div class="col-lg-4 mb-2 text-content">
            <label class="text-lable"><b>Tên KH: </b>&nbsp;@Model.DataInfo.CustomerName</label>
        </div>
        <div class="col-lg-4 mb-2 text-content">

        </div>
    </div>
    <div class="row mt-2 ml-2 mb-2">
        <div class="col-lg-4 col-xl-4 mb-2 text-content">
            <label class="text-lable"><b>Số điện thoại: </b>&nbsp;@Model.DataInfo.MobileNumber</label>
        </div>
        <div class="col-lg-4 col-xl-4 mb-2 text-content">
            <label class="text-lable"><b>Địa chỉ: </b>&nbsp;@Model.DataInfo.Address</label>
        </div>
        <div class="col-lg-4 col-xl-4 mb-2 text-content">
            <label class="text-lable"><b>TaxCode: </b>&nbsp;@Model.DataInfo.TaxCode</label>
        </div>
    </div>
    <hr />
    <p>&nbsp;</p>
}
<div class="table-responsive">
    <table id="ListDataTableSearch" class="table table-bordered table-hover text-center">
        <thead>
            <tr>
                <th class="align-middle" colspan="7">Tổng dữ liệu</th>
                @if (Model != null)
                {
                    <th class="text-right"> @Model.SumMainFee.ToString("N0") ₫</th>
                    <th class="text-right"> @Model.SumCODFee.ToString("N0") ₫</th>
                    <th class="text-right"> @Model.SumServiceFee.ToString("N0") ₫</th>
                    <th class="text-right"> @Model.SumAdjustmentFee.ToString("N0") ₫</th>
                    <th class="text-right"> @Model.SumTotalCharge.ToString("N0") ₫</th>
                }
                else
                {
                    <th class="text-right"> 0 ₫</th>
                    <th class="text-right"> 0 ₫</th>
                    <th class="text-right"> 0 ₫</th>
                    <th class="text-right"> 0 ₫</th>
                    <th class="text-right"> 0 ₫</th>
                }
                <th class="align-middle"></th>
            </tr>
            <tr class="table-info text-center">
                <th class="align-middle"> STT </th>
                <th class="align-middle"> Số hiệu </th>
                <th class="align-middle"> Số tham chiếu</th>
                <th class="align-middle"> Ngày</th>
                <th class="align-middle"> Bưu cục khai thác </th>
                <th class="align-middle"> Bưu cục trả </th>
                <th class="align-middle"> Trọng lượng</th>
                <th class="align-middle"> Cước chính (VNĐ)</th>
                <th class="align-middle"> Cước COD (VNĐ)</th>
                <th class="align-middle"> Cước DV (VNĐ)</th>
                <th class="align-middle"> Cước điều chỉnh (VNĐ)</th>
                <th class="align-middle"> Tổng cước (VNĐ)</th>
                <th class="align-middle" style="max-width: 260px; white-space: inherit; text-align: left; vertical-align: baseline;line-height: 1.4rem;"> Nội dung</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var item in Model.DataInfoDetails)
                {
                    var TotalCharge = item.MainFee + item.CODFee + item.ServiceFee + item.AdjustmentFee;
                    <tr>
                        <td class="text-center">@(stt++)</td>
                        <td class="text-center">
                            @item.ItemCode
                        </td>
                        <td class="text-center">
                            @item.ReferenceNumber
                        </td>
                        <td class="text-center">
                            @item.ReleaseDate
                        </td>
                        <td class="text-center">
                            @item.PostOfficeExploit
                        </td>
                        <td class="text-center">
                            @item.PostOfficeReturn
                        </td>
                        <td class="text-right">
                            @item.Weight
                        </td>
                        <td class="text-right">
                            @item.MainFee.ToString("N0")
                        </td>
                        <td class="text-right">
                            @item.CODFee.ToString("N0")
                        </td>
                        <td class="text-right">
                            @item.ServiceFee.ToString("N0")
                        </td>
                        <td class="text-right">
                            @item.AdjustmentFee.ToString("N0")
                        </td>
                        <td class="text-right">
                            @TotalCharge.ToString("N0")
                        </td>
                        <td class="text-left" style="max-width: 260px; white-space: inherit; text-align: left; vertical-align: baseline;line-height: 1.4rem;">
                            @item.Content
                        </td>
                    </tr>
                }
            }
        </tbody>
        <tfoot>
            <tr>
                <th class="align-middle" colspan="7"></th>
                <th class="text-right"></th>
                <th class="text-right"></th>
                <th class="text-right"></th>
                <th class="text-right"></th>
                <th class="text-right"></th>
                <th class="text-middle"></th>
            </tr>
        </tfoot>
    </table>
</div>
@if (Model != null)
{
    if (Model.DataInfo.CustomerCode != null)
    {
        <p>&nbsp;</p>
        <div class="table-responsive mt-2">
            <table id="ListDataSum" class="table" style="border-collapse:collapse;" border="0" cellspacing="0" cellpadding="0">
                <tbody>
                    <tr>
                        <td class="cell-Width">
                            <div class="text-content mt-2">
                                <label class="text-lable"><b>Cước khác:</b></label>
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Model.DataInfo.OtherCharges.ToString("N0")
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Model.DataInfo.OtherCharges.ToString("N0")
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="cell-Width">
                            <div class="text-content mt-2">
                                <label class="text-lable"><b>Cước điều chỉnh:</b></label>
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @{
                                    var AdjustmentFee = (Model.DataInfo.AdjustmentFeeRevenue - Model.SumAdjustmentFee);
                                }
                                @AdjustmentFee.ToString("N0")
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @AdjustmentFee.ToString("N0")
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="cell-Width">
                            <div class="text-content mt-2">
                                <label class="text-lable"><b>Trong nước:</b></label>
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Model.DataInfo.DomesticRevenue.ToString("N0")
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Model.DataInfo.DomesticRate.ToString("N0") %
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Math.Round((double)(Model.DataInfo.DomesticRevenue * Model.DataInfo.DomesticRate) / 100).ToString("N0")
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="cell-Width">
                            <div class="text-content mt-2">
                                <label class="text-lable"><b>Thoả thuận:</b></label>
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Model.DataInfo.NegotiableRevenue.ToString("N0")
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Model.DataInfo.AgreementRate.ToString("N0") %
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Math.Round((double)(Model.DataInfo.NegotiableRevenue * Model.DataInfo.AgreementRate) / 100).ToString("N0")
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="cell-Width">
                            <div class="text-content mt-2">
                                <label class="text-lable"><b>Quốc tế:</b></label>
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Model.DataInfo.InternationalRevenue.ToString("N0")
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Model.DataInfo.InternationalRate.ToString("N0") %
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Math.Round((double)(Model.DataInfo.InternationalRevenue * Model.DataInfo.InternationalRate) / 100).ToString("N0")
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="cell-Width">
                            <div class="text-content mt-2">
                                <label class="text-lable"><b>Quốc tế Priority:</b></label>
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Model.DataInfo.InternationalPriorityRevenue.ToString("N0")
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Model.DataInfo.PriorityRate.ToString("N0") %
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Math.Round((double)(Model.DataInfo.InternationalPriorityRevenue * Model.DataInfo.PriorityRate) / 100).ToString("N0")
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="cell-Width">
                            <div class="text-content mt-2">
                                <label class="text-lable"><b>Thương mại điện tử:</b></label>
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Model.DataInfo.EcommerceRevenue.ToString("N0")
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Model.DataInfo.EcommerceRate.ToString("N0") %
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Math.Round((double)(Model.DataInfo.EcommerceRevenue * Model.DataInfo.EcommerceRate) / 100).ToString("N0")
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="cell-Width">
                            <div class="text-content mt-2">
                                <label class="text-lable"><b>Chuyển hoàn:</b></label>
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Model.DataInfo.PermuteRevenue.ToString("N0")
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Model.DataInfo.ReturnRate.ToString("N0") %
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Math.Round((double)(Model.DataInfo.PermuteRevenue * Model.DataInfo.ReturnRate) / 100).ToString("N0")
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="cell-Width">
                            <div class="text-content mt-2">
                                <label class="text-lable"><b>Hoàn cước:</b></label>
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Model.DataInfo.RefundRevenue.ToString("N0")
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Model.DataInfo.RefundRevenue.ToString("N0")
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="cell-Width">
                            <div class="text-content mt-2">
                                <label class="text-lable"><b>Truy thu:</b></label>
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Model.DataInfo.ArrearsRevenue.ToString("N0")
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Model.DataInfo.ArrearsRevenue.ToString("N0")
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="cell-Width">
                            <div class="text-content mt-2">
                                <label class="text-lable"><b>Khuyến mãi theo CV:</b></label>
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Model.DataInfo.PromotionCVRevenue.ToString("N0")
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Model.DataInfo.PromotionCVRevenue.ToString("N0")
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="cell-Width">
                            <div class="text-content mt-2">
                                <label class="text-lable"><b>Cước điều chỉnh khác:</b></label>
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Model.DataInfo.OtherAdjustmentChargesRevenue.ToString("N0")
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @Model.DataInfo.OtherAdjustmentChargesRevenue.ToString("N0")
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="cell-Width">
                            <div class="text-content mt-2">
                                <label class="text-lable"><b>Tổng tiền thanh toán sau khi chiết khấu giảm giá:</b></label>
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                            </div>
                        </td>
                        <td>
                            <div class="text-right">
                                @{
                                    double Sum = (((double)(Model.DataInfo.DomesticRevenue * Model.DataInfo.DomesticRate) / 100) +
                                            ((double)(Model.DataInfo.PermuteRevenue * Model.DataInfo.ReturnRate) / 100) +
                                            ((double)(Model.DataInfo.InternationalRevenue * Model.DataInfo.InternationalRate) / 100) +
                                            ((double)(Model.DataInfo.NegotiableRevenue * Model.DataInfo.AgreementRate) / 100) +
                                            ((double)(Model.DataInfo.EcommerceRevenue * Model.DataInfo.EcommerceRate) / 100) +
                                            (Model.DataInfo.ArrearsRevenue + Model.DataInfo.RefundRevenue));
                                }
                                @Math.Round((double)((Model.SumTotalCharge + (Model.DataInfo.AdjustmentFeeRevenue - Model.SumAdjustmentFee) + Model.DataInfo.OtherCharges) - Sum)).ToString("N0")
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
}
<script>
    $(document).ready(function () {
        $('#ListDataTableSearch').DataTable({
            "aLengthMenu": [
                [20, 30, 50, 100, -1],
                [20, 30, 50, 100, "Tất cả"]
            ],
            "iDisplayLength": 20,
            'language': {
                sSearch: 'Tìm kiếm ',
                emptyTable: "Không có dữ liệu",
                zeroRecords: "Không có dữ liệu",
                sInfo: 'Hiển thị từ _START_ đến _END_ của _TOTAL_ bản ghi',
                infoEmpty: "Hiển thị từ _START_ đến _END_ của _TOTAL_ bản ghi",
                infoFiltered: "(Tìm kiếm từ _MAX_ bản ghi)",
                oPaginate: {
                    'sFirst': 'Trang đầu',
                    'sPrevious': 'Trang trước',
                    'sNext': 'Trang sau',
                    'sLast': 'Trang cuối'
                },
                lengthMenu: "Hiển thị _MENU_ bản ghi"
            },
            "ordering": false,
            "footerCallback": function (row, data, start, end, display) {
                var api = this.api(), data;
                var intVal = function (i) {
                    return typeof i === 'string' ?
                        i.replace(/[\$,]/g, '') * 1 :
                        typeof i === 'number' ?
                            i : 0;
                };
                var j = 7;
                while (j < 12) {
                    // Total over all pages
                    total = api
                        .column(j)
                        .data()
                        .reduce(function (a, b) {
                            return intVal(a) + intVal(b);
                        }, 0);

                    // Total over this page
                    pageTotal = api
                        .column(j, { page: 'current' })
                        .data()
                        .reduce(function (a, b) {
                            return intVal(a) + intVal(b);
                        }, 0);

                    // Update footer
                    $(api.column(j).footer()).html(
                        CurrencyFormatVND(pageTotal)
                    );
                    j++;
                }
            },
        });
    });
</script>
